    }

    #banner-container.portal-banner-mode.banner-only-mode .banner-aspect-container {
      height: 100dvh;
      min-height: 0;
    }
  }

  @media (max-width: 767px) and (orientation: landscape) {
    #main-grid {
      grid-template-columns: 10rem minmax(0, 1fr) !important;
