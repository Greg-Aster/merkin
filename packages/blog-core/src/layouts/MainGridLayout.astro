---
// =====================================================================
// COMPONENT IMPORTS - CLEAN AND SIMPLE
// =====================================================================
import Footer from '@components/Footer.astro'
import Navbar from '@components/Navbar.astro'
import BackToTop from '@components/control/BackToTop.astro'
import RightRailContent from '@components/widget/RightRailContent.astro'
import SideBar from '@components/widget/SideBar.astro'
import type { MarkdownHeading } from 'astro'
import BannerStage from '../components/banner-stage/BannerStage.astro'
import TOC from '../components/widget/TOC.astro'
import { siteConfig } from '@/config/config'
import Layout from './Layout.astro'
import '../styles/timeline-styles.css'
import { pathsEqual, url } from '../utils/url-utils'

// Blog-core shared client components (relative imports)
import MobileProfileOverlay from '../components/client/MobileProfileOverlay.svelte'
import PageAnimations from '../components/client/PageAnimations.svelte'
import Profile from '../components/client/Profile.svelte'
import ScrollEffects from '../components/client/ScrollEffects.svelte'
import SidenavPanels from '../components/client/SidenavPanels.svelte'
import SpecialPageFeatures from '../components/client/SpecialPageFeatures.svelte'

import { avatarConfig } from '@/config/avatar.config'
// Profile and avatar configs for Svelte components
import { profileConfig } from '@/config/config'

// App-level banner configuration (supports both legacy and advanced contracts)
import * as bannerModule from '@/config/banner.config'

// =====================================================================
// TYPESCRIPT INTERFACES
// =====================================================================

interface Props {
  title?: string
  banner?: string
  description?: string
  lang?: string
  setOGTypeArticle?: boolean
  headings?: MarkdownHeading[]
  post?: any
  bannerLink?: string
  isPostPage?: boolean
  pageMascotContext?: string
  backgroundImage?: string | null
  // ⭐ NEW: OneColumn layout prop
  oneColumn?: boolean
  // ⭐ NEW: Custom author data prop
  customAuthorData?: {
    avatarImage?: string
    authorName?: string
    authorBio?: string
    authorLink?: string
  }
  homeLayout?: 'default' | 'portal'
  contentMode?: 'default' | 'banner-only'
  showAssistantWidget?: boolean
  timelineEvents?: any[]
  timelineEraConfig?: Record<string, any>
  timelineConstellationConfig?: Record<string, any>
  timelineConstellationPatterns?: Record<string, any>
  timelineConnectionPatterns?: Record<string, any>
}

// =====================================================================
// PROPS DESTRUCTURING AND SETUP
// =====================================================================

const {
  title,
  banner = siteConfig.banner.src,
  description,
  lang,
  setOGTypeArticle,
  headings = [],
  post,
  bannerLink = '',
  isPostPage = false,
  backgroundImage,
  oneColumn = false, // ⭐ NEW: Accept oneColumn prop
  customAuthorData, // ⭐ NEW: Extract custom author data
  homeLayout = 'default',
  contentMode = 'default',
  showAssistantWidget = false,
  timelineEvents = [],
  timelineEraConfig,
  timelineConstellationConfig,
  timelineConstellationPatterns,
  timelineConnectionPatterns,
} = Astro.props

const isBannerOnly = contentMode === 'banner-only'
const isPortalBannerMode = homeLayout === 'portal' && isBannerOnly

const rawBannerConfig = (bannerModule as any).bannerConfig ?? {}

function createLegacyStandardBannerConfig(config: any) {
  const bannerList = Array.isArray(config.bannerList) ? config.bannerList : []
  const bannerLinks = Array.isArray(config.bannerLinks)
    ? config.bannerLinks
    : []

  const getBannerLinkFromList = (index: number): string | null => {
    if (typeof bannerLinks[index] !== 'string') return null
    const link = bannerLinks[index].trim()
    return link.length > 0 ? link : null
  }

  return {
    bannerList,
    bannerLinks,
    animation: {
      enabled: config.animation?.enabled ?? true,
      interval: config.animation?.interval ?? 5000,
      transitionDuration: config.animation?.transitionDuration ?? 1000,
      direction: config.animation?.direction ?? 'forward',
    },
    video: {
      autoplay: true,
      muted: true,
      loop: true,
      playsInLine: true,
      controls: false,
      preload: 'none',
    },
    getBannerAnimationSettings: () => ({
      enabled: config.animation?.enabled ?? true,
      interval: config.animation?.interval ?? 5000,
      transitionDuration: config.animation?.transitionDuration ?? 1000,
      direction: config.animation?.direction ?? 'forward',
    }),
    getBannerLink: getBannerLinkFromList,
    hasAnyBannerLinks: () =>
      bannerLinks.some(
        (link: unknown) => typeof link === 'string' && link.trim().length > 0,
      ),
    getLinkPreviewData: (url: string) => ({
      title: 'Explore More',
      description: url || 'Click to visit this page',
      icon: 'arrow-up-right-from-square',
    }),
    getIconSVG: () => '',
    getBannerItemPreviewDetails: (index: number) => {
      const item = bannerList[index]
      const link = getBannerLinkFromList(index)
      return {
        hasValidLink: !!link,
        originalHref: link || '',
        urlForDisplay: link || '',
        previewTitle: item?.alt || `Banner ${index + 1}`,
        previewDescription: 'Click to explore this banner item.',
        previewIconSVG: '',
        isVideoButton: item?.type === 'video',
      }
    },
    isVideoBannerItem: (item: any) =>
      item?.type === 'video' ||
      (typeof item?.src === 'string' &&
        /\.(webm|mp4|mov|ogg)(\?.*)?$/i.test(item.src)),
    isImageBannerItem: (item: any) =>
      item?.type === 'image' ||
      (typeof item?.src !== 'undefined' && item?.type !== 'video'),
  }
}

function normalizeCssSize(
  value: unknown,
  fallback: string,
  defaultUnit: 'vh' | 'rem' = 'vh',
): string {
  if (typeof value === 'number' && Number.isFinite(value)) {
    return value === 0 ? '0' : `${value}${defaultUnit}`
  }

  if (typeof value !== 'string') return fallback

  const trimmedValue = value.trim()
  if (!trimmedValue) return fallback

  // Keep valid CSS expressions as-is.
  if (
    trimmedValue.startsWith('calc(') ||
    trimmedValue.startsWith('clamp(') ||
    trimmedValue.startsWith('min(') ||
    trimmedValue.startsWith('max(') ||
    trimmedValue.startsWith('var(')
  ) {
    return trimmedValue
  }

  // Accept common CSS size units directly.
  if (
    /^-?\d*\.?\d+(px|rem|em|vh|vw|vmin|vmax|svh|lvh|dvh|%)$/i.test(trimmedValue)
  ) {
    return trimmedValue
  }

  // Handle bare numbers like "80" from manual tuning.
  if (/^-?\d*\.?\d+$/.test(trimmedValue)) {
    const numericValue = Number(trimmedValue)
    return numericValue === 0 ? '0' : `${trimmedValue}${defaultUnit}`
  }

  return fallback
}

function normalizeBannerConfig(config: any) {
  const standardBannerConfig =
    config.standardBannerConfig ?? createLegacyStandardBannerConfig(config)

  const rawDesktopBannerHeight =
    typeof config.layout?.height === 'string'
      ? config.layout.height
      : config.layout?.height?.desktop
  const desktopBannerHeight = normalizeCssSize(rawDesktopBannerHeight, '60vh')

  const rawMobileBannerHeight =
    config.layout?.mobileHeight ??
    (typeof config.layout?.height === 'object'
      ? config.layout?.height?.mobile
      : undefined)
  const mobileBannerHeight = normalizeCssSize(
    rawMobileBannerHeight,
    desktopBannerHeight,
  )

  const spacingFromConfig = config.navbar?.spacing ?? config.navbarSpacing ?? {}
  const mobileBannerGap =
    config.navbar?.mobileBannerGap ??
    config.navbar?.mobilePortraitSpacing ??
    config.navbar?.height?.mobile ??
    '4rem'
  const mobilePortraitPanelTop =
    config.panel?.top?.mobilePortrait ?? config.panel?.top?.standard ?? '0'

  return {
    ...config,
    defaultBannerType: config.defaultBannerType ?? 'standard',
    defaultBannerData: config.defaultBannerData ?? {},
    standardBannerConfig,
    layout: {
      ...config.layout,
      height: desktopBannerHeight,
      mobileHeight: mobileBannerHeight,
      maxWidth: config.layout?.maxWidth ?? 1920,
      mainContentOffset: config.layout?.mainContentOffset ?? '1.5rem',
    },
    visual: {
      objectFit: config.visual?.objectFit ?? 'cover',
      objectPosition: config.visual?.objectPosition ?? 'center',
      applyGradientOverlay: config.visual?.applyGradientOverlay ?? false,
      gradientOverlay:
        config.visual?.gradientOverlay ??
        'linear-gradient(to bottom, rgba(0,0,0,0.2), transparent)',
      borderRadius: config.visual?.borderRadius ?? '0',
    },
    fallback: {
      enabled: config.fallback?.enabled ?? true,
      type: config.fallback?.type ?? 'gradient',
      value:
        config.fallback?.value ??
        'linear-gradient(to bottom, var(--color-primary-light), var(--color-primary))',
    },
    navbar: {
      ...config.navbar,
      height:
        typeof config.navbar?.height === 'string'
          ? config.navbar.height
          : config.navbar?.height?.desktop ?? '4.5rem',
      mobileBannerGap,
      // Backward compatibility: older configs may still read/write this key.
      mobilePortraitSpacing: mobileBannerGap,
      spacing: {
        standard: spacingFromConfig.standard ?? '0',
        timeline: spacingFromConfig.timeline ?? '5.5rem',
        video: spacingFromConfig.video ?? '5.5rem',
        image: spacingFromConfig.image ?? '0',
        assistant:
          spacingFromConfig.assistant ?? spacingFromConfig.standard ?? '0',
        cookbook:
          spacingFromConfig.cookbook ??
          spacingFromConfig.video ??
          spacingFromConfig.standard ??
          '0',
        archive:
          spacingFromConfig.archive ??
          spacingFromConfig.video ??
          spacingFromConfig.standard ??
          '0',
        reader:
          spacingFromConfig.reader ??
          spacingFromConfig.video ??
          spacingFromConfig.standard ??
          '0',
        none: spacingFromConfig.none ?? '0',
      },
    },
    panel: {
      ...config.panel,
      top: {
        standard: config.panel?.top?.standard ?? '0',
        timeline: config.panel?.top?.timeline ?? '0',
        video: config.panel?.top?.video ?? '0',
        image: config.panel?.top?.image ?? '0',
        assistant:
          config.panel?.top?.assistant ?? config.panel?.top?.standard ?? '0',
        archive:
          config.panel?.top?.archive ??
          config.panel?.top?.video ??
          config.panel?.top?.standard ??
          '0',
        reader:
          config.panel?.top?.reader ??
          config.panel?.top?.video ??
          config.panel?.top?.standard ??
          '0',
        none: config.panel?.top?.none ?? '0',
        mobilePortrait: mobilePortraitPanelTop,
      },
    },
    parallax: {
      enabled: config.parallax?.enabled ?? false,
      scrollFactor: config.parallax?.scrollFactor ?? -0.02,
      easingFactor: config.parallax?.easingFactor ?? 0.1,
    },
  }
}

const bannerConfig = normalizeBannerConfig(rawBannerConfig)
const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')

function normalizeAssetUrl(assetPath?: string | null): string {
  if (!assetPath) return ''
  if (
    assetPath.startsWith('http://') ||
    assetPath.startsWith('https://') ||
    assetPath.startsWith('//') ||
    assetPath.startsWith('data:')
  ) {
    return assetPath
  }
  if (!assetPath.startsWith('/')) return assetPath
  if (baseUrl && assetPath.startsWith(`${baseUrl}/`)) return assetPath
  return url(assetPath, import.meta.env.BASE_URL)
}

const getPanelTopPosition = (bannerType: string): string => {
  switch (bannerType) {
    case 'video':
      return bannerConfig.panel.top.video
    case 'image':
      return bannerConfig.panel.top.image
    case 'timeline':
      return bannerConfig.panel.top.timeline
    case 'assistant':
      return bannerConfig.panel.top.assistant
    case 'cookbook':
      return bannerConfig.panel.top.video ?? bannerConfig.panel.top.standard
    case 'archive':
      return bannerConfig.panel.top.archive ??
        bannerConfig.panel.top.video ??
        bannerConfig.panel.top.standard
    case 'reader':
      return bannerConfig.panel.top.reader ??
        bannerConfig.panel.top.video ??
        bannerConfig.panel.top.standard
    case 'none':
      return bannerConfig.panel.top.none
    default:
      return bannerConfig.panel.top.standard
  }
}

const determineBannerConfiguration =
  typeof (bannerModule as any).determineBannerConfiguration === 'function'
    ? (bannerModule as any).determineBannerConfiguration
    : (postValue: any, _pageType = 'default', defaultBannerLink = '') => {
        const postData = {
          bannerLink: postValue?.data?.bannerLink || '',
          customAvatar: normalizeAssetUrl(postValue?.data?.avatarImage || ''),
          customName: postValue?.data?.authorName || '',
          customBio: postValue?.data?.authorBio || '',
          slug: postValue?.slug || '',
          // `showImageOnPost` only controls the inline article cover image.
          // It should not disable the page banner or shared default banner system.
          wantsNoDefaultBanner: false,
        }

        const hasPostTimelineBanner =
          postValue?.data?.bannerType === 'timeline' &&
          postValue?.data?.bannerData?.category
        const hasPostVideoBanner =
          postValue?.data?.bannerType === 'video' &&
          postValue?.data?.bannerData?.videoId
        const hasPostAssistantBanner =
          postValue?.data?.bannerType === 'assistant'
        const hasPostCookbookBanner =
          postValue?.data?.bannerType === 'cookbook'
        const hasPostArchiveBanner =
          postValue?.data?.bannerType === 'archive'
        const hasPostReaderBanner =
          postValue?.data?.bannerType === 'reader'
        const hasPostImageBanner =
          !!(
            postValue?.data?.image ||
            (postValue?.data?.bannerType === 'image' &&
              postValue?.data?.bannerData?.imageUrl)
          ) &&
          !hasPostVideoBanner &&
          !hasPostTimelineBanner &&
          !hasPostAssistantBanner &&
          !hasPostCookbookBanner &&
          !hasPostArchiveBanner &&
          !hasPostReaderBanner

        const hasPostBanner =
          hasPostVideoBanner ||
          hasPostImageBanner ||
          hasPostTimelineBanner ||
          hasPostAssistantBanner ||
          hasPostCookbookBanner ||
          hasPostArchiveBanner ||
          hasPostReaderBanner

        const defaultBannerType = bannerConfig.defaultBannerType
        const hasTimelineBanner =
          hasPostTimelineBanner ||
          (!hasPostBanner && defaultBannerType === 'timeline')
        const hasVideoBanner =
          hasPostVideoBanner ||
          (!hasPostBanner && defaultBannerType === 'video')
        const hasImageBanner =
          hasPostImageBanner ||
          (!hasPostBanner && defaultBannerType === 'image')
        const hasAssistantBanner =
          hasPostAssistantBanner ||
          (!hasPostBanner && defaultBannerType === 'assistant')
        const hasCookbookBanner = hasPostCookbookBanner
        const hasArchiveBanner = hasPostArchiveBanner
        const hasReaderBanner = hasPostReaderBanner
        const hasStandardBanner =
          !hasPostBanner &&
          !hasTimelineBanner &&
          !hasVideoBanner &&
          !hasImageBanner &&
          !hasAssistantBanner &&
          !hasCookbookBanner &&
          !hasArchiveBanner &&
          !hasReaderBanner

        const currentBannerType = hasVideoBanner
          ? 'video'
          : hasImageBanner
            ? 'image'
            : hasTimelineBanner
              ? 'timeline'
              : hasAssistantBanner
                ? 'assistant'
                : hasCookbookBanner
                  ? 'cookbook'
                  : hasArchiveBanner
                    ? 'archive'
                    : hasReaderBanner
                      ? 'reader'
                      : hasStandardBanner
                        ? 'standard'
                        : 'none'

        const postImage = normalizeAssetUrl(
          postValue?.data?.bannerData?.imageUrl || postValue?.data?.image,
        )

        return {
          postData,
          bannerType: {
            hasTimelineBanner,
            hasVideoBanner,
            hasImageBanner,
            hasAssistantBanner,
            hasCookbookBanner,
            hasArchiveBanner,
            hasReaderBanner,
            hasStandardBanner,
            hasPostBanner,
            isStandardPage: !hasPostBanner,
            currentBannerType,
          },
          bannerDataSources: {
            videoBannerData:
              hasVideoBanner && postValue?.data?.bannerType === 'video'
                ? postValue.data.bannerData
                : hasVideoBanner
                  ? bannerConfig.defaultBannerData
                  : null,
            imageBannerData: hasImageBanner
              ? postImage
                ? { imageUrl: postImage }
                : bannerConfig.imageBannerConfig?.data || null
              : null,
            timelineBannerData:
              hasTimelineBanner && postValue?.data?.bannerType === 'timeline'
                ? postValue.data.bannerData
                : hasTimelineBanner
                  ? bannerConfig.defaultBannerData
                  : null,
            assistantBannerData:
              hasAssistantBanner && postValue?.data?.bannerType === 'assistant'
                ? postValue.data.bannerData
                : hasAssistantBanner
                  ? bannerConfig.defaultBannerData
                  : null,
            cookbookBannerData:
              hasCookbookBanner && postValue?.data?.bannerType === 'cookbook'
                ? postValue.data.bannerData
                : null,
            archiveBannerData:
              hasArchiveBanner && postValue?.data?.bannerType === 'archive'
                ? postValue.data.bannerData
                : null,
            readerBannerData:
              hasReaderBanner && postValue?.data?.bannerType === 'reader'
                ? postValue.data.bannerData
                : null,
          },
          layout: {
            mainPanelTop: getPanelTopPosition(currentBannerType),
            navbarSpacing:
              bannerConfig.navbar.spacing[currentBannerType] ??
              bannerConfig.navbar.spacing.standard,
            bannerHeight: bannerConfig.layout.height,
            bannerHeightMobile:
              bannerConfig.layout.mobileHeight ?? bannerConfig.layout.height,
            mainContentOffset: bannerConfig.layout.mainContentOffset,
          },
          finalBannerLink: postData.bannerLink || defaultBannerLink,
          currentBannerType,
        }
      }

const getBannerAnimationSettings =
  typeof (bannerModule as any).getBannerAnimationSettings === 'function'
    ? (bannerModule as any).getBannerAnimationSettings
    : () => bannerConfig.standardBannerConfig.getBannerAnimationSettings()

const getDynamicBackgroundImage =
  typeof (bannerModule as any).getDynamicBackgroundImage === 'function'
    ? (bannerModule as any).getDynamicBackgroundImage
    : (bgImage?: string | null) => {
        if (bgImage === 'none' || bgImage === '') return null
        if (bgImage) return bgImage
        if (siteConfig?.banner?.enable && siteConfig?.banner?.src) {
          return siteConfig.banner.src
        }
        return null
      }

const getShouldShowParallaxBackground =
  typeof (bannerModule as any).getShouldShowParallaxBackground === 'function'
    ? (bannerModule as any).getShouldShowParallaxBackground
    : (bgImage?: string | null) =>
        !!(getDynamicBackgroundImage(bgImage) && bannerConfig.parallax.enabled)

// =====================================================================
// ⭐ NEW: Determine oneColumn mode from props or post data
// =====================================================================
const oneColumnMode = oneColumn || post?.data?.oneColumn || false
if (import.meta.env.DEV) {
}

// =====================================================================
// ⭐ RESTORED: Use working banner configuration system
// =====================================================================

// Get current path for page type determination
const currentPath = Astro.url.pathname
const basePath = import.meta.env.BASE_URL || '/'
const isHomePage = pathsEqual(currentPath, basePath)
const isPortalHome = isHomePage && homeLayout === 'portal'
const isPostRoute = Boolean(post)

// ⭐ RESTORED: Use the working banner configuration function
const bannerConfiguration = determineBannerConfiguration(
  post,
  'default',
  bannerLink,
)

const bannerAnimationSettings = getBannerAnimationSettings()

// Destructure the processed configuration - WORKING STRUCTURE
const {
  postData,
  bannerType,
  bannerDataSources,
  layout,
  finalBannerLink,
  currentBannerType,
} = bannerConfiguration

const tocMinHeadings = siteConfig.toc.minHeadings ?? 3
const tocOverride =
  typeof post?.data?.showToc === 'boolean' ? post.data.showToc : undefined
const hasEnoughHeadingsForToc = headings.length >= tocMinHeadings
const shouldShowToc =
  siteConfig.toc.enable && (tocOverride ?? hasEnoughHeadingsForToc)

const shouldShowFallbackRightRail =
  !isPortalHome &&
  siteConfig.rightRail?.enable === true &&
  ((isHomePage && siteConfig.rightRail?.showOnHome !== false) ||
    (isPostRoute &&
      !shouldShowToc &&
      siteConfig.rightRail?.showOnPostsWithoutToc === true))

const shouldShowRightRail = shouldShowToc || shouldShowFallbackRightRail
const shouldMergeRightRailIntoSidebar =
  shouldShowFallbackRightRail && !shouldShowToc
const rightRailStickyTop = siteConfig.rightRail?.stickyTop ?? '3.5rem'

// Process custom author data with direct post-data fallbacks so avatar overrides
// remain functional even if app banner adapters omit author fields.
const directPostAuthorData = {
  slug: post?.slug || '',
  avatarImage: normalizeAssetUrl(post?.data?.avatarImage || ''),
  authorName: post?.data?.authorName || '',
  authorBio: post?.data?.authorBio || '',
  authorLink: post?.data?.authorLink || '',
}

const processedAuthorData = {
  slug: postData?.slug || directPostAuthorData.slug || '',
  customAvatar: normalizeAssetUrl(
    customAuthorData?.avatarImage ||
      postData?.customAvatar ||
      directPostAuthorData.avatarImage ||
      '',
  ),
  customName:
    customAuthorData?.authorName ||
    postData?.customName ||
    directPostAuthorData.authorName ||
    '',
  customBio:
    customAuthorData?.authorBio ||
    postData?.customBio ||
    directPostAuthorData.authorBio ||
    '',
  customLink:
    customAuthorData?.authorLink ||
    postData?.customLink ||
    directPostAuthorData.authorLink ||
    '',
}

if (import.meta.env.DEV) {
}

const { hasPostBanner } = bannerType

// ⭐ RESTORED: Use working layout values
const {
  mainPanelTop, // This controls the overlap (WORKING)
  navbarSpacing, // This controls navbar spacing (WORKING + MOBILE PORTRAIT FIX)
  bannerHeight,
  bannerHeightMobile,
  mainContentOffset,
} = layout

const resolvedBannerHeight = normalizeCssSize(
  bannerHeight,
  bannerConfig.layout.height,
)
const resolvedBannerHeightMobile = normalizeCssSize(
  bannerHeightMobile,
  bannerConfig.layout.mobileHeight ?? resolvedBannerHeight,
)

const mobileMainPanelTop =
  currentBannerType === 'standard'
    ? bannerConfig.panel?.top?.mobilePortrait ?? mainPanelTop
    : mainPanelTop
const mobilePortraitRightRailHeroStyle =
  siteConfig.rightRail?.mobilePortraitHero?.style ?? 'banner-overlay'
const shouldShowMobilePortraitRightRailHero =
  shouldMergeRightRailIntoSidebar &&
  currentBannerType === 'standard' &&
  siteConfig.rightRail?.mobilePortraitHero?.enabled === true

// =====================================================================
// ⭐ RESTORED: Background image logic (working)
// =====================================================================

const currentBackgroundImage = getDynamicBackgroundImage(backgroundImage)
const shouldShowParallaxBackground =
  !isPortalBannerMode && getShouldShowParallaxBackground(backgroundImage)

// =====================================================================
// BLEEPY CONTEXT SETUP
// =====================================================================

let contextForBleepy = null
if (post && post.data) {
  contextForBleepy = {
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
    category: post.data.category,
    timelineEra: post.data.timelineEra,
    timelineLocation: post.data.timelineLocation,
    mascotContext: post.data.mascotContext,
  }
}

// Conditionally create the grid classes
const gridLayoutClasses = [
  'transition duration-700 w-full left-0 right-0 grid mx-auto gap-4 md:gap-4 px-2 md:px-4 relative',
  isPortalHome || isBannerOnly || oneColumnMode
    ? 'grid-cols-1'
    : 'grid-cols-1 md:grid-cols-[16.5rem_auto]',
  !isPortalHome && !isBannerOnly && !oneColumnMode && shouldShowRightRail
    ? '2xl:grid-cols-[16.5rem_auto_var(--toc-width)]'
    : '',
].join(' ')
---

<Layout 
  title={title} 
  banner={banner} 
  description={description} 
  lang={lang} 
  setOGTypeArticle={setOGTypeArticle}
  post={post} 
>

  <!-- =============================================================== -->
  <!-- PARALLAX BACKGROUND SECTION                                   -->
  <!-- =============================================================== -->
  {shouldShowParallaxBackground &&
    <div id="parallax-banner" class="fixed top-0 left-0 w-full h-screen z-[-1] overflow-hidden">
      {siteConfig.banner.video ? (
        <>
          <video
            id="parallax-image"
            class="parallax-bg object-cover w-full h-[120vh]"
            autoplay
            loop
            muted
            playsinline
            aria-hidden="true"
            data-playback-rate={siteConfig.banner.playbackRate ?? 1}
            style={`object-position: ${siteConfig.banner.position || 'center'}`}
          >
            <source src={siteConfig.banner.video} type="video/webm" />
          </video>
          <script>
            (function () {
              var v = document.getElementById('parallax-image');
              if (v && v.tagName === 'VIDEO') {
                var configuredRate = Number(v.dataset.playbackRate);
                var playbackRate = Number.isFinite(configuredRate) && configuredRate > 0 ? configuredRate : 1;
                v.playbackRate = playbackRate;
                v.addEventListener('play', function () { v.playbackRate = playbackRate; });
              }
            })();
          </script>
        </>
      ) : (
        <ImageWrapper
          id="parallax-image"
          alt="Site background image"
          class="parallax-bg object-cover w-full h-[120vh]"
          src={currentBackgroundImage}
          position={siteConfig.banner.position || 'center'}
        />
      )}
      {siteConfig.banner.credit?.enable &&
        <div class="absolute bottom-4 right-4 text-white/50 text-xs bg-black/30 px-2 py-1 rounded">
          {siteConfig.banner.credit.text &&
            <a href={siteConfig.banner.credit.url || '#'} class="hover:text-white/80 transition">
              {siteConfig.banner.credit.text}
            </a>
          }
        </div>
      }
      <div class="absolute inset-0 bg-gradient-to-b from-black/20 to-black/50 pointer-events-none"></div>
    </div>
  }

  <!-- =============================================================== -->
  <!-- ⭐ SIMPLIFIED: NAVBAR - NOW ALWAYS VISIBLE                     -->
  <!-- =============================================================== -->
  <slot slot="head" name="head"></slot>
  <div
    id="top-row"
    class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-2 md:px-4 mx-auto"
    data-content-mode={isBannerOnly ? 'banner-only' : 'default'}
  >
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all duration-300">
      <Navbar></Navbar>
    </div>
  </div>

  <BannerStage
    title={title}
    post={post}
    currentBannerType={currentBannerType}
    bannerDataSources={bannerDataSources}
    hasPostBanner={hasPostBanner}
    finalBannerLink={finalBannerLink}
    bannerConfig={bannerConfig}
    bannerAnimationSettings={bannerAnimationSettings}
    isBannerOnly={isBannerOnly}
    isPortalBannerMode={isPortalBannerMode}
    timelineEvents={timelineEvents}
    timelineEraConfig={timelineEraConfig}
    timelineConstellationConfig={timelineConstellationConfig}
    timelineConstellationPatterns={timelineConstellationPatterns}
    timelineConnectionPatterns={timelineConnectionPatterns}
    shouldShowMobilePortraitRightRailHero={shouldShowMobilePortraitRightRailHero}
    mobilePortraitRightRailHeroStyle={mobilePortraitRightRailHeroStyle}
    currentPath={currentPath}
    isHomePage={isHomePage}
    navbarSpacing={navbarSpacing}
    mobileNavbarSpacing={bannerConfig.navbar.mobileBannerGap ??
      bannerConfig.navbar.mobilePortraitSpacing}
    bannerHeight={resolvedBannerHeight}
    bannerHeightMobile={resolvedBannerHeightMobile}
  >
    <slot name="banner-slide-content" slot="banner-slide-content" />
    <slot name="banner-overlay-content" slot="banner-overlay-content" />
    <RightRailContent
      slot="banner-mobile-right-rail"
      currentPath={currentPath}
      post={post}
      isHomePage={isHomePage}
    />
  </BannerStage>

  <!-- =============================================================== -->
  <!-- ⭐ SIMPLIFIED: One column mobile, two column desktop           -->
  <!-- =============================================================== -->
  <div class={`w-full z-30 pointer-events-none relative`}>
    <div
      id="main-panel-wrapper"
      class="responsive-panel-wrapper relative max-w-[var(--page-width)] mx-auto pointer-events-auto"
      data-is-home={isHomePage ? "true" : "false"}
      data-home-layout={isPortalHome ? 'portal' : 'default'}
      data-content-mode={isBannerOnly ? 'banner-only' : 'default'}
    >
      <div
        id="main-grid"
        class:list={[gridLayoutClasses, 'transition-swup-fade', { 'has-right-rail': shouldShowRightRail }]}
        style={`margin-top: ${mainContentOffset};`}
        data-one-column={oneColumnMode ? 'true' : 'false'}
        data-mobile-right-rail-hero={shouldShowMobilePortraitRightRailHero ? mobilePortraitRightRailHeroStyle : 'default'}
      >

        <!-- Grid Item 1: SIDEBAR -->
        {!isPortalHome && !isBannerOnly && !oneColumnMode && (
        <div class="hidden md:block mb-4 col-span-1 md:max-w-[17.5rem] onload-animation mobile-support-column">
          <section class="mobile-support-group mobile-support-profile-group">
            <div class="mobile-support-label">About</div>
            <div class="mb-4">
            <Profile client:load slug={processedAuthorData.slug} customAvatar={processedAuthorData.customAvatar} customName={processedAuthorData.customName} customBio={processedAuthorData.customBio} customLink={processedAuthorData.customLink} isHomePage={isHomePage} profileConfig={profileConfig} avatarConfig={avatarConfig} />
            </div>
          </section>
          {shouldShowToc && (
            <section id="sidebar-mobile-toc" class="mobile-support-group mobile-support-toc-group mb-4 block md:hidden">
              <div class="mobile-support-label">On this page</div>
              <div class="card-base overflow-hidden">
                <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2 before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)] before:absolute before:left-[-16px] before:top-[5.5px]">
                  Contents
                </div>
                <div class="px-4 pb-4">
                  <TOC headings={headings}></TOC>
                </div>
              </div>
            </section>
          )}
          <SideBar class="flex-1" headings={headings} postSlug={processedAuthorData.slug} customAvatar={processedAuthorData.customAvatar} customName={processedAuthorData.customName} customBio={processedAuthorData.customBio} pageMascotContext={Astro.props.pageMascotContext} hideProfile={true} showAssistantWidget={showAssistantWidget}>
            {shouldMergeRightRailIntoSidebar && (
              <div
                id="sidebar-right-rail-merge"
                class="hidden md:flex 2xl:hidden flex-col gap-4 pt-2"
              >
                <RightRailContent
                  currentPath={currentPath}
                  post={post}
                  isHomePage={isHomePage}
                />
              </div>
              )}
          </SideBar>
        </div>
        )}

        <!-- Grid Item 2: MAIN CONTENT -->
        <main id="main" class="col-span-1 overflow-hidden">
          <div id="main-content-wrapper" class="onload-animation">
            <div
              id="author-context"
              hidden
              aria-hidden="true"
              data-slug={processedAuthorData.slug}
              data-custom-avatar={processedAuthorData.customAvatar}
              data-custom-name={processedAuthorData.customName}
              data-custom-bio={processedAuthorData.customBio}
              data-custom-link={processedAuthorData.customLink}
              data-is-home-page={isHomePage}
            ></div>
            {!isBannerOnly && <slot />}
            {!isBannerOnly && <div class="footer onload-animation hidden md:block">
              <Footer></Footer>
            </div>}
          </div>
        </main>

        <!-- Grid Item 3: RIGHT RAIL -->
        {shouldShowRightRail && !isBannerOnly && !oneColumnMode && (
          <div
            id="toc-wrapper"
            class="hidden 2xl:block z-0"
            data-rail-mode={shouldShowToc ? 'toc' : 'widget'}
          >
            {shouldShowToc ? (
              <div
                class="sticky"
                style={`top: ${rightRailStickyTop};`}
              >
                <div class="card-base overflow-hidden onload-animation">
                  <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2 before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)] before:absolute before:left-[-16px] before:top-[5.5px]">
                    Contents
                  </div>
                  <div
                    id="toc-inner-wrapper"
                    class="max-h-[calc(100vh_-_12rem)] overflow-y-auto hide-scrollbar px-4 pb-4"
                    style="mask-image: none;"
                  >
                    <TOC headings={headings}></TOC>
                  </div>
                </div>
              </div>
            ) : (
              <div
                id="toc-inner-wrapper"
                class="transition-all duration-300"
                style="mask-image: none;"
              >
                <RightRailContent
                  currentPath={currentPath}
                  post={post}
                  isHomePage={isHomePage}
                />
              </div>
            )}
          </div>
        )}

        <!-- Mobile-only Footer -->
        {!isBannerOnly && <div class="footer col-span-1 onload-animation block md:hidden 2xl:hidden">
          <Footer></Footer>
        </div>}
      </div>

      {!isBannerOnly && <BackToTop></BackToTop>}
    </div>
  </div>


  <!-- =============================================================== -->
  <!-- APP MASCOT SLOT (e.g. Bleepy for MEGAMEAL)                    -->
  <!-- =============================================================== -->
  {contextForBleepy && (
    <div id="bleepy-page-context" style="display: none;" data-context={JSON.stringify(contextForBleepy)}></div>
  )}
  <slot name="mascot" />
  <slot name="overlay" />

  <!-- =============================================================== -->
  <!-- ⭐ NEW: CLIENT-SIDE SVELTE COMPONENTS                          -->
  <!-- =============================================================== -->
  
  <!-- Sidenav panels with settings and navigation -->
  <SidenavPanels client:idle siteConfig={siteConfig} />
  
  <!-- ⭐ UPDATED: Mobile profile overlay with custom author data -->
  {!isPortalHome && (
    <MobileProfileOverlay
      client:idle
      postSlug={processedAuthorData.slug}
      customAvatar={processedAuthorData.customAvatar}
      customName={processedAuthorData.customName}
      customBio={processedAuthorData.customBio}
      customLink={processedAuthorData.customLink}
      profileConfig={profileConfig}
      avatarConfig={avatarConfig}
    />
  )}
  
  <!-- ⭐ UPDATED: Special page features with oneColumn support -->
  <SpecialPageFeatures 
    client:idle 
    currentPath={currentPath} 
    oneColumn={oneColumnMode}
  />
  
  <!-- Scroll effects and parallax -->
  <ScrollEffects client:idle bannerConfig={bannerConfig} siteConfig={siteConfig} />
  
  <!-- Page load animations -->
  <PageAnimations client:load />

</Layout>

<!-- =============================================================== -->
<!-- ⭐ SUPER SIMPLIFIED: CSS with only essential positioning       -->
<!-- =============================================================== -->
<style define:vars={{
  'main-content-offset': mainContentOffset,
  'main-panel-top': mainPanelTop,
  'mobile-main-panel-top': mobileMainPanelTop,
  'navbar-spacing': navbarSpacing,
  'mobile-navbar-spacing':
    bannerConfig.navbar.mobileBannerGap ??
    bannerConfig.navbar.mobilePortraitSpacing,
  'banner-height': resolvedBannerHeight,
  'banner-height-mobile': resolvedBannerHeightMobile,
}}>
  /* ⭐ CRITICAL: Explicit mobile touch scrolling enablement */
  html, body {
    touch-action: pan-y pan-x !important;
    overscroll-behavior: auto !important;
    -webkit-overflow-scrolling: touch !important;
  }
  
  /* ⭐ CRITICAL: Ensure main content areas allow scrolling on mobile */
  @media (max-width: 767px) {
    body, html, #main, #main-content-wrapper, #main-grid, #main-panel-wrapper {
      touch-action: pan-y pan-x !important;
      overscroll-behavior: auto !important;
      -webkit-overflow-scrolling: touch !important;
    }
  }
  
  /* ⭐ ESSENTIAL: Main grid margin */
  #main-grid {
    margin-top: var(--main-content-offset);
  }

  :global(html:has(#banner-container.portal-banner-mode.banner-only-mode)),
  :global(html:has(#banner-container.portal-banner-mode.banner-only-mode) body) {
    height: 100%;
    overflow: hidden !important;
    overscroll-behavior: none !important;
  }

  .mobile-support-label,
  :global(#sidebar .sidebar-group-label) {
    display: none;
  }
  
  /* ⭐ ESSENTIAL: Main panel positioning */
  .responsive-panel-wrapper {
    top: var(--main-panel-top);
    transition: top 0.3s ease;
  }
  
  /* ⭐ ESSENTIAL: Banner spacing from navbar */
  #banner-container {
    margin-top: var(--navbar-spacing);
    transition: margin-top 0.3s ease;
  }

  /* Shared source of truth for banner height */
  #banner-container .banner-aspect-container {
    height: var(--banner-height);
  }

  #banner-container.portal-banner-mode.banner-only-mode {
    margin-top: 0;
  }

  #banner-container.portal-banner-mode.banner-only-mode .banner-aspect-container {
    height: 100dvh;
    min-height: 0;
  }

  #banner-container.portal-banner-mode.banner-only-mode .banner-content-wrapper,
