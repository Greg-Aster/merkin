  }

  /* Disable legacy aspect-ratio sizing; height comes from config via MainGridLayout */
  #banner-container .banner-aspect-container::before {
    padding-bottom: 0 !important;
  }
  
  /* ⭐ SIMPLIFIED: Mobile spacing (navbar always visible now) */
  @media (max-width: 767px) {
    .responsive-panel-wrapper {
      top: var(--mobile-main-panel-top);
    }

    #banner-container {
      margin-top: var(--mobile-navbar-spacing);
    }

    #banner-container .banner-aspect-container {
      height: var(--banner-height-mobile, var(--banner-height));
    }

