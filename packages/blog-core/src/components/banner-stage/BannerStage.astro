                                </div>
                              )}
                            </div>
                          )
                        )}
                      </div>
                    </div>
                  )
                })
              : <div
                  class="w-full h-full rounded-lg"
                  style={`background: ${bannerConfig.fallback.enabled ? bannerConfig.fallback.value : 'transparent'};`}
                ></div>}

            {shouldShowMobilePortraitRightRailHero && (
