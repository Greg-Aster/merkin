  .banner-media-layer.banner-motion-pan-down > .banner-video,
  .banner-media-layer.banner-motion-pan-down > .banner-image-fallback {
    animation-name: bannerMotionPanDown;
  }

  @keyframes bannerMotionZoomIn {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(var(--banner-motion-scale, 1.08));
    }
  }

  @keyframes bannerMotionZoomOut {
    from {
      transform: scale(var(--banner-motion-scale, 1.08));
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes bannerMotionPanLeft {
    from {
      transform: scale(var(--banner-motion-pan-scale, 1.1)) translate3d(0, 0, 0);
    }
    to {
      transform: scale(var(--banner-motion-pan-scale, 1.1))
        translate3d(calc(-1 * var(--banner-motion-pan-distance, 4%)), 0, 0);
    }
  }

  @keyframes bannerMotionPanRight {
    from {
      transform: scale(var(--banner-motion-pan-scale, 1.1))
        translate3d(calc(-1 * var(--banner-motion-pan-distance, 4%)), 0, 0);
    }
    to {
      transform: scale(var(--banner-motion-pan-scale, 1.1)) translate3d(0, 0, 0);
    }
  }

  @keyframes bannerMotionPanUp {
    from {
      transform: scale(var(--banner-motion-pan-scale, 1.1)) translate3d(0, 0, 0);
    }
    to {
      transform: scale(var(--banner-motion-pan-scale, 1.1))
        translate3d(0, calc(-1 * var(--banner-motion-pan-distance, 4%)), 0);
    }
  }

  @keyframes bannerMotionPanDown {
    from {
      transform: scale(var(--banner-motion-pan-scale, 1.1))
        translate3d(0, calc(-1 * var(--banner-motion-pan-distance, 4%)), 0);
    }
    to {
      transform: scale(var(--banner-motion-pan-scale, 1.1)) translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-media-layer.banner-motion-active > .banner-image,
    .banner-media-layer.banner-motion-active > .banner-video,
    .banner-media-layer.banner-motion-active > .banner-image-fallback {
      animation: none !important;
    }
  }
</style>

<script is:inline define:vars={{ bannerAnimationSettings }}>
  const bannerCleanupKey = '__merkinBannerCleanup'
  const bannerPageLoadBoundKey = '__merkinBannerPageLoadBound'
  const bannerControlEventName = 'merkin:banner-control'
  const bannerSceneSelectEventName = 'merkin:banner-select-scene'
  const bannerStateEventName = 'merkin:banner-state'

  const initializeBannerSystems = () => {
    if (typeof window === 'undefined') return

    if (typeof window[bannerCleanupKey] === 'function') {
      window[bannerCleanupKey]()
    }

    const abortController = new AbortController()
    const { signal } = abortController

    const standardBannerContainer = document.getElementById(
      'standard-banner-container',
    )
    const standardBannerIsPortalControlled =
      document
        .getElementById('banner-container')
        ?.classList.contains('portal-banner-mode') === true
    const slides = Array.from(
      standardBannerContainer?.querySelectorAll('.banner-slide') || [],
    )
    const animationConfig = bannerAnimationSettings || {}
    const motionConfig = animationConfig.motion || {}
    const motionClassNames = [
      'banner-motion-active',
      'banner-motion-zoom-in',
      'banner-motion-zoom-out',
      'banner-motion-pan-left',
      'banner-motion-pan-right',
      'banner-motion-pan-up',
      'banner-motion-pan-down',
    ]
    const motionEffects = [
      'zoom-in',
      'zoom-out',
      'pan-left',
      'pan-right',
      'pan-up',
      'pan-down',
    ]
    const prefersReducedMotion =
      typeof window !== 'undefined' &&
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const toFiniteNumber = (value, fallbackValue) => {
      const parsed = Number(value)
      return Number.isFinite(parsed) ? parsed : fallbackValue
    }
    const interval = Math.max(1000, toFiniteNumber(animationConfig.interval, 5000))
    const transitionDuration = Math.max(
      0,
      toFiniteNumber(animationConfig.transitionDuration, 1000),
    )
    const randomStartEnabled = !!animationConfig.randomStart
    const rotationMode =
      animationConfig.rotationMode === 'shuffle' ? 'shuffle' : 'sequential'
    const preserveFirstSlide = animationConfig.preserveFirstSlide === true
    const initialSlideIndex =
      preserveFirstSlide
        ? 0
        : randomStartEnabled && slides.length > 1
          ? Math.floor(Math.random() * slides.length)
          : 0
    const motionEnabled = !!(
      animationConfig.enabled &&
      motionConfig.enabled &&
      !prefersReducedMotion
    )
    const motionDuration = Math.max(
      transitionDuration + 250,
      toFiniteNumber(motionConfig.duration, interval),
    )
    const motionScale = Math.min(
      1.3,
      Math.max(1.01, toFiniteNumber(motionConfig.scale, 1.08)),
    )
    const motionPanDistance = Math.min(
      12,
      Math.max(1, toFiniteNumber(motionConfig.panDistance, 4)),
    )
    const motionPanScale = Math.max(1.02, motionScale)
    const motionEasing =
      typeof motionConfig.easing === 'string' && motionConfig.easing.trim().length > 0
        ? motionConfig.easing.trim()
        : 'ease-in-out'
    const shouldAlternateDirection = motionConfig.alternate === true
    const normalizeMotionMode = modeValue => {
      if (typeof modeValue !== 'string') return 'zoom-in'
      const normalized = modeValue.toLowerCase().replace(/[^a-z]/g, '')
      switch (normalized) {
        case 'zoomin':
        case 'pushin':
          return 'zoom-in'
        case 'zoomout':
        case 'pushout':
          return 'zoom-out'
        case 'panleft':
          return 'pan-left'
        case 'panright':
          return 'pan-right'
        case 'panup':
          return 'pan-up'
        case 'pandown':
          return 'pan-down'
        case 'pan':
        case 'panhorizontal':
          return 'pan-horizontal'
        case 'panvertical':
          return 'pan-vertical'
        case 'alternate':
        case 'mixed':
          return 'alternate'
        case 'random':
          return 'random'
        default:
          return 'zoom-in'
      }
    }
    const motionMode = normalizeMotionMode(motionConfig.mode)
    const oppositeEffect = {
      'zoom-in': 'zoom-out',
      'zoom-out': 'zoom-in',
      'pan-left': 'pan-right',
      'pan-right': 'pan-left',
      'pan-up': 'pan-down',
      'pan-down': 'pan-up',
    }
    let bannerTimeoutId = null
    let motionCleanupTimeoutId = null
    let portalCleanupFrameId = null
    let progressAnimationFrameId = null
    let currentSlideIndex = initialSlideIndex
    let currentSlideDuration = interval
    let remainingSlideDuration = currentSlideDuration
    let slideDeadline = 0
    let rotationBag = []
    let portalStandardModeActive = false
    const activePauseReasons = new Set()

    const isPortalDemoSlide = slide =>
      slide?.dataset.portalDemoSlide === 'true'
    const hasPortalDemoSlide = slides.some(isPortalDemoSlide)
    const shouldDisablePortalStandardRotation = () =>
      portalStandardModeActive && hasPortalDemoSlide

    const getSlideDuration = slideIndex => {
      const slide = slides[slideIndex]
      const configuredHold = Number(slide?.dataset.bannerHoldMs)
      return Number.isFinite(configuredHold) && configuredHold > 0
        ? configuredHold
        : interval
    }

    const getSlideWeight = slideIndex => {
      const slide = slides[slideIndex]
      const configuredWeight = Number(slide?.dataset.bannerWeight)
      const normalizedWeight = Number.isFinite(configuredWeight)
        ? Math.round(configuredWeight)
        : 1
      return Math.min(6, Math.max(1, normalizedWeight))
    }

    const shuffleList = list => {
      const copy = [...list]
      for (let index = copy.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1))
        ;[copy[index], copy[swapIndex]] = [copy[swapIndex], copy[index]]
      }
      return copy
    }

    const getRotatableSlideIndices = () => {
      if (shouldDisablePortalStandardRotation()) return []

      return slides
        .map((_, index) => index)
        .filter(index => {
          const slide = slides[index]
          if (portalStandardModeActive && slide?.dataset.portalIntroSlide === 'true') {
            return false
          }

          if (portalStandardModeActive && isPortalDemoSlide(slide)) {
            return false
          }

          return !(preserveFirstSlide && index === 0)
        })
    }

    const rebuildRotationBag = () => {
      const weightedIndices = getRotatableSlideIndices().flatMap(index =>
        Array.from({ length: getSlideWeight(index) }, () => index),
      )
      rotationBag = shuffleList(weightedIndices)
    }

    const getNextSlideIndex = () => {
      const rotatableIndices = getRotatableSlideIndices()
      if (portalStandardModeActive) {
        if (rotatableIndices.length === 0) return currentSlideIndex
        const currentPosition = rotatableIndices.indexOf(currentSlideIndex)
        const nextPosition =
          currentPosition >= 0 ? (currentPosition + 1) % rotatableIndices.length : 0
        return rotatableIndices[nextPosition] ?? currentSlideIndex
      }

      if (rotationMode !== 'shuffle') {
        return (currentSlideIndex + 1) % slides.length
      }

      if (rotatableIndices.length === 0) {
        return preserveFirstSlide ? 0 : currentSlideIndex
      }

      if (rotationBag.length === 0) {
        rebuildRotationBag()
      }

      let bagIndex = rotationBag.findIndex(index => index !== currentSlideIndex)
      if (bagIndex === -1) {
        rebuildRotationBag()
        bagIndex = rotationBag.findIndex(index => index !== currentSlideIndex)
      }

      if (bagIndex === -1) {
        return rotatableIndices[0] ?? currentSlideIndex
      }

      const [nextIndex] = rotationBag.splice(bagIndex, 1)
      return typeof nextIndex === 'number' ? nextIndex : currentSlideIndex
    }

    const clearMotionClasses = mediaLayer => {
      mediaLayer.classList.remove(...motionClassNames)
    }

    const applyVideoPlaybackRate = videoElement => {
      if (!videoElement) return
      const configuredRate = Number(videoElement.dataset.playbackRate)
      videoElement.playbackRate =
        Number.isFinite(configuredRate) && configuredRate > 0 ? configuredRate : 1
    }

    const ensureSlideMediaLoaded = slideIndex => {
      const slide = slides[slideIndex]
      if (!slide) return

      slide.querySelectorAll('video[data-src]').forEach(videoElement => {
        const deferredSrc = videoElement.dataset.src
        if (!deferredSrc || videoElement.getAttribute('src')) return

        videoElement.src = deferredSrc
        videoElement.removeAttribute('data-src')
        if (videoElement.dataset.poster) {
          videoElement.poster = videoElement.dataset.poster
          videoElement.removeAttribute('data-poster')
        }
        applyVideoPlaybackRate(videoElement)
        videoElement.load()
      })

      slide.querySelectorAll('img[data-src]').forEach(imageElement => {
        const deferredSrc = imageElement.dataset.src
        if (!deferredSrc || imageElement.getAttribute('src') === deferredSrc) return

        imageElement.src = deferredSrc
        imageElement.removeAttribute('data-src')
      })
    }

    const syncSlidePlayback = activeIndex => {
      slides.forEach((slide, index) => {
        const videoElement = slide.querySelector('video')
        if (!videoElement) return
        applyVideoPlaybackRate(videoElement)

        if (index === activeIndex) {
          const playPromise = videoElement.play()
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(() => {})
          }
        } else {
          videoElement.pause()
        }
      })
    }

    const cleanupHiddenSlideMotion = () => {
      slides.forEach((slide, index) => {
        if (index === currentSlideIndex) return
        const mediaLayer = slide.querySelector('.banner-media-layer')
        if (mediaLayer) {
          clearMotionClasses(mediaLayer)
        }
      })
    }

    const resolveMotionEffect = slideIndex => {
      if (motionMode === 'alternate') {
        return motionEffects[slideIndex % motionEffects.length]
      }
      if (motionMode === 'random') {
        return motionEffects[Math.floor(Math.random() * motionEffects.length)]
      }
      if (motionMode === 'pan-horizontal') {
        return slideIndex % 2 === 0 ? 'pan-left' : 'pan-right'
      }
      if (motionMode === 'pan-vertical') {
        return slideIndex % 2 === 0 ? 'pan-up' : 'pan-down'
      }
      if (shouldAlternateDirection && oppositeEffect[motionMode]) {
        return slideIndex % 2 === 0 ? motionMode : oppositeEffect[motionMode]
      }
      return motionMode
    }

    const applyMotionToSlide = slideIndex => {
      if (!motionEnabled) return
      const slide = slides[slideIndex]
      if (!slide) return

      const mediaLayer = slide.querySelector('.banner-media-layer')
      if (!mediaLayer) return

      const mediaType = mediaLayer.dataset.bannerMediaType
      if (mediaType === 'unknown') return

      const effect = resolveMotionEffect(slideIndex)

      clearMotionClasses(mediaLayer)
      mediaLayer.style.setProperty('--banner-motion-duration', `${motionDuration}ms`)
      mediaLayer.style.setProperty('--banner-motion-easing', motionEasing)
      mediaLayer.style.setProperty('--banner-motion-scale', String(motionScale))
      mediaLayer.style.setProperty(
        '--banner-motion-pan-scale',
        String(motionPanScale),
      )
      mediaLayer.style.setProperty(
        '--banner-motion-pan-distance',
        `${motionPanDistance}%`,
      )

      void mediaLayer.offsetWidth
      mediaLayer.classList.add('banner-motion-active', `banner-motion-${effect}`)
    }

    const dispatchBannerState = () => {
      if (typeof window === 'undefined') return

      const totalDuration = Math.max(1, currentSlideDuration)
      const remainingDuration =
        activePauseReasons.size > 0
          ? remainingSlideDuration
          : Math.max(0, slideDeadline - performance.now())
      const progress = Math.min(
        1,
        Math.max(0, 1 - remainingDuration / totalDuration),
      )

      window.dispatchEvent(
        new CustomEvent(bannerStateEventName, {
          detail: {
            currentIndex: currentSlideIndex,
            slideCount: slides.length,
            isPaused: activePauseReasons.size > 0,
            progress,
            durationMs: totalDuration,
            remainingMs: remainingDuration,
          },
        }),
      )
    }

    const stopProgressLoop = () => {
      if (!progressAnimationFrameId) return
      cancelAnimationFrame(progressAnimationFrameId)
      progressAnimationFrameId = null
    }

    const startProgressLoop = () => {
      stopProgressLoop()

      const step = () => {
        dispatchBannerState()
        if (!bannerTimeoutId || activePauseReasons.size > 0) return
        progressAnimationFrameId = requestAnimationFrame(step)
      }

      step()
    }

    const clearScheduledAdvance = () => {
      if (!bannerTimeoutId) return
      clearTimeout(bannerTimeoutId)
      bannerTimeoutId = null
    }

    const showSlide = nextIndex => {
      if (!slides.length) return

      ensureSlideMediaLoaded(nextIndex)

      slides.forEach((slide, index) => {
        const isActive = index === nextIndex
        slide.style.opacity = isActive ? '1' : '0'
        slide.style.pointerEvents = isActive ? '' : 'none'
        slide.dataset.active = isActive ? 'true' : 'false'
      })

      applyMotionToSlide(nextIndex)
      syncSlidePlayback(nextIndex)
      currentSlideIndex = nextIndex
      currentSlideDuration = getSlideDuration(nextIndex)
      remainingSlideDuration = currentSlideDuration
      dispatchBannerState()

      if (motionCleanupTimeoutId) {
        clearTimeout(motionCleanupTimeoutId)
      }
      motionCleanupTimeoutId = setTimeout(() => {
        cleanupHiddenSlideMotion()
      }, Math.max(transitionDuration + 60, 120))
    }

    const queueNextSlide = delay => {
      clearScheduledAdvance()
      if (shouldDisablePortalStandardRotation()) {
        stopProgressLoop()
        dispatchBannerState()
        return
      }

      currentSlideDuration = Math.max(250, delay)
      remainingSlideDuration = currentSlideDuration
      slideDeadline = performance.now() + currentSlideDuration
      bannerTimeoutId = setTimeout(() => {
        const nextIndex = getNextSlideIndex()
        showSlide(nextIndex)
        queueNextSlide(getSlideDuration(nextIndex))
      }, currentSlideDuration)
      startProgressLoop()
    }

    const startBannerAnimation = () => {
      if (!slides.length || slides.length <= 1 || !animationConfig.enabled) return
      if (activePauseReasons.size > 0) return
      if (shouldDisablePortalStandardRotation()) return
      queueNextSlide(Math.max(250, remainingSlideDuration))
    }

    const pauseBanner = reason => {
      if (activePauseReasons.has(reason)) return

      if (activePauseReasons.size === 0 && bannerTimeoutId) {
        remainingSlideDuration = Math.max(0, slideDeadline - performance.now())
        clearScheduledAdvance()
        stopProgressLoop()
      }

      activePauseReasons.add(reason)
      dispatchBannerState()
    }

    const resumeBanner = reason => {
      if (!activePauseReasons.delete(reason)) return
      if (activePauseReasons.size > 0) {
        dispatchBannerState()
        return
      }

      startBannerAnimation()
      dispatchBannerState()
    }

    const stopBannerAnimation = () => {
      pauseBanner('script')
    }

    const goToSlide = nextIndex => {
      if (!slides.length) return
      const normalizedIndex = (nextIndex + slides.length) % slides.length
      showSlide(normalizedIndex)

      if (activePauseReasons.size === 0) {
        queueNextSlide(getSlideDuration(normalizedIndex))
      } else {
        stopProgressLoop()
        dispatchBannerState()
      }
    }

    const getPortalMediaElements = slide =>
      slide
        ? Array.from(
            slide.querySelectorAll(
              '.banner-media-layer > .banner-image, .banner-media-layer > .banner-video, .banner-media-layer > .banner-image-fallback',
            ),
          )
        : []

    const setPortalMediaTransform = (slide, transform) => {
      getPortalMediaElements(slide).forEach(mediaElement => {
        mediaElement.style.transform = transform
      })
    }

    const clearPortalMediaTransform = slide => {
      getPortalMediaElements(slide).forEach(mediaElement => {
        mediaElement.style.transform = ''
      })
    }

    const clampUnit = value => Math.min(1, Math.max(0, value))

    const clearPortalTransitionArtifacts = () => {
      const layer = standardBannerContainer?.querySelector('.banner-portal-glitch-layer')
      if (!layer) return

      layer.remove()
    }

    const getPortalCrossfadeProgress = progress => {
      const heldProgress = clampUnit((progress - 0.08) / 0.84)
      return heldProgress * heldProgress * (3 - 2 * heldProgress)
    }

    const clearPortalWipeClip = slide => {
      slide.style.clip = ''
      slide.style.clipPath = ''
    }

    const clearPortalWipe = () => {
      if (portalCleanupFrameId) {
        cancelAnimationFrame(portalCleanupFrameId)
        portalCleanupFrameId = null
      }
      standardBannerContainer?.classList.remove('banner-portal-wiping')
      standardBannerContainer?.classList.remove('banner-portal-demo-handoff')
      slides.forEach(slide => {
        slide.classList.remove(
          'banner-portal-wipe-incoming',
          'banner-portal-wipe-outgoing',
        )
        clearPortalWipeClip(slide)
        clearPortalMediaTransform(slide)
      })
      clearPortalTransitionArtifacts()
    }

    const finishPortalWipe = nextIndex => {
      if (!slides[nextIndex]) return

      if (portalCleanupFrameId) {
        cancelAnimationFrame(portalCleanupFrameId)
        portalCleanupFrameId = null
      }

      standardBannerContainer?.classList.add('banner-portal-wiping')
      slides.forEach(slide => {
        slide.classList.remove(
          'banner-portal-wipe-incoming',
          'banner-portal-wipe-outgoing',
        )
        clearPortalWipeClip(slide)
        clearPortalMediaTransform(slide)
      })
      clearPortalTransitionArtifacts()

      showSlide(nextIndex)
      portalCleanupFrameId = requestAnimationFrame(() => {
        portalCleanupFrameId = null
        standardBannerContainer?.classList.remove('banner-portal-wiping')
      })
    }

    const findSceneSlideIndex = sceneId =>
      slides.findIndex(slide => slide.dataset.sceneId === sceneId)

    const findFirstPortalStandardSlideIndex = () =>
      slides.findIndex(slide => slide.dataset.portalStandardSlide === 'true')

    const syncPortalStandardPhaseClass = detail => {
      const standardPhaseActive =
        detail?.phase === 'standard-banner' &&
        Math.min(1, Math.max(0, Number(detail?.progress) || 0)) > 0.18

      document.documentElement.classList.toggle(
        'megameal-home-standard-banner-phase',
        standardPhaseActive,
      )
    }

    const startPortalStandardBanner = startIndex => {
      if (!slides[startIndex]) return

      const isPortalDemoSlide = slides[startIndex]?.dataset.portalDemoSlide === 'true'

      portalStandardModeActive = true
      activePauseReasons.delete('portal-sync')
      clearScheduledAdvance()
      stopProgressLoop()
      clearPortalWipe()
      showSlide(startIndex)

      if (
        !isPortalDemoSlide &&
        slides.length > 1 &&
        animationConfig.enabled &&
        activePauseReasons.size === 0
      ) {
        queueNextSlide(getSlideDuration(startIndex))
      }
    }

    const syncPortalStandardBannerPhase = detail => {
      const toIndex = findFirstPortalStandardSlideIndex()
      if (toIndex < 0) return

      const sceneFromIndex = findSceneSlideIndex(detail?.fromSceneId)
      const fallbackFromIndex =
        sceneFromIndex >= 0 ? sceneFromIndex : 0
      const fromIndex =
        slides[currentSlideIndex]?.dataset.portalStandardSlide === 'true'
          ? currentSlideIndex
          : fallbackFromIndex
      const isDemoHandoff =
        slides[toIndex]?.dataset.portalDemoSlide === 'true'
      const progress = prefersReducedMotion
        ? 1
        : Math.min(1, Math.max(0, Number(detail?.progress) || 0))

      if (progress <= 0.001) {
        portalStandardModeActive = false
        clearPortalWipe()
        goToSceneSlide(detail?.fromSceneId)
        return
      }

      pauseBanner('portal-sync')
      clearScheduledAdvance()
      stopProgressLoop()

      if (progress >= 0.999) {
        startPortalStandardBanner(toIndex)
        return
      }

      const crossfadeProgress = getPortalCrossfadeProgress(progress)
      ensureSlideMediaLoaded(fromIndex)
      ensureSlideMediaLoaded(toIndex)

      if (portalCleanupFrameId) {
        cancelAnimationFrame(portalCleanupFrameId)
        portalCleanupFrameId = null
      }

      standardBannerContainer?.classList.add('banner-portal-wiping')
      standardBannerContainer?.classList.toggle(
        'banner-portal-demo-handoff',
        isDemoHandoff,
      )
      slides.forEach((slide, index) => {
        const isOutgoing = index === fromIndex
        const isIncoming = index === toIndex

        slide.classList.toggle('banner-portal-wipe-outgoing', isOutgoing)
        slide.classList.toggle('banner-portal-wipe-incoming', isIncoming)
        slide.style.opacity = isOutgoing
          ? String(1 - crossfadeProgress)
          : isIncoming
            ? String(crossfadeProgress)
            : '0'
        slide.style.pointerEvents = 'none'
        slide.dataset.active = 'false'
        clearPortalWipeClip(slide)
        clearPortalMediaTransform(slide)
      })

      currentSlideIndex = crossfadeProgress >= 0.5 ? toIndex : fromIndex
      currentSlideDuration = getSlideDuration(currentSlideIndex)
      remainingSlideDuration = currentSlideDuration
      syncSlidePlayback(currentSlideIndex)
      dispatchBannerState()
    }

    const syncPortalWipe = detail => {
      if (!slides.length || !detail) return
      portalStandardModeActive = false

      const fromIndex = findSceneSlideIndex(detail.fromSceneId)
      const toIndex = findSceneSlideIndex(detail.toSceneId)
      if (fromIndex < 0 || toIndex < 0) {
        goToSceneSlide(detail.sceneId)
        return
      }

      pauseBanner('portal-sync')
      clearScheduledAdvance()
      stopProgressLoop()

      const progress = prefersReducedMotion
        ? 1
        : Math.min(1, Math.max(0, Number(detail.progress) || 0))
      const crossfadeProgress = getPortalCrossfadeProgress(progress)

      ensureSlideMediaLoaded(fromIndex)
      ensureSlideMediaLoaded(toIndex)

      if (fromIndex === toIndex || progress <= 0.001) {
        finishPortalWipe(fromIndex)
        return
      }

      if (progress >= 0.999) {
        finishPortalWipe(toIndex)
        return
      }

      if (portalCleanupFrameId) {
        cancelAnimationFrame(portalCleanupFrameId)
        portalCleanupFrameId = null
      }

      standardBannerContainer?.classList.add('banner-portal-wiping')
      standardBannerContainer?.classList.remove('banner-portal-demo-handoff')
      slides.forEach((slide, index) => {
        const isOutgoing = index === fromIndex
        const isIncoming = index === toIndex

        slide.classList.toggle('banner-portal-wipe-outgoing', isOutgoing)
        slide.classList.toggle('banner-portal-wipe-incoming', isIncoming)
        slide.style.opacity = isOutgoing
          ? String(1 - crossfadeProgress)
          : isIncoming
            ? String(crossfadeProgress)
            : '0'
        slide.style.pointerEvents = 'none'
        slide.dataset.active = 'false'
        clearPortalWipeClip(slide)
        clearPortalMediaTransform(slide)
      })

      currentSlideIndex = crossfadeProgress >= 0.5 ? toIndex : fromIndex
      currentSlideDuration = getSlideDuration(currentSlideIndex)
      remainingSlideDuration = currentSlideDuration
      syncSlidePlayback(currentSlideIndex)
      dispatchBannerState()
    }

    const goToSceneSlide = sceneId => {
      if (!slides.length || typeof sceneId !== 'string' || sceneId.length === 0) {
        return
      }
      portalStandardModeActive = false

      const nextIndex = findSceneSlideIndex(sceneId)
      if (nextIndex < 0) return

      pauseBanner('portal-sync')
      clearScheduledAdvance()
      stopProgressLoop()

      if (nextIndex === currentSlideIndex) {
        dispatchBannerState()
        return
      }

      clearPortalWipe()
      finishPortalWipe(nextIndex)
    }

    if (standardBannerContainer && slides.length > 0) {
      showSlide(initialSlideIndex)
      if (
        !standardBannerIsPortalControlled &&
        slides.length > 1 &&
        animationConfig.enabled
      ) {
        queueNextSlide(getSlideDuration(initialSlideIndex))
      } else {
        dispatchBannerState()
      }

      if (animationConfig.pauseOnHover !== false) {
        standardBannerContainer.addEventListener('mouseenter', () => pauseBanner('hover'), {
          signal,
        })
        standardBannerContainer.addEventListener('mouseleave', () => resumeBanner('hover'), {
          signal,
        })
      }

      standardBannerContainer.querySelectorAll('.banner-link').forEach(linkElement => {
        const hasLink = linkElement.dataset.hasLink === 'true'
        const href = linkElement.dataset.href
        if (!hasLink || !href) return

        linkElement.addEventListener(
          'click',
          e => {
            if (e.target.closest('a[href]')) return
            window.location.href = href
          },
          { signal },
        )

        linkElement.addEventListener(
          'keydown',
          event => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault()
              window.location.href = href
            }
          },
          { signal },
        )
      })

      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) {
            pauseBanner('visibility')
          } else {
            resumeBanner('visibility')
          }
        },
        { signal },
      )

      window.addEventListener(
        bannerSceneSelectEventName,
        event => {
          const detail = event?.detail
          syncPortalStandardPhaseClass(detail)

          if (detail?.phase === 'standard-banner') {
            syncPortalStandardBannerPhase(detail)
            return
          }

          if (typeof detail?.progress === 'number') {
            syncPortalWipe(detail)
            return
          }

          goToSceneSlide(detail?.sceneId)
        },
        { signal },
      )

      window.addEventListener(
        bannerControlEventName,
        event => {
          const action = event?.detail?.action
          if (!action || !slides.length) return

          if (action === 'next') {
            goToSlide(currentSlideIndex + 1)
            return
          }

          if (action === 'previous') {
            goToSlide(currentSlideIndex - 1)
            return
          }

          if (action === 'toggle-pause') {
            if (activePauseReasons.has('manual')) {
              resumeBanner('manual')
            } else {
              pauseBanner('manual')
            }
          }
        },
        { signal },
      )
    }

    const timelineWrapper = document.getElementById('timeline-mobile-wrapper')
    if (timelineWrapper && window.innerWidth < 768) {
      let isTimelineActive = false

      timelineWrapper.addEventListener(
        'click',
        e => {
          if (!isTimelineActive) {
            e.preventDefault()
            e.stopPropagation()
            isTimelineActive = true
            timelineWrapper.classList.remove('timeline-mobile-inactive')
            timelineWrapper.classList.add('timeline-mobile-active')
          }
        },
        { signal },
      )

      document.addEventListener(
        'click',
        e => {
          if (isTimelineActive && !timelineWrapper.contains(e.target)) {
            isTimelineActive = false
            timelineWrapper.classList.remove('timeline-mobile-active')
            timelineWrapper.classList.add('timeline-mobile-inactive')
          }
        },
        { signal },
      )

      window.addEventListener(
        'beforeunload',
        () => {
          isTimelineActive = false
          timelineWrapper.classList.remove('timeline-mobile-active')
          timelineWrapper.classList.add('timeline-mobile-inactive')
        },
        { signal },
      )

      document.addEventListener(
        'astro:page-load',
        () => {
          isTimelineActive = false
          const wrapper = document.getElementById('timeline-mobile-wrapper')
          if (wrapper) {
            wrapper.classList.remove('timeline-mobile-active')
            wrapper.classList.add('timeline-mobile-inactive')
          }
        },
        { signal },
      )
    }

    window[bannerCleanupKey] = () => {
      clearScheduledAdvance()
      stopProgressLoop()
      if (motionCleanupTimeoutId) {
        clearTimeout(motionCleanupTimeoutId)
        motionCleanupTimeoutId = null
      }
      if (portalCleanupFrameId) {
        cancelAnimationFrame(portalCleanupFrameId)
        portalCleanupFrameId = null
      }
      standardBannerContainer?.classList.remove('banner-portal-wiping')
      slides.forEach(slide => {
        slide.classList.remove(
          'banner-portal-wipe-incoming',
          'banner-portal-wipe-outgoing',
        )
        clearPortalWipeClip(slide)
        clearPortalMediaTransform(slide)
      })
      clearPortalTransitionArtifacts()
      cleanupHiddenSlideMotion()
      abortController.abort()
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeBannerSystems, {
      once: true,
    })
  } else {
    initializeBannerSystems()
  }

  if (!window[bannerPageLoadBoundKey]) {
    document.addEventListener('astro:page-load', initializeBannerSystems)
    window[bannerPageLoadBoundKey] = true
  }
</script>
