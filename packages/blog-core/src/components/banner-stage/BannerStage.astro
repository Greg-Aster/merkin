---
import { Image } from "astro:assets";
import { siteConfig } from "@/config/config";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
import TimelineController from "../timeline/TimelineBanner.astro";
import { resolveLegacyBannerScene } from "./legacySceneRegistry";

type BannerMediaData = {
	imageUrl?: string;
	videoId?: string;
	category?: string;
	startYear?: number;
	endYear?: number;
	background?: string;
	backgroundVideo?: string;
	backgroundVideoPlaybackRate?: number;
	compact?: boolean;
};

type LegacyPost = {
	data?: {
		bannerType?: string;
		bannerData?: BannerMediaData;
		image?: string;
		title?: string;
	};
};

type StandardBannerItem = {
	type?: string;
	src?: string;
	alt?: string;
	fallbackImage?: import("astro").ImageMetadata | string;
	preload?: "none" | "metadata" | "auto";
	playbackRate?: number;
	holdMs?: number;
	sceneId?: string;
	weight?: number;
	showPreviewCard?: boolean;
};

type StandardBannerPreview = {
	hasValidLink: boolean;
	previewTitle: string;
	previewDescription: string;
	previewKicker?: string;
	previewStat?: string;
	previewCtaLabel?: string;
	previewIconSVG?: string;
};

type BannerStageConfig = {
	standardBannerConfig: {
		bannerList: StandardBannerItem[];
		getBannerLink: (index: number) => string | null;
		getBannerItemPreviewDetails: (
			index: number,
		) => StandardBannerPreview | null | undefined;
		isVideoBannerItem: (item: StandardBannerItem) => boolean;
		isImageBannerItem: (item: StandardBannerItem) => boolean;
		animation: {
			transitionDuration: number;
		};
		video: {
			autoplay: boolean;
			muted: boolean;
			loop: boolean;
			playsInLine: boolean;
			controls: boolean;
			preload: "none" | "metadata" | "auto";
		};
	};
	visual: {
		objectFit: string;
		objectPosition: string;
		borderRadius: string;
		applyGradientOverlay: boolean;
		gradientOverlay: string;
	};
	fallback: {
		enabled: boolean;
		value: string;
	};
	layout: {
		maxWidth: number;
	};
};

type TimelineEraDefinition = {
	backgroundVideo?: string;
	backgroundVideoPlaybackRate?: number;
};

interface Props {
	title?: string;
	post?: LegacyPost;
	currentBannerType?: string;
	bannerDataSources: {
		videoBannerData?: BannerMediaData;
		imageBannerData?: BannerMediaData;
		timelineBannerData?: BannerMediaData;
		assistantBannerData?: BannerMediaData;
	};
	hasPostBanner?: boolean;
	finalBannerLink?: string;
	bannerConfig: BannerStageConfig;
	bannerAnimationSettings: unknown;
	isBannerOnly?: boolean;
	isPortalBannerMode?: boolean;
	timelineEvents?: unknown[];
	timelineEraConfig?: Record<string, TimelineEraDefinition>;
	timelineConstellationConfig?: Record<string, unknown>;
	timelineConstellationPatterns?: Record<string, unknown>;
	timelineConnectionPatterns?: Record<string, unknown>;
	shouldShowMobilePortraitRightRailHero?: boolean;
	mobilePortraitRightRailHeroStyle?: string;
	currentPath: string;
	isHomePage: boolean;
	navbarSpacing: string;
	mobileNavbarSpacing: string;
	bannerHeight: string;
	bannerHeightMobile: string;
}

const {
	title,
	post,
	currentBannerType = "none",
	bannerDataSources,
	hasPostBanner = false,
	finalBannerLink = "",
	bannerConfig,
	bannerAnimationSettings,
	isBannerOnly = false,
	isPortalBannerMode = false,
	timelineEvents = [],
	timelineEraConfig,
	timelineConstellationConfig,
	timelineConstellationPatterns,
	timelineConnectionPatterns,
	shouldShowMobilePortraitRightRailHero = false,
	mobilePortraitRightRailHeroStyle = "default",
	currentPath,
	isHomePage,
	navbarSpacing,
	mobileNavbarSpacing,
	bannerHeight,
	bannerHeightMobile,
} = Astro.props;

const scene = resolveLegacyBannerScene(currentBannerType);

const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

function normalizeAssetUrl(assetPath?: string | null): string {
	if (!assetPath) return "";
	if (
		assetPath.startsWith("http://") ||
		assetPath.startsWith("https://") ||
		assetPath.startsWith("//") ||
		assetPath.startsWith("data:")
	) {
		return assetPath;
	}
	if (!assetPath.startsWith("/")) return assetPath;
	if (baseUrl && assetPath.startsWith(`${baseUrl}/`)) return assetPath;
	return url(assetPath, import.meta.env.BASE_URL);
}

function getAssetSrc(asset?: import("astro").ImageMetadata | string): string | undefined {
	if (!asset) return undefined;
	if (typeof asset === "string") return normalizeAssetUrl(asset);
	return asset.src;
}

const hasVideoBanner = scene?.id === "video";
const hasTimelineBanner = scene?.id === "timeline";
const hasImageBanner = scene?.id === "image";
const hasStandardBanner = scene?.id === "standard";
const hasAssistantBanner = scene?.id === "assistant";
---

<div
  id="banner-container"
  class={`z-10 w-full relative transition-all duration-500
    ${hasTimelineBanner ? 'has-timeline-banner' : ''}
    ${hasVideoBanner ? 'has-video-banner' : ''}
    ${hasImageBanner ? 'has-image-banner' : ''}
    ${hasAssistantBanner ? 'has-assistant-banner' : ''}
    ${hasStandardBanner ? 'has-standard-banner' : ''}
    ${isBannerOnly ? 'banner-only-mode' : ''}
    ${isPortalBannerMode ? 'portal-banner-mode' : ''}`}
  data-banner-scene={scene?.id ?? 'none'}
  data-mobile-right-rail-hero={shouldShowMobilePortraitRightRailHero
    ? mobilePortraitRightRailHeroStyle
    : 'default'}
>
  {hasVideoBanner && (
    <div class="banner-container-video">
      <div class="banner-aspect-container">
        <div class="banner-content-wrapper">
          <iframe
            src={`https://www.youtube.com/embed/${hasPostBanner && post?.data?.bannerType === 'video' ? post.data.bannerData.videoId : bannerDataSources.videoBannerData?.videoId}?autoplay=0&mute=0&controls=1&enablejsapi=1&playsinline=1`}
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
            allowfullscreen
            class="absolute top-0 left-0 w-full h-full"
          ></iframe>
        </div>
      </div>
    </div>
  )}

  {hasTimelineBanner && (
    <div
      class:list={[
        'banner-container-timeline',
        isBannerOnly ? 'banner-container-timeline--hero-only' : '',
      ]}
    >
      <div class="banner-aspect-container">
        <div
          class:list={[
            'banner-content-wrapper',
            isBannerOnly ? 'banner-content-wrapper--timeline-hero' : '',
          ]}
        >
          <div id="timeline-mobile-wrapper" class="timeline-mobile-inactive">
            <div class="timeline-mobile-indicator md:hidden">
              <div class="timeline-tap-hint">
                <Icon
                  name="fa6-solid:hand-pointer"
                  class="w-6 h-6 text-white/80"
                />
                <span class="text-white/80 text-sm font-medium"
                  >Tap to interact with timeline</span
                >
              </div>
            </div>

            <TimelineController
              category={hasPostBanner && post?.data?.bannerType === 'timeline'
                ? post.data.bannerData.category
                : bannerDataSources.timelineBannerData?.category || 'MEGA MEAL'}
              startYear={hasPostBanner && post?.data?.bannerType === 'timeline'
                ? post.data.bannerData.startYear
                : bannerDataSources.timelineBannerData?.startYear}
              endYear={hasPostBanner && post?.data?.bannerType === 'timeline'
                ? post.data.bannerData.endYear
                : bannerDataSources.timelineBannerData?.endYear}
              background={hasPostBanner && post?.data?.bannerType === 'timeline'
                ? post.data.bannerData.background
                : bannerDataSources.timelineBannerData?.background}
              backgroundVideo={hasPostBanner && post?.data?.bannerType === 'timeline'
                ? post.data.bannerData.backgroundVideo
                : bannerDataSources.timelineBannerData?.backgroundVideo ||
                    timelineEraConfig?.['all-eras']?.backgroundVideo ||
                    timelineEraConfig?.['all-time']?.backgroundVideo}
              backgroundVideoPlaybackRate={hasPostBanner &&
              post?.data?.bannerType === 'timeline'
                ? post.data.bannerData.backgroundVideoPlaybackRate
                : bannerDataSources.timelineBannerData
                    ?.backgroundVideoPlaybackRate ||
                  timelineEraConfig?.['all-eras']?.backgroundVideoPlaybackRate ||
                  timelineEraConfig?.['all-time']?.backgroundVideoPlaybackRate}
              compact={hasPostBanner && post?.data?.bannerType === 'timeline'
                ? post.data.bannerData.compact || false
                : bannerDataSources.timelineBannerData?.compact || false}
              events={timelineEvents}
              eraConfig={timelineEraConfig}
              constellationConfig={timelineConstellationConfig}
              constellationPatterns={timelineConstellationPatterns}
              connectionPatterns={timelineConnectionPatterns}
              class="w-full h-full"
              asBanner={true}
              bannerHeight="100%"
            />
          </div>
        </div>
      </div>
    </div>
  )}

  {hasImageBanner && (
    <div class="banner-container-image">
      <div class="banner-aspect-container">
        <div class="banner-content-wrapper">
          {finalBannerLink ? (
            <a
              href={finalBannerLink}
              aria-label="Banner Link"
              class="group block w-full h-full"
            >
              <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50 w-full h-full z-50 flex items-center justify-center">
                <Icon
                  name="fa6-solid:link"
                  class="text-white drop-shadow-lg"
                  style="font-size: clamp(2rem, 4vw, 4rem);"
                ></Icon>
              </div>
              <ImageWrapper
                src={hasPostBanner && post?.data?.bannerType === 'image'
                  ? normalizeAssetUrl(post.data.bannerData?.imageUrl || post.data.image)
                  : normalizeAssetUrl(
                      bannerDataSources.imageBannerData?.imageUrl ||
                        siteConfig.banner.src,
                    )}
                alt={hasPostBanner
                  ? post.data.title || 'Post banner image'
                  : title || 'Banner image'}
                class="w-full h-full object-cover"
                imgClass="object-cover"
                loading="eager"
              />
            </a>
          ) : (
            <ImageWrapper
              src={hasPostBanner && post?.data?.bannerType === 'image'
                ? normalizeAssetUrl(post.data.bannerData?.imageUrl || post.data.image)
                : normalizeAssetUrl(
                    bannerDataSources.imageBannerData?.imageUrl ||
                      siteConfig.banner.src,
                  )}
              alt={hasPostBanner
                ? post.data.title || 'Post banner image'
                : title || 'Banner image'}
              class="w-full h-full object-cover"
              imgClass="object-cover"
              loading="eager"
            />
          )}
        </div>
      </div>
    </div>
  )}

  {hasStandardBanner && (
    <div class="banner-container-standard">
      <div class="banner-aspect-container">
        <div class="banner-content-wrapper">
          <div id="standard-banner-container">
            {bannerConfig.standardBannerConfig.bannerList.length > 0
              ? bannerConfig.standardBannerConfig.bannerList.map((item, index) => {
                  const bannerLink = bannerConfig.standardBannerConfig.getBannerLink(
                    index,
                  )
                  const previewDetails =
                    bannerConfig.standardBannerConfig.getBannerItemPreviewDetails(
                      index,
                    )
                  const isClickable = bannerLink !== null
                  const isVideoItem =
                    bannerConfig.standardBannerConfig.isVideoBannerItem(item)
                  const isImageItem =
                    bannerConfig.standardBannerConfig.isImageBannerItem(item)
                  const isInitialSlide = index === 0

                  return (
                    <div
                      class="banner-slide absolute inset-0 w-full h-full transition-opacity"
                      style={`
                        transition-duration: ${bannerConfig.standardBannerConfig.animation.transitionDuration}ms;
                        opacity: ${index === 0 ? '1' : '0'};
                        pointer-events: ${index === 0 ? '' : 'none'};
                      `}
                      data-banner-index={index}
                      data-active={index === 0 ? 'true' : 'false'}
                      data-banner-hold-ms={typeof item.holdMs === 'number'
                        ? item.holdMs
                        : undefined}
                      data-scene-id={item.sceneId || undefined}
                      data-banner-weight={typeof item.weight === 'number'
                        ? item.weight
                        : undefined}
                    >
                      <div
                        class:list={[
                          'banner-link group w-full h-full relative',
                          isClickable ? 'cursor-pointer' : '',
                        ]}
                        data-has-link={isClickable}
                        data-href={bannerLink}
                        aria-label={`Banner ${index + 1}${isClickable ? ' - Click to visit link' : ' - Interactive slide'}`}
                        role={isClickable ? 'button' : undefined}
                        tabindex={isClickable ? '0' : undefined}
                      >
                        {isClickable && (
                          <div class="banner-hover-overlay absolute inset-0 w-full h-full transition-all duration-300 opacity-0 group-hover:opacity-30 bg-black pointer-events-none z-10"></div>
                        )}

                        <div
                          class="banner-media-layer w-full h-full overflow-hidden"
                          data-banner-media-type={isVideoItem
                            ? 'video'
                            : isImageItem
                              ? 'image'
                              : 'unknown'}
                        >
                          {isVideoItem ? (
                            <>
                              <video
                                src={isInitialSlide ? item.src : undefined}
                                data-src={isInitialSlide ? undefined : item.src}
                                data-playback-rate={typeof item.playbackRate ===
                                'number'
                                  ? item.playbackRate
                                  : undefined}
                                autoplay={bannerConfig.standardBannerConfig.video.autoplay}
                                muted={bannerConfig.standardBannerConfig.video.muted}
                                loop={bannerConfig.standardBannerConfig.video.loop}
                                playsinline={bannerConfig.standardBannerConfig.video
                                  .playsInLine}
                                controls={bannerConfig.standardBannerConfig.video
                                  .controls}
                                preload={isInitialSlide
                                  ? item.preload ||
                                    bannerConfig.standardBannerConfig.video.preload
                                  : 'none'}
                                poster={getAssetSrc(item.fallbackImage)}
                                class={`banner-video w-full h-full object-${bannerConfig.visual.objectFit} object-${bannerConfig.visual.objectPosition} transition-transform duration-300 group-hover:scale-105`}
                                style={`border-radius: ${bannerConfig.visual.borderRadius};`}
                                onerror="this.style.display='none'; var ne = this.nextElementSibling; if (ne) ne.style.display='block';"
                              >
                                Your browser does not support the video tag.
                              </video>
                              <Image
                                src={item.fallbackImage}
                                alt={item.alt}
                                width={bannerConfig.layout.maxWidth}
                                height={Math.round(
                                  bannerConfig.layout.maxWidth * 0.5625,
                                )}
                                class={`banner-image-fallback w-full h-full object-${bannerConfig.visual.objectFit} object-${bannerConfig.visual.objectPosition} transition-transform duration-300 group-hover:scale-105`}
                                style={`border-radius: ${bannerConfig.visual.borderRadius}; display: none;`}
                                loading={isInitialSlide ? 'eager' : 'lazy'}
                              />
                            </>
                          ) : isImageItem ? (
                            <Image
                              src={item.src}
                              alt={item.alt}
                              width={bannerConfig.layout.maxWidth}
                              height={Math.round(
                                bannerConfig.layout.maxWidth * 0.5625,
                              )}
                              class={`banner-image w-full h-full object-${bannerConfig.visual.objectFit} object-${bannerConfig.visual.objectPosition} transition-transform duration-300 group-hover:scale-105`}
                              style={`border-radius: ${bannerConfig.visual.borderRadius};`}
                              loading={isInitialSlide ? 'eager' : 'lazy'}
                            />
                          ) : (
                            <slot name="banner-slide-content" />
                          )}
                        </div>
                        {previewDetails && item.showPreviewCard !== false && (
                          item.sceneId === 'timeline-billboard' ? (
                            <div class="banner-billboard banner-billboard--timeline">
                              <div class="banner-billboard__timeline-panel">
                                <div class="banner-billboard__timeline-topline">
                                  {previewDetails.previewIconSVG && (
                                    <div class="banner-title-sigil" aria-hidden="true">
                                      <svg viewBox="0 0 24 24" fill="currentColor">
                                        <g set:html={previewDetails.previewIconSVG} />
                                      </svg>
                                    </div>
                                  )}
                                  <div class="banner-title-kicker">
                                    {previewDetails.previewKicker || 'Chronology Console'}
                                  </div>
                                  {previewDetails.previewStat && (
                                    <div class="banner-billboard__timeline-statline">
                                      {previewDetails.previewStat}
                                    </div>
                                  )}
                                </div>
                                <div class="banner-billboard__timeline-copy">
                                  <h3>{previewDetails.previewTitle}</h3>
                                  <p>{previewDetails.previewDescription}</p>
                                </div>
                                {previewDetails.previewCtaLabel && (
                                  <div class="banner-billboard__timeline-footer">
                                    <div class="banner-billboard__timeline-cta">
                                      {previewDetails.previewCtaLabel}
                                    </div>
                                  </div>
                                )}
                              </div>
                            </div>
                          ) : item.sceneId === 'archive-billboard' ? (
                            <div class="banner-billboard banner-billboard--archive">
                              <div class="banner-billboard__archive-card">
                                <div class="banner-billboard__archive-header">
                                  {previewDetails.previewIconSVG && (
                                    <div class="banner-title-sigil" aria-hidden="true">
                                      <svg viewBox="0 0 24 24" fill="currentColor">
                                        <g set:html={previewDetails.previewIconSVG} />
                                      </svg>
                                    </div>
                                  )}
                                  <div class="banner-title-kicker">
                                    {previewDetails.previewKicker || 'Story Archive'}
                                  </div>
                                  {previewDetails.previewStat && (
                                    <div class="banner-billboard__archive-stamp">
                                      {previewDetails.previewStat}
                                    </div>
                                  )}
                                </div>
                                <h3>{previewDetails.previewTitle}</h3>
                                <p>{previewDetails.previewDescription}</p>
                                {previewDetails.previewCtaLabel && (
                                  <div class="banner-billboard__archive-footer">
                                    {previewDetails.previewCtaLabel}
                                  </div>
                                )}
                              </div>
                            </div>
                          ) : item.sceneId === 'cookbook-billboard' ? (
                            <div class="banner-billboard banner-billboard--cookbook">
                              <div class="banner-billboard__cookbook-slab">
                                <div class="banner-billboard__cookbook-topline">
                                  {previewDetails.previewIconSVG && (
                                    <div class="banner-title-sigil" aria-hidden="true">
                                      <svg viewBox="0 0 24 24" fill="currentColor">
                                        <g set:html={previewDetails.previewIconSVG} />
                                      </svg>
                                    </div>
                                  )}
                                  <div class="banner-title-kicker">
                                    {previewDetails.previewKicker || 'Cookbook Project'}
                                  </div>
                                </div>
                                <div class="banner-billboard__cookbook-copy">
                                  <h3>{previewDetails.previewTitle}</h3>
                                  <p>{previewDetails.previewDescription}</p>
                                </div>
                                <div class="banner-billboard__cookbook-footer">
                                  {previewDetails.previewStat && (
                                    <span class="banner-title-stat">
                                      {previewDetails.previewStat}
                                    </span>
                                  )}
                                  {previewDetails.previewCtaLabel && (
                                    <span class="banner-title-cta">
                                      {previewDetails.previewCtaLabel}
                                    </span>
                                  )}
                                </div>
                              </div>
                            </div>
                          ) : item.sceneId === 'game-billboard' ? (
                            <div class="banner-billboard banner-billboard--game">
                              <div class="banner-billboard__game-surface">
                                <div class="banner-billboard__game-reticle" aria-hidden="true">
                                  <span></span>
                                  <span></span>
                                  <span></span>
                                  <span></span>
                                </div>
                                <div class="banner-billboard__game-copy">
                                  <div class="banner-billboard__game-topline">
                                    {previewDetails.previewIconSVG && (
                                      <div class="banner-title-sigil" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                          <g set:html={previewDetails.previewIconSVG} />
                                        </svg>
                                      </div>
                                    )}
                                    <div class="banner-title-kicker">
                                      {previewDetails.previewKicker || 'Star Observatory'}
                                    </div>
                                    {previewDetails.previewStat && (
                                      <div class="banner-billboard__game-statline">
                                        {previewDetails.previewStat}
                                      </div>
                                    )}
                                  </div>
                                  <div class="banner-billboard__game-hero">
                                    <div class="banner-billboard__game-watermark" aria-hidden="true">
                                      Observatory
                                    </div>
                                    <h3>{previewDetails.previewTitle}</h3>
                                  </div>
                                  <div class="banner-billboard__game-sidecar">
                                    <p>{previewDetails.previewDescription}</p>
                                    <div class="banner-title-meta">
                                      {previewDetails.previewCtaLabel && (
                                        <span class="banner-title-cta">
                                          {previewDetails.previewCtaLabel}
                                        </span>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          ) : item.sceneId === 'store-billboard' ? (
                            <div class="banner-billboard banner-billboard--store">
                              <div class="banner-billboard__store-headline">
                                <div class="banner-title-kicker">
                                  {previewDetails.previewKicker || 'Commercial Layer'}
                                </div>
                                <h3>{previewDetails.previewTitle}</h3>
                              </div>
                              <div class="banner-billboard__store-deck">
                                <p>{previewDetails.previewDescription}</p>
                                <div class="banner-billboard__store-offer">
                                  {previewDetails.previewStat && (
                                    <span class="banner-title-stat">
                                      {previewDetails.previewStat}
                                    </span>
                                  )}
                                  {previewDetails.previewCtaLabel && (
                                    <span class="banner-title-cta">
                                      {previewDetails.previewCtaLabel}
                                    </span>
                                  )}
                                </div>
                              </div>
                              {previewDetails.previewIconSVG && (
                                <div class="banner-title-sigil" aria-hidden="true">
                                  <svg viewBox="0 0 24 24" fill="currentColor">
                                    <g set:html={previewDetails.previewIconSVG} />
                                  </svg>
                                </div>
                              )}
                            </div>
                          ) : item.sceneId === 'story-mode-billboard' ? (
                            <div class="banner-billboard banner-billboard--story-mode">
                              <div class="banner-billboard__story-mode-panel">
                                <div class="banner-billboard__story-mode-header">
                                  {previewDetails.previewIconSVG && (
                                    <div class="banner-title-sigil" aria-hidden="true">
                                      <svg viewBox="0 0 24 24" fill="currentColor">
                                        <g set:html={previewDetails.previewIconSVG} />
                                      </svg>
                                    </div>
                                  )}
                                  <div class="banner-title-kicker">
                                    {previewDetails.previewKicker || 'Guided Entry'}
                                  </div>
                                </div>
                                <h3>{previewDetails.previewTitle}</h3>
                                <p>{previewDetails.previewDescription}</p>
                                <div class="banner-billboard__story-mode-footer">
                                  {previewDetails.previewStat && (
                                    <span class="banner-title-stat">
                                      {previewDetails.previewStat}
                                    </span>
                                  )}
                                  {previewDetails.previewCtaLabel && (
                                    <span class="banner-title-cta">
                                      {previewDetails.previewCtaLabel}
                                    </span>
                                  )}
                                </div>
                              </div>
                            </div>
                          ) : item.sceneId === 'community-billboard' ? (
                            <div class="banner-billboard banner-billboard--community">
                              <div class="banner-billboard__community-marquee">
                                <span>{previewDetails.previewKicker || 'Live Channels'}</span>
                                {previewDetails.previewStat && (
                                  <span>{previewDetails.previewStat}</span>
                                )}
                                {previewDetails.previewCtaLabel && (
                                  <span>{previewDetails.previewCtaLabel}</span>
                                )}
                              </div>
                              <div class="banner-billboard__community-window">
                                <div class="banner-billboard__community-topline">
                                  {previewDetails.previewIconSVG && (
                                    <div class="banner-title-sigil" aria-hidden="true">
                                      <svg viewBox="0 0 24 24" fill="currentColor">
                                        <g set:html={previewDetails.previewIconSVG} />
                                      </svg>
                                    </div>
                                  )}
                                  <div class="banner-title-kicker">
                                    {previewDetails.previewKicker || 'Live Channels'}
