---
import TimelineView from './TimelineViewModes/TimelineView.astro'
import {
  defaultTimelineViewConfig,
  type EraConfigMap,
  type TimelineConnectionPatternMap,
  type TimelineConstellationConfigMap,
  type TimelineConstellationPatternMap,
  type TimelineEvent,
} from '@/services/TimelineConfig'

export interface Props {
  id?: string
  class?: string
  category?: string
  startYear?: number
  endYear?: number
  background?: string
  compact?: boolean
  asBanner?: boolean
  bannerHeight?: string
  mobileHeight?: string
  initialViewMode?: 'timeline' | 'list' | 'tree' | 'map'
  initialScale?: number
  initialOffsetX?: number
  initialOffsetY?: number
  useEraColors?: boolean
  events?: TimelineEvent[]
  eraConfig?: EraConfigMap
  constellationConfig?: TimelineConstellationConfigMap
  constellationPatterns?: TimelineConstellationPatternMap
  connectionPatterns?: TimelineConnectionPatternMap
}

const {
  id = 'unified-timeline-area',
  class: classList = '',
  startYear: propStartYear,
  endYear: propEndYear,
  background = '/posts/timeline/universe.png',
  compact = false,
  asBanner = true,
  bannerHeight = '500px',
  mobileHeight = '400px',
  initialViewMode = 'timeline',
  useEraColors = false,
  initialScale = defaultTimelineViewConfig.defaultZoom,
  initialOffsetX = 0,
  initialOffsetY = 0,
  events = [],
  eraConfig = {},
  constellationConfig = {},
  constellationPatterns = {},
  connectionPatterns = {},
} = Astro.props

const years = events.map((event) => event.year)
const computedStartYear =
  propStartYear ??
  (years.length > 0 ? Math.min(...years) - Math.max(5, Math.ceil((Math.max(...years) - Math.min(...years)) * 0.1)) : 2000)
const computedEndYear =
  propEndYear ??
  (years.length > 0 ? Math.max(...years) + Math.max(5, Math.ceil((Math.max(...years) - Math.min(...years)) * 0.1)) : 2100)

const eraEntries = Object.entries(eraConfig).filter(
  ([eraKey]) => eraKey !== 'all-time' && eraKey !== 'all-eras',
)
const initialEra =
  eraConfig['all-eras'] ? 'all-eras' : eraEntries[0]?.[0] ?? ''
const menuEntries = [
  ...(eraConfig['all-eras']
    ? [{ key: 'all-eras', label: 'All Eras' }]
    : []),
  ...eraEntries.map(([eraKey, config]) => ({
    key: eraKey,
    label: config.displayName || eraKey,
  })),
]
---

<section
  id={`${id}-wrapper`}
  class:list={['timeline-wrapper relative w-full overflow-hidden', asBanner ? 'timeline-banner-mode' : '', classList]}
  style={`height: ${bannerHeight}; --timeline-mobile-height: ${mobileHeight};`}
>
  <div class="timeline-map-controls">
    <div class="timeline-zoom-controls">
      <button type="button" class="timeline-control-button" data-action="zoom-out" aria-label="Zoom out">-</button>
      <button type="button" class="timeline-control-button" data-action="reset-view">Reset</button>
      <button type="button" class="timeline-control-button" data-action="zoom-in" aria-label="Zoom in">+</button>
    </div>
    <div class="timeline-era-filter" role="group" aria-label="Select era">
      {menuEntries.map((entry) => (
        <button
          type="button"
          class:list={['timeline-era-option', entry.key === initialEra ? 'is-active' : '']}
          data-era-option={entry.key}
        >
          {entry.label}
        </button>
      ))}
    </div>
  </div>

  <TimelineView
    id={`${id}-timeline`}
    events={events}
    background={background}
    compact={compact}
    initialScale={initialScale}
    initialOffsetX={initialOffsetX}
    initialOffsetY={initialOffsetY}
    useEraColors={useEraColors}
    startYear={computedStartYear}
    endYear={computedEndYear}
    eraConfig={eraConfig}
    constellationConfig={constellationConfig}
    constellationPatterns={constellationPatterns}
    connectionPatterns={connectionPatterns}
    selectedEventSlug={null}
  />
</section>

<script
  define:vars={{
    wrapperId: `${id}-wrapper`,
    timelineId: `${id}-timeline`,
    initialEra,
    eraConfig,
  }}
>
  (() => {
    const wrapper = document.getElementById(wrapperId)
    if (!wrapper) return

    const zoomButtons = wrapper.querySelectorAll('[data-action]')
    const eraOptions = wrapper.querySelectorAll('[data-era-option]')
    let syncRetryCount = 0

    const setActiveEra = (eraKey) => {
      eraOptions.forEach((opt) => {
        opt.classList.toggle('is-active', opt.getAttribute('data-era-option') === eraKey)
      })
    }

    const syncTimelineCore = () => {
      const timelineCore = window[`timelineCore_${timelineId}`]
      if (!timelineCore) {
        if (syncRetryCount < 12) {
          syncRetryCount += 1
          window.setTimeout(syncTimelineCore, 50)
        }
        return
      }

      syncRetryCount = 0
      if (initialEra && typeof timelineCore.selectEra === 'function') {
        timelineCore.selectEra(initialEra)
        setActiveEra(initialEra)
      }

      zoomButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.getAttribute('data-action')
          if (action === 'zoom-in' && typeof timelineCore.zoomIn === 'function') timelineCore.zoomIn()
          if (action === 'zoom-out' && typeof timelineCore.zoomOut === 'function') timelineCore.zoomOut()
          if (action === 'reset-view' && typeof timelineCore.resetView === 'function') timelineCore.resetView()
        })
      })

      eraOptions.forEach((option) => {
        option.addEventListener('click', () => {
          const nextEra = option.getAttribute('data-era-option')
          if (!nextEra || typeof timelineCore.selectEra !== 'function') return
          timelineCore.selectEra(nextEra)
          setActiveEra(nextEra)
        })
      })

      wrapper.addEventListener('timeline:eraChange', (event) => {
        const nextEra = event.detail?.era
        if (nextEra) setActiveEra(nextEra)
      })
    }

    syncTimelineCore()
  })()
</script>

<style>
  .timeline-wrapper {
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at top, rgb(18 31 58 / 0.88), rgb(3 7 18 / 0.98)),
      rgb(2 6 23);
  }

  .timeline-wrapper.timeline-banner-mode {
    border-radius: inherit;
    background:
      radial-gradient(circle at 50% 16%, rgb(59 130 246 / 0.1), transparent 40%),
      linear-gradient(180deg, rgb(2 6 23 / 0.3), rgb(2 6 23 / 0.12));
  }

  .timeline-map-controls {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    pointer-events: none;
  }

  .timeline-zoom-controls,
  .timeline-era-filter {
    display: flex;
    align-items: center;
    pointer-events: auto;
  }

  .timeline-zoom-controls {
    display: flex;
    align-items: center;
    gap: 0;
    pointer-events: auto;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgb(186 230 253 / 0.28);
    border-radius: 0.9rem;
    background: rgb(2 6 23 / 0.74);
    backdrop-filter: blur(14px);
    box-shadow:
      0 18px 60px rgb(2 6 23 / 0.42),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  .timeline-control-button {
    border: 1px solid rgb(186 230 253 / 0.2);
    border-radius: 0.65rem;
    background: rgb(15 23 42 / 0.86);
    color: rgb(241 245 249);
    font: inherit;
    min-width: 2.35rem;
    padding: 0.55rem 0.8rem;
    transition:
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .timeline-control-button:hover,
  .timeline-control-button:focus-visible {
    background: rgb(14 165 233 / 0.38);
    box-shadow:
      0 0 0 1px rgb(125 211 252 / 0.42),
      0 0 24px rgb(56 189 248 / 0.14);
    outline: none;
    transform: translateY(-1px);
  }

  .timeline-era-filter {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0.3rem;
    border: 1px solid rgb(186 230 253 / 0.28);
    border-radius: 0.9rem;
    background: rgb(2 6 23 / 0.74);
    backdrop-filter: blur(14px);
    box-shadow:
      0 18px 60px rgb(2 6 23 / 0.42),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
    pointer-events: auto;
  }

  .timeline-era-option {
    padding: 0.38rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    background: transparent;
    color: rgb(186 218 248);
    font: inherit;
    font-size: 0.84rem;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 140ms ease,
      color 140ms ease,
      border-color 140ms ease;
  }

  .timeline-era-option:hover,
  .timeline-era-option:focus-visible {
    background: rgb(14 165 233 / 0.18);
    color: rgb(224 242 254);
    outline: none;
  }

  .timeline-era-option.is-active {
    border-color: rgb(125 211 252 / 0.26);
    background: rgb(14 165 233 / 0.22);
    color: rgb(224 242 254);
    font-weight: 500;
  }

  @media (max-width: 767px) {
    .timeline-wrapper {
      height: var(--timeline-mobile-height) !important;
      border-radius: 1rem;
    }

    .timeline-wrapper.timeline-banner-mode {
      border-radius: inherit;
    }

    .timeline-map-controls {
      bottom: 0.8rem;
      left: 0.8rem;
      right: 0.8rem;
      flex-direction: column;
      align-items: stretch;
    }

    .timeline-zoom-controls,
    .timeline-era-filter {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>
