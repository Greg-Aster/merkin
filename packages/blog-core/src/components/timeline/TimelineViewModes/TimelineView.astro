---
import ImageWrapper from '../../misc/ImageWrapper.astro'
import StarNode from '../StarNode.astro'
import { hashCode } from '@merkin/blog-core/utils/starUtils'
import {
  defaultTimelineViewConfig,
  type EraConfigMap,
  type TimelineConnectionPatternMap,
  type TimelineConstellationConfigMap,
  type TimelineConstellationPatternMap,
  type TimelineEvent,
} from '../../../services/TimelineConfig'

export interface Props {
  id?: string
  events: TimelineEvent[]
  background: string
  backgroundVideo?: string
  backgroundVideoPlaybackRate?: number
  compact?: boolean
  initialScale?: number
  initialOffsetX?: number
  initialOffsetY?: number
  useEraColors?: boolean
  startYear: number
  endYear: number
  eraConfig: EraConfigMap
  constellationConfig?: TimelineConstellationConfigMap
  constellationPatterns?: TimelineConstellationPatternMap
  connectionPatterns?: TimelineConnectionPatternMap
  selectedEventSlug?: string | null
}

const {
  id = 'timeline-view',
  events,
  background,
  backgroundVideo,
  backgroundVideoPlaybackRate = 1,
  compact = false,
  initialScale = defaultTimelineViewConfig.defaultZoom,
  initialOffsetX = 0,
  initialOffsetY = 0,
  useEraColors = false,
  startYear,
  endYear,
  eraConfig,
  constellationConfig = {},
  constellationPatterns = {},
  connectionPatterns = {},
  selectedEventSlug = null,
} = Astro.props

const clamp = (value: number, min: number, max: number) =>
  Math.max(min, Math.min(max, value))

const timespan = Math.max(1, endYear - startYear)
const padding = defaultTimelineViewConfig.padding
const defaultPattern = constellationPatterns.scattered ?? [{ azOffset: 0, elOffset: 0 }]
const positionedPerEra = new Map<string, number>()
const sortedEvents = [...events].sort(
  (a, b) => a.year - b.year || a.slug.localeCompare(b.slug),
)

function getPositionPercentage(year: number, customPadding?: number): number {
  const paddingToUse = customPadding !== undefined ? customPadding : padding
  const clampedYear = Math.max(startYear, Math.min(endYear, year))
  const basePercentage = ((clampedYear - startYear) / timespan) * 100
  return paddingToUse + (basePercentage * (100 - 2 * paddingToUse)) / 100
}

const eventPositions = sortedEvents.map((event) => {
  const eraKey = event.era || 'unknown'
  const eventEraConfig = event.era && eraConfig[event.era] ? eraConfig[event.era] : null
  const eraVisual = constellationConfig[eraKey] ?? constellationConfig.unknown ?? {
    centerAzimuth: 180,
    centerElevation: 45,
    spread: 24,
    pattern: 'scattered',
  }
  const pattern =
    constellationPatterns[eraVisual.pattern] ??
    constellationPatterns[eraKey] ??
    defaultPattern
  const eraIndex = positionedPerEra.get(eraKey) ?? 0
  positionedPerEra.set(eraKey, eraIndex + 1)

  const point = pattern[eraIndex % pattern.length] ?? { azOffset: 0, elOffset: 0 }
  const loop = Math.floor(eraIndex / pattern.length)
  const spreadScale = Math.max(0.78, Math.min(1.16, eraVisual.spread / 38))
  const eraOffsetX = (eraVisual.centerAzimuth - 180) / 26
  const eraOffsetY = (eraVisual.centerElevation - 45) / 3.6
  const timelineX = getPositionPercentage(event.year, eventEraConfig?.customPadding)
  const orbitAngle = (loop % 6) * (Math.PI / 3)
  const orbitRing = Math.floor(loop / 6) + (loop > 0 ? 1 : 0)
  const overflowX = orbitRing > 0 ? Math.cos(orbitAngle) * orbitRing * 1.9 : 0
  const overflowY = orbitRing > 0 ? Math.sin(orbitAngle) * orbitRing * 2.1 : 0
  const yearBias =
    eventEraConfig && Number.isFinite(eventEraConfig.startYear) && Number.isFinite(eventEraConfig.endYear)
      ? (((event.year - eventEraConfig.startYear) / Math.max(1, eventEraConfig.endYear - eventEraConfig.startYear)) - 0.5) * 2.2
      : 0
  const fineSeed = hashCode(event.slug) % 3
  const fineShift = fineSeed === 0 ? -0.18 : fineSeed === 1 ? 0 : 0.18

  return {
    event,
    x: clamp(
      timelineX + point.azOffset * 0.24 * spreadScale + eraOffsetX * 0.04 + yearBias + overflowX + fineShift,
      9,
      91,
    ),
    y: clamp(
      50 - point.elOffset * 1.02 * spreadScale - eraOffsetY * 0.82 + overflowY,
      16,
      84,
    ),
  }
})

const positionedBySlug = Object.fromEntries(
  eventPositions.map((entry) => [entry.event.slug, entry]),
)

const groupedByEra = eventPositions.reduce<Record<string, typeof eventPositions>>(
  (groups, entry) => {
    const eraKey = entry.event.era || 'unknown'
    groups[eraKey] ??= []
    groups[eraKey].push(entry)
    return groups
  },
  {},
)

const connectionLines = Object.entries(groupedByEra).flatMap(([eraKey, entries]) => {
  if (entries.length < 2) return []
  const patternName =
    constellationConfig[eraKey]?.pattern ?? constellationConfig.unknown?.pattern ?? 'scattered'
  const patternConnections = connectionPatterns[patternName]
  const fallbackConnections = entries.slice(0, -1).map((_, index) => [index, index + 1] as [number, number])
  const activeConnections =
    patternConnections?.filter(([from, to]) => entries[from] && entries[to]) ?? fallbackConnections

  return activeConnections.map(([fromIndex, toIndex], index) => ({
    id: `${eraKey}-${fromIndex}-${toIndex}-${index}`,
    era: eraKey,
    x1: entries[fromIndex].x,
    y1: entries[fromIndex].y,
    x2: entries[toIndex].x,
    y2: entries[toIndex].y,
  }))
})

const initialBackground =
  eraConfig['all-eras']?.backgroundImage ||
  Object.values(eraConfig).find((entry) => entry.backgroundImage)?.backgroundImage ||
  background
const initialBackgroundVideo =
  eraConfig['all-eras']?.backgroundVideo ||
  Object.values(eraConfig).find((entry) => entry.backgroundVideo)?.backgroundVideo ||
  backgroundVideo ||
  ''
const initialBackgroundVideoPlaybackRate =
  eraConfig['all-eras']?.backgroundVideoPlaybackRate ||
  Object.values(eraConfig).find((entry) => typeof entry.backgroundVideoPlaybackRate === 'number')?.backgroundVideoPlaybackRate ||
  backgroundVideoPlaybackRate ||
  1
---

<div
  id={`${id}-container`}
  class="timeline-map-shell relative h-full overflow-hidden"
  data-background={initialBackground}
  data-timeline-shell="true"
  data-events-id={`${id}-events-data`}
  data-era-config-id={`${id}-era-config-data`}
  data-initial-background={initialBackground}
  data-initial-background-video={initialBackgroundVideo}
  data-initial-background-video-playback-rate={String(initialBackgroundVideoPlaybackRate)}
  data-min-zoom={String(defaultTimelineViewConfig.minZoom)}
  data-max-zoom={String(defaultTimelineViewConfig.maxZoom)}
  data-zoom-step={String(defaultTimelineViewConfig.zoomStep)}
>
  <div class="timeline-background-layer absolute inset-0 z-0 overflow-hidden">
    <ImageWrapper
      src={initialBackground}
      alt="Timeline background"
      class:list={[
        'timeline-background-image-wrapper h-full w-full',
        initialBackgroundVideo ? 'is-background-hidden' : '',
      ]}
      imgClass="timeline-background-media timeline-background-image object-cover"
      loading="eager"
    />
    <video
      class:list={[
        'timeline-background-media',
        'timeline-background-video',
        'object-cover',
        !initialBackgroundVideo ? 'is-background-hidden' : '',
      ]}
      src={initialBackgroundVideo || undefined}
      poster={initialBackgroundVideo ? undefined : initialBackground}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      data-playback-rate={initialBackgroundVideoPlaybackRate}
      aria-hidden="true"
    ></video>
    <div class="timeline-depth-layer timeline-depth-layer--nebula"></div>
    <div class="timeline-depth-layer timeline-depth-layer--dust"></div>
    <div class="timeline-depth-layer timeline-depth-layer--foreground"></div>
  </div>

  <div class="timeline-stage" data-initial-scale={initialScale} data-initial-offset-x={initialOffsetX} data-initial-offset-y={initialOffsetY}>
    <div class="timeline-flow-axis" aria-hidden="true">
      <div class="timeline-flow-axis__line"></div>
      <div class="timeline-flow-axis__marker timeline-flow-axis__marker--start"></div>
      <div class="timeline-flow-axis__marker timeline-flow-axis__marker--end"></div>
    </div>

    <svg class="timeline-constellation-lines absolute inset-0 z-10 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {connectionLines.map((line) => (
        <line
          class="timeline-constellation-line"
          data-era={line.era}
          x1={line.x1}
          y1={line.y1}
          x2={line.x2}
          y2={line.y2}
        />
      ))}
    </svg>

    <div class="timeline-events-layer absolute inset-0 z-20">
      {eventPositions.map(({ event, x, y }) => (
        <div
          class:list={[
            'timeline-event',
            selectedEventSlug === event.slug ? 'has-active-card is-selected-event' : '',
          ]}
          data-event-slug={event.slug}
          data-era={event.era || 'unknown'}
          data-year={event.year}
          style={`left:${x}%; top:${y}%;`}
        >
          <button
            type="button"
            class="timeline-event-button"
            data-slug={event.slug}
            aria-label={`Open ${event.title}`}
          >
            <StarNode
              era={event.era}
              isKeyEvent={event.isKeyEvent}
              isSelected={selectedEventSlug === event.slug}
              isHovered={false}
              identifier={event.slug}
              useEraColors={useEraColors}
              size={event.isKeyEvent ? 6 : 4.8}
            />
          </button>
        </div>
      ))}
    </div>
  </div>

  <div class="timeline-active-card" aria-live="polite"></div>

  {events.length === 0 && (
    <div class="timeline-empty-state">
      <div class="timeline-empty-title">No timeline events found</div>
      <div class="timeline-empty-copy">
        Add timeline metadata to your content to populate the chronology map.
      </div>
    </div>
  )}
</div>

<script
  type="application/json"
  id={`${id}-events-data`}
  is:inline
  set:html={JSON.stringify(eventPositions)}
></script>
<script
  type="application/json"
  id={`${id}-era-config-data`}
  is:inline
  set:html={JSON.stringify(eraConfig)}
></script>
<script
  type="application/json"
  id={`${id}-connection-lines-data`}
  is:inline
  set:html={JSON.stringify(connectionLines)}
></script>

<script>
  import { initTimelineViews } from './timelineViewClient.js'

  initTimelineViews()
</script>

<style>
  .timeline-map-shell {
    border-radius: inherit;
    min-height: 100%;
    background: rgb(2 6 23 / 0.72);
  }

  :global(.timeline-banner-mode) .timeline-map-shell {
    background: transparent;
    border: 0;
    box-shadow: none;
    border-radius: inherit;
  }

  :global(.timeline-banner-mode) .timeline-background-layer::after {
    background:
      linear-gradient(180deg, rgb(2 6 23 / 0.02), rgb(2 6 23 / 0.18)),
      radial-gradient(circle at 20% 20%, rgb(125 211 252 / 0.16), transparent 38%),
      radial-gradient(circle at 80% 30%, rgb(196 181 253 / 0.2), transparent 32%);
  }

  .timeline-background-layer::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(2 6 23 / 0.18), rgb(2 6 23 / 0.6)),
      radial-gradient(circle at 20% 20%, rgb(125 211 252 / 0.12), transparent 35%),
      radial-gradient(circle at 80% 30%, rgb(196 181 253 / 0.14), transparent 28%);
  }

  .timeline-background-media,
  .timeline-background-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transform: scale(1.05);
    filter: saturate(1.04) brightness(0.96);
  }

  :global(.timeline-banner-mode) .timeline-background-media,
  :global(.timeline-banner-mode) .timeline-background-image-wrapper :global(img) {
    opacity: 1;
    filter: saturate(1.06) brightness(1);
  }

  .timeline-background-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .timeline-background-image-wrapper {
    position: relative;
    z-index: 0;
  }

  .is-background-hidden {
    display: none;
  }

  .timeline-depth-layer {
    position: absolute;
    inset: -10%;
    pointer-events: none;
  }

  .timeline-depth-layer--nebula {
    background:
      radial-gradient(circle at 18% 26%, rgb(125 211 252 / 0.18), transparent 24%),
      radial-gradient(circle at 72% 18%, rgb(96 165 250 / 0.16), transparent 21%),
      radial-gradient(circle at 52% 72%, rgb(244 114 182 / 0.14), transparent 26%);
    filter: blur(22px);
  }

  .timeline-depth-layer--dust {
    opacity: 0.55;
    background-image:
      radial-gradient(circle, rgb(255 255 255 / 0.9) 0.8px, transparent 1.2px),
      radial-gradient(circle, rgb(186 230 253 / 0.55) 0.7px, transparent 1px);
    background-size: 180px 180px, 130px 130px;
    background-position: 0 0, 45px 60px;
    animation: timelineDustDrift 28s linear infinite;
  }

  .timeline-depth-layer--foreground {
    background:
      radial-gradient(circle at 50% 105%, rgb(15 23 42 / 0.88), transparent 48%),
      linear-gradient(180deg, transparent, rgb(2 6 23 / 0.28));
  }

  .timeline-stage {
    position: absolute;
    inset: 0;
    z-index: 10;
    transform-origin: top left;
    will-change: transform;
  }

  .timeline-stage.is-dragging {
    cursor: grabbing;
  }

  .timeline-flow-axis {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
  }

  .timeline-flow-axis__line {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 50%;
    height: 2px;
    border-radius: 999px;
    background:
      linear-gradient(
        90deg,
        transparent 0%,
        rgb(125 211 252 / 0.18) 10%,
        rgb(186 230 253 / 0.52) 50%,
        rgb(125 211 252 / 0.18) 90%,
        transparent 100%
      );
    box-shadow:
      0 0 12px rgb(125 211 252 / 0.18),
      0 0 28px rgb(59 130 246 / 0.12);
    transform: translateY(-50%);
  }

  .timeline-flow-axis__marker {
    position: absolute;
    top: calc(50% - 12px);
    width: 4px;
    height: 24px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgb(186 230 253 / 0.4), rgb(125 211 252 / 0.88), rgb(186 230 253 / 0.4));
    box-shadow:
      0 0 12px rgb(125 211 252 / 0.24),
      0 0 24px rgb(56 189 248 / 0.18);
  }

  .timeline-flow-axis__marker--start {
    left: calc(9% - 1px);
  }

  .timeline-flow-axis__marker--end {
    right: calc(9% - 1px);
  }

  .timeline-constellation-line {
    stroke: rgb(186 230 253 / 0.24);
    stroke-width: 0.08;
    stroke-linecap: round;
    stroke-dasharray: 0.45 1.35;
    filter: drop-shadow(0 0 3px rgb(125 211 252 / 0.12));
    transition:
      opacity 220ms ease,
      stroke 220ms ease;
  }

  .timeline-event {
    position: absolute;
    transform: translate(-50%, -50%);
    transition:
      opacity 240ms ease,
      filter 240ms ease,
      transform 240ms ease;
  }

  .timeline-event-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }

  .timeline-event.is-hidden-event,
  .timeline-constellation-line.is-hidden-line {
    opacity: 0.09;
    pointer-events: none;
  }

  .timeline-event.is-hovered-event,
  .timeline-event.is-selected-event {
    z-index: 25;
    filter: drop-shadow(0 0 20px rgb(125 211 252 / 0.32));
  }

  .timeline-active-card {
    position: absolute;
    z-index: 50;
    width: min(19rem, calc(100% - 2rem));
    pointer-events: none;
    transform: translate(-50%, -100%);
    opacity: 0;
    transition:
      opacity 220ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .timeline-active-card.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, calc(-100% - 0.2rem));
  }

  :global(.timeline-event-card) {
    padding: 1rem 1.05rem;
    border: 1px solid rgb(148 163 184 / 0.18);
    border-radius: 1.05rem;
    background: linear-gradient(180deg, rgb(2 6 23 / 0.9), rgb(15 23 42 / 0.82));
    backdrop-filter: blur(18px);
    box-shadow: 0 24px 60px rgb(2 6 23 / 0.45);
  }

  :global(.timeline-event-card.is-persistent-card) {
    border-color: rgb(125 211 252 / 0.34);
    box-shadow:
      0 24px 60px rgb(2 6 23 / 0.45),
      0 0 30px rgb(56 189 248 / 0.14);
  }

  :global(.timeline-event-card h3) {
    margin: 0;
    color: rgb(248 250 252);
    font-size: 1rem;
    line-height: 1.25;
  }

  :global(.timeline-event-card p) {
    margin: 0.55rem 0 0;
    color: rgb(203 213 225 / 0.9);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  :global(.timeline-card-kicker) {
    margin-bottom: 0.35rem;
    color: rgb(125 211 252);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  :global(.timeline-card-meta) {
    margin-top: 0.45rem;
    color: rgb(148 163 184);
    font-size: 0.78rem;
  }

  :global(.timeline-event-card a) {
    display: inline-flex;
    align-items: center;
    margin-top: 0.8rem;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    background: rgb(14 165 233 / 0.16);
    color: rgb(224 242 254);
    text-decoration: none;
  }

  .timeline-empty-state {
    position: absolute;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    color: rgb(226 232 240);
  }

  .timeline-empty-title {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .timeline-empty-copy {
    max-width: 28rem;
    color: rgb(148 163 184);
  }

  @keyframes timelineDustDrift {
    from { transform: translate3d(0, 0, 0) scale(1.02); }
    to { transform: translate3d(-20px, 12px, 0) scale(1.08); }
  }

  @media (max-width: 767px) {
    .timeline-active-card {
      width: min(17rem, calc(100% - 1rem));
    }

    .timeline-active-card.is-visible {
      transform: translate(-50%, calc(-100% - 0.35rem));
    }
  }
</style>
