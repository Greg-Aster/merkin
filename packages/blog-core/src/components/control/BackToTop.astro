---
import { Icon } from 'astro-icon/components'
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper">
    <button id="back-to-top-btn" aria-label="Back to Top" class="back-to-top-btn hide btn-card flex h-11 w-11 lg:h-[3.5rem] lg:w-[3.5rem] items-center justify-center rounded-2xl overflow-hidden transition shadow-lg" onclick="backToTop()">
        <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
    </button>
</div>

<style>
.back-to-top-wrapper {
    width: 3.5rem;
    height: 3.5rem;
    position: absolute;
    right: 0;
    top: 0;
    pointer-events: none;
    z-index: 45;
}

.back-to-top-btn {
    color: var(--primary);
    font-size: 1.85rem;
    font-weight: bold;
    border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
    position: fixed;
    right: max(0.85rem, calc((100vw - var(--page-width, 78rem)) / 2 - 4.5rem));
    bottom: 1.25rem;
    opacity: 1;
    cursor: pointer;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    z-index: 45;
}

@media (min-width: 1024px) {
    .back-to-top-btn {
        font-size: 2.15rem;
        bottom: 4rem;
    }
}

.back-to-top-btn.hide {
    transform: translateY(0.5rem) scale(0.9);
    opacity: 0;
    pointer-events: none;
}

.back-to-top-btn:active {
    transform: scale(0.92);
}
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
