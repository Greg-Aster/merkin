---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import GalleryImage from '../components/GalleryImage.astro'
import ShareBar from '../components/ShareBar.astro'
import gallery from '../data/gallery.json'
import { url } from '../utils/url-utils'

const galleryTitle = 'Ainekio Robot Gallery — Photos, Videos, Wiring Diagrams & Simulation'
const galleryDescription = 'Explore Ainekio in photos, videos, and diagrams: the 12-servo V2 prototype, onboard carpet trial footage, MuJoCo/MJX simulation, 58 LCD expressions, and ESP32-P4 wiring diagrams.'
const galleryJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: galleryTitle,
  description: galleryDescription,
  url: Astro.url.href,
  hasPart: gallery.filter(item => item.src).map(item => ({
    '@type': 'VideoObject',
    name: item.title,
    description: item.caption,
    contentUrl: new URL(url(item.src!), Astro.site).href,
    thumbnailUrl: new URL(url(item.poster!), Astro.site).href,
    uploadDate: `${item.date || '2026-11-06'}T00:00:00Z`,
    duration: `PT${Math.max(1, Math.round(item.duration || 1))}S`,
  })),
}
const groups = [
  { id: 'photos', title: 'From the workbench', intro: 'Photographs of the physical build: the 12-servo V2 feedback rebuild, single-leg linkage prototypes, and the earlier 8-servo V1 robot.', kinds: ['photo'] },
  { id: 'videos', title: 'The physical robot on video', intro: 'Onboard OV5647 camera footage from November carpet walking trials, plus floor and bench tests.', kinds: ['physical-video'] },
  { id: 'animation', title: 'Simulation, neural gait & motion studies', intro: 'MuJoCo quadruped RL baselines (stock Pupper V3), C-gait imitation policy comparisons, and Blender motion studies.', kinds: ['animation'] },
  { id: 'diagrams', title: 'V2 hardware, wiring & LCD expressions', intro: 'Pinouts, PCA9685 PWM and CD74HC4067 4th-wire feedback wiring diagrams, and the 58-expression ST7789 LCD contact sheet.', kinds: ['diagram'] },
  { id: 'design', title: 'CAD & MuJoCo MJCF models', intro: 'The November 5 full-CAD MuJoCo MJCF model (0.650 kg, four-bar equality constraints) and earlier Blender assembly studies.', kinds: ['design'] },
]
const date = (value: string) => new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
const labelForKind = (kind: string) =>
  kind === 'photo'
    ? 'Photograph'
    : kind === 'physical-video'
      ? 'Physical footage'
      : kind === 'animation'
        ? 'Simulation & motion'
        : kind === 'diagram'
          ? 'Hardware reference'
          : 'CAD model'
---
<MainGridLayout oneColumn={true} title={galleryTitle} description={galleryDescription}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(galleryJsonLd)}></script>
  <article class="robot-gallery" data-pagefind-body>
    <header>
      <p class="eyebrow">Visual reference & media library</p>
      <h1>Meet the robot</h1>
      <p>Workbench photos, onboard camera footage from physical carpet trials, DAgger-distilled on-chip ESP32-P4 neural gait rollouts, 59 LCD facial expressions, and complete V2 wiring diagrams.</p>
      <p>Latest milestone: <a href={url('/posts/2026-11-11-on-chip-neural-gait-and-ainekio-os/')}>November 11 on-chip ESP32-P4 L2-cached MicroDuck neural gait, Cockpit HUD, and Ainekio OS</a>.</p>
      <ShareBar title={galleryTitle} description={galleryDescription} url={Astro.url.href} />
      <nav aria-label="Gallery sections">{groups.map(group => <a href={`#${group.id}`}>{group.title} ↓</a>)}</nav>
    </header>
    {groups.map(group => <section id={group.id} aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`}>{group.title}</h2><p class="section-intro">{group.intro}</p>
      <div class:list={['gallery-grid', { 'video-grid': group.kinds.some(k => ['physical-video', 'animation'].includes(k)) }]}>
        {gallery.filter(item => group.kinds.includes(item.kind)).map(item => <figure id={item.id}>
          {item.variants ? <a class="image-link" href={url(item.variants.at(-1)!.src)} aria-label={`Open larger image: ${item.title}`}><GalleryImage item={item} /></a> :
            <video controls playsinline preload="none" width={item.width} height={item.height} poster={url(item.poster!)} aria-describedby={`${item.id}-caption`}>
              <source src={url(item.src!)} type="video/mp4" />
              <a href={url(item.src!)}>Download {item.title}</a>
            </video>}
          <figcaption id={`${item.id}-caption`}>
            <p class="media-label">{labelForKind(item.kind)} · {item.date ? <time datetime={item.date}>{date(item.date)}</time> : 'Undated'}</p>
            <h3>{item.title}</h3><p>{item.caption}</p>
            {item.src && <a class="download" href={url(item.src)} download>Download MP4 · {Math.floor(item.duration! / 60)}:{String(Math.round(item.duration! % 60)).padStart(2, '0')} · {(item.bytes! / 1024 / 1024).toFixed(1)} MB</a>}
          </figcaption>
        </figure>)}
      </div>
    </section>)}
    <footer><a href={url('/updates/')}>Read the build journal →</a><a href={url('/posts/project-overview/')}>System overview & status →</a></footer>
  </article>
</MainGridLayout>
<style>
  .robot-gallery { max-width: 80rem; margin: 0 auto 2rem; color: var(--text-color); }
  header { padding: clamp(1.25rem,4vw,3rem); border-radius: var(--radius-large); background: var(--card-bg); }
  h1 { font-size: clamp(2.2rem,5vw,3.8rem); line-height: 1.1; font-weight: 750; margin: .6rem 0 1rem; }
  h2 { font-size: clamp(1.5rem,3vw,2rem); font-weight: 700; }
  h3 { font-size: 1.1rem; font-weight: 700; margin: .4rem 0; }
  p { line-height: 1.65; }
  header > p { max-width: 65ch; margin-bottom: .8rem; }
  .eyebrow, .media-label { color: var(--primary); font-size: .75rem; letter-spacing: .03em; }
  .eyebrow { text-transform: uppercase; font-weight: 700; }
  a { color: var(--primary); text-underline-offset: .2em; }
  a:hover { text-decoration: underline; }
  nav, footer { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1.5rem; }
  nav a, footer a { padding-block: .6rem; }
  section { margin-top: 2.5rem; scroll-margin-top: 6rem; }
  .section-intro { margin: .5rem 0 1.25rem; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.2rem; }
  .video-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  figure { background: var(--card-bg); border-radius: .8rem; overflow: hidden; }
  .image-link { display: block; background: #161c22; }
  .image-link :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4/3; object-fit: contain; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16/9; background: #111; }
  figcaption { padding: 1.1rem; }
  figcaption > p:not(.media-label) { font-size: .9rem; }
  .download { display: inline-block; margin-top: .75rem; font-size: .85rem; }
  @media (max-width: 1000px) { .gallery-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 640px) { .gallery-grid { grid-template-columns: 1fr; } }
</style>
