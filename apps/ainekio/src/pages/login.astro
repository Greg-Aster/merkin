---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { url } from '../utils/url-utils'
---

<MainGridLayout title="Admin Login" description="Admin login entry point">
  <meta http-equiv="refresh" content={`0;url=${url('/configs/')}`} slot="head" />
  <div class="card-base w-full rounded-[var(--radius-large)] p-6">
    <h1 class="text-xl font-bold mb-2">Admin Login</h1>
    <p class="text-black/70 dark:text-white/70 mb-4">
      Redirecting to the admin login page.
    </p>
    <a href={url('/configs/')} class="btn-plain inline-flex rounded-lg px-4 py-2 font-bold">
      Continue to Login
    </a>
  </div>
</MainGridLayout>
