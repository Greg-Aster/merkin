---
import AinekioHome from '../components/AinekioHome.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'

const description =
  'Follow the development of Ainekio, a twelve-servo quadruped robot companion combining closed-loop ESP32-P4 hardware with MetaHuman OS for conversation, memory, perception, autonomy, and learned locomotion.'
---

<MainGridLayout description={description} homeLayout="portal" oneColumn={true}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Ainekio',
      url: Astro.site,
      description,
      inLanguage: 'en',
    })}
  />
  <AinekioHome />
</MainGridLayout>
