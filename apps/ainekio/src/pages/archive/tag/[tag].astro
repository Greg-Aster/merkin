---
import ArchivePanel from '@components/ArchivePanel.astro'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { getSortedArchivePosts } from '@utils/content-utils'

export async function getStaticPaths() {
  const posts = await getSortedArchivePosts()

  const allTags = posts.reduce<Map<string, string>>((acc, post) => {
    post.data.tags.forEach(tag => acc.set(tag.toLowerCase(), tag))
    return acc
  }, new Map())

  return Array.from(allTags).map(([tag, label]) => ({
    props: { label },
    params: {
      tag,
    },
  }))
}

const tag = decodeURIComponent(Astro.params.tag as string).toLowerCase()
const { label } = Astro.props
---

<MainGridLayout title={`${label} — tag archive`} description={`Explore Ainekio articles in the ${label} tag archive, with robot build notes, reference guides, and development updates.`}>
    <ArchivePanel tags={[tag]}></ArchivePanel>
</MainGridLayout>
