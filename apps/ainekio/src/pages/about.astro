---
import { getEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Markdown from '../components/misc/Markdown.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'

const about = await getEntry('spec', 'about')
if (!about) throw new Error("About content not found in 'spec/about'")

const { Content, headings } = await about.render()
---

<MainGridLayout title="About Ainekio" description={about.data.description} headings={headings}>
  <article class="card-base overflow-hidden rounded-[var(--radius-large)] border border-black/5 dark:border-white/10">
    <img
      src="/assets/ainekio/hero.webp"
      alt="The red-and-black open-frame Ainekio prototype overlooking a ruined science-fiction city"
      class="aspect-[16/7] w-full object-cover object-center"
    />
    <div class="p-6 sm:p-9">
      <Markdown class="prose max-w-none dark:prose-invert">
        <Content />
      </Markdown>
    </div>
  </article>

  <section class="mt-4 grid gap-4 sm:grid-cols-2">
    <a href="https://github.com/Greg-Aster/Ainekio-bot" target="_blank" rel="noreferrer" class="card-base group flex items-center gap-4 rounded-[var(--radius-large)] border border-black/5 p-5 transition hover:border-cyan-400/50 dark:border-white/10">
      <span class="rounded-xl bg-cyan-500/10 p-3 text-cyan-700 dark:text-cyan-300"><Icon name="fa6-brands:github" class="text-2xl" /></span>
      <span class="min-w-0">
        <span class="block text-xs font-bold uppercase tracking-[0.16em] text-50">Robot source</span>
        <span class="mt-1 block font-black text-90 group-hover:text-cyan-700 dark:group-hover:text-cyan-300">Greg-Aster/Ainekio-bot</span>
      </span>
      <Icon name="material-symbols:open-in-new-rounded" class="ml-auto text-xl text-slate-400 dark:text-slate-500" />
    </a>
    <a href="https://github.com/Greg-Aster/metahuman-os" target="_blank" rel="noreferrer" class="card-base group flex items-center gap-4 rounded-[var(--radius-large)] border border-black/5 p-5 transition hover:border-amber-400/50 dark:border-white/10">
      <span class="rounded-xl bg-amber-500/10 p-3 text-amber-700 dark:text-amber-300"><Icon name="fa6-brands:github" class="text-2xl" /></span>
      <span class="min-w-0">
        <span class="block text-xs font-bold uppercase tracking-[0.16em] text-50">Reasoning system</span>
        <span class="mt-1 block font-black text-90 group-hover:text-amber-700 dark:group-hover:text-amber-300">Greg-Aster/metahuman-os</span>
      </span>
      <Icon name="material-symbols:open-in-new-rounded" class="ml-auto text-xl text-slate-400 dark:text-slate-500" />
    </a>
  </section>
</MainGridLayout>
