---
import fs from 'node:fs'
import path from 'node:path'
import { getCollection } from 'astro:content'
import License from '@components/misc/License.astro'
import Markdown from '@components/misc/Markdown.astro'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { url, getDir, getPostUrlBySlug } from '@utils/url-utils'
import ImageWrapper from '../../components/misc/ImageWrapper.astro'
import { licenseConfig, profileConfig, siteConfig } from '../../config/config'
import { formatDateToYYYYMMDD } from '../../utils/date-utils'
import { getReading, validateReadingPaths, topics, generations, kinds } from '../../lib/reading'
import { getPageSocialImage } from '../../lib/social-images'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  validateReadingPaths(posts)
  return posts.map(post => {
    const reading = getReading(post)
    const nextPost = posts.find(item => item.slug === reading.next)
    const previousPosts = posts.filter(item => getReading(item).next === post.slug)
    const relatedSlugs = new Set([topics[reading.topic].reference, ...reading.related])
    relatedSlugs.delete(post.slug)
    if (reading.next) relatedSlugs.delete(reading.next)
    return {
      params: { slug: post.slug },
      props: { post, nextPost, previousPosts, relatedPosts: [...relatedSlugs].map(slug => posts.find(item => item.slug === slug)!) },
    }
  })
}

const { post, nextPost, previousPosts, relatedPosts } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await post.render()
const reading = getReading(post)
const topic = topics[reading.topic]
const topicUrl = `/archive/?topic=${reading.topic}`
const socialImage = await getPageSocialImage({ post })
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.data.title, description: post.data.description,
  keywords: post.data.tags,
  image: new URL(socialImage.src, Astro.site).href,
  mainEntityOfPage: Astro.url.href,
  datePublished: formatDateToYYYYMMDD(post.data.published),
  ...(post.data.updated ? { dateModified: formatDateToYYYYMMDD(post.data.updated) } : {}),
  author: { '@type': 'Person', name: profileConfig.name, url: Astro.site },
  inLanguage: (post.data.lang || siteConfig.lang).replace('_', '-'),
}
const isDownloadable = post.data.downloadable === true
const isDev = import.meta.env.DEV
const hasDevPdfFile = fs.existsSync(path.join(process.cwd(), 'public', 'downloads', 'posts', `${post.slug}.pdf`))
const useDownloadFile = !isDev || hasDevPdfFile
const pdfDownloadUrl = useDownloadFile ? url(`/downloads/posts/${post.slug}.pdf`) : url(`/pdf/posts/${post.slug}/`)
const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
const contents = headings.filter(heading => heading.depth <= 2)
---
<MainGridLayout title={post.data.title} description={post.data.description} lang={post.data.lang} setOGTypeArticle={true} headings={headings} post={post}>
  <meta name="publish-date" content={formatDateToYYYYMMDD(post.data.published)} slot="head" />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <article id="post-container" class="card-base article-page"
    data-post-date={formatDateToYYYYMMDD(post.data.published)} data-post-timestamp={post.data.published.getTime()}
    data-post-slug={post.slug} data-post-title={post.data.title} data-post-category={post.data.category}
    data-post-tags={post.data.tags.join(',')} data-post-image={post.data.image} data-post-description={post.data.description}>
    <nav class="article-breadcrumb" aria-label="Breadcrumb">
      <a href={url('/')}>Ainekio</a><span aria-hidden="true">/</span>
      <a href={url(topicUrl)}>{topic.title}</a><span aria-hidden="true">/</span><span aria-current="page">{kinds[reading.kind]}</span>
    </nav>
    <header>
      <div class="article-context"><span>{generations[reading.generation]}</span><span>{kinds[reading.kind]}</span></div>
      <h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <p class="article-dates">
        <span>Published <time datetime={post.data.published.toISOString()}>{dateFormat.format(post.data.published)}</time></span>
        {post.data.updated && post.data.updated > post.data.published && <span>Updated <time datetime={post.data.updated.toISOString()}>{dateFormat.format(post.data.updated)}</time></span>}
        <span data-post-minutes={remarkPluginFrontmatter.minutes}>{remarkPluginFrontmatter.minutes} min read</span>
      </p>
      {reading.kind !== 'reference' && <p class="article-period"><a href={url('/posts/current-status/')}>Current status →</a></p>}
    </header>

    {contents.length >= 3 && <details class="article-contents"><summary>On this page</summary><ol>{contents.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
    {post.data.image && post.data.showImageOnPost !== false && <ImageWrapper id="post-cover" src={post.data.image} basePath={path.join('content/posts/', getDir(post.id))} class="mb-8 rounded-xl" />}

    <Markdown class="mb-6 markdown-content"><Content /></Markdown>

    <nav class="article-reading" aria-label="Article reading path" data-reading-path>
      {nextPost && <div class="article-next"><p class="reading-label">{reading.kind === 'reference' ? 'Next reference' : reading.kind === 'original' ? 'Next entry' : 'Next entry'}</p><a data-reading-next href={getPostUrlBySlug(nextPost.slug)}>{nextPost.data.title} →</a><p>{nextPost.data.description}</p></div>}
      {previousPosts.length > 0 && <div><p class="reading-label">Previous entries</p><ul>{previousPosts.map(previous => <li><a href={getPostUrlBySlug(previous.slug)}>← {previous.data.title}</a></li>)}</ul></div>}
      {relatedPosts.length > 0 && <div><h2>Related notes</h2><ul>{relatedPosts.map(related => <li><a href={getPostUrlBySlug(related.slug)}>{related.data.title}</a><span class="related-kind">{generations[getReading(related).generation]} · {kinds[getReading(related).kind]}</span></li>)}</ul></div>}
      <a class="article-back" href={url(topicUrl)}>All {topic.title.toLowerCase()} articles →</a>
    </nav>

    {isDownloadable && <p class="article-download"><a href={pdfDownloadUrl} download={useDownloadFile ? `${post.slug}.pdf` : undefined}>{useDownloadFile ? 'Download article (PDF)' : 'Open printable view'}</a></p>}
    {licenseConfig.enable && <License title={post.data.title} slug={post.slug} pubDate={post.data.published} class="mb-6 rounded-xl license-container" />}
  </article>
</MainGridLayout>

<style>
  .article-page { padding: clamp(1.2rem, 3vw, 2.25rem); color: var(--text-color); min-width: 0; }
  .article-breadcrumb, .article-context, .article-dates { display: flex; flex-wrap: wrap; gap: .5rem 1rem; font-size: .8rem; color: var(--text-color-muted); }
  .article-breadcrumb { margin-bottom: 1.5rem; align-items: center; }
  .article-breadcrumb a { padding-block: .5rem; }
  .article-context span { border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent); padding: .25rem .6rem; border-radius: .3rem; color: var(--primary); }
  h1 { font-size: clamp(1.65rem, 3.4vw, 2.4rem); font-weight: 750; line-height: 1.2; margin: .8rem 0; }
  .article-description { font-size: 1.05rem; line-height: 1.65; max-width: 75ch; }
  .article-dates { margin: .85rem 0 1.25rem; }
  .article-period { padding: .75rem 1rem; border-left: 2px solid var(--primary); font-size: .85rem; line-height: 1.6; margin-bottom: 1.25rem; }
  a { color: var(--primary); text-underline-offset: .2em; }
  a:hover { text-decoration: underline; }
  .article-contents { margin-bottom: 1.5rem; border-block: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); padding: .75rem 0; }
  summary { cursor: pointer; font-weight: 650; padding: .5rem 0; }
  .article-contents ol { padding-left: 1.2rem; max-height: 50vh; overflow-y: auto; }
  .article-contents a { display: inline-block; padding: .4rem 0; }
  .article-reading { border-top: 1px solid color-mix(in srgb, var(--primary) 30%, transparent); padding-top: 1.5rem; margin: 2rem 0; display: grid; gap: 1.5rem; }
  .article-next { padding: 1.25rem; background: color-mix(in srgb, var(--primary) 7%, transparent); border-radius: .6rem; }
  .reading-label { text-transform: uppercase; letter-spacing: .05em; font-size: .75rem; color: var(--text-color-muted); margin-bottom: .5rem; }
  .article-next > a { display: block; font-size: 1.2rem; font-weight: 700; line-height: 1.4; }
  .article-next > p:last-child { margin-top: .6rem; line-height: 1.6; font-size: .9rem; }
  .article-reading h2 { font-size: 1.1rem; font-weight: 700; }
  .article-reading li { margin-top: .6rem; line-height: 1.5; }
  .article-reading li a { display: inline-block; padding-block: .25rem; }
  .related-kind { display: block; font-size: .75rem; color: var(--text-color-muted); }
  .article-back, .article-download a { display: inline-block; padding-block: .75rem; font-weight: 650; }
  :global(.article-page [id]) { scroll-margin-top: 6rem; }
  @media (min-width: 1280px) { .article-contents { display: none; } }
  @media print { .article-reading, .article-download, .article-contents { display: none; } }
</style>
