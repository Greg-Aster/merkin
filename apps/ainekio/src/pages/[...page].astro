---
import type { GetStaticPaths } from 'astro'
import AinekioHome from '../components/AinekioHome.astro'
import PostPage from '../components/PostPage.astro'
import Pagination from '../components/control/Pagination.astro'
import { PAGE_SIZE } from '../constants/constants'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { getSortedPosts } from '../utils/content-utils'

export const getStaticPaths = (async ({ paginate }) => {
  const allBlogPosts = await getSortedPosts()
  return paginate(allBlogPosts, { pageSize: PAGE_SIZE })
}) satisfies GetStaticPaths
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props

const len = page.data.length
const isFirstPage = page.currentPage === 1
const description = isFirstPage
  ? 'Follow the development of Ainekio, a robot companion combining a 3D-printed body with MetaHuman OS for conversation, memory, vision, personality, and movement.'
  : `Browse page ${page.currentPage} of the Ainekio build journal: robot hardware, firmware, motion, and MetaHuman OS development.`
---

<MainGridLayout title={isFirstPage ? undefined : `Build journal — page ${page.currentPage}`} description={description} homeLayout={isFirstPage ? 'portal' : 'default'} oneColumn={isFirstPage}>
    {isFirstPage && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'WebSite', name: 'Ainekio',
      url: Astro.site, description, inLanguage: 'en',
    })} />}
    {isFirstPage ? <AinekioHome /> : (
      <>
        <header class="card-base p-6 mb-4"><h1 class="text-2xl font-bold">Build journal — page {page.currentPage}</h1></header>
        <PostPage page={page}></PostPage>
        <Pagination class="mx-auto onload-animation" page={page} style=`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`></Pagination>
      </>
    )}
</MainGridLayout>
