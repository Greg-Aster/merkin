---
import SharedNavbar from '@merkin/blog-core/components/Navbar.astro'
---

<SharedNavbar {...Astro.props} />

<style>
  /* Compact link padding so all 6 desktop navigation items fit cleanly from 900px upward without wasted gaps */
  :global(#navbar .admin-navbar-component a) {
    padding-inline: 0.85rem;
  }

  :global(#standard-nav) {
    gap: 0.15rem;
  }

  :global(#standard-nav > a),
  :global(#standard-nav > .group > a) {
    padding-inline: 0.72rem !important;
    font-size: 0.92rem;
    white-space: nowrap;
  }

  @media (min-width: 1120px) {
    :global(#standard-nav > a),
    :global(#standard-nav > .group > a) {
      padding-inline: 0.95rem !important;
      font-size: 0.95rem;
    }
  }

  /* Switch cleanly to the compact dropdown menu below 900px before links crowd the search trigger */
  @media (min-width: 768px) and (max-width: 899px) {
    :global(#standard-nav) {
      display: none !important;
    }

    :global(#nav-menu-switch) {
      display: inline-flex !important;
    }
  }

  /* Tighten floating menus (#nav-menu-panel and #display-setting) so there is zero float gap or dead space */
  :global(#nav-menu-panel),
  :global(#display-setting) {
    top: calc(var(--navbar-height, 4.5rem) + 0.4rem) !important;
    right: 0.5rem !important;
    border: 1px solid color-mix(in srgb, var(--primary) 26%, transparent);
    background: color-mix(in srgb, var(--card-surface-bg, var(--card-bg)) 96%, #050b0e) !important;
    box-shadow: 0 18px 38px -16px rgb(0 0 0 / 0.72) !important;
  }

  :global(#nav-menu-panel) {
    min-width: 14rem;
    padding: 0.4rem !important;
  }

  :global(#nav-menu-panel #default-links > a) {
    gap: 1.25rem !important;
    padding: 0.5rem 0.65rem 0.5rem 0.8rem !important;
    font-size: 0.92rem;
  }
</style>
