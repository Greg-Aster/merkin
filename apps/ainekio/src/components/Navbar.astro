---
import SharedNavbar from '@merkin/blog-core/components/Navbar.astro'
---

<SharedNavbar {...Astro.props} />

<style>
  /* Keep the six-link navigation usable on tablets without changing other sites. */
  @media (min-width: 768px) and (max-width: 1023px) {
    :global(#standard-nav) {
      display: none;
    }

    :global(#nav-menu-switch) {
      display: flex !important;
    }
  }
</style>
