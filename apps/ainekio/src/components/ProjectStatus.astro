---
import { getEntry } from 'astro:content'
import { url } from '../utils/url-utils'

interface Props { compact?: boolean }
const { compact = false } = Astro.props

const updates = await getEntry('updates', 'site-updates')
if (!updates) throw new Error('Project status requires updates/site-updates')
const current = updates.data.current
const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
})
---

<section id="project-status" class:list={['project-status', { 'is-compact': compact }]} aria-labelledby="project-status-title" data-status-updated={current.updated.toISOString()}>
  <header class="status-header">
    <div class="status-badge-row">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="status-label">Workbench status</span>
      <span class="status-sep" aria-hidden="true">·</span>
      <time datetime={current.updated.toISOString()}>Updated {dateFormat.format(current.updated)}</time>
    </div>
    <h2 id="project-status-title">{current.status}</h2>
  </header>

  <p class="status-summary">{current.note}</p>

  {!compact && <dl class="status-areas">
    {current.areas.map(area => (
      <div class="status-area-card">
        <dt>{area.label}</dt>
        <dd>
          <strong>{area.status}</strong>
          <span>{area.detail}</span>
        </dd>
      </div>
    ))}
  </dl>}

  {!compact && <div class="status-next">
    <span class="status-label">Next on the bench</span>
    <p>{current.nextStop}</p>
  </div>}

  {compact && <div class="status-compact-footer">
    <span class="status-focus"><strong>Next on the bench:</strong> {current.nextStop}</span>
    <a class="status-detail" href={url('/posts/project-overview/#project-status')}>Full status &amp; overview →</a>
  </div>}
</section>

<style>
  .project-status {
    padding: clamp(1.1rem, 2.2vw, 1.45rem) clamp(1.15rem, 2.5vw, 1.65rem);
    border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    border-left: 4px solid var(--primary);
    border-radius: 0.5rem var(--radius-large) var(--radius-large) 0.5rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 7%, var(--card-bg)), color-mix(in srgb, var(--card-bg) 94%, black));
    color: var(--text-color);
    scroll-margin-top: 6rem;
  }
  .project-status.is-compact {
    padding: 1rem 1.35rem;
  }
  .status-badge-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
  .status-dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: #34d399; box-shadow: 0 0 0 3px rgb(52 211 153 / 0.18); }
  .status-label, dt { font-size: 0.72rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; color: var(--primary); }
  .status-sep, time { font-size: 0.76rem; color: var(--text-color-muted); }
  h2 { margin-top: 0.3rem; font-size: clamp(1.04rem, 1.6vw, 1.22rem); font-weight: 750; line-height: 1.32; }
  .status-summary { margin-top: 0.5rem; font-size: 0.9rem; line-height: 1.6; color: color-mix(in srgb, var(--text-color) 88%, transparent); }
  .status-areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; margin-top: 1rem; }
  .status-area-card { padding: 0.85rem 0.95rem; border-radius: 0.55rem; background: rgb(0 0 0 / 0.22); border: 1px solid rgb(255 255 255 / 0.07); }
  dd { margin-top: 0.3rem; }
  dd strong { display: block; font-size: 0.9rem; font-weight: 700; line-height: 1.38; }
  dd span { display: block; margin-top: 0.3rem; font-size: 0.82rem; line-height: 1.52; color: var(--text-color-muted); }
  .status-next { display: flex; align-items: baseline; gap: 0.65rem 1.15rem; margin-top: 0.95rem; padding-top: 0.85rem; border-top: 1px solid color-mix(in srgb, var(--primary) 16%, transparent); }
  .status-next > span { flex-shrink: 0; }
  .status-next p { font-size: 0.86rem; line-height: 1.55; }
  .status-compact-footer { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.45rem 1.25rem; margin-top: 0.7rem; padding-top: 0.65rem; border-top: 1px solid rgb(255 255 255 / 0.08); font-size: 0.84rem; }
  .status-focus { color: var(--text-color-muted); line-height: 1.5; flex: 1 1 26rem; }
  .status-focus strong { color: var(--text-color); font-weight: 650; }
  .status-detail { color: var(--primary); font-weight: 700; white-space: nowrap; text-underline-offset: 0.2em; }
  .status-detail:hover { text-decoration: underline; }
  @media (max-width: 760px) {
    .status-areas { grid-template-columns: 1fr; }
    .status-next { flex-direction: column; gap: 0.3rem; }
  }
</style>
