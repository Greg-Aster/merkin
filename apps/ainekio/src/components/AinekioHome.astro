---
import { getCollection, getEntry } from 'astro:content'
import gallery from '../data/gallery.json'
import GalleryImage from './GalleryImage.astro'
import { topics, getReading, validateReadingPaths, generations } from '../lib/reading'
import { url } from '../utils/url-utils'
import ProjectStatus from './ProjectStatus.astro'

const updates = await getEntry('updates', 'site-updates')
if (!updates) throw new Error('Ainekio homepage requires updates/site-updates')
const posts = await getCollection('posts', ({ data }) => !data.draft)
validateReadingPaths(posts)
const latestUpdates = [...updates.data.entries].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 3)
const recent = latestUpdates.map(entry => {
  const post = posts.find(post => `/posts/${post.slug}/` === entry.url)
  if (!post?.data.image) throw new Error(`Homepage update needs an illustrated article: ${entry.title}`)
  return { entry, post }
})
const topicCards = Object.entries(topics).filter(([id]) => !['overview', 'v1'].includes(id)).map(([id, topic]) => {
  return { id, ...topic, count: posts.filter(post => getReading(post).topic === id).length }
})
const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
const hero = gallery.find(item => item.id === 'ainekio-v2-physical-three-quarter')!
const galleryPreview = ['ainekio-v2-physical-front', 'ainekio-mjcf-preview', 'lcd-face-contact-sheet'].map(id => gallery.find(item => item.id === id)!)
const paths = [
  { title: 'Ainekio OS Architecture', href: '/posts/ainekio-os/', text: 'The local-first personal AI OS (Greg-Aster/ainekio-os): 47 cognitive graphs, 14-table SQLite durable execution, ServerStatus hybrid compute, warm Gemini ACP, and the 02:00 Sleep Cycle.' },
  { title: 'V2 Hardware & On-Chip Neural Gait', href: '/posts/ainekio-v2/', text: 'The 650 g 12-servo four-bar body, Waveshare ESP32-P4-WIFI6 running a 107.8 KB L2-cached 50 Hz MicroDuck policy, 4th-wire feedback mux, ST7789 LCD, and Keeper Bridge STLs.' },
  { title: 'Build Journal & Milestones', href: '/updates/', text: 'Chronological engineering milestones from early linkage prototypes through carpet trials, DAgger L2-cache policy distillation, Cockpit HUD, and Ainekio OS.' },
]
---
<div class="ainekio-home">
  <section class="home-feature" aria-labelledby="home-title">
    <div>
      <p class="home-eyebrow">Open-Source 3D-Printed Quadruped · On-Chip ESP32-P4 Neural Gait · Ainekio OS</p>
      <h1 id="home-title">Ainekio: 12-Servo ESP32-P4 Quadruped &amp; Ainekio OS</h1>
      <p class="home-intro">Ainekio pairs an open-source, 3D-printed twelve-servo closed-loop quadruped (<code>Ainekio-bot</code>) with <strong><a href={url('/posts/ainekio-os/')}>Ainekio OS</a></strong> (<code>ainekio-os</code>, formerly MetaHuman OS)—a local-first personal AI operating system for persistent identity, episodic memory, 47 cognitive graphs, and bounded autonomy.</p>
      <p class="home-intro">Onboard, a Waveshare ESP32-P4-WIFI6 executes a DAgger-distilled <code>107.8 KB</code> neural gait policy natively at <code>50 Hz</code> inside its <code>128 KB</code> L2 cache alongside 4th-wire potentiometer feedback, a 1.9-inch ST7789 LCD, an OV5647 CSI camera, and a 208 Hz LSM6DS3 IMU—bridged over Wi-Fi to the Body Control Cockpit HUD and Ainekio OS.</p>
      <div class="home-actions">
        <a class="home-primary-link" href={url('/posts/project-overview/')}>System Overview →</a>
        <a class="home-secondary-link" href={url('/posts/ainekio-os/')}>Ainekio OS Guide →</a>
        <a class="home-secondary-link" href={url('/posts/how-does-ainekio-stack-up/')}>How Does Ainekio Stack Up? →</a>
        <a class="home-secondary-link" href={url('/updates/')}>Latest Milestones →</a>
      </div>
    </div>
    <figure>
      <a href={url('/gallery/')} aria-label="See Ainekio in the photo, video, and diagram gallery"><GalleryImage item={hero} eager sizes="(max-width: 767px) 100vw, 50vw" /></a>
      <figcaption class="home-meta">The 650 g twelve-servo V2 prototype on the workbench. <a href={url('/gallery/')}>Explore workbench photos, carpet trial videos, and wiring diagrams →</a></figcaption>
    </figure>
  </section>

  <ProjectStatus compact />

  <nav class="home-paths" aria-label="Choose a reading path">
    {paths.map(path => <a href={url(path.href)}><h2>{path.title} <span aria-hidden="true">→</span></h2><p>{path.text}</p></a>)}
  </nav>

  <section aria-labelledby="home-updates-title">
    <div class="home-section-heading"><h2 id="home-updates-title">Latest milestones</h2><a href={url('/updates/')}>All build journal milestones →</a></div>
    <div class="home-recent-grid">
      {recent.map(({ entry, post }) => <article class="home-update">
        <a href={url(entry.url)} tabindex="-1" aria-hidden="true"><img src={url(post.data.image)} alt="" loading="lazy" decoding="async" /></a>
        <div><p class="home-meta"><time datetime={entry.date.toISOString()}>{dateFormat.format(entry.date)}</time> · {generations[getReading(post).generation]}</p><h3><a href={url(entry.url)}>{entry.title}</a></h3><p>{entry.summary}</p></div>
      </article>)}
    </div>
  </section>

  <section aria-labelledby="home-gallery-title">
    <div class="home-section-heading"><div><h2 id="home-gallery-title">From the workbench & simulator</h2><p>Physical hardware, full-CAD MuJoCo MJCF simulation, 58 LCD expressions, and V2 wiring diagrams.</p></div><a href={url('/gallery/')}>Open full gallery →</a></div>
    <div class="home-recent-grid">
      {galleryPreview.map(item => <figure class="home-update"><a href={url(`/gallery/#${item.id}`)}><GalleryImage item={item} /><figcaption>{item.title} →</figcaption></a></figure>)}
    </div>
  </section>

  <section id="project-guides" aria-labelledby="home-guide-title">
    <div class="home-section-heading"><div><h2 id="home-guide-title">Explore by subsystem</h2></div><a href={url('/archive/?kind=reference')}>All reference guides →</a></div>
    <div class="home-topic-grid">
      {topicCards.map(topic => <a class="home-topic" href={url(`/archive/?topic=${topic.id}`)}><h3>{topic.title} →</h3><p>{topic.description}</p><span class="home-meta">{topic.count} articles</span></a>)}
    </div>
  </section>

  <section class="home-original" aria-labelledby="home-original-title">
    <img src={url('/posts/ainekio/wizard-lab-banner.webp')} alt="Original Ainekio illustration: the eight-servo robot as a familiar in a wizard's workshop" loading="lazy" decoding="async" />
    <div><p class="home-eyebrow">Where the build began</p><h2 id="home-original-title">The original V1 eight-servo robot</h2><p>Before the twelve-servo ESP32-P4 rebuild, Ainekio began as an eight-servo ESP32-S3 quadruped. All original parts lists, firmware notes, and design documents remain preserved for reference.</p><a href={url('/posts/v1-original-posts/')}>Explore the V1 archive →</a></div>
  </section>

  <nav id="article-library" class="home-library-links" aria-label="More project resources">
    <a href={url('/archive/')}>Browse all {posts.length} articles →</a>
    <a href={url('/archive/?kind=reference')}>Technical reference library →</a>
    <a href={url('/about/')}>About Ainekio & repositories →</a>
  </nav>
</div>

<style>
  :global(body:has(.ainekio-home) #main-grid) { grid-template-columns: minmax(0,1fr) !important; }
  :global(body:has(.ainekio-home) main#main) { grid-column: 1 / -1; min-width: 0; }
  .ainekio-home { max-width: 80rem; margin: 0 auto 2rem; display: grid; gap: 2rem; color: var(--text-color); }
  .home-feature { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: center; padding: clamp(1.2rem,3vw,2rem); background: var(--card-bg); border-radius: var(--radius-large); }
  h1 { font-size: clamp(2rem,4vw,3.2rem); line-height: 1.1; font-weight: 750; margin: .75rem 0; }
  h2 { font-size: 1.4rem; font-weight: 700; line-height: 1.3; }
  h3 { font-size: 1.1rem; font-weight: 700; line-height: 1.4; }
  p { line-height: 1.65; }
  .home-intro { margin-top: .85rem; max-width: 58ch; }
  .home-eyebrow { color: var(--primary); text-transform: uppercase; font-size: .75rem; font-weight: 700; letter-spacing: .05em; }
  .home-meta { font-size: .75rem; line-height: 1.6; color: var(--text-color-muted); }
  figure :global(img) { width: 100%; border-radius: .7rem; }
  .home-feature figcaption { margin-top: .65rem; }
  .home-update figcaption { padding: 1rem; font-weight: 650; }
  a { color: var(--primary); text-underline-offset: .2em; }
  a:hover { text-decoration: underline; }
  .home-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.25rem; }
  .home-primary-link { display: inline-block; padding: .75rem 1.1rem; border-radius: .4rem; background: var(--primary); color: #071b20; font-weight: 700; }
  .home-secondary-link { display: inline-block; padding: .75rem 1.1rem; border-radius: .4rem; border: 1px solid color-mix(in srgb,var(--primary) 45%,transparent); font-weight: 650; }
  .home-paths, .home-recent-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .home-paths > a, .home-topic { padding: 1.25rem; border: 1px solid color-mix(in srgb,var(--primary) 25%,transparent); border-radius: .65rem; background: var(--card-bg); }
  .home-paths h2 { font-size: 1.1rem; }
  .home-paths p, .home-topic p { margin-top: .6rem; color: var(--text-color); font-size: .9rem; }
  .home-section-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .75rem; margin-bottom: 1rem; }
  .home-section-heading > a { padding-block: .6rem; font-size: .9rem; }
  .home-section-heading p { font-size: .9rem; color: var(--text-color-muted); margin-top: .4rem; }
  .home-update { border-radius: .65rem; overflow: hidden; background: var(--card-bg); }
  .home-update :global(img) { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .home-update > div { padding: 1.15rem; }
  .home-update h3 { margin: .4rem 0 .6rem; }
  .home-update > div > p:last-child { font-size: .9rem; }
  .home-topic-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .home-topic .home-meta { display: block; margin-top: .6rem; }
  .home-original { display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 1.5rem; background: var(--card-bg); border-radius: .65rem; padding: 1.25rem; }
  .home-original img { width: 100%; border-radius: .5rem; }
  .home-original p { margin: .65rem 0; }
  .home-original a { display: inline-block; padding-block: .6rem; }
  .home-library-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .home-library-links a { padding-block: .75rem; }
  section[id], nav[id] { scroll-margin-top: 6rem; }
  @media (max-width: 767px) { .home-feature, .home-paths, .home-recent-grid, .home-topic-grid, .home-original { grid-template-columns: 1fr; } .home-feature { gap: 1.2rem; } .home-original img { max-height: 14rem; object-fit: cover; } }
</style>
