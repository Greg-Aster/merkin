---
import { getCollection, getEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import ProjectStatus from './ProjectStatus.astro'

const updates = await getEntry('updates', 'site-updates')
if (!updates) throw new Error('Ainekio homepage requires updates/site-updates')
const latestUpdates = [...updates.data.entries]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 4)
const [featured, ...recentUpdates] = latestUpdates
const posts = await getCollection('posts', ({ data }) => !data.draft)
const library = [...posts].sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
const featuredPost = posts.find(post => `/posts/${post.slug}/` === featured?.url)
if (!featured?.url || !featuredPost?.data.image) {
  throw new Error('The latest Ainekio update must link to a published post with a cover image')
}
const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
})

const sections = [
  {
    title: 'Body & mechanics',
    description: 'V1 hardware, the V2 design plan, and mechanical references.',
    icon: 'material-symbols:precision-manufacturing-outline',
    links: [
      { label: 'V2 parts & assembly record', href: '/posts/ainekio-v2/' },
      { label: 'Body design & hardware', href: '/posts/body-design-and-hardware/' },
      { label: 'Leg mechanism alternatives', href: '/posts/2026-09-09-leg-mechanism-study/' },
    ],
  },
  {
    title: 'Firmware & gateway',
    description: 'The software that carries commands to the robot and checks movement.',
    icon: 'material-symbols:hub-outline',
    links: [
      { label: 'Controller firmware', href: '/posts/controller-firmware/' },
      { label: 'Commands & safety', href: '/posts/protocol-and-safety/' },
      { label: 'Gateway & dashboard', href: '/posts/gateway-and-simulator/' },
    ],
  },
  {
    title: 'Perception & voice',
    description: 'Camera observations, listening, and speech connect Ainekio to the room.',
    icon: 'material-symbols:spatial-audio-outline',
    links: [
      { label: 'Camera & vision', href: '/posts/vision-loop/' },
      { label: 'Listening & speech', href: '/posts/voice-loop/' },
    ],
  },
  {
    title: 'MetaHuman OS',
    description: 'Conversation, decisions, and keeping track of a request while the robot acts.',
    icon: 'material-symbols:account-tree-outline',
    links: [
      { label: 'Robot integration', href: '/posts/metahuman-integration/' },
      { label: 'Robot decision-making', href: '/posts/bounded-autonomy/' },
    ],
  },
].map(section => {
  const post = posts.find(post => `/posts/${post.slug}/` === section.links[0].href)
  if (!post?.data.image) throw new Error(`Missing guide cover: ${section.title}`)
  return { ...section, image: post.data.image }
})

---

<div class="ainekio-home">
  <section class="home-feature" aria-labelledby="home-title">
    <div class="home-feature-copy">
      <div class="home-eyebrow">
        <span>Ainekio · latest development</span>
        <time datetime={featured.date.toISOString()}>{dateFormat.format(featured.date)}</time>
      </div>
      <h1 id="home-title">{featured.title}</h1>
      <p class="home-intro">A small four-legged robot connected to MetaHuman OS for conversation, memory, and decisions.</p>
      <p class="home-feature-summary">{featured.summary}</p>
      <div class="home-actions">
        <a class="home-primary-link" href={featured.url}>Read the latest update <Icon name="material-symbols:arrow-forward-rounded" /></a>
        <a class="home-text-link" href="/posts/project-overview/">What is Ainekio?</a>
        <a class="home-text-link" href="/archive/">All articles <Icon name="material-symbols:arrow-forward-rounded" /></a>
      </div>
    </div>
    <figure class="home-feature-image">
      <a href={featured.url} aria-label="Explore the latest Ainekio build">
        <img class="home-concept" src="/assets/ainekio/v2/assembly-september-10-concept.webp" alt="Concept illustration of the September 10 CAD body with red articulated legs and a camera above its cyan face, in a ruined futuristic city" loading="eager" fetchpriority="high" decoding="async" />
      </a>
      <figcaption>Concept illustration based on the September 10 CAD design</figcaption>
      <a class="home-update-preview" href={featured.url}>
        <img src={featuredPost.data.image} alt={`Build update: ${featuredPost.data.title}`} loading="eager" decoding="async" />
        <span>See the build photos and details <span aria-hidden="true">→</span></span>
      </a>
    </figure>
  </section>

  <div class="home-status">
    <ProjectStatus />
    <a class="home-text-link home-status-link" href="/posts/current-status/">Status details and earlier reviews <Icon name="material-symbols:arrow-forward-rounded" /></a>
  </div>

  <section class="home-recent" aria-labelledby="home-updates-title">
    <div class="home-section-heading">
      <h2 id="home-updates-title">Recent updates</h2>
      <a class="home-text-link" href="/updates/">All development updates <Icon name="material-symbols:arrow-forward-rounded" /></a>
    </div>
    <div class="home-update-list">
      {recentUpdates.map(entry => (
        <article class="home-update">
          {posts.find(post => `/posts/${post.slug}/` === entry.url)?.data.image && <a class="home-update-image" href={entry.url} aria-label={entry.title}><img src={posts.find(post => `/posts/${post.slug}/` === entry.url)!.data.image} alt="" loading="lazy" decoding="async" /></a>}
          <div class="home-update-meta">
            <time datetime={entry.date.toISOString()}>{dateFormat.format(entry.date)}</time>
            {entry.location && <span>{entry.location}</span>}
          </div>
          <div>
            <h3>{entry.url ? <a href={entry.url}>{entry.title} <span aria-hidden="true">→</span></a> : entry.title}</h3>
            <p>{entry.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="project-guides" aria-labelledby="home-guide-title">
    <div class="home-section-heading">
      <div>
        <h2 id="home-guide-title">Project guides</h2>
        <p class="home-section-intro">How the parts work and fit together.</p>
      </div>
      <a class="home-text-link" href="#article-library">Browse every article <Icon name="material-symbols:arrow-forward-rounded" /></a>
    </div>
    <div class="home-guide-grid">
      {sections.map(section => (
        <article class="home-guide">
          <a class="home-guide-image" href={section.links[0].href} aria-label={section.title}><img src={section.image} alt="" loading="lazy" decoding="async" /></a>
          <h3><Icon name={section.icon} />{section.title}</h3>
          <p>{section.description}</p>
          <ul>
            {section.links.map(link => <li><a class="home-text-link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a></li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="article-library" aria-labelledby="home-library-title">
    <div class="home-section-heading">
      <div><h2 id="home-library-title">All articles & build history</h2><p class="home-section-intro">Parts, wiring, software, design revisions, and earlier experiments.</p></div>
      <a class="home-text-link" href="/archive/">Open the archive <Icon name="material-symbols:arrow-forward-rounded" /></a>
    </div>
    <div class="home-library-grid">
      {library.map(post => (
        <article class="home-library-entry">
          <a class="home-library-image" href={`/posts/${post.slug}/`} aria-label={post.data.title}><img src={post.data.image} alt="" loading="lazy" decoding="async" /></a>
          <div>
            <p class="home-library-meta">{post.data.archive ? 'Earlier build record' : post.data.category} · <time datetime={post.data.published.toISOString()}>{dateFormat.format(post.data.published)}</time></p>
            <h3><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<style>
  :global(body:has(.ainekio-home) #main-panel-wrapper[data-home-layout='portal'] #main-grid) {
    grid-template-columns: minmax(0, 1fr) !important;
  }
  :global(body:has(.ainekio-home) #main-panel-wrapper[data-home-layout='portal'] main#main) {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .ainekio-home { max-width: 80rem; margin: 0 auto 2rem; display: grid; gap: 2rem; color: var(--text-color); }
  .home-feature { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(1.5rem, 4vw, 3rem); padding: 1.5rem; border-radius: var(--radius-large); background: var(--card-bg); }
  .home-feature-copy { display: grid; gap: 1rem; }
  .home-eyebrow { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.75rem; font-weight: 700; color: var(--primary); }
  .home-eyebrow time { color: var(--text-color-muted); }
  h1 { font-size: clamp(1.8rem, 3.3vw, 2.75rem); line-height: 1.12; font-weight: 750; letter-spacing: -0.025em; }
  .home-intro { max-width: 52ch; font-size: 1rem; line-height: 1.65; }
  .home-feature-summary { max-width: 60ch; font-size: 0.95rem; line-height: 1.65; }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; }
  .home-primary-link { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 44px; padding: 0.75rem 1rem; background: var(--primary); color: #071b20; border-radius: 0.6rem; font-size: 0.9rem; font-weight: 750; }
  .home-primary-link:hover { filter: brightness(1.1); }
  .home-text-link { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; color: var(--primary); font-size: 0.875rem; font-weight: 650; }
  a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  a:focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; border-radius: 0.25rem; }
  .home-feature-image { min-width: 0; margin: 0; }
  .home-feature-image a { display: block; }
  .home-feature-image .home-concept { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.65rem; }
  .home-feature-image .home-update-preview { display: flex; align-items: center; gap: 1rem; margin-top: 0.9rem; color: var(--primary); font-size: 0.85rem; font-weight: 650; }
  .home-update-preview img { width: 7rem; aspect-ratio: 3 / 2; object-fit: contain; background: #454545; border-radius: 0.35rem; }
  figcaption { margin-top: 0.5rem; font-size: 0.75rem; color: var(--text-color-muted); }
  .home-status-link { margin: 0.35rem 1.25rem 0; }
  .home-section-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; margin-bottom: 0.5rem; }
  h2 { font-size: 1.4rem; font-weight: 750; line-height: 1.3; }
  .home-section-intro { margin-top: 0.45rem; font-size: 0.9rem; color: var(--text-color-muted); }
  .home-update { display: grid; grid-template-columns: 9rem 10rem minmax(0, 1fr); column-gap: 1.5rem; padding: 1.1rem 0; border-top: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); }
  .home-update-image img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.5rem; }
  .home-update-meta { display: grid; align-content: start; gap: 0.45rem; padding-top: 0.4rem; font-size: 0.8rem; }
  .home-update-meta time { font-weight: 700; }
  .home-update-meta span { color: var(--text-color-muted); }
  .home-update h3 { font-size: 1.05rem; font-weight: 700; line-height: 1.45; }
  .home-update h3 a { display: inline-flex; gap: 0.5rem; align-items: center; min-height: 44px; }
  .home-update h3 a span { color: var(--primary); }
  .home-update p { max-width: 95ch; margin-top: 0.25rem; font-size: 0.9rem; line-height: 1.6; }
  #project-guides, #article-library { scroll-margin-top: 6rem; }
  .home-guide-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  .home-guide { padding-top: 1.25rem; min-width: 0; }
  .home-guide-image { display: block; margin-bottom: 1rem; }
  .home-guide-image img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.6rem; }
  .home-guide h3 { display: flex; align-items: center; gap: 0.6rem; font-size: 1.05rem; font-weight: 700; }
  .home-guide h3 :global(svg) { color: var(--primary); flex-shrink: 0; font-size: 1.4rem; }
  .home-guide p { margin-top: 0.6rem; font-size: 0.85rem; line-height: 1.6; }
  .home-guide ul { margin-top: 0.6rem; }
  .home-library-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; }
  .home-library-entry { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; padding: 1.25rem 0; border-top: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); }
  .home-library-image img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.5rem; }
  .home-library-entry h3 { font-size: 1rem; line-height: 1.45; font-weight: 700; margin: 0.3rem 0; }
  .home-library-entry p { font-size: 0.85rem; line-height: 1.6; }
  .home-library-entry .home-library-meta { color: var(--text-color-muted); font-size: 0.75rem; }
  @media (max-width: 1000px) {
    .home-guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .home-feature { grid-template-columns: 1fr; padding: 1.25rem; gap: 1.25rem; }
    .home-update { grid-template-columns: 1fr; gap: 0.35rem; }
    .home-update-image { width: 9rem; margin-bottom: 0.35rem; }
    .home-update-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; padding: 0; }
    .home-guide-grid { grid-template-columns: 1fr; gap: 0; }
    .home-guide { border-top: 1px solid color-mix(in srgb, var(--primary) 16%, transparent); padding: 1rem 0; }
    .home-guide p { margin-top: 0.35rem; }
    .home-guide ul { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
    .home-status-link { margin-left: 0; }
    .home-library-grid { grid-template-columns: 1fr; }
    .home-library-entry { grid-template-columns: 5.5rem minmax(0, 1fr); gap: 0.75rem; }
  }
</style>
