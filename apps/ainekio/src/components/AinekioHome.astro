---
import { getEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

const updates = await getEntry('updates', 'site-updates')
const current = updates?.data.current
if (!updates || !current?.updated || !current.nextStop) {
  throw new Error('Ainekio homepage requires dated project status and a next milestone')
}
const latestUpdates = [...updates.data.entries]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3)
const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
})

const sections = [
  {
    title: 'Body & mechanics',
    description: 'The working eight-servo robot and the twelve-servo build ahead.',
    icon: 'material-symbols:precision-manufacturing-outline',
    links: [
      { label: 'V2 roadmap', href: '/posts/ainekio-v2/' },
      { label: 'Body design & hardware', href: '/posts/body-design-and-hardware/' },
    ],
  },
  {
    title: 'Firmware & gateway',
    description: 'How commands reach the body through its controller and safety gates.',
    icon: 'material-symbols:hub-outline',
    links: [
      { label: 'Controller firmware', href: '/posts/controller-firmware/' },
      { label: 'Protocol & safety', href: '/posts/protocol-and-safety/' },
      { label: 'Gateway & dashboard', href: '/posts/gateway-and-simulator/' },
    ],
  },
  {
    title: 'Perception & voice',
    description: 'Camera observations, listening, and speech connect Ainekio to the room.',
    icon: 'material-symbols:spatial-audio-outline',
    links: [
      { label: 'Vision loop', href: '/posts/vision-loop/' },
      { label: 'Voice loop', href: '/posts/voice-loop/' },
    ],
  },
  {
    title: 'MetaHuman OS',
    description: 'The reasoning and persistent execution behind the robot’s behavior.',
    icon: 'material-symbols:account-tree-outline',
    links: [
      { label: 'System integration', href: '/posts/metahuman-integration/' },
      { label: 'Bounded autonomy', href: '/posts/bounded-autonomy/' },
    ],
  },
]

const milestones = [
  { label: 'Working V1', value: '8 servos · ESP32-S3', detail: 'The current physical prototype.' },
  { label: 'Planned V2', value: '12 servos · ESP32-P4', detail: 'New mechanics and controller development.' },
  { label: 'Next milestone', value: current.nextStop, detail: 'Physical testing before the final body design.' },
]
---

<div class="ainekio-home">
  <section class="home-hero card-base relative overflow-hidden rounded-[var(--radius-large)] border border-cyan-300/20 shadow-2xl shadow-cyan-950/15" aria-labelledby="home-title">
    <img
      src="/assets/ainekio/v2/hero-concept.webp"
      srcset="/assets/ainekio/v2/hero-concept-small.webp 800w, /assets/ainekio/v2/hero-concept.webp 1672w"
      sizes="(max-width: 600px) 100vw, (max-width: 1344px) calc(100vw - 32px), 1280px"
      width="1672"
      height="941"
      alt="Prospective Ainekio V2 hybrid concept with a stout body and red serrated legs on a fictional ruined highway"
      class="absolute inset-0 h-full w-full object-cover object-[68%_center]"
      loading="eager"
      fetchpriority="high"
    />
    <div class="home-hero-shade absolute inset-0 bg-[linear-gradient(90deg,rgba(3,8,12,.97)_0%,rgba(3,8,12,.91)_38%,rgba(3,8,12,.42)_70%,rgba(3,8,12,.14)_100%)]"></div>
    <div class="home-hero-copy relative z-10">
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-cyan-100/80">
        <span class="rounded-full border border-cyan-300/25 bg-cyan-950/55 px-3 py-1.5">Ainekio V2 · concept art</span>
        <time datetime={current.updated.toISOString().slice(0, 10)} class="rounded-full border border-amber-300/25 bg-amber-950/40 px-3 py-1.5">Updated {dateFormat.format(current.updated)}</time>
      </div>
      <h1 id="home-title" class="font-black tracking-[-0.04em] text-white">A new body.<br />A persistent mind.</h1>
      <p class="home-intro text-slate-200/85">
        A robot familiar powered by MetaHuman OS. Follow the new body,
        the software redesign, and the next steps toward V2.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/posts/ainekio-v2/" class="inline-flex items-center gap-2 rounded-full bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-200 active:scale-95">
          Explore the V2 roadmap <Icon name="material-symbols:arrow-forward-rounded" class="text-xl" />
        </a>
        <a href="/posts/current-status/" class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-black/30 px-5 py-3 text-sm font-bold text-white backdrop-blur transition hover:border-amber-300/60 hover:bg-black/45 active:scale-95">
          Current status <Icon name="material-symbols:fact-check-outline" class="text-xl" />
        </a>
      </div>
    </div>
  </section>

  <section aria-label="Project at a glance" class="home-milestones card-base rounded-[var(--radius-large)]">
    {milestones.map(item => (
      <div class="home-milestone">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{item.label}</p>
        <p class="mt-2 text-xl font-bold text-slate-950 dark:text-white">{item.value}</p>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.detail}</p>
      </div>
    ))}
  </section>

  <section aria-labelledby="home-guide-title">
    <div class="home-section-heading">
      <h2 id="home-guide-title" class="text-2xl font-black tracking-[-0.02em] text-slate-950 dark:text-white">Explore the project</h2>
      <a href="/posts/project-overview/" class="home-text-link">Start with the overview <Icon name="material-symbols:arrow-forward-rounded" class="text-lg" /></a>
    </div>
    <div class="home-guide-grid">
      {sections.map(section => (
        <article class="home-guide-card card-base rounded-[var(--radius-large)]">
          <Icon name={section.icon} class="home-guide-icon text-3xl text-cyan-700 dark:text-cyan-300" />
          <h3 class="home-guide-heading mt-4 text-xl font-bold text-slate-950 dark:text-white">{section.title}</h3>
          <p class="home-guide-description mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{section.description}</p>
          <div class="home-guide-links">
            {section.links.map(link => (
              <a href={link.href} class="home-text-link justify-between py-1.5">
                {link.label} <Icon name="material-symbols:arrow-forward-rounded" class="shrink-0 text-lg" />
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="home-updates-title">
    <div class="home-section-heading">
      <h2 id="home-updates-title" class="text-2xl font-black tracking-[-0.02em] text-slate-950 dark:text-white">Latest developments</h2>
      <a href="/updates/" class="home-text-link">All updates <Icon name="material-symbols:arrow-forward-rounded" class="text-lg" /></a>
    </div>
    <div class="home-updates-grid">
      {latestUpdates.map(entry => (
        <article class:list={["home-update card-base rounded-[var(--radius-large)]", { "home-update-linked": entry.url }]}>
          <time datetime={entry.date.toISOString().slice(0, 10)} class="text-xs font-semibold uppercase tracking-[0.12em] text-amber-600 dark:text-amber-300">{dateFormat.format(entry.date)}</time>
          <h3 class="mt-3 text-lg font-bold leading-6 text-slate-950 dark:text-white">
            {entry.url ? <a href={entry.url} class="hover:underline">{entry.title}</a> : entry.title}
          </h3>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{entry.summary}</p>
          {entry.url && <a href={entry.url} class="home-text-link mt-auto pt-4" aria-label={`Read more: ${entry.title}`}>Read more <Icon name="material-symbols:arrow-forward-rounded" class="text-lg" /></a>}
        </article>
      ))}
    </div>
    <a href="/archive/" class="home-text-link mt-5">Browse all field notes <Icon name="material-symbols:arrow-forward-rounded" class="text-lg" /></a>
  </section>
</div>

<style>
  /* Keep the portal full-width when the shared blog shell uses landscape rails. */
  :global(body:has(.ainekio-home) #main-panel-wrapper[data-home-layout='portal'] #main-grid) {
    grid-template-columns: minmax(0, 1fr) !important;
  }
  :global(body:has(.ainekio-home) #main-panel-wrapper[data-home-layout='portal'] main#main) {
    grid-column: 1 / -1 !important;
    min-width: 0;
  }
  .ainekio-home {
    max-width: 80rem;
    margin: 0 auto 2rem;
    display: grid;
    gap: 2rem;
  }
  .home-hero-copy {
    max-width: 40rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    gap: 1.5rem;
  }
  #home-title {
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    line-height: 1.04;
  }
  .home-intro { max-width: 48ch; font-size: 1.0625rem; line-height: 1.7; }
  .home-milestones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .home-milestone { padding: 1.5rem; }
  .home-section-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.75rem; margin-bottom: 1rem; }
  .home-guide-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .home-guide-card, .home-update { min-width: 0; padding: 1.5rem; display: flex; flex-direction: column; }
  .home-guide-links { margin-top: auto; padding-top: 1rem; display: flex; flex-direction: column; }
  .home-text-link { @apply inline-flex items-center gap-2 text-sm font-bold text-cyan-700 hover:underline dark:text-cyan-300; }
  .home-updates-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 1100px) {
    .home-guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-updates-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .ainekio-home { gap: 2rem; margin-bottom: 0; }
    .home-hero-shade { background: linear-gradient(90deg, rgba(3,8,12,.97), rgba(3,8,12,.72)); }
    .home-hero-copy { gap: 1.25rem; }
    #home-title { font-size: clamp(1.95rem, 8.8vw, 2.25rem); }
    .home-milestones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-milestone { padding: 1.25rem; }
    .home-milestone > p:nth-child(2) { font-size: 1.0625rem; line-height: 1.5; }
    .home-milestone:not(:last-child) > p:last-child { display: none; }
    .home-milestone:last-child {
      grid-column: 1 / -1;
      padding-top: 1rem;
      border-top: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    }
    .home-section-heading { align-items: center; gap: 0.25rem 0.75rem; margin-bottom: 0.75rem; }
    .home-section-heading h2 { font-size: 1.375rem; }
    .home-guide-grid { grid-template-columns: 1fr; gap: 0; }
    .home-guide-card {
      display: grid;
      grid-template-columns: 1.75rem minmax(0, 1fr);
      column-gap: 0.75rem;
      padding: 1rem 0.25rem;
      border-radius: 0;
      background: transparent;
      backdrop-filter: none;
      box-shadow: none;
    }
    .home-guide-card + .home-guide-card {
      border-top: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    }
    .home-guide-card :global(.home-guide-icon) { grid-column: 1; grid-row: 1; font-size: 1.5rem; }
    .home-guide-heading { grid-column: 2; margin-top: 0; font-size: 1.125rem; }
    .home-guide-description { display: none; }
    .home-guide-links { grid-column: 2; padding-top: 0.25rem; flex-direction: row; flex-wrap: wrap; column-gap: 1rem; }
    .home-guide-links :global(svg) { display: none; }
    .home-text-link { min-height: 44px; }
    .home-updates-grid { gap: 0; }
    .home-update { padding: 1.25rem; }
    .home-update:first-child { margin-bottom: 0.75rem; }
    .home-update-linked:not(:first-child) {
      padding: 1rem 0.25rem;
      border-radius: 0;
      background: transparent;
      backdrop-filter: none;
      box-shadow: none;
    }
    .home-update-linked + .home-update-linked {
      border-top: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    }
    .home-update-linked:not(:first-child) h3 { margin-top: 0.375rem; font-size: 1rem; }
    .home-update-linked:not(:first-child) h3 a { display: flex; align-items: center; min-height: 44px; }
    .home-update-linked:not(:first-child) p,
    .home-update-linked:not(:first-child) > .home-text-link { display: none; }
    :global(body:has(.ainekio-home) #main-grid > .footer > div:first-child) { margin-top: 1rem; margin-bottom: 1.5rem; }
  }
</style>
