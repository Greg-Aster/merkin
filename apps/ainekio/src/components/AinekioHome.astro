---
import { getCollection, getEntry } from 'astro:content'
import gallery from '../data/gallery.json'
import GalleryImage from './GalleryImage.astro'
import { topics, getReading, validateReadingPaths } from '../lib/reading'
import { url } from '../utils/url-utils'

const updates = await getEntry('updates', 'site-updates')
if (!updates) throw new Error('Ainekio homepage requires updates/site-updates')
const current = updates.data.current
const posts = await getCollection('posts', ({ data }) => !data.draft)
validateReadingPaths(posts)

const latestUpdates = [...updates.data.entries].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 4)
const recent = latestUpdates.map(entry => {
  const post = posts.find(post => `/posts/${post.slug}/` === entry.url)
  if (!post?.data.image) throw new Error(`Homepage update needs an illustrated article: ${entry.title}`)
  return { entry, post }
})

const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
const hero = gallery.find(item => item.id === 'ainekio-v2-physical-three-quarter')!
const featuredVideo = gallery.find(item => item.id === 'ainekio-v2-neural-walk-first-run')!
const stageTiles = [
  { item: gallery.find(item => item.id === 'ainekio-v2-physical-front')!, badge: 'Front CSI Cam & LCD', label: 'Front profile on carpet', fit: 'cover' },
  { item: gallery.find(item => item.id === 'lcd-face-contact-sheet')!, badge: '59 LCD Faces', label: 'Procedural 1.9" LCD face sheet', fit: 'cover' },
  { item: gallery.find(item => item.id === 'ainekio-mjcf-preview')!, badge: 'Blender → MuJoCo', label: 'Full-CAD 650 g MJCF twin', fit: 'cover' },
  { item: gallery.find(item => item.id === 'diagram-assembly-reference')!, badge: 'V2 Wiring & Buses', label: 'ESP32-P4 & 4th-wire schematic', fit: 'contain' },
]

const referenceCount = posts.filter(p => getReading(p).kind === 'reference').length
const directoryCards = [
  {
    num: '01',
    title: 'Overview, Capabilities & Lineup',
    description: 'What Ainekio can do in the room, how the ~$85 hardware and local AI mind fit together, and how it compares to other quadrupeds.',
    primaryHref: '/posts/project-overview/',
    primaryLabel: 'System Overview',
    secondaryHref: '/posts/what-ainekio-can-do/',
    secondaryLabel: 'What It Can Do',
    count: posts.filter(p => getReading(p).topic === 'overview').length,
  },
  {
    num: '02',
    title: 'Legs & Neural Walking',
    description: 'Compact four-bar knee linkages, printed tolerances, reinforcement learning failure modes, and the 50 Hz L2-cached walking policy.',
    primaryHref: '/posts/gait-development/',
    primaryLabel: 'Gait Guide',
    secondaryHref: '/archive/?topic=legs',
    secondaryLabel: `All ${posts.filter(p => getReading(p).topic === 'legs').length} leg notes`,
    count: posts.filter(p => getReading(p).topic === 'legs').length,
  },
  {
    num: '03',
    title: 'Chassis, Shell & Power',
    description: 'The 650 g 3D-printed shell, fourth-wire modified MG90S servos, GPIO pinouts, and rear 2S Wireless Keeper Bridge.',
    primaryHref: '/posts/ainekio-v2/',
    primaryLabel: 'V2 Hardware & Wiring',
    secondaryHref: '/archive/?topic=body',
    secondaryLabel: `All ${posts.filter(p => getReading(p).topic === 'body').length} chassis notes`,
    count: posts.filter(p => getReading(p).topic === 'body').length,
  },
  {
    num: '04',
    title: 'Firmware, Cockpit & Safety',
    description: 'ESP32-P4 control loops, shaft-arrival verification, stall protection, gentle startup rise, and the live camera Cockpit HUD.',
    primaryHref: '/posts/protocol-and-safety/',
    primaryLabel: 'Protocol & Safety',
    secondaryHref: '/posts/gateway-and-simulator/',
    secondaryLabel: 'Cockpit HUD',
    count: posts.filter(p => getReading(p).topic === 'control').length,
  },
  {
    num: '05',
    title: 'Vision, Face & Voice',
    description: 'Chin-mounted OV5647 camera tracking, 59 procedural expressions on the 1.9" LCD, wake-word listening, and room speech.',
    primaryHref: '/posts/vision-loop/',
    primaryLabel: 'Vision & Face',
    secondaryHref: '/posts/voice-loop/',
    secondaryLabel: 'Voice Loop',
    count: posts.filter(p => getReading(p).topic === 'perception').length,
  },
  {
    num: '06',
    title: 'Ainekio OS (The Mind)',
    description: 'The local-first personal AI OS behind Ainekio: persistent persona, episodic memory, nightly sleep consolidation, and robot reflexes.',
    primaryHref: '/posts/ainekio-os/',
    primaryLabel: 'Ainekio OS Guide',
    secondaryHref: '/posts/ainekio-companion/',
    secondaryLabel: 'Companion Loop',
    count: posts.filter(p => getReading(p).topic === 'metahuman').length,
  },
]

const specs = [
  { label: 'Physical body', value: '650 g · 12 feedback servos' },
  { label: 'Onboard brain', value: 'ESP32-P4 · 50 Hz neural gait' },
  { label: 'Face & senses', value: '1.9" LCD (59 faces) · Cam · IMU' },
  { label: 'Companion mind', value: 'Ainekio OS · Local memory & voice' },
]
---

<div class="ainekio-home">
  <!-- ZONE 1: WORKBENCH HERO + INTEGRATED LIVE BENCH STATUS BAR -->
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-main">
      <div class="hero-copy">
        <p class="home-eyebrow">Personal Build Journal · Embodied Robotics &amp; Local AI</p>
        <h1 id="home-title">Building Ainekio: a 3D-printed quadruped with a persistent mind</h1>
        <p class="home-intro">
          Ainekio is an ongoing workbench project pairing a custom <strong>650&nbsp;g</strong>, twelve-servo walking robot (<a href="https://github.com/Greg-Aster/Ainekio-bot" target="_blank" rel="noreferrer">Ainekio-bot</a>) with <strong><a href={url('/posts/ainekio-os/')}>Ainekio OS</a></strong> (<a href="https://github.com/Greg-Aster/ainekio-os" target="_blank" rel="noreferrer">ainekio-os</a>)—a local-first AI companion runtime that remembers past days, talks in the room, and reacts when the robot is picked up or nudged.
        </p>
        <p class="home-intro home-intro-sub">
          Nothing here is a commercial product. This site is my engineering logbook: CAD files modeled in Blender, fourth-wire servo modifications, reinforcement-learning faceplants on the living-room rug, and the notes behind getting a ~$85 hobby quadruped walking untethered.
        </p>

        <dl class="hero-specs" aria-label="At-a-glance specifications">
          {specs.map(spec => (
            <div>
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>

        <div class="home-actions">
          <a class="home-primary-link" href={url('/posts/project-overview/')}>Start with the Overview →</a>
          <a class="home-secondary-link" href={url('/posts/what-ainekio-can-do/')}>What It Can Do →</a>
          <a class="home-secondary-link" href={url('/posts/how-does-ainekio-stack-up/')}>How It Stacks Up →</a>
        </div>
      </div>

      <figure class="hero-media">
        <a href={url('/gallery/')} aria-label="Open the Ainekio photo, video, and wiring gallery">
          <GalleryImage item={hero} eager sizes="(max-width: 860px) 100vw, 44vw" />
        </a>
        <figcaption>
          <span>The 650 g twelve-servo V2 prototype on carpet with its printed shell and fourth-wire feedback harness.</span>
          <a href={url('/gallery/')}>Browse photos &amp; videos →</a>
        </figcaption>
      </figure>
    </div>

    <div class="hero-status-bar" aria-label="Current workbench status">
      <div class="hero-status-left">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-tag">Bench status · {dateFormat.format(current.updated)}</span>
        <span class="status-headline">{current.status}</span>
      </div>
      <a class="hero-status-link" href={url('/posts/project-overview/#project-status')}>Full status &amp; next steps →</a>
    </div>
  </section>

  <!-- ZONE 2: DARK STUDIO MEDIA STAGE (VIDEO + BALANCED 2x2 VISUAL GRID) -->
  <section class="home-stage" aria-labelledby="home-stage-title">
    <div class="stage-header">
      <div>
        <p class="stage-eyebrow">Floor Footage, CAD &amp; Schematics</p>
        <h2 id="home-stage-title">See the robot in motion</h2>
      </div>
      <a class="stage-all-link" href={url('/gallery/')}>Open full media gallery ({gallery.length} items) →</a>
    </div>

    <div class="stage-grid">
      <figure class="stage-feature-video">
        <video
          controls
          playsinline
          preload="none"
          width={featuredVideo.width}
          height={featuredVideo.height}
          poster={url(featuredVideo.poster!)}
        >
          <source src={url(featuredVideo.src!)} type="video/mp4" />
          <a href={url(featuredVideo.src!)}>Download walking video</a>
        </video>
        <figcaption>
          <div class="stage-caption-top">
            <span class="stage-pill">Physical Carpet Test · MP4</span>
            <a class="stage-video-more" href={url('/gallery/#videos')}>All floor videos →</a>
          </div>
          <h3>{featuredVideo.title}</h3>
          <p>{featuredVideo.caption}</p>
        </figcaption>
      </figure>

      <div class="stage-tile-grid">
        {stageTiles.map(({ item, badge, label, fit }) => (
          <a class:list={['stage-tile', { 'is-contain': fit === 'contain' }]} href={url(`/gallery/#${item.id}`)}>
            <div class="stage-tile-thumb">
              <GalleryImage item={item} sizes="(max-width: 640px) 50vw, 260px" />
            </div>
            <div class="stage-tile-copy">
              <span class="stage-tile-badge">{badge}</span>
              <h3>{label}&nbsp;→</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ZONE 3: OPEN 3x2 TECHNICAL SYSTEM DIRECTORY (NO DOUBLE-BOX WRAPPER) -->
  <section id="project-guides" class="home-directory" aria-labelledby="home-guide-title">
    <div class="open-section-header">
      <div>
        <p class="home-eyebrow">Technical Notebook &amp; Reference</p>
        <h2 id="home-guide-title">Explore how each part works</h2>
      </div>
      <a class="section-link" href={url('/archive/?kind=reference')}>All {referenceCount} reference guides →</a>
    </div>

    <div class="directory-grid">
      {directoryCards.map(card => (
        <article class="directory-card">
          <div class="directory-card-top">
            <span class="directory-num">{card.num}</span>
            <span class="directory-count">{card.count} {card.count === 1 ? 'note' : 'notes'}</span>
          </div>
          <h3><a href={url(card.primaryHref)}>{card.title}</a></h3>
          <p>{card.description}</p>
          <div class="directory-links">
            <a class="directory-primary" href={url(card.primaryHref)}>{card.primaryLabel}&nbsp;→</a>
            <span class="directory-dot" aria-hidden="true">·</span>
            <a class="directory-secondary" href={url(card.secondaryHref)}>{card.secondaryLabel}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ZONE 4: 2x2 ILLUSTRATED BUILD JOURNAL GRID -->
  <section class="home-journal" aria-labelledby="home-updates-title">
    <div class="panel-section-header">
      <div>
        <p class="home-eyebrow">Chronological Workbench Log</p>
        <h2 id="home-updates-title">Recent build journal entries</h2>
      </div>
      <a class="section-link" href={url('/updates/')}>View all {updates.data.entries.length} milestones →</a>
    </div>

    <ol class="logbook-grid">
      {recent.map(({ entry, post }) => (
        <li class="logbook-card">
          <a class="logbook-thumb" href={url(entry.url)} tabindex="-1" aria-hidden="true">
            <img src={url(post.data.image)} alt="" loading="lazy" decoding="async" />
          </a>
          <div class="logbook-body">
            <div class="logbook-meta">
              <time datetime={entry.date.toISOString()}>{dateFormat.format(entry.date)}</time>
              <span aria-hidden="true">·</span>
              <span>{topics[getReading(post).topic].title}</span>
            </div>
            <h3><a href={url(entry.url)}>{entry.title}</a></h3>
            <p>{entry.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ZONE 5: HISTORICAL V1 FOOTNOTE & FULL ARCHIVE BAR -->
  <footer class="home-origins" aria-labelledby="home-original-title">
    <div class="origins-card">
      <img
        src={url('/posts/ainekio/wizard-lab-banner.webp')}
        alt="Illustration from the original summer 2026 eight-servo Ainekio V1 concept notes"
        loading="lazy"
        decoding="async"
      />
      <div class="origins-copy">
        <p class="home-eyebrow">Where the project started (Summer 2026)</p>
        <h2 id="home-original-title">Looking for the original eight-servo V1 prototype?</h2>
        <p>
          Before the twelve-servo ESP32-P4 rebuild, Ainekio started as a simpler eight-servo ESP32-S3 frame with an OLED screen. Those early parts lists, wiring notes, and lessons learned are kept intact in the archive.
        </p>
        <div id="article-library" class="origins-links">
          <a href={url('/posts/v1-original-posts/')}>Original V1 build archive →</a>
          <a href={url('/archive/')}>Search &amp; filter all {posts.length} articles →</a>
          <a href={url('/about/')}>About the builder &amp; GitHub repos →</a>
        </div>
      </div>
    </div>
  </footer>
</div>

<style>
  :global(body:has(.ainekio-home) #main-grid) { grid-template-columns: minmax(0, 1fr) !important; }
  :global(body:has(.ainekio-home) main#main) { grid-column: 1 / -1; min-width: 0; }

  .ainekio-home {
    width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.65rem;
    color: var(--text-color);
  }
  .ainekio-home > * { min-width: 0; }

  h1 { font-size: clamp(1.85rem, 3.3vw, 2.65rem); line-height: 1.12; font-weight: 780; margin: 0.45rem 0 0.75rem; letter-spacing: -0.015em; }
  h2 { font-size: clamp(1.3rem, 2vw, 1.55rem); font-weight: 750; line-height: 1.24; }
  h3 { font-size: 1.02rem; font-weight: 700; line-height: 1.34; }
  p { line-height: 1.6; }
  a { color: var(--primary); text-underline-offset: 0.2em; }
  a:hover { text-decoration: underline; }
  .home-eyebrow { color: var(--primary); text-transform: uppercase; font-size: 0.72rem; font-weight: 750; letter-spacing: 0.08em; }

  /* ZONE 1: WORKBENCH HERO + INTEGRATED STATUS FOOTER */
  .home-hero {
    border-radius: var(--radius-large);
    overflow: hidden;
    background:
      radial-gradient(circle at 92% 12%, color-mix(in srgb, var(--primary) 13%, transparent), transparent 46%),
      var(--card-bg);
    border: 1px solid color-mix(in srgb, var(--primary) 24%, transparent);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.65);
  }
  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(1.25rem, 2.6vw, 2rem);
    align-items: center;
    padding: clamp(1.25rem, 2.6vw, 2rem);
  }
  .hero-copy, .hero-media { min-width: 0; }
  .home-intro { font-size: 0.97rem; }
  .home-intro strong { font-weight: 700; color: var(--text-color); }
  .home-intro-sub { margin-top: 0.55rem; font-size: 0.9rem; color: color-mix(in srgb, var(--text-color) 82%, transparent); }
  .hero-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 0.65rem;
    margin-top: 1rem;
  }
  .hero-specs > div {
    padding: 0.48rem 0.7rem;
    border-radius: 0.45rem;
    background: rgb(0 0 0 / 0.24);
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  .hero-specs dt { font-size: 0.67rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-color-muted); font-weight: 700; }
  .hero-specs dd { margin-top: 0.12rem; font-size: 0.83rem; font-weight: 680; color: var(--text-color); }

  .home-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.05rem; }
  .home-primary-link {
    display: inline-block;
    padding: 0.62rem 1.05rem;
    border-radius: 0.45rem;
    background: var(--primary);
    color: #06191e;
    font-weight: 750;
    font-size: 0.9rem;
  }
  .home-primary-link:hover { text-decoration: none; filter: brightness(1.08); }
  .home-secondary-link {
    display: inline-block;
    padding: 0.62rem 0.95rem;
    border-radius: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--primary) 42%, transparent);
    background: rgb(0 0 0 / 0.18);
    font-weight: 650;
    font-size: 0.9rem;
  }
  .hero-media :global(img) { width: 100%; height: auto; border-radius: 0.65rem; border: 1px solid rgb(255 255 255 / 0.1); }
  .hero-media figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.3rem 0.85rem;
    margin-top: 0.55rem;
    font-size: 0.77rem;
    color: var(--text-color-muted);
  }
  .hero-media figcaption a { font-weight: 700; white-space: nowrap; }

  .hero-status-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 0.78rem clamp(1.25rem, 2.6vw, 2rem);
    border-top: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 8%, rgb(0 0 0 / 0.25)), rgb(0 0 0 / 0.28));
    font-size: 0.85rem;
  }
  .hero-status-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
    min-width: 0;
  }
  .status-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    background: #34d399;
    box-shadow: 0 0 0 3px rgb(52 211 153 / 0.18);
    flex-shrink: 0;
  }
  .status-tag {
    font-size: 0.71rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--primary);
    white-space: nowrap;
  }
  .status-headline {
    font-weight: 650;
    color: color-mix(in srgb, var(--text-color) 92%, transparent);
  }
  .hero-status-link {
    font-weight: 700;
    font-size: 0.83rem;
    white-space: nowrap;
  }

  /* SECTION HEADERS */
  .open-section-header,
  .panel-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .open-section-header {
    padding: 0 0.15rem 0.65rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
  }
  .panel-section-header {
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
  }
  .open-section-header h2,
  .panel-section-header h2 { margin-top: 0.2rem; }
  .section-link { font-size: 0.88rem; font-weight: 680; white-space: nowrap; }

  /* ZONE 2: DARK RECESSED MEDIA STAGE */
  .home-stage {
    padding: clamp(1.2rem, 2.4vw, 1.7rem);
    border-radius: var(--radius-large);
    background: #070f13;
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
  }
  .stage-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.95rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.09);
  }
  .stage-eyebrow { text-transform: uppercase; letter-spacing: 0.09em; font-size: 0.71rem; font-weight: 750; color: #fcd34d; }
  .stage-header h2 { margin-top: 0.18rem; }
  .stage-all-link { font-size: 0.88rem; font-weight: 680; white-space: nowrap; }
  .stage-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: 0.9rem;
    align-items: stretch;
  }
  .stage-feature-video {
    display: flex;
    flex-direction: column;
    border-radius: 0.65rem;
    overflow: hidden;
    background: #0f191e;
    border: 1px solid rgb(255 255 255 / 0.09);
    min-width: 0;
  }
  .stage-feature-video video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    object-fit: cover;
  }
  .stage-feature-video figcaption {
    padding: 0.85rem 1.05rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
  }
  .stage-caption-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .stage-video-more { font-size: 0.78rem; font-weight: 680; }
  .stage-pill {
    display: inline-block;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    background: rgb(245 158 11 / 0.16);
    color: #fcd34d;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .stage-feature-video h3 { margin: 0.38rem 0 0.22rem; font-size: 1.02rem; }
  .stage-feature-video p { font-size: 0.84rem; color: var(--text-color-muted); line-height: 1.5; }

  .stage-tile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.75rem;
    min-width: 0;
  }
  .stage-tile {
    display: flex;
    flex-direction: column;
    border-radius: 0.6rem;
    overflow: hidden;
    background: #0f191e;
    border: 1px solid rgb(255 255 255 / 0.08);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
    min-width: 0;
  }
  .stage-tile:hover {
    text-decoration: none;
    border-color: color-mix(in srgb, var(--primary) 55%, transparent);
    background: #132128;
  }
  .stage-tile-thumb {
    background: #070d10;
    overflow: hidden;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .stage-tile-thumb :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .stage-tile.is-contain .stage-tile-thumb {
    padding: 0.25rem;
    background: #0b1419;
  }
  .stage-tile.is-contain .stage-tile-thumb :global(img) {
    object-fit: contain;
  }
  .stage-tile-copy {
    padding: 0.55rem 0.75rem 0.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
  }
  .stage-tile-badge {
