---
interface Props {
  heading?: string
  description?: string
  buttonLabel?: string
  href?: string
}

const {
  heading = 'Drive V1, V2 & V3 Live in Your Browser',
  description = 'Runs 500 Hz MuJoCo WASM, compiled ESP32-P4 C firmware, MicroDuck neural walking, and NeuralPose emotes across all three robots (V1, V2 & V3) in 6 playable 3D worlds — including the 19 m Robotics Lab, Yggdrasil, and PeerJS multiplayer rooms. Zero install required.',
  buttonLabel = 'Try the Simulator Now',
  href = 'https://simulator.ainek.io/',
} = Astro.props
---

<aside class="sim-cta not-prose" aria-label="Launch Ainekio 3D Web Simulator">
  <div class="sim-cta-body">
    <p class="sim-cta-eyebrow">
      <span class="sim-cta-dot" aria-hidden="true"></span>
      Live 3D Browser Simulator · simulator.ainek.io
    </p>
    <p class="sim-cta-heading">{heading}</p>
    <p class="sim-cta-desc">{description}</p>
  </div>
  <div class="sim-cta-actions">
    <a class="sim-cta-btn" href={href} target="_blank" rel="noopener noreferrer">
      <span>{buttonLabel}</span>
      <svg class="sim-cta-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </svg>
    </a>
    <span class="sim-cta-meta">Desktop &amp; Mobile WebGL · V1/V2/V3 · PeerJS Multiplayer · Body Control WS</span>
  </div>
</aside>

<style>
  .sim-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.15rem 1.6rem;
    margin: 1.5rem 0;
    padding: 1.35rem 1.5rem;
    border-radius: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--primary) 34%, transparent);
    border-left: 4px solid var(--primary);
    background: linear-gradient(
      115deg,
      color-mix(in srgb, var(--primary) 13%, var(--card-bg)),
      color-mix(in srgb, var(--card-bg) 96%, black)
    );
    box-shadow: 0 10px 28px -18px color-mix(in srgb, var(--primary) 45%, transparent);
  }

  .sim-cta-body {
    flex: 1 1 20rem;
    min-width: 0;
  }

  .sim-cta-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .sim-cta-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.22);
  }

  .sim-cta-heading {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    line-height: 1.25;
    font-weight: 800;
    color: var(--text-color);
  }

  .sim-cta-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--text-color) 82%, transparent);
  }

  .sim-cta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    flex: 0 0 auto;
  }

  .sim-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.95rem 1.7rem;
    border-radius: 0.65rem;
    background: var(--primary);
    color: #06181d !important;
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: 0 8px 22px -8px color-mix(in srgb, var(--primary) 75%, transparent);
    transition: transform 140ms ease, filter 140ms ease, box-shadow 140ms ease;
  }

  .sim-cta-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
    box-shadow: 0 12px 26px -8px color-mix(in srgb, var(--primary) 88%, transparent);
  }

  .sim-cta-btn:active {
    transform: translateY(0);
  }

  .sim-cta-arrow {
    font-size: 1.15em;
    line-height: 1;
  }

  .sim-cta-meta {
    font-size: 0.76rem;
    color: color-mix(in srgb, var(--text-color) 65%, transparent);
  }

  @media (max-width: 640px) {
    .sim-cta {
      padding: 1.15rem 1.1rem;
    }

    .sim-cta-actions,
    .sim-cta-btn {
      width: 100%;
    }
  }
</style>
