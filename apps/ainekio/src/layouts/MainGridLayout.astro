---
import SharedMainGridLayout from '@merkin/blog-core/layouts/MainGridLayout.astro'
import { getPageSocialImage } from '../lib/social-images'
import { url } from '../utils/url-utils'
const socialImage = await getPageSocialImage(Astro.props)
const { post, setOGTypeArticle } = Astro.props
const llmsHref = new URL(url('/llms.txt'), Astro.site ?? 'https://ainek.io').href
import '../styles/variables.styl'
import '../styles/main.css'
import '../styles/markdown.css'
import '../styles/markdown-extend.styl'
import '../styles/scrollbar.css'
import '../styles/transition.css'
---

<SharedMainGridLayout {...Astro.props} socialImage={socialImage}>
  <Fragment slot="head">
    <link rel="alternate" type="text/plain" title="Ainekio LLM Documentation" href={llmsHref} />
    {socialImage?.alt && <meta name="twitter:image:alt" content={socialImage.alt} />}
    {setOGTypeArticle && post?.data?.updated && (
      <meta property="article:modified_time" content={post.data.updated.toISOString()} />
    )}
    <slot name="head" />
  </Fragment>
  <slot />
</SharedMainGridLayout>
