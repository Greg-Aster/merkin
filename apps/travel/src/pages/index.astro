<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Greg Aster Trail Log — Archived</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: #0f1117;
        color: #e2e8f0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Georgia', 'Times New Roman', serif;
        padding: 2rem 1rem;
      }

      .card {
        max-width: 480px;
        text-align: center;
      }

      .label {
        font-family: monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #6d9f71;
        margin-bottom: 1.25rem;
      }

      h1 {
        font-size: clamp(1.4rem, 4vw, 2rem);
        font-weight: normal;
        color: #e2e8f0;
        margin-bottom: 1rem;
      }

      p {
        color: #8892a4;
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 2rem;
      }

      a {
        color: #6d9f71;
        text-decoration: none;
        font-size: 0.85rem;
      }

      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="label">Archived</div>
      <h1>Greg Aster Trail Log</h1>
      <p>This site has been archived and is no longer active.</p>
      <a href="https://dndiy.org">← dndiy.org</a>
    </div>
  </body>
</html>
