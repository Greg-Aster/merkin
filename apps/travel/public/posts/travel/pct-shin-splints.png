    margin-right: 10px;
    color: #026559;
    background-color: #F9D95F;
    font-weight: 600;
}
.ser-pg-but a:hover {
    background: #026559;
    color: #F9D95F;
}
a.serv-but-book {
    background: #026559;
    color: #F9D95F;
}
a.serv-but-book:hover {
    background: #F9D95F;
    color: #026559;
}
.ser-pg-but {
    margin-top: 20px;
}
@media screen and (min-width:767px) {
.colm-2 {
    column-count: 2;
}
}

.bg-blc {
    background: #161616;
}
		</style>
