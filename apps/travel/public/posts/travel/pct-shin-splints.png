<style type="text/css">
@media screen and (min-width: 1024px) {
.clean-header .logo1, .custom-logo .logo1 {
    max-height: 70px;
    width: 100%;
}
}

@media screen and (max-width: 500px) {
.img-slide-height img {
    height: 300px !important;
    object-fit: cover;
}	
}

input#gform_submit_button_2 {
    font-family: "Heebo", Sans-serif;
    font-size: 13px;
    border-color: #fbdb60;
    text-transform: uppercase;
    font-weight: 700;
    color: #fff;
    background: #fbdb60;
}

input#gform_submit_button_2:hover {
    border-color: #fbdb60;
    background: #fff;
    color: #fbdb60;
}
div#gform_confirmation_message_2 {
    color: #026559;
    font-weight: 700;
    border: 3px solid;
    padding: 10px 20px;
}
textarea#input_2_5 {
    height: 150px;
}

.img-slide-height img {
    height: 450px;
    object-fit: cover;
}
div#gform_confirmation_wrapper_1 {
    text-align: center;
    border: 2px solid #03a84e;
    padding: 10px;
}
input#gform_submit_button_1 {
    background: #03665a;
    color: #ffde5f;
    text-transform: uppercase;
    font-weight: 600;
    width: 220px;
    height: 58px;
    font-size: 22px;
    margin: auto;
    margin-top: 30px;
}
input#gform_submit_button_1:hover {
    color: #03665a;
    background: #ffde5f;
}
.img-overlay .elementor-background-overlay {
    background: #000;
}
.slider > .slide {
    opacity: 1 !important;
}
.slider>.slide {
    opacity: 1 !important;	
}
div#my-tab .elementor-tab-title a {
    color: #000;
}
div#my-tab .elementor-tab-desktop-title.elementor-active a {
    color: #fff;
}

#my-tab h4 {
    color: #fff;
}
.col-md-4.sidebar {
    display: none;
}
.blog-content.col-md-8 {
    width: 100%;
}
.post img.full-size-img.wp-post-image {
    display: none;
    width: 100% !important;
    height: 400px;
    object-fit: cover;
}
.post .blogtitle-box.clearfix {
    display: none;
}
.post .spacing30 {
    display: none;
}
.content.blog-wrapper {
    padding-top: 0px;
}
h1.blog-title {
    font-size: 32px;
}
.post h2, .post h3 {
    font-size: 22px;
}
.related-inner.clerfix {
    background: #f8f8f8;
}
div#respond {
    display: none !important;
}
.img-pagination {
    padding-top: 0;
    margin-bottom: 0;
}
div#search-2 {
    box-shadow: 7px 7px 10px 0px rgb(0 0 0 / 50%);
    padding-bottom: 0;
}
.searchform .search-input-form {
    padding: 8px 20px;
}
span.rpwwt-post-title {
    font-weight: 700 !important;
}

.mobile-hd-bg h2 {
    background: black;
    padding: 10px;
    display: inline-block;
    color: #fff !important;
}


/*refferral form fields start*/
input#input_1_3, input#input_1_4, input#input_1_6, input#input_1_5, input#input_1_7, input#input_1_23, input#input_1_8, input#input_1_9, textarea#input_1_11, input#input_1_13, input#input_1_14, input#input_1_15, input#input_1_16, input#input_1_17, input#input_1_18, input#input_1_20, input#input_1_21, input#input_1_22 {
    color: black;
    font-weight: 400;
}
input#input_1_3::placeholder, input#input_1_4::placeholder, input#input_1_6::placeholder, input#input_1_5::placeholder, input#input_1_7::placeholder, input#input_1_23::placeholder, input#input_1_8::placeholder, input#input_1_9::placeholder, textarea#input_1_11::placeholder, input#input_1_13::placeholder, input#input_1_14::placeholder, input#input_1_15::placeholder, input#input_1_16::placeholder, input#input_1_17::placeholder, input#input_1_18::placeholder, input#input_1_20::placeholder, input#input_1_21::placeholder, input#input_1_22::placeholder {
    color: black;
    font-weight: 400;
}
/*refferral form fields end*/


@media screen and (max-width: 600px) {
.post img.full-size-img.wp-post-image {
    height: 175px;
}
.spacing30.clearfix {
    height: 0px;
}  
.to-top.fixed {
    opacity: 1;
    bottom: 55px;
    right: 10px;
}  
}
@media screen and (max-width: 768px) {
.mob-shadow {
    box-shadow: 0 0 10px #00000080;
}
}

@media screen and (min-width: 767px) {
.line-limit-5 {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    -webkit-box-orient: vertical;
}
.pgafu-post-short-content {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3 !important;
    line-clamp: 3;
    -webkit-box-orient: vertical;
}
.sec-box-height .text-wline {
    min-height: 465px;
}
.three-col-ul ul {
    columns: 4;
}
.col-two ul {
    columns: 2;
}  
}


/*Post Grid Blog filter Style*/
.pgafu-filter li.pgafu-active-filtr a {
    background-color: #1f1f1f;
    color: #fff !important;
}
ul#pgafu-filtr-1 {
    margin-bottom: 50px;
}
.pgafu-filter li a:hover {
    background: #1f1f1f;
    color: #fff !important;
}
.pgafu-filter li a {
    background: #fff;
    padding: 7px 20px;
    margin: 0 10px;
    text-decoration: none!important;
    position: relative;
    transform: scale(1);
    transition: .15s all ease;
    color: #1f1f1f !important;
    box-shadow: none!important;
    border-radius: 3px;
    font-weight: 600;
    border: 1px solid #1f1f1f;
    text-transform: uppercase;
}

h2.pgafu-post-title {
    border-bottom: 1px solid #e8e8e8;
    padding-bottom: 15px !important;
}
.pgafu-post-grid-main.pgafu-design-1 .pgafu-post-grid-content {
    background: #fff;
    text-align: left;
    border: 1px solid #e8e8e8;
}
.pgafu-post-grid-main h2.pgafu-post-title a {
    font-size: 16px !important;
    line-height: normal !important;
    font-weight: 600;
    color: #000;
}
.pgafu-post-categories {
    display: none;
}
