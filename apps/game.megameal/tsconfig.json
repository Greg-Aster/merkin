{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engine/*": ["src/engine/*"],
      "@editor/*": ["src/editor/*"],
      "@game/*": ["src/game/*"],
      "@global/*": ["src/global/*"],
      "@levels/*": ["src/levels/*"],
      "@ui/*": ["src/ui/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*.mjs", "scripts/**/*.ts"]
}
