{
	"name": "@merkin/game-megameal",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.14.4",
	"dependencies": {
		"@astrojs/svelte": "7.2.5",
		"@dimforge/rapier3d-compat": "0.17.3",
		"@merkin/megameal-engine": "workspace:*",
		"astro": "5.18.0",
		"mermaid": "^11.16.0",
		"peerjs": "^1.5.5",
		"svelte": "5.26.2",
		"three": "0.178.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm check:static-environment-collision && pnpm type-check && astro build",
		"preview": "astro preview",
		"type-check": "astro check && tsc --noEmit",
		"audit:protected-docs": "node ./scripts/audit-protected-doc-edits.mjs",
		"audit:engine-boundaries": "node ./scripts/audit-protected-doc-edits.mjs && node ./scripts/audit-engine-boundaries.mjs",
		"test:input-contract": "tsx ./scripts/test-input-contract.ts",
		"test:charged-action-contract": "tsx ./scripts/test-charged-action-contract.ts",
		"test:story-note-contract": "tsx ./scripts/test-story-note-contract.ts",
		"test:scene-environment-contract": "tsx ./scripts/test-scene-environment-contract.ts",
		"test:runtime-scene-contract": "tsx ./scripts/test-runtime-scene-contract.ts",
		"test:material-parameter-contract": "tsx ./scripts/test-material-parameter-contract.ts",
		"test:player-package-contract": "tsx ./scripts/test-player-package-contract.ts",
		"test:npc-contract": "tsx ./scripts/test-npc-contract.ts",
		"test:multiplayer-contract": "tsx ./scripts/test-multiplayer-contract.ts",
		"test:performance-collision-contract": "tsx ./scripts/test-performance-collision-contract.ts",
		"test:performance-config-contract": "tsx ./scripts/test-performance-config-contract.ts",
		"test:performance-culling-contract": "tsx ./scripts/test-performance-culling-contract.ts",
		"test:performance-diagnostics-contract": "tsx ./scripts/test-performance-diagnostics-contract.ts",
		"test:performance-lod-contract": "tsx ./scripts/test-performance-lod-contract.ts",
		"test:performance-runtime-contract": "tsx ./scripts/test-performance-runtime-contract.ts",
		"test:performance-streaming-contract": "tsx ./scripts/test-performance-streaming-contract.ts",
		"test:level-editor-workspace-contract": "tsx ./scripts/test-level-editor-workspace-contract.ts",
		"test:collision-overlay-contract": "tsx ./scripts/test-collision-overlay-contract.ts",
		"test:static-environment-collision-contract": "tsx ./scripts/test-static-environment-collision-contract.ts",
		"cook:static-environment-collision": "tsx ./scripts/cook-static-environment-collision.ts",
		"check:static-environment-collision": "tsx ./scripts/cook-static-environment-collision.ts --level=observatory --check",
		"generate:portal-field-glb": "node ./scripts/generate-portal-field-glb.mjs",
		"lint": "biome check ./src ./scripts",
		"format": "biome format --write ./src ./scripts"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@biomejs/biome": "1.8.3",
		"@types/node": "25.3.0",
		"@types/three": "0.176.0",
		"tsx": "4.21.0",
		"typescript": "^5.7.3"
	}
}
