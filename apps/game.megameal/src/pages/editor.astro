---
import { readFile } from "node:fs/promises";
import type { LevelEditorSessionSummary } from "../app/editor/levelEditorSession.js";

const title = "Megameal Level Editor";
const isDevEditor = import.meta.env.DEV;
const selectedRuntimeSceneId = Astro.url.searchParams.get("scene") ?? undefined;
let editorCss: string | undefined;
let editorSummary: LevelEditorSessionSummary | undefined;

if (isDevEditor) {
	editorCss = await readFile(new URL("../styles/editor.css", import.meta.url), {
		encoding: "utf8",
	});
	const editorModule = await import("../app/editor/levelEditorSession.js");
	editorSummary = editorModule.getDefaultLevelEditorSessionSummary(
		selectedRuntimeSceneId === undefined ? {} : { selectedRuntimeSceneId },
	);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Megameal game engine level editor development shell."
		/>
		<title>{title}</title>
		{isDevEditor && editorCss ? <style set:html={editorCss} /> : null}
	</head>
	<body>
		<main class="editor-shell">
			{
				isDevEditor && editorSummary ? (
					<div
						data-level-editor-workspace
						data-editor-session={JSON.stringify(editorSummary)}
					/>
				) : (
					<section class="editor-panel" aria-label="Level editor unavailable">
						<p>Level editor disabled outside development mode.</p>
					</section>
				)
			}
		</main>
		{
			isDevEditor && editorSummary ? (
				<script>
					if (import.meta.env.DEV) {
						void (async () => {
							const target = document.querySelector(
								"[data-level-editor-workspace]",
							);

							if (!(target instanceof HTMLElement)) {
								return;
							}

							let serializedEditorSession =
								target.getAttribute("data-editor-session");

							if (serializedEditorSession === null) {
								return;
							}

							const requestedRuntimeSceneId = new URL(
								globalThis.location.href,
							).searchParams.get("scene");
							const serverEditorSession = JSON.parse(serializedEditorSession) as {
								readonly selectedRuntimeSceneId?: string;
							};

							const [{ mount }, workspaceModule, sessionModule] = await Promise.all([
								import("svelte"),
								import("../app/editor/LevelEditorWorkspace.svelte"),
								import("../app/editor/levelEditorSession.js"),
							]);

							if (
								requestedRuntimeSceneId &&
								requestedRuntimeSceneId !==
									serverEditorSession.selectedRuntimeSceneId
							) {
								serializedEditorSession = JSON.stringify(
									sessionModule.getDefaultLevelEditorSessionSummary({
										selectedRuntimeSceneId: requestedRuntimeSceneId,
									}),
								);
								target.setAttribute(
									"data-editor-session",
									serializedEditorSession,
								);
							}

							const LevelEditorWorkspace =
								workspaceModule.default as unknown as import("svelte").Component<{
									serializedEditorSession: string;
								}>;

							mount(LevelEditorWorkspace, {
								target,
								props: {
									serializedEditorSession,
								},
							});
						})();
					}
				</script>
			) : null
		}
	</body>
</html>
