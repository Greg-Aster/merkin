---
interface Props {
  title?: string
  description?: string
  lang?: string
}

const {
  title = 'Star Observatory — MegaMeal Navigator',
  description = 'Navigate through cosmic time in your beat-up spaceship, discovering the lost stories of the MegaMeal universe.',
  lang = 'en',
} = Astro.props
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #000;
      }
      #game-viewport {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        z-index: 0;
      }
    </style>
  </head>
  <body>
    <div id="game-viewport">
      <slot />
    </div>
  </body>
</html>
