{
  "name": "@merkin/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev": "pnpm dev:app",
    "dev:app": "node ./scripts/dev-app.mjs",
    "dev:manual-refresh": "GAME_DEV_MANUAL_REFRESH=1 GAME_DEV_AUTO_PORT=1 pnpm dev:app",
    "build": "astro build && node -e \"require('node:fs').rmSync('dist/_redirects',{force:true})\"",
    "test:publish-pipeline": "tsx ./scripts/test-publish-pipeline.ts",
    "test:style-bake-products": "tsx ./scripts/test-style-bake-products.ts",
    "test:collision-manager": "tsx ./scripts/test-collision-manager.ts && tsx ./scripts/test-collision-manager-product.ts && tsx ./scripts/test-collision-policy-contract.ts",
    "test:collision-manager-product": "tsx ./scripts/test-collision-manager-product.ts",
    "test:asset-local-transform": "tsx ./scripts/test-asset-local-transform-contract.ts",
    "test:asset-trimesh-collider": "tsx ./scripts/test-asset-trimesh-collider-geometry.ts",
    "test:mesh-collider-bake": "node ./scripts/test-mesh-collider-bake.mjs",
    "smoke:engine": "node ./scripts/smoke-check.mjs",
    "smoke:boot": "node ./scripts/boot-check.mjs",
    "smoke:boot:firefox": "node ./scripts/boot-check.mjs --browser=firefox",
    "smoke:editor-ux": "node ./scripts/editor-ux-smoke.mjs",
    "smoke:visual": "node ./scripts/visual-smoke.mjs",
    "smoke:visual:firefox": "node ./scripts/visual-smoke.mjs --browser=firefox",
    "baseline:visual": "node ./scripts/visual-smoke.mjs",
    "baseline:visual:update": "node ./scripts/visual-smoke.mjs --update-baselines --write-artifacts",
    "release:gate": "node ./scripts/release-gate.mjs",
    "release:gate:quick": "node ./scripts/release-gate.mjs --profile=quick",
    "release:gate:ci": "node ./scripts/release-gate.mjs --profile=ci",
    "release:gate:browser": "node ./scripts/release-gate.mjs --profile=browser",
    "check:generated-drift": "node ./scripts/check-generated-drift.mjs",
    "audit:runtime-purity": "node ./scripts/audit-runtime-purity.mjs",
    "audit:engine": "node ./scripts/audit-engine-architecture.mjs && tsx ./scripts/audit-collision-review.ts && node ./scripts/audit-chunk-ownership.mjs && node ./scripts/bake-runtime-prefabs.mjs && node ./scripts/audit-runtime-purity.mjs && node ./scripts/audit-engine-pillars.mjs",
    "audit:collision": "tsx ./scripts/audit-collision-review.ts",
    "audit:engine-pillars": "node ./scripts/audit-engine-pillars.mjs",
    "audit:runtime-assets": "node ./scripts/cook-runtime-assets.mjs",
    "audit:runtime-prefabs": "node ./scripts/bake-runtime-prefabs.mjs",
    "cook:runtime-assets": "node ./scripts/cook-runtime-assets.mjs --write-manifest --cook",
    "bake:runtime-prefabs": "node ./scripts/bake-runtime-prefabs.mjs --write",
    "cook:runtime-assets:low": "node ./scripts/cook-runtime-assets.mjs --write-manifest --cook --tier=low",
    "cook:runtime-assets:medium": "node ./scripts/cook-runtime-assets.mjs --write-manifest --cook --tier=medium",
    "cook:runtime-assets:high": "node ./scripts/cook-runtime-assets.mjs --write-manifest --cook --tier=high",
    "cook:runtime-assets:build": "node ./scripts/cook-runtime-assets.mjs --write-manifest --cook",
    "author:pbr:yggdrasil-bifrost-ribbon": "node ./scripts/author-yggdrasil-bifrost-ribbon-pbr.mjs",
    "author:pbr:yggdrasil-crown": "node ./scripts/author-yggdrasil-crown-pbr.mjs",
    "author:pbr:weathered-monolith": "node ./scripts/author-weathered-monolith-pbr.mjs",
    "bake:style-asset": "node ./scripts/bake-style-asset.mjs",
    "report:graphics-backlog": "node ./scripts/report-aaa-graphics-content-backlog.mjs",
    "report:graphics-backlog:write": "node ./scripts/report-aaa-graphics-content-backlog.mjs --write",
    "cook:world-partition": "node ./scripts/cook-world-partition.mjs",
    "baseline:performance": "node ./scripts/performance-baseline.mjs",
    "baseline:performance:firefox": "node ./scripts/performance-baseline.mjs --browser=firefox",
    "baseline:performance:strict": "node ./scripts/performance-baseline.mjs --strict",
    "certify:performance": "node ./scripts/performance-baseline.mjs --certification --write-json=reports/performance-certification-report.json",
    "certify:performance:strict": "node ./scripts/performance-baseline.mjs --certification --strict --write-json=reports/performance-certification-report.json",
    "certify:performance:all-levels": "node ./scripts/performance-baseline.mjs --certification --coverage=all-level-reporting --write-json=reports/performance-all-level-report.json",
    "profile:resources": "node ./scripts/profile-level-resources.mjs",
    "profile:resources:all-levels": "node ./scripts/profile-level-resources.mjs --levels=miranda,observatory,sci-fi-room,solitude,yggdrasil",
    "profile:resources:strict": "node ./scripts/profile-level-resources.mjs --strict",
    "bake:mesh-collider": "node ./scripts/bake-mesh-collider.mjs",
    "bake:scene-mesh-colliders": "node ./scripts/bake-scene-mesh-colliders.mjs",
    "bake:terrain-collision": "node ./scripts/bake-terrain-collision.mjs",
    "cook:terrain-chunks": "node ./scripts/cook-terrain-chunks.mjs",
    "cook:terrain-glb-chunks": "node ./scripts/cook-terrain-glb-chunks.mjs",
    "generate:terrain-heightmap": "node ./scripts/generate-terrain-heightmap.mjs",
    "profile:three-runtime": "node ./scripts/profile-three-runtime.mjs",
    "blender:addon:package": "node ./scripts/package-blender-addon.mjs",
    "blender:scene:export": "node ./scripts/export-blender-scene-package.mjs",
    "blender:scene:import": "node ./scripts/import-blender-scene-delta.mjs",
    "audit:chunks": "node ./scripts/audit-chunk-ownership.mjs",
    "preview": "astro preview",
    "type-check": "tsc --noEmit",
    "format": "biome format --write ./src",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src"
  },
  "dependencies": {
    "@astrojs/svelte": "7.0.3",
    "@astrojs/tailwind": "^5.1.5",
    "@dimforge/rapier3d": "0.17.3",
    "@dimforge/rapier3d-compat": "^0.17.3",
    "@merkin/blog-core": "workspace:*",
    "@merkin/shared-audio": "workspace:*",
    "@merkin/shared-data": "workspace:*",
    "@threlte/core": "8.1.3",
    "@threlte/extras": "9.4.2",
    "@threlte/rapier": "3.1.4",
    "@threlte/theatre": "3.0.4",
    "astro": "5.1.6",
    "bitecs": "^0.3.40",
    "howler": "^2.2.4",
    "lil-gui": "^0.20.0",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.37.6",
    "stats.js": "^0.17.0",
    "svelte": "5.26.2",
    "tailwindcss": "^3.4.17",
    "three": "^0.178.0",
    "threlte-postprocessing": "^0.0.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/ts-plugin": "^1.10.4",
    "@biomejs/biome": "1.8.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/three": "^0.176.0",
    "playwright": "1.59.1",
    "tsx": "4.21.0",
    "typescript": "^5.7.3",
    "vite-plugin-wasm": "^3.4.1"
  }
}
