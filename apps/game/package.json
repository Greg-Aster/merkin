{
	"name": "@merkin/game",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.14.4",
	"scripts": {
		"sync:onnx-runtime": "node ./scripts/sync-onnx-runtime.mjs",
		"dev": "concurrently -k -n game,tools -c magenta,cyan \"pnpm dev:app\" \"pnpm dev:tools\"",
		"dev:app": "pnpm sync:onnx-runtime && astro dev --port 4322",
		"dev:tools": "node ../../tools/legacy-megameal-tools/app.cjs",
		"build": "pnpm sync:onnx-runtime && astro build && rm -f dist/_redirects",
		"preview": "astro preview",
		"type-check": "tsc --noEmit",
		"format": "biome format --write ./src",
		"lint": "biome check --apply ./src"
	},
	"dependencies": {
		"@astrojs/svelte": "7.0.3",
		"@astrojs/tailwind": "^5.1.5",
		"@dimforge/rapier3d": "0.17.3",
		"@dimforge/rapier3d-compat": "^0.17.3",
		"@merkin/blog-core": "workspace:*",
		"@merkin/shared-audio": "workspace:*",
		"@merkin/shared-data": "workspace:*",
		"@threlte/core": "8.1.3",
		"@threlte/extras": "9.4.2",
		"@threlte/rapier": "3.1.4",
		"@threlte/theatre": "3.0.4",
		"astro": "5.1.6",
		"bitecs": "^0.3.40",
		"canvas": "^3.1.2",
		"howler": "^2.2.4",
		"lil-gui": "^0.20.0",
		"onnxruntime-web": "^1.24.3",
		"peerjs": "^1.5.5",
		"postprocessing": "^6.37.6",
		"stats.js": "^0.17.0",
		"svelte": "5.26.2",
		"tailwindcss": "^3.4.17",
		"three": "^0.178.0",
		"threlte-postprocessing": "^0.0.10"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@astrojs/ts-plugin": "^1.10.4",
		"@biomejs/biome": "1.8.3",
		"@tailwindcss/typography": "^0.5.16",
		"@types/three": "^0.176.0",
		"typescript": "^5.7.3",
		"vite-plugin-wasm": "^3.4.1"
	}
}
