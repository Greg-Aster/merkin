{
	"name": "@merkin/megameal",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "pnpm --filter @merkin/shared-data build && astro build && node scripts/audit-built-html.mjs --dist dist && pagefind --site dist --root-selector \"[data-pagefind-body]\"",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit",
		"audit:links": "node scripts/audit-links.mjs --dist dist",
		"audit:contracts": "node scripts/audit-site-contracts.mjs",
		"audit:css": "node scripts/audit-css-architecture.mjs --all",
		"audit:css:changed": "node scripts/audit-css-architecture.mjs --changed",
		"audit:css:strict": "node scripts/audit-css-architecture.mjs --changed --strict",
		"generate:home-intro-stills": "node scripts/generate-home-intro-stills.mjs",
		"format": "biome format --write ./src",
		"lint": "biome check ./src",
		"lint:fix": "biome check --write ./src",
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.4",
		"@astrojs/mdx": "^4.1.0",
		"@astrojs/rss": "^4.0.11",
		"@astrojs/sitemap": "^3.2.1",
		"@astrojs/svelte": "7.2.5",
		"@astrojs/tailwind": "^5.1.5",
		"@fontsource-variable/jetbrains-mono": "^5.1.2",
		"@fontsource/creepster": "^5.2.7",
		"@fontsource/metal-mania": "^5.2.7",
		"@fontsource/roboto": "^5.1.1",
		"@fontsource/sriracha": "^5.1.1",
		"@iconify-json/fa6-brands": "^1.2.5",
		"@iconify-json/fa6-regular": "^1.2.3",
		"@iconify-json/fa6-solid": "^1.2.3",
		"@iconify-json/material-symbols": "^1.2.14",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/svelte": "^5.0.0",
		"@merkin/blog-core": "workspace:*",
		"@merkin/shared-audio": "workspace:*",
		"@merkin/shared-content": "workspace:*",
		"@tailwindcss/typography": "^0.5.16",
		"@threlte/core": "8.1.3",
		"@types/chart.js": "^4.0.1",
		"astro": "5.18.0",
		"astro-compress": "^2.3.6",
		"astro-icon": "^1.1.5",
		"astro-seo": "^0.8.4",
		"chart.js": "^4.5.0",
		"hastscript": "^9.0.0",
		"howler": "^2.2.4",
		"katex": "^0.16.21",
		"markdown-it": "^14.1.0",
		"marked": "^15.0.7",
		"mdast-util-to-string": "^4.0.0",
		"overlayscrollbars": "^2.10.1",
		"pagefind": "^1.3.0",
		"peerjs": "^1.5.5",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^3.0.1",
		"remark-directive-rehype": "^0.4.2",
		"remark-github-admonitions-to-directives": "^1.0.5",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.14.0",
		"sharp": "^0.33.5",
		"stylus": "^0.63.0",
		"svelte": "5.26.2",
		"tailwindcss": "^3.4.17",
		"three": "^0.178.0",
		"typescript": "^5.7.3",
		"unist-util-visit": "^5.0.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.4",
		"@biomejs/biome": "1.8.3",
		"@iconify-json/famicons": "^1.2.0",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/peerjs": "^1.1.0",
		"@types/sanitize-html": "^2.13.0",
		"@types/three": "^0.176.0",
		"ktx2tools": "1.1.0",
		"postcss-import": "^16.1.0",
		"postcss-nesting": "^13.0.1",
		"svelte-preprocess": "^6.0.3"
	},
	"packageManager": "pnpm@9.14.4"
}
