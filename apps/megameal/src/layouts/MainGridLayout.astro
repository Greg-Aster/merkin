---
import fs from 'node:fs'
import path from 'node:path'
import '@fontsource/creepster'
import '@fontsource/metal-mania'
import {
  connectionPatterns,
  constellationConfig,
  constellationPatterns,
  defaultEraConfig,
} from '@/config/timelineconfig'
import Bleepy from '@components/bleepy/Bleepy.astro'
import CompactArchiveBanner from '@components/archive/CompactArchiveBanner.astro'
import SiteSfxBridge from '@components/client/SiteSfxBridge.svelte'
import LegacyTimelineBanner from '@components/timeline/TimelineBanner.astro'
import TimelinePortalCarousel from '@components/timeline/TimelinePortalCarousel.svelte'
import UniverseHeroSlide from '@components/home/UniverseHeroSlide.astro'
import SharedMainGridLayout from '@merkin/blog-core/layouts/MainGridLayout.astro'
import timelineManifest from '../../../../packages/shared-data/generated/timeline.json'
import '@/styles/features/banner/banner-base.css'
import '@/styles/features/banner/banner-billboards.css'
import '@/styles/features/banner/banner-title-display.css'
import '@/styles/features/banner/banner-responsive.css'
import '@/styles/features/interactions.css'

interface Props {
  title?: string
  banner?: string
  description?: string
  lang?: string
  setOGTypeArticle?: boolean
  headings?: import('astro').MarkdownHeading[]
  post?: unknown
  bannerLink?: string
  isPostPage?: boolean
  pageMascotContext?: string
  backgroundImage?: string | null
  oneColumn?: boolean
  customAuthorData?: {
    avatarImage?: string
    authorName?: string
    authorBio?: string
    authorLink?: string
  }
  homeLayout?: 'default' | 'portal' | 'test-portal'
  contentMode?: 'default' | 'banner-only'
  showMascot?: boolean
  showAssistantWidget?: boolean
  timelineEvents?: unknown[]
  timelineEraConfig?: Record<string, unknown>
  timelineConstellationConfig?: Record<string, unknown>
  timelineConstellationPatterns?: Record<string, unknown>
  timelineConnectionPatterns?: Record<string, unknown>
}

const isTestPortalLayout = Astro.props.homeLayout === 'test-portal'
const sharedHomeLayout: 'default' | 'portal' | undefined = isTestPortalLayout
  ? 'portal'
  : Astro.props.homeLayout === 'test-portal'
    ? undefined
    : Astro.props.homeLayout
const hasCustomBannerSlideContent = Astro.slots.has('banner-slide-content')
const hasCustomBannerOverlayContent = Astro.slots.has('banner-overlay-content')
const normalizedPath = Astro.url.pathname.replace(/\/$/, '')
const isTimelineRoute = normalizedPath === '/timeline'
const isTimeline2DRoute = normalizedPath === '/timeline/2d'
const originalPost = Astro.props.post as
  | ({ data?: { bannerType?: string } } & Record<string, unknown>)
  | undefined
const isContentPost = Astro.props.isPostPage === true && Boolean(originalPost)
const layoutPost = originalPost
const postSourcePath =
  isContentPost && typeof (originalPost as any)?.id === 'string'
    ? path.join(
        process.cwd(),
        'src',
        'content',
        'posts',
        (originalPost as any).id,
      )
    : ''
const rawPostFrontmatter =
  postSourcePath && fs.existsSync(postSourcePath)
    ? (fs.readFileSync(postSourcePath, 'utf8').split('---')[1] ?? '')
    : ''
const postRequestsVisibleSidebar =
  /^\s*oneColumn:\s*false\s*(?:#.*)?$/m.test(rawPostFrontmatter)
const resolvedOneColumn = isContentPost
  ? !postRequestsVisibleSidebar
  : Astro.props.oneColumn
const usesArchiveBanner =
  !isContentPost && layoutPost?.data?.bannerType === 'archive'
const sharedProps: Omit<Props, 'homeLayout'> & {
  homeLayout?: 'default' | 'portal'
} = {
  ...Astro.props,
  post: layoutPost,
  homeLayout: sharedHomeLayout,
  oneColumn: resolvedOneColumn,
  contentMode: isTestPortalLayout ? 'banner-only' : Astro.props.contentMode,
}
---

<SharedMainGridLayout
  {...sharedProps}
  timelineEvents={timelineManifest.items}
  timelineEraConfig={defaultEraConfig}
  timelineConstellationConfig={constellationConfig}
  timelineConstellationPatterns={constellationPatterns}
  timelineConnectionPatterns={connectionPatterns}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <script>
    import { initMegamealRouteTransitions } from '@/utils/megamealRouteTransitions'

    initMegamealRouteTransitions()
  </script>
  <slot />
  <SiteSfxBridge client:load />
  <!-- MEGAMEAL-specific: Bleepy AI assistant mascot -->
  {Astro.props.showMascot && (
    <Fragment slot="mascot">
      <Bleepy mascotContext={Astro.props.pageMascotContext} instanceIdentifier="LAYOUT_BLEEPY" />
    </Fragment>
  )}
  {hasCustomBannerOverlayContent && (
    <Fragment slot="banner-overlay-content">
      <slot name="banner-overlay-content" />
    </Fragment>
  )}
  <Fragment slot="overlay">
    <slot name="overlay" />
  </Fragment>
  {(isTimelineRoute || isTimeline2DRoute) && (
    <Fragment slot="timeline-banner-content">
      {isTimelineRoute ? (
        <>
          <div id="megameal-timeline-route-marker" hidden></div>
          <TimelinePortalCarousel
            events={timelineManifest.items}
            eraConfig={defaultEraConfig}
            client:only="svelte"
          />
        </>
      ) : (
        <div class="relative h-full w-full">
          <LegacyTimelineBanner
            id="megameal-legacy-timeline"
            bannerHeight="100%"
            mobileHeight="100%"
            compact={false}
          />
          <a
            href="/timeline/"
            class="absolute bottom-4 left-1/2 z-20 -translate-x-1/2 rounded-lg border border-cyan-100/25 bg-slate-950/78 px-4 py-2 font-mono text-[0.68rem] font-black uppercase tracking-[0.18em] text-cyan-100 shadow-[0_0_1.2rem_rgba(8,145,178,0.24)] backdrop-blur-md transition hover:border-cyan-100/55 hover:bg-cyan-950/78 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-200"
          >
            3D
          </a>
        </div>
      )}
    </Fragment>
  )}
  {hasCustomBannerSlideContent ? (
    <Fragment slot="banner-slide-content">
      <slot name="banner-slide-content" />
    </Fragment>
  ) : usesArchiveBanner ? (
    <Fragment slot="banner-slide-content">
      <CompactArchiveBanner post={layoutPost as any} />
    </Fragment>
  ) : (
    <Fragment slot="banner-slide-content">
      <UniverseHeroSlide />
    </Fragment>
  )}
</SharedMainGridLayout>
