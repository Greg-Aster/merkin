---
import SharedLayout from '@merkin/blog-core/layouts/Layout.astro'
import SiteArrivalStatus from '../components/client/SiteArrivalStatus.astro'
import SiteAudioRuntime from '../components/client/SiteAudioRuntime.svelte'
import SiteSfxBridge from '../components/client/SiteSfxBridge.svelte'
import { siteStyleHref } from '../styles/site'
---

<SharedLayout {...Astro.props}>
  <Fragment slot="head">
    <SiteArrivalStatus part="styles" />
    <link rel="stylesheet" href={siteStyleHref} data-site-style />
    <slot name="head" />
  </Fragment>
  <SiteArrivalStatus part="status" />
  <slot />
  <SiteAudioRuntime client:load />
  <SiteSfxBridge client:load />
</SharedLayout>

<script>
  import { initMegamealRouteTransitions } from '@/utils/megamealRouteTransitions'

  initMegamealRouteTransitions()
</script>
