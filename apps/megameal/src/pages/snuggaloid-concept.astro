---
import ImageWrapper from '../components/misc/ImageWrapper.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'

const title = 'Snuggaloid Brief'
const description =
  'A concise artist brief for making physical Snuggaloid plush artifacts for the MegaMeal archive.'

const references = [
  {
    label: 'Store',
    title: 'Snuggaloids listing',
    href: '/store/snuggaloids/',
  },
  {
    label: 'Lore',
    title: 'The Snuggloid Emergence',
    href: '/posts/timelines/snuggaliod-emergence/',
  },
  {
    label: 'Commercial',
    title: 'Recovered companion ad',
    href: '/posts/timelines/snuggloids-commercial/',
  },
  {
    label: 'Owner file',
    title: 'Registered owner dossier',
    href: '/about/snuggloid-owner/',
  },
  {
    label: 'Video',
    title: 'Companion Program commercial',
    href: 'https://www.youtube.com/watch?v=n_cgEvkZ-U0',
  },
  {
    label: '3D',
    title: 'Bonded-unit scan',
    href: '/models/snuggaliod/Fur.glb',
  },
]

const buildSpecs = [
  [
    'Object type',
    "Collectible art plush / mixed-media creature, not a children's toy.",
  ],
  [
    'Scale',
    'Small hand-scale body; palm-sized to shelf-sized for the first demo batch.',
  ],
  ['Body', 'Furry, colorful, multihued, tactile, and handmade-looking.'],
  [
    'Variation',
    'Each one should be unique: some simple puffs, some with mutations.',
  ],
  [
    'Features',
    'Possible beaks, bead eyes, antlers, horns, mustaches, tiny limbs, teeth, tags, or asymmetry.',
  ],
  ['Handling', 'Durable enough to photograph, handle, ship, and archive.'],
]

const shleemSpecs = [
  [
    'Feel',
    'Squishy, dense, weighted, and strange in the hand. Avoid plain loose teddy-bear stuffing, no loose sharp, leaking, breakable, powdery. Seal risky items separately.',
  ],
]

const internalArtifacts = [
  'QR code or web address for a mini quest, puzzle, hidden page, or archive entry, 3D printed organs, teeth, bones, glands, charms, or fake anatomy, one single unexplained puzzle piece, buyer-specific photo or location artifact, only with explicit opt-in and no exposed address, in-world factory note written by a child worker saying working conditions are good, second in-world note saying friends have gone missing and the writer is worried, condom, OB tampon, toe, fake blood capsule, dubious old hard candy, fortune slip, coin, tiny key, dead battery, or sealed empty vial, certificate, warning label, receipt fragment, adoption form, or fake inspection sticker',
]
import '../styles/features/extracted/snuggaloid-concept.css'
---

<MainGridLayout
  title={title}
  description={description}
  oneColumn={true}
  showMascot={true}
  pageMascotContext="A concise brief for making real plush Snuggaloids as physical MegaMeal archive artifacts."
>
  <article class="snuggaloid-brief">
    <header class="brief-hero">
      <div class="brief-hero__copy">
        <p class="brief-kicker">Artist commission brief</p>
        <h1>Snuggaloid Brief</h1>
        <p>
          Snuggaloids are small furry creature-objects from MegaMeal. 
      handmade, colorful,
          named, numbered, photographed, and added to the site archive.
        </p>
        <div class="brief-actions">
          <a href="/store/snuggaloids/" data-sfx-hover="hover-emphasis" data-sfx-click="soft">
            Store reference
          </a>
          <a href="/posts/timelines/snuggaliod-emergence/" data-sfx-hover="hover-soft" data-sfx-click="soft">
            Lore reference
          </a>
        </div>
      </div>

      <figure class="brief-hero__media">
        <ImageWrapper
          src="/ads/snuggloids.png"
          alt="Snuggaloids advertisement"
          class="brief-hero__image"
          imgClass="brief-hero__image-inner"
          loading="eager"
          sizes="(max-width: 900px) 100vw, 34vw"
        />
        <figcaption>Current product/ad reference.</figcaption>
      </figure>
    </header>

    <section class="brief-section brief-section--media" aria-labelledby="references">
      <div class="brief-heading">
        <p class="brief-kicker">Current material</p>
        <h2 id="references">References</h2>
      </div>
      <div class="reference-grid">
        {references.map(reference => (
          <a class="reference-card" href={reference.href} data-sfx-hover="hover-emphasis" data-sfx-click="soft">
            <span>{reference.label}</span>
            <strong>{reference.title}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="brief-media-strip" aria-label="Visual references">
      <figure>
        <ImageWrapper
          src="/posts/timeline/snuggloid-entity.png"
          alt="Snuggloid entity reference"
          class="brief-media-strip__image"
          imgClass="brief-media-strip__image-inner"
        />
        <figcaption>Entity image reference.</figcaption>
      </figure>
      <figure>
        <video src="/about/video/snuggloid-owner.webm" poster="/ads/snuggloids.png" controls preload="metadata" playsinline></video>
        <figcaption>Registered owner video reference.</figcaption>
      </figure>
    </section>

    <section class="brief-section" aria-labelledby="build-specs">
      <div class="brief-heading">
        <p class="brief-kicker">Physical design</p>
        <h2 id="build-specs">Build Specs</h2>
      </div>
      <dl class="spec-list">
        {buildSpecs.map(([label, value]) => (
          <>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </>
        ))}
      </dl>
    </section>

    <section class="brief-section brief-section--shleem" aria-labelledby="shleem">
      <div class="brief-heading">
        <p class="brief-kicker">Interior anatomy</p>
        <h2 id="shleem">The Shleem</h2>
      </div>
      <dl class="spec-list">
        {shleemSpecs.map(([label, value]) => (
          <>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </>
        ))}
      </dl>
    </section>

    <section class="brief-section" aria-labelledby="contents">
      <div class="brief-heading">
        <p class="brief-kicker">Permanent contents</p>
        <h2 id="contents">Sealed Artifacts</h2>
      </div>
      <div class="artifact-list">
        {internalArtifacts.map(item => <span>{item}</span>)}
      </div>
    </section>

    <section class="brief-section" aria-labelledby="archive">
      <div class="brief-heading">
        <p class="brief-kicker">Documentation</p>
        <h2 id="archive">Archive Record</h2>
      </div>
    </section>

    <section class="brief-section" aria-labelledby="decisions">
      <div class="brief-heading">
        <p class="brief-kicker">Before production</p>
        <h2 id="decisions">Open Decisions</h2>
      </div>

    </section>
  </article>
</MainGridLayout>

