---
import fs from 'node:fs'
import path from 'node:path'
import { getCollection } from 'astro:content'
import License from '@components/misc/License.astro'
import Markdown from '@components/misc/Markdown.astro'
import I18nKey from '@i18n/i18nKey'
import { i18n } from '@i18n/translation'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { url, getDir, getPostUrlBySlug } from '@utils/url-utils'
import { Icon } from 'astro-icon/components'
import PostMetadata from '../../components/PostMeta.astro'
import ImageWrapper from '../../components/misc/ImageWrapper.astro'
import { licenseConfig } from '../../config/config'
import { profileConfig, siteConfig } from '../../config/config'
import { publicCollectionFilter } from '../../contracts/content'
import { SERIES_CONFIG } from '../../config/seriesConfig'
import { getPostsBySeries } from '../../utils/content-utils'
import { formatDateToYYYYMMDD } from '../../utils/date-utils'
import { firstContactManualRedirects } from '../../utils/reader'
import '../../styles/pages/post-detail.css'

import LayoutToggle from '../../components/client/LayoutToggle.svelte'

export async function getStaticPaths() {
  const posts = await getCollection('posts', publicCollectionFilter)
  const sortedPosts = [...posts].sort(
    (a, b) =>
      new Date(b.data.published).getTime() -
      new Date(a.data.published).getTime(),
  )

  return sortedPosts.map((post, index) => {
    const newerPost = index > 0 ? sortedPosts[index - 1] : null
    const olderPost =
      index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null

    return {
      params: { slug: post.slug },
      props: {
        post,
        previousPost: newerPost
          ? { slug: newerPost.slug, title: newerPost.data.title }
          : null,
        nextPost: olderPost
          ? { slug: olderPost.slug, title: olderPost.data.title }
          : null,
      },
    }
  })
}

const { post, previousPost, nextPost } = Astro.props // Destructure `post` instead of `entry`
const retiredPostRedirects: Record<string, string> = {
  ...firstContactManualRedirects(),
  'introducing-story-mode': '/reader/first-contact-manual/',
  'mega-meal-explained': '/videos/mega-meal-explained/',
  'mega-meal-3': '/videos/qarnivor-snuggloid-emergence/',
  'cookbook/cookbook-index': '/cookbook/',
  'timelines/perfect-mary-recipe': '/cookbook/perfect-miranda-bloody-mary/',
  'timelines/zelephant-truffle-roast': '/cookbook/zelephant-truffle-roast/',
  'timelines/meat-cake': '/cookbook/meat-cake/',
}
const retiredPostRedirect = retiredPostRedirects[post.slug]

if (retiredPostRedirect) {
  return Astro.redirect(retiredPostRedirect, 301)
}

const mascotCtx = post.data.mascotContext

// Extract backgroundImage from frontmatter for dynamic background support
const backgroundImage = post.data.backgroundImage

const oneColumnMode = post.data.oneColumn

// Extract custom author data from frontmatter
const customAuthorData = {
  avatarImage: post.data.avatarImage,
  authorName: post.data.authorName,
  authorBio: post.data.authorBio,
  authorLink: post.data.authorLink, // NEW - Extract custom author link
}

const { Content, headings } = await post.render()

const { remarkPluginFrontmatter } = await post.render()
const contentOwnsPageHeading = headings.some(heading => heading.depth === 1)
const postTitleClass = `transition w-full block font-bold mb-3
                    text-2xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                `

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description || post.data.title,
  keywords: post.data.tags?.join(', ') || '',
  image: post.data.image
    ? new URL(post.data.image, Astro.site).toString()
    : undefined,
  datePublished: post.data.published.toISOString(),
  dateModified:
    post.data.updated?.toISOString() || post.data.published.toISOString(),
  author: {
    '@type': 'Person',
    name: profileConfig.name,
    url: Astro.site?.toString() || 'https://megameal.org',
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.title,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/thumb/favicon-light-192.png', Astro.site).toString(),
    },
  },
  inLanguage: post.data.lang
    ? post.data.lang.replace('_', '-')
    : siteConfig.lang.replace('_', '-'),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(getPostUrlBySlug(post.slug), Astro.site).toString(),
  },
}

const previousArticle = post.data.nextSlug
  ? {
      slug: post.data.nextSlug,
      title: post.data.nextTitle || previousPost?.title || 'Previous Article',
    }
  : previousPost

const nextArticle = post.data.prevSlug
  ? {
      slug: post.data.prevSlug,
      title: post.data.prevTitle || nextPost?.title || 'Next Article',
    }
  : nextPost

// Series navigation
const postSeries = (post.data as any).series as string | undefined
const postSeriesPart = (post.data as any).seriesPart as number | undefined
const postSeriesTitle = (post.data as any).seriesTitle as string | undefined
let seriesPosts: { slug: string; title: string; seriesPart?: number }[] = []
let seriesPrevPost: { slug: string; title: string } | null = null
let seriesNextPost: { slug: string; title: string } | null = null
let seriesConfig = postSeries ? SERIES_CONFIG[postSeries] : null

if (postSeries) {
  const rawSeriesPosts = await getPostsBySeries(postSeries)
  seriesPosts = rawSeriesPosts.map(p => ({
    slug: p.slug,
    title: p.data.title,
    seriesPart: (p.data as any).seriesPart as number | undefined,
  }))
  const currentIdx = seriesPosts.findIndex(p => p.slug === post.slug)
  if (currentIdx > 0) seriesPrevPost = seriesPosts[currentIdx - 1]
  if (currentIdx < seriesPosts.length - 1)
    seriesNextPost = seriesPosts[currentIdx + 1]
}

const showPostFooterNav = siteConfig.enablePostFooterNav === true
const isDownloadable = post.data.downloadable === true
const isDev = import.meta.env.DEV
const localPdfPath = path.join(
  process.cwd(),
  'public',
  'downloads',
  'posts',
  `${post.slug}.pdf`,
)
const hasDevPdfFile = isDev && fs.existsSync(localPdfPath)
const useDownloadFile = !isDev || hasDevPdfFile
const pdfDownloadUrl = useDownloadFile
  ? url(`/downloads/posts/${post.slug}.pdf`)
  : url(`/pdf/posts/${post.slug}/`)
const pdfButtonLabel = useDownloadFile
  ? 'Download Article (PDF)'
  : 'Open Printable View (PDF generated on build)'
---
<MainGridLayout 
  banner={post.data.image} 
  title={post.data.title} 
  description={post.data.description} 
  lang={post.data.lang} 
  setOGTypeArticle={true} 
  headings={headings}
  post={post}
  bannerLink={post.data.bannerLink}
  isPostPage={true}
  pageMascotContext={mascotCtx}
  backgroundImage={backgroundImage}
  customAuthorData={customAuthorData}
  oneColumn={oneColumnMode}
>

<!-- Add these meta tags for better date extraction -->
<meta name="publish-date" content={formatDateToYYYYMMDD(post.data.published)} slot="head" />
<meta property="article:published_time" content={post.data.published.toISOString()} slot="head" />

<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

<LayoutToggle 
  client:load 
  variant="minimal"
  position="top-right"
  size="md"
/>

    <div class="mobile-content-frame-shell flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
            <div id="post-container" 
                 class:list={["mobile-content-frame card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full [--card-bg:oklch(0.14_0.035_265)]",
                    {}
                 ]}
                 data-post-date={formatDateToYYYYMMDD(post.data.published)}
                 data-post-timestamp={post.data.published.getTime()}
                 data-post-title={post.data.title}
                 data-post-category={post.data.category}
                 data-post-tags={post.data.tags.join(',')}
                 data-post-image={post.data.image}
                 data-post-description={post.data.description}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm" data-post-words={remarkPluginFrontmatter.words}>{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm" data-post-minutes={remarkPluginFrontmatter.minutes}>{remarkPluginFrontmatter.minutes} {" " + i18n(I18nKey.minutesCount)}</div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                {contentOwnsPageHeading ? (
                  <div
                    data-pagefind-body
                    data-pagefind-weight="10"
                    data-pagefind-meta="title"
                    class={postTitleClass}
                  >
                    {post.data.title}
                  </div>
                ) : (
                  <h1
                    data-pagefind-body
                    data-pagefind-weight="10"
                    data-pagefind-meta="title"
                    class={postTitleClass}
                  >
                    {post.data.title}
                  </h1>
                )}
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={post.data.published}
                        updated={post.data.updated}
                        tags={post.data.tags}
                        category={post.data.category}
                ></PostMetadata>
                {!post.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- Only show cover if it exists and showImageOnPost isn't false -->
            {post.data.image && post.data.showImageOnPost !== false && post.data.bannerType !== 'assistant' &&
              <ImageWrapper id="post-cover" src={post.data.image} basePath={path.join("content/posts/", getDir(post.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }
            <Markdown class="mb-6 markdown-content onload-animation max-md:prose-sm">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={post.data.title} slug={post.slug} pubDate={post.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    {isDownloadable && (
      <div class="mb-4 w-full">
        <a
          href={pdfDownloadUrl}
          download={useDownloadFile ? `${post.slug}.pdf` : undefined}
          data-sfx-hover="hover-emphasis"
          data-sfx-click="confirm"
          class="download-pdf-btn w-full font-bold overflow-hidden active:scale-95"
        >
          <div class="card-base btn-card rounded-2xl w-full min-h-[4.5rem] max-w-full px-4 py-3 flex items-center justify-center gap-3">
            <Icon name="material-symbols:download-rounded" class="text-[1.5rem] text-[var(--primary)] shrink-0" />
            <div class="transition text-black/80 dark:text-white/80">
              {pdfButtonLabel}
            </div>
          </div>
        </a>
      </div>
    )}

    {/* Series navigation — shown when this post is part of a named series */}
    {postSeries && seriesPosts.length > 0 && (
      <div class="series-nav-block mb-4">
        <div class="series-nav-header">
          <span class="series-nav-label">Story Arc</span>
          <span class="series-nav-title">
            {seriesConfig?.title ?? postSeriesTitle ?? postSeries}
          </span>
          {seriesPosts.length > 1 && (
            <span class="series-nav-progress">
              {postSeriesPart ?? seriesPosts.findIndex(p => p.slug === post.slug) + 1} of {seriesPosts.length}
            </span>
          )}
        </div>

        <div class="series-chapters">
          {seriesPosts.map((sp, i) => (
            <a
              href={getPostUrlBySlug(sp.slug)}
              data-sfx-hover="hover-soft"
              data-sfx-click="soft"
              class:list={['series-chapter-link', { 'series-chapter-current': sp.slug === post.slug }]}
            >
              <span class="chapter-num">{sp.seriesPart ?? i + 1}</span>
              <span class="chapter-title">{sp.title}</span>
            </a>
          ))}
        </div>

        {(seriesPrevPost || seriesNextPost) && (
          <div class="series-prev-next">
            <a
              href={seriesPrevPost ? getPostUrlBySlug(seriesPrevPost.slug) : '#'}
              data-sfx-hover="hover-soft"
              data-sfx-click="panel-back"
              class:list={['series-pn-btn', { 'series-pn-disabled': !seriesPrevPost }]}
            >
              <Icon name="material-symbols:chevron-left-rounded" class="text-xl" />
              <span>{seriesPrevPost?.title ?? 'No previous chapter'}</span>
            </a>
            <a
              href={seriesNextPost ? getPostUrlBySlug(seriesNextPost.slug) : '#'}
              data-sfx-hover="hover-soft"
              data-sfx-click="sweep"
              class:list={['series-pn-btn series-pn-right', { 'series-pn-disabled': !seriesNextPost }]}
            >
              <span>{seriesNextPost?.title ?? 'No next chapter'}</span>
              <Icon name="material-symbols:chevron-right-rounded" class="text-xl" />
            </a>
          </div>
        )}
      </div>
    )}

    {showPostFooterNav && <div class="grid grid-cols-1 md:grid-cols-3 mb-4 gap-4 overflow-hidden w-full">
        <a href={previousArticle ? getPostUrlBySlug(previousArticle.slug) : "#"}
           data-sfx-hover="hover-soft"
           data-sfx-click="panel-back"
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none opacity-60": !previousArticle}]}>
            <div class="card-base btn-card rounded-2xl w-full min-h-[4.5rem] max-w-full px-4 py-3 flex items-center gap-3">
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)] shrink-0" />
                <div class="overflow-hidden min-w-0">
                    <div class="text-[0.7rem] uppercase tracking-[0.08em] text-black/45 dark:text-white/45">Previous</div>
                    <div class="transition overflow-hidden overflow-ellipsis whitespace-nowrap text-black/75 dark:text-white/75">
                        {previousArticle ? previousArticle.title : "No previous article"}
                    </div>
                </div>
            </div>
        </a>

        <a href={url('/')} data-sfx-hover="hover-soft" data-sfx-click="sweep" class="w-full font-bold overflow-hidden active:scale-95">
            <div class="card-base btn-card rounded-2xl w-full min-h-[4.5rem] max-w-full px-4 py-3 flex items-center justify-center gap-3">
                <Icon name="material-symbols:home-rounded" class="text-[1.5rem] text-[var(--primary)] shrink-0" />
                <div class="transition text-black/80 dark:text-white/80">
                    Back to {i18n(I18nKey.home)}
                </div>
            </div>
        </a>

        <a href={nextArticle ? getPostUrlBySlug(nextArticle.slug) : "#"}
           data-sfx-hover="hover-soft"
           data-sfx-click="sweep"
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none opacity-60": !nextArticle}]}>
            <div class="card-base btn-card rounded-2xl w-full min-h-[4.5rem] max-w-full px-4 py-3 flex items-center justify-end gap-3 text-right">
                <div class="overflow-hidden min-w-0">
                    <div class="text-[0.7rem] uppercase tracking-[0.08em] text-black/45 dark:text-white/45">Next</div>
                    <div class="transition overflow-hidden overflow-ellipsis whitespace-nowrap text-black/75 dark:text-white/75">
                        {nextArticle ? nextArticle.title : "No next article"}
                    </div>
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)] shrink-0" />
            </div>
        </a>
    </div>}

</MainGridLayout>
