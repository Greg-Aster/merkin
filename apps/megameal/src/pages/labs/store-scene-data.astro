---
import { getCollection } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import {
  normalizeProductEntry,
  normalizeReviewEntry,
} from '../../utils/store-scene-content'

const prototypeProducts = (await getCollection('products'))
  .filter(
    product =>
      product.data.draft === true &&
      typeof product.data.sceneWeight === 'number',
  )
  .sort((a, b) => (b.data.sceneWeight ?? 0) - (a.data.sceneWeight ?? 0))

const reviewEntries = await getCollection('reviews')
const reviewMap = new Map(reviewEntries.map(review => [review.id, review]))

const labProducts = await Promise.all(
  prototypeProducts.map(async entry => {
    const product = normalizeProductEntry(entry)
    const { Content: ProductContent } = await entry.render()
    const reviews = []

    for (const reviewId of product.reviews) {
      const reviewEntry = reviewMap.get(reviewId)
      if (!reviewEntry) continue

      const review = normalizeReviewEntry(reviewEntry)
      const { Content: ReviewContent } = await reviewEntry.render()

      reviews.push({
        review,
        ReviewContent,
      })
    }

    return {
      product,
      ProductContent,
      reviews,
    }
  }),
)
---

<Layout
  title="Store Scene Data Lab"
  description="Milestone 3 verification route for the scene-oriented product and review content model."
>
  <main class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <header class="mb-10 max-w-3xl">
      <p class="text-xs uppercase tracking-[0.28em] text-cyan-300/80">
        MEGAMEAL Store Lab
      </p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">
        Product Scene Data Pipeline
      </h1>
      <p class="mt-4 text-base leading-7 text-slate-300">
        This route loads draft prototype products from the Astro content
        collection, normalizes them into the scene-facing data model, and renders
        linked MDX reviews. It is isolated from the live store routes.
      </p>
    </header>

    <section class="grid gap-8">
      {labProducts.map(({ product, ProductContent, reviews }) => (
        <article class="overflow-hidden rounded-3xl border border-white/10 bg-slate-950/70 shadow-2xl shadow-cyan-950/20">
          <div class="border-b border-white/10 bg-gradient-to-r from-cyan-500/10 via-slate-900 to-amber-500/10 px-6 py-5">
            <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.22em] text-slate-400">
              <span>{product.brand ?? 'Unassigned Brand'}</span>
              <span class="text-slate-600">/</span>
              <span>{product.slug}</span>
              {typeof product.sceneWeight === 'number' && (
                <>
                  <span class="text-slate-600">/</span>
                  <span>Weight {product.sceneWeight}</span>
                </>
              )}
            </div>
            <h2 class="mt-3 text-3xl font-bold text-white">{product.name}</h2>
            {product.tagline && (
              <p class="mt-2 text-sm italic text-slate-300">"{product.tagline}"</p>
            )}
          </div>

          <div class="grid gap-8 px-6 py-6 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="space-y-6">
              <div class="prose prose-invert max-w-none prose-p:text-slate-300 prose-strong:text-white prose-a:text-cyan-300">
                <ProductContent />
              </div>

              <div>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">
                  Media Assets
                </h3>
                <div class="grid gap-3 sm:grid-cols-2">
                  {product.media.map((asset) => (
                    <div class="rounded-2xl border border-white/10 bg-slate-900/80 p-4">
                      <div class="text-xs uppercase tracking-[0.22em] text-cyan-300">
                        {asset.type}
                      </div>
                      <p class="mt-2 break-all text-sm text-slate-200">{asset.src}</p>
                      {asset.caption && (
                        <p class="mt-2 text-sm text-slate-400">{asset.caption}</p>
                      )}
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">
                  Linked Reviews
                </h3>
                <div class="grid gap-4">
                  {reviews.map(({ review, ReviewContent }) => (
                    <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
                      <div class="flex flex-wrap items-center gap-3 text-sm text-slate-300">
                        <span class="font-semibold text-white">{review.author}</span>
                        <span>{review.date}</span>
                        <span>Rating {review.rating}/5</span>
                        {review.verified && (
                          <span class="rounded-full bg-emerald-400/15 px-2 py-0.5 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">
                            Verified
                          </span>
                        )}
                      </div>
                      {review.flags && review.flags.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-2">
                          {review.flags.map((flag: string) => (
                            <span class="rounded-full bg-amber-400/10 px-2 py-1 text-xs text-amber-200">
                              {flag}
                            </span>
                          ))}
                        </div>
                      )}
                      <div class="prose prose-invert mt-4 max-w-none prose-p:text-slate-300 prose-a:text-cyan-300">
                        <ReviewContent />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <aside class="space-y-6">
              <section class="rounded-2xl border border-white/10 bg-slate-900/80 p-5">
                <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">
                  Sheet Fields
                </h3>
                <div class="mt-4 space-y-3">
                  {product.sheet.map((field) => (
                    <div class="rounded-xl border border-white/10 bg-slate-950/70 p-3">
                      <div class="text-xs uppercase tracking-[0.2em] text-cyan-300">
                        {field.type}
                        {field.label ? ` / ${field.label}` : ''}
                      </div>
                      <pre class="mt-2 whitespace-pre-wrap break-words font-mono text-xs text-slate-200">{JSON.stringify(field.value, null, 2)}</pre>
                    </div>
                  ))}
                </div>
              </section>

              <section class="rounded-2xl border border-white/10 bg-slate-900/80 p-5">
                <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">
                  Panels & Quirks
                </h3>
                <div class="mt-4 space-y-4">
                  <div>
                    <div class="mb-2 text-xs uppercase tracking-[0.2em] text-slate-500">
                      Panels
                    </div>
                    <div class="flex flex-wrap gap-2">
                      {product.panels.map((panel) => (
                        <span class="rounded-full bg-cyan-400/10 px-3 py-1 text-xs text-cyan-200">
                          {panel.id}
                          {panel.type ? ` (${panel.type})` : ''}
                        </span>
                      ))}
                    </div>
                  </div>
                  <div>
                    <div class="mb-2 text-xs uppercase tracking-[0.2em] text-slate-500">
                      Quirks
                    </div>
                    <div class="flex flex-wrap gap-2">
                      {product.quirks && product.quirks.length > 0 ? (
                        product.quirks.map((quirk) => (
                          <span class="rounded-full bg-rose-400/10 px-3 py-1 text-xs text-rose-200">
                            {quirk.name}
                          </span>
                        ))
                      ) : (
                        <span class="text-sm text-slate-500">No quirks declared.</span>
                      )}
                    </div>
                  </div>
                </div>
              </section>

              <section class="rounded-2xl border border-white/10 bg-slate-900/80 p-5">
                <h3 class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">
                  Rotation Metadata
                </h3>
                <dl class="mt-4 space-y-3 text-sm text-slate-300">
                  <div>
                    <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Eligible Pages</dt>
                    <dd class="mt-1">{product.eligiblePages?.join(', ') ?? 'None'}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Min Interval Days</dt>
                    <dd class="mt-1">{product.minIntervalDays ?? 'Not set'}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-[0.2em] text-slate-500">Related Products</dt>
                    <dd class="mt-1">{product.relatedProducts?.join(', ') ?? 'None'}</dd>
                  </div>
                </dl>
              </section>
            </aside>
          </div>
        </article>
      ))}
    </section>
  </main>
</Layout>
