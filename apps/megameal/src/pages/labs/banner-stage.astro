---
import BannerStageLab from '@components/banner-stage/BannerStageLab.svelte'
import Layout from '@layouts/Layout.astro'
---

<Layout
  title="Banner Stage Lab"
  description="Milestone 1 verification route for the unified BannerStage abstraction."
>
  <main class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <header class="mb-8 max-w-3xl">
      <p class="text-xs uppercase tracking-[0.28em] text-cyan-300/80">
        MEGAMEAL Stage Lab
      </p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">
        Unified Banner Stage
      </h1>
      <p class="mt-4 text-base leading-7 text-slate-300">
        This route is isolated from the live banner stack. It exercises the new
        scene registry, context bridge, client-side rotation cookie, and a mock
        scene contract without changing production page behavior.
      </p>
    </header>

    <BannerStageLab client:load />
  </main>
</Layout>
