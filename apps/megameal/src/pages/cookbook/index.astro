---
import { getCollection } from 'astro:content'
import CookbookReaderPage from '../../components/cookbook/CookbookReaderPage.astro'
import { publicCollectionFilter } from '../../contracts/content'

const entries = await getCollection('cookbook', publicCollectionFilter)
const indexEntry =
  entries.find(entry => entry.slug === 'cookbook-index') ?? entries[0]

if (!indexEntry) {
  throw new Error('No cookbook index entry found.')
}
---

<CookbookReaderPage entry={indexEntry} entries={entries} />
