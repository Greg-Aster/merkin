---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import privacyHref from '../styles/pages/privacy.css?url'
---

<MainGridLayout title="Privacy Policy" description="Corporate Privacy Division Notice - Data collection and privacy practices">
	<Fragment slot="head">
		<link rel="stylesheet" href={privacyHref} data-route-style="privacy" />
	</Fragment>
	<div class="privacy-page max-w-3xl mx-auto">
		<div class="card-base2 rounded-lg p-8 mb-8">
			<div class="mb-8">
				<div class="text-sm font-bold uppercase tracking-widest text-[var(--primary)] mb-2">
					Corporate Privacy Division
				</div>
				<h1 class="text-4xl font-black mb-4">Privacy Notice</h1>
				<p class="text-sm text-white/60">Effective Date: March 2042 | Temporal Authority: Unrestricted</p>
			</div>

			<div class="prose prose-invert max-w-none space-y-6 text-white/80">
				<section>
					<h2 class="text-2xl font-bold text-white mb-3">Information We Do Not Collect</h2>
					<p>
						The Corporate Privacy Division operates under a strict doctrine of <strong>minimal data philosophy</strong>.
						This site collects <strong>no personal information</strong> about you. We do not:
					</p>
					<ul class="list-disc list-inside space-y-2 ml-2">
						<li>Track your behavior across the site with analytics tools</li>
						<li>Use cookies to identify or follow you</li>
						<li>Store your IP address or device information</li>
						<li>Integrate third-party tracking pixels or beacons</li>
						<li>Require login credentials to view content</li>
						<li>Sell, rent, or share any data with third parties</li>
					</ul>
				</section>

				<section>
					<h2 class="text-2xl font-bold text-white mb-3">What We Do Store Locally</h2>
					<p>
						For your convenience, we store <strong>your preferences in your browser only</strong>:
					</p>
					<ul class="list-disc list-inside space-y-2 ml-2">
						<li><code class="bg-black/30 px-2 py-1 rounded">theme</code> — Your light/dark mode preference</li>
						<li><code class="bg-black/30 px-2 py-1 rounded">hue</code> — Your custom color hue override</li>
						<li><code class="bg-black/30 px-2 py-1 rounded">megameal-cart</code> — Your shopping cart contents (if using the store)</li>
						<li><code class="bg-black/30 px-2 py-1 rounded">megameal-sponsored-window-dismissed</code> — Whether you've dismissed the sponsor overlay this session</li>
					</ul>
					<p class="text-sm text-white/60 mt-3">
						These are stored only in your browser. We never see them. They are deleted when you clear your browser cache.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-bold text-white mb-3">Third-Party Resources</h2>
					<p>
						This site is hosted on <strong>Cloudflare Pages</strong>, a global content delivery network. Cloudflare's privacy policy applies to their infrastructure logs (IP, request metadata). We do not control or access this data.
					</p>
					<p class="text-sm text-white/60">
						Cloudflare's privacy practices: <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" class="text-[var(--primary)] underline">cloudflare.com/privacypolicy</a>
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-bold text-white mb-3">Your Rights</h2>
					<p>
						Under GDPR, CCPA, and similar privacy frameworks:
					</p>
					<ul class="list-disc list-inside space-y-2 ml-2">
						<li>You have the right to know what data we collect (answer: nothing about you)</li>
						<li>You have the right to request your data (answer: we don't have it)</li>
						<li>You have the right to deletion (answer: clear your browser, you're done)</li>
						<li>You have the right to object to tracking (answer: we don't track)</li>
					</ul>
				</section>

				<section>
					<h2 class="text-2xl font-bold text-white mb-3">Changes to This Policy</h2>
					<p>
						If this policy changes, we will update it here. Check back occasionally, though we expect minimal changes given that we collect nothing.
					</p>
				</section>

				<section class="border-t border-white/10 pt-6 mt-8">
					<h3 class="text-sm font-bold uppercase tracking-widest text-white/60 mb-3">Contact the Corporate Privacy Division</h3>
					<p>
						Questions about privacy on this site? Concerns about temporal data governance? Send a message to:
					</p>
					<p class="text-white/60 text-sm">
						Privacy inquiries are processed through our <a href="/about/" class="text-[var(--primary)] underline">corporate contacts</a>.
					</p>
				</section>

				<div class="bg-black/30 border border-white/10 rounded-lg p-6 mt-8 text-sm text-white/60">
					<p class="font-bold text-white mb-2">⚖️ Legal Basis</p>
					<p>
						This privacy notice complies with the General Data Protection Regulation (GDPR), the California Consumer Privacy Act (CCPA), and similar privacy frameworks. By visiting this site, you acknowledge this policy.
					</p>
				</div>
			</div>
		</div>

		<div class="text-center text-sm text-white/40">
			<p>Last updated: April 2026</p>
		</div>
	</div>
</MainGridLayout>
