---
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const entries = await getCollection('cookbook')

  return entries
    .filter(entry => entry.data.downloadable === true && entry.data.draft !== true)
    .map(entry => ({
      params: { slug: entry.slug },
      props: { entry },
    }))
}

const { entry } = Astro.props
const { Content } = await entry.render()
const publishedDate =
  entry.data.published instanceof Date
    ? entry.data.published.toISOString().slice(0, 10)
    : String(entry.data.published)
import '../../../styles/pages/pdf-post.css'
---
<html lang="en" class="pdf-export-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.data.title} - Recipe PDF</title>
  </head>
  <body class="pdf-export-body">
    <article class="pdf-article">
      <h1>{entry.data.title}</h1>
      <p class="meta">Published: {publishedDate}</p>
      {entry.data.description && <p class="description">{entry.data.description}</p>}
      {entry.data.image && (
        <img src={entry.data.image} alt={entry.data.title} loading="eager" />
      )}
      <Content />
    </article>
  </body>
</html>
