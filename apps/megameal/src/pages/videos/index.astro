---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { publicCollectionFilter } from '../../contracts/content'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { routeStyleHref } from '../../styles/routeStyleBundles'

const videos = (await getCollection('videos', publicCollectionFilter)).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
)

function getVideoHref(video: (typeof videos)[number]) {
  return `/videos/${video.slug}/`
}

function getVideoThumbnail(video: (typeof videos)[number]) {
  return (
    video.data.image ||
    `https://img.youtube.com/vi/${video.data.videoId}/hqdefault.jpg`
  )
}

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date)
}

function uniqueBySlug(items: typeof videos) {
  return Array.from(new Map(items.map(item => [item.slug, item])).values())
}

function slugify(value: string) {
  return value
    .toLowerCase()
    .replaceAll(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
}

const featuredVideo = videos[0]
const latestVideos = videos
const categories = Array.from(
  new Set(videos.map(video => video.data.category ?? 'Video')),
)
const categoryRows = categories
  .map(category => ({
    category,
    videos: videos.filter(
      video => (video.data.category ?? 'Video') === category,
    ),
  }))
  .filter(row => row.videos.length > 0)

const videoBannerPost = featuredVideo
  ? {
      slug: 'videos',
      data: {
        title: 'Video Archive',
        description:
          'Browse MEGA MEAL video transmissions, trailer breakdowns, field reports, and corporate media fragments.',
        image: getVideoThumbnail(featuredVideo),
        bannerType: 'none',
        oneColumn: true,
        showToc: false,
      },
    }
  : {
      slug: 'videos',
      data: {
        title: 'Video Archive',
        description:
          'Browse MEGA MEAL video transmissions, trailer breakdowns, field reports, and corporate media fragments.',
        image: '/assets/banner/posters/universe-poster.webp',
        oneColumn: true,
        showToc: false,
      },
    }
---

<MainGridLayout
  title="Video Archive — MEGA MEAL"
  description={videoBannerPost.data.description}
  banner={videoBannerPost.data.image}
  post={videoBannerPost}
  backgroundImage="none"
  oneColumn={true}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={routeStyleHref('videos-index')} data-route-style="videos-index" />
  </Fragment>
  <section data-videos-archive class="mt-2 w-full space-y-5 pb-8 sm:mt-2 sm:space-y-6 sm:pb-10">
    {featuredVideo && (
      <article
        class="card-base relative isolate -mx-4 min-h-[17.5rem] overflow-hidden rounded-none bg-black text-white onload-animation sm:mx-0 sm:min-h-[28rem] sm:rounded-2xl"
      >
        <img
          src={getVideoThumbnail(featuredVideo)}
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-100"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,6,23,0.94)_0%,rgba(2,6,23,0.72)_30%,rgba(2,6,23,0.16)_70%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black via-black/55 to-transparent"></div>

        <div class="relative z-10 flex min-h-[17.5rem] max-w-3xl flex-col justify-end p-3.5 sm:min-h-[28rem] sm:p-7 lg:p-9">
          <div class="mb-2 inline-flex w-fit items-center gap-1.5 rounded-full border border-cyan-300/25 bg-black/45 px-2.5 py-1 text-[8px] font-bold uppercase tracking-[0.16em] text-cyan-100 sm:mb-3 sm:gap-2 sm:px-3 sm:text-[10px] sm:tracking-[0.22em]">
            <span class="h-1.5 w-1.5 rounded-full bg-red-500 shadow-[0_0_14px_rgba(239,68,68,0.9)] sm:h-2 sm:w-2"></span>
            Featured Transmission
          </div>
          <h1 class="max-w-2xl text-xl font-black leading-tight text-white sm:text-4xl lg:text-5xl">
            {featuredVideo.data.title}
          </h1>
          <p class="mt-2 line-clamp-2 max-w-2xl text-xs leading-relaxed text-white/78 sm:mt-4 sm:line-clamp-none sm:text-base">
            {featuredVideo.data.description}
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[9px] font-bold uppercase tracking-[0.1em] text-white/55 sm:mt-5 sm:gap-x-2 sm:text-[11px] sm:tracking-[0.16em]">
            <span>{featuredVideo.data.category ?? 'Video'}</span>
            <span>•</span>
            <span>{featuredVideo.data.channelName ?? 'MEGA MEAL SAGA'}</span>
            <span>•</span>
            <span>{formatDate(featuredVideo.data.published)}</span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2 sm:mt-6 sm:flex sm:flex-wrap sm:gap-3">
            <a
              href={getVideoHref(featuredVideo)}
              data-sfx-hover="hover-emphasis"
              data-sfx-click="sweep"
              class="inline-flex min-h-10 items-center justify-center gap-1.5 rounded-md bg-white px-2.5 py-1.5 text-xs font-black text-slate-950 transition hover:bg-cyan-100 sm:min-h-11 sm:gap-2 sm:px-5 sm:py-2 sm:text-sm sm:justify-start"
            >
              <Icon name="material-symbols:play-arrow-rounded" class="h-5 w-5 sm:h-6 sm:w-6" />
              Watch Now
            </a>
            <a
              href="#all-transmissions"
              data-sfx-hover="hover-soft"
              data-sfx-click="soft"
              class="inline-flex min-h-10 items-center justify-center gap-1.5 rounded-md border border-white/20 bg-white/10 px-2.5 py-1.5 text-xs font-bold text-white backdrop-blur transition hover:bg-white/16 sm:min-h-11 sm:gap-2 sm:px-5 sm:py-2 sm:text-sm sm:justify-start"
            >
              <Icon name="material-symbols:video-library-outline-rounded" class="h-4 w-4 sm:h-5 sm:w-5" />
              Browse Library
            </a>
          </div>
        </div>
      </article>
    )}

    {categoryRows.map(row => (
      <section
        id={`category-${slugify(row.category)}`}
        class="space-y-2 onload-animation sm:space-y-3"
      >
        <div class="flex items-center justify-between gap-3 px-1">
          <h2 class="text-base font-black text-black/85 dark:text-white/85 sm:text-lg">
            {row.category}
          </h2>
          <div class="flex items-center gap-2">
            <span class="hidden text-xs font-bold uppercase tracking-[0.14em] text-black/35 dark:text-white/35 sm:inline">
              {row.videos.length} titles
            </span>
          </div>
        </div>
        <div class="relative">
          <button
            type="button"
            aria-label={`Scroll ${row.category} left`}
            data-video-rail-control
            data-video-rail-target={`category-${slugify(row.category)}`}
            data-video-rail-direction="-1"
            hidden
            disabled
            class="absolute left-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-black/70 text-white opacity-70 shadow-2xl backdrop-blur transition hover:scale-105 hover:bg-[var(--primary)] hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white disabled:cursor-default disabled:hover:scale-100 disabled:hover:bg-black/70 disabled:hover:opacity-70 sm:flex"
          >
            <Icon name="material-symbols:chevron-left-rounded" class="h-8 w-8" />
          </button>
          <button
            type="button"
            aria-label={`Scroll ${row.category} right`}
            data-video-rail-control
            data-video-rail-target={`category-${slugify(row.category)}`}
            data-video-rail-direction="1"
            hidden
            disabled
            class="absolute right-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-black/70 text-white opacity-70 shadow-2xl backdrop-blur transition hover:scale-105 hover:bg-[var(--primary)] hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white disabled:cursor-default disabled:hover:scale-100 disabled:hover:bg-black/70 disabled:hover:opacity-70 sm:flex"
          >
            <Icon name="material-symbols:chevron-right-rounded" class="h-8 w-8" />
          </button>
          <div
            data-video-rail-affordance={`category-${slugify(row.category)}`}
            aria-hidden="true"
            hidden
            class="pointer-events-none absolute -right-4 top-0 bottom-2 z-10 flex w-16 items-center justify-end bg-gradient-to-l from-[var(--page-bg)] to-transparent pr-3 sm:hidden"
          >
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/20 bg-black/65 text-white shadow-xl backdrop-blur">
              <Icon name="material-symbols:chevron-right-rounded" class="h-6 w-6" />
            </span>
          </div>
          <div
            data-video-rail={`category-${slugify(row.category)}`}
            class="-mx-4 flex snap-x snap-mandatory gap-2.5 overflow-x-auto overscroll-x-contain px-4 pb-2 scroll-smooth [scrollbar-width:none] [-webkit-overflow-scrolling:touch] sm:mx-0 sm:gap-4 sm:px-0 sm:pb-3 sm:[scrollbar-width:thin]"
          >
            {uniqueBySlug(row.videos).map(video => (
              <a
                href={getVideoHref(video)}
                data-sfx-hover="hover-soft"
                data-sfx-click="soft"
                class="group min-w-[58vw] max-w-[58vw] snap-start overflow-hidden rounded-lg border border-black/10 bg-white/55 text-left backdrop-blur-md backdrop-saturate-150 transition hover:-translate-y-0.5 hover:border-[var(--primary)]/45 dark:border-white/10 dark:bg-white/[0.06] sm:min-w-[20rem] sm:max-w-[20rem] sm:rounded-xl"
              >
                <div class="relative aspect-video overflow-hidden bg-slate-950">
                  <img
                    src={getVideoThumbnail(video)}
                    alt={`${video.data.title} thumbnail`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
                  <Icon
                    name="material-symbols:play-circle-outline-rounded"
                    class="absolute bottom-2 left-2 h-6 w-6 text-white sm:bottom-3 sm:left-3 sm:h-8 sm:w-8"
                  />
                </div>
                <div class="p-2 sm:p-3">
                  <h3 class="line-clamp-2 text-xs font-black leading-tight text-black/80 group-hover:text-[var(--primary)] dark:text-white/80 sm:text-sm">
                    {video.data.title}
                  </h3>
                  <div class="mt-1.5 text-[10px] uppercase tracking-[0.1em] text-black/35 dark:text-white/35 sm:mt-2 sm:text-[11px] sm:tracking-[0.12em]">
                    {formatDate(video.data.published)}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section id="all-transmissions" class="space-y-2 onload-animation sm:space-y-3">
      <div class="flex items-center justify-between gap-3 px-1">
        <h2 class="text-base font-black text-black/85 dark:text-white/85 sm:text-lg">
          All Transmissions
        </h2>
        <div class="flex items-center gap-2">
          <span class="hidden text-xs font-bold uppercase tracking-[0.14em] text-black/35 dark:text-white/35 sm:inline">
            {videos.length} available
          </span>
        </div>
      </div>
      <div class="relative">
        <button
          type="button"
          aria-label="Scroll All Transmissions left"
          data-video-rail-control
          data-video-rail-target="all-transmissions"
          data-video-rail-direction="-1"
          hidden
          disabled
          class="absolute left-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-black/70 text-white opacity-70 shadow-2xl backdrop-blur transition hover:scale-105 hover:bg-[var(--primary)] hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white disabled:cursor-default disabled:hover:scale-100 disabled:hover:bg-black/70 disabled:hover:opacity-70 sm:flex"
        >
          <Icon name="material-symbols:chevron-left-rounded" class="h-8 w-8" />
        </button>
        <button
          type="button"
          aria-label="Scroll All Transmissions right"
          data-video-rail-control
          data-video-rail-target="all-transmissions"
          data-video-rail-direction="1"
          hidden
          disabled
          class="absolute right-2 top-1/2 z-20 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-black/70 text-white opacity-70 shadow-2xl backdrop-blur transition hover:scale-105 hover:bg-[var(--primary)] hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white disabled:cursor-default disabled:hover:scale-100 disabled:hover:bg-black/70 disabled:hover:opacity-70 sm:flex"
        >
          <Icon name="material-symbols:chevron-right-rounded" class="h-8 w-8" />
        </button>
        <div
          data-video-rail-affordance="all-transmissions"
          aria-hidden="true"
          hidden
          class="pointer-events-none absolute -right-4 top-0 bottom-2 z-10 flex w-16 items-center justify-end bg-gradient-to-l from-[var(--page-bg)] to-transparent pr-3 sm:hidden"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/20 bg-black/65 text-white shadow-xl backdrop-blur">
            <Icon name="material-symbols:chevron-right-rounded" class="h-6 w-6" />
          </span>
        </div>
        <div
          data-video-rail="all-transmissions"
          class="-mx-4 flex snap-x snap-mandatory gap-2.5 overflow-x-auto overscroll-x-contain px-4 pb-2 scroll-smooth [scrollbar-width:none] [-webkit-overflow-scrolling:touch] sm:mx-0 sm:gap-4 sm:px-0 sm:pb-3 sm:[scrollbar-width:thin]"
        >
          {latestVideos.map(video => (
            <a
              href={getVideoHref(video)}
              data-sfx-hover="hover-soft"
              data-sfx-click="soft"
              class="group min-w-[58vw] max-w-[58vw] snap-start overflow-hidden rounded-lg border border-black/10 bg-white/55 text-left backdrop-blur-md backdrop-saturate-150 transition hover:-translate-y-0.5 hover:border-[var(--primary)]/45 dark:border-white/10 dark:bg-white/[0.06] sm:min-w-[20rem] sm:max-w-[20rem] sm:rounded-xl"
            >
              <div class="relative aspect-video overflow-hidden bg-slate-950">
                <img
                  src={getVideoThumbnail(video)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
                <Icon
                  name="material-symbols:play-circle-outline-rounded"
                  class="absolute bottom-2 left-2 h-6 w-6 text-white sm:bottom-3 sm:left-3 sm:h-8 sm:w-8"
                />
              </div>
              <div class="p-2 sm:p-3">
                <h3 class="line-clamp-2 text-xs font-black leading-tight text-black/80 group-hover:text-[var(--primary)] dark:text-white/80 sm:text-sm">
                  {video.data.title}
                </h3>
                <div class="mt-1.5 text-[10px] uppercase tracking-[0.1em] text-black/35 dark:text-white/35 sm:mt-2 sm:text-[11px] sm:tracking-[0.12em]">
                  {formatDate(video.data.published)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </section>

  <script>
    import { initVideosArchiveRail } from '../../components/videos/videosArchiveRail'

    initVideosArchiveRail()
    document.addEventListener('astro:page-load', initVideosArchiveRail)
  </script>
</MainGridLayout>
