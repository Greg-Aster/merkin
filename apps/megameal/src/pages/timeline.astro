---
import MainGridLayout from '../layouts/MainGridLayout.astro'

const syntheticPost = {
  slug: 'timeline',
  data: {
    title: 'MEGAMEAL Timeline',
    description: 'The MEGAMEAL chronology star map: eras, incidents, recipes, wars, corporate ascensions, and archival fragments.',
    bannerType: 'timeline',
    bannerData: {
      category: 'MEGA MEAL',
      background: '/posts/timeline/universe.png',
      compact: false,
    },
  },
}
---

<MainGridLayout
  title="Timeline"
  description="The MEGAMEAL chronology star map: eras, incidents, recipes, wars, corporate ascensions, and archival fragments."
  post={syntheticPost}
  contentMode="banner-only"
  showAssistantWidget={false}
/>
