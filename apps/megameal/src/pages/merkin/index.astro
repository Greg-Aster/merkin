---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Markdown from '@components/misc/Markdown.astro'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import MerkinMedia from '../../components/merkin/MerkinMedia.astro'
import MerkinShareActions from '../../components/merkin/MerkinShareActions.svelte'
import {
  formatMerkinDate,
  getMerkinHref,
  getMerkinOgImage,
  getMerkinThumbnail,
  getPublishableMerkinEntries,
} from '../../utils/merkin-gallery'

const allMerkinEntries = await getCollection(
  'merkin',
  ({ data }) => data.draft !== true,
)
const merkinEntries = getPublishableMerkinEntries(allMerkinEntries)
const featuredEntry = merkinEntries[0]

if (!featuredEntry) {
  throw new Error('Merkin gallery needs at least one publishable entry.')
}

const { Content: FeaturedStory } = await featuredEntry.render()
const previousEntries = merkinEntries.slice(1)
const pageDescription =
  featuredEntry.data.description ??
  'A curated Merkin gallery devoted to love, light, acceptance, and strange devotional media.'
const featuredImage = getMerkinOgImage(featuredEntry)
const featuredHref = getMerkinHref(featuredEntry)
const absoluteFeaturedUrl = new URL(
  featuredHref,
  Astro.site ?? Astro.url.origin,
).toString()
const merkinPagePost = {
  slug: 'merkin',
  data: {
    title: 'Merkin Lord of Love and Light',
    description: pageDescription,
    image: featuredImage,
    bannerType: 'none',
    oneColumn: true,
    showToc: false,
  },
}
---

<MainGridLayout
  title="Merkin Lord of Love and Light"
  description={pageDescription}
  banner={featuredImage}
  post={merkinPagePost}
  backgroundImage="none"
  oneColumn={true}
>
  <section class="mt-2 w-full space-y-6 pb-10 sm:space-y-8">
    <article class="card-base overflow-hidden rounded-none bg-slate-950/86 text-slate-100 onload-animation sm:rounded-2xl">
      <div class="grid gap-0 lg:grid-cols-[minmax(0,1.18fr)_minmax(21rem,0.82fr)]">
        <div class="group relative flex min-h-[22rem] bg-black sm:min-h-[34rem]">
          <MerkinMedia
            media={featuredEntry.data.media}
            loading="eager"
            class="transition duration-500 group-hover:scale-[1.01]"
          />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/78 via-black/12 to-transparent p-4 text-white sm:p-6 lg:hidden">
            <div class="text-[0.68rem] font-black uppercase tracking-[0.18em] text-white/68">
              Featured Entry
            </div>
            <h1 class="mt-1 text-2xl font-black leading-tight sm:text-3xl">
              {featuredEntry.data.title}
            </h1>
          </div>
        </div>

        <div class="flex flex-col gap-5 p-5 sm:p-7 lg:p-8">
          <div class="hidden lg:block">
            <div class="text-[0.72rem] font-black uppercase tracking-[0.18em] text-[var(--primary)]">
              Featured Entry
            </div>
            <h1
              data-pagefind-body
              data-pagefind-weight="10"
              data-pagefind-meta="title"
              class="mt-2 text-4xl font-black leading-tight text-slate-50"
            >
              {featuredEntry.data.title}
            </h1>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-slate-400">
            <span>{formatMerkinDate(featuredEntry.data.date)}</span>
            <span>/</span>
            <span>{featuredEntry.data.media.type === 'video' ? 'Moving Image' : 'Image'}</span>
            <span>/</span>
            <span>Gallery Queue</span>
          </div>

          <p
            data-pagefind-body
            class="text-base leading-relaxed text-slate-300 sm:text-lg"
          >
            {featuredEntry.data.caption}
          </p>

          <Markdown class="markdown-content prose-invert text-slate-300 prose-p:text-slate-300 prose-strong:text-slate-100 prose-a:text-[var(--primary)] max-md:prose-sm">
            <FeaturedStory />
          </Markdown>

          <div class="mt-auto space-y-4 border-t border-white/10 pt-5">
            <MerkinShareActions
              client:load
              title={featuredEntry.data.title}
              text={featuredEntry.data.caption}
              url={absoluteFeaturedUrl}
            />
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              <a
                href={featuredHref}
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-[var(--primary)] px-4 py-2 text-sm font-black text-white transition hover:opacity-90 active:scale-[0.98]"
                data-sfx-hover="hover-emphasis"
                data-sfx-click="sweep"
              >
                <Icon name="material-symbols:open-in-new-rounded" class="h-5 w-5" />
                Open Entry
              </a>
              <a
                href="#archive"
                class="btn-card inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/10 px-4 py-2 text-sm font-black text-slate-100 transition hover:bg-white/15 active:scale-[0.98]"
                data-sfx-hover="hover-soft"
                data-sfx-click="soft"
              >
                <Icon name="material-symbols:grid-view-rounded" class="h-5 w-5" />
                View Archive
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>

    <section id="archive" class="space-y-3 onload-animation">
      <div class="flex flex-wrap items-end justify-between gap-3 px-1">
        <div>
          <div class="text-[0.72rem] font-black uppercase tracking-[0.18em] text-[var(--primary)]">
            Previous Offerings
          </div>
          <h2 class="mt-1 text-2xl font-black text-slate-100">
            Gallery Archive
          </h2>
        </div>
        <div class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">
          {merkinEntries.length} entries
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {previousEntries.map(entry => (
          <a
            href={getMerkinHref(entry)}
            class="card-base group overflow-hidden rounded-xl bg-slate-950/78 text-left text-slate-100 transition hover:-translate-y-0.5"
            data-sfx-hover="hover-soft"
            data-sfx-click="soft"
          >
            <div class="relative aspect-[4/3] bg-black">
              <img
                src={getMerkinThumbnail(entry)}
                alt={entry.data.media.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/76 to-transparent p-3 text-white">
                <div class="flex items-center gap-2 text-[0.68rem] font-black uppercase tracking-[0.12em] text-white/70">
                  <Icon
                    name={entry.data.media.type === 'video' ? 'material-symbols:play-circle-outline-rounded' : 'material-symbols:image-outline-rounded'}
                    class="h-4 w-4"
                  />
                  <span>{entry.data.media.type === 'video' ? 'Video' : 'Image'}</span>
                </div>
              </div>
            </div>
            <div class="space-y-2 p-4">
              <div class="text-[0.68rem] font-black uppercase tracking-[0.14em] text-[var(--primary)]">
                {formatMerkinDate(entry.data.date)}
              </div>
              <h3 class="line-clamp-2 text-lg font-black leading-tight text-slate-100 group-hover:text-[var(--primary)]">
                {entry.data.title}
              </h3>
              <p class="line-clamp-3 text-sm leading-relaxed text-slate-300">
                {entry.data.caption}
              </p>
            </div>
          </a>
        ))}
      </div>

      {previousEntries.length === 0 && (
        <div class="card-base rounded-xl bg-slate-950/78 p-5 text-sm leading-relaxed text-slate-300">
          The archive opens after the next Merkin entry is published.
        </div>
      )}
    </section>
  </section>
</MainGridLayout>
