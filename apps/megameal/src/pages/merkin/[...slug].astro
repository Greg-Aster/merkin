---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Markdown from '@components/misc/Markdown.astro'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import MerkinMedia from '../../components/merkin/MerkinMedia.astro'
import MerkinShareActions from '../../components/merkin/MerkinShareActions.svelte'
import { publicCollectionFilter } from '../../contracts/content'
import {
  formatMerkinDate,
  getMerkinHref,
  getMerkinOgImage,
  getMerkinThumbnail,
  getPublishableMerkinEntries,
} from '../../utils/merkin-gallery'

export async function getStaticPaths() {
  const entries = getPublishableMerkinEntries(
    await getCollection('merkin', publicCollectionFilter),
  )

  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry, entries },
  }))
}

const { entry, entries } = Astro.props
const { Content } = await entry.render()
const currentIndex = entries.findIndex(item => item.slug === entry.slug)
const newerEntry = currentIndex > 0 ? entries[currentIndex - 1] : undefined
const olderEntry =
  currentIndex >= 0 && currentIndex < entries.length - 1
    ? entries[currentIndex + 1]
    : undefined
const entryDescription = entry.data.description ?? entry.data.caption
const entryImage = getMerkinOgImage(entry)
const entryHref = getMerkinHref(entry)
const absoluteEntryUrl = new URL(entryHref, Astro.site ?? Astro.url.origin).toString()
const pagePost = {
  slug: entry.slug,
  data: {
    title: entry.data.title,
    description: entryDescription,
    image: entryImage,
    bannerType: 'none',
    oneColumn: true,
    showToc: false,
  },
}
---

<MainGridLayout
  title={`${entry.data.title} - Merkin Gallery`}
  description={entryDescription}
  banner={entryImage}
  post={pagePost}
  backgroundImage="none"
  oneColumn={true}
  setOGTypeArticle={true}
>
  <article class="mt-2 w-full pb-10">
    <div class="mb-3 px-1">
      <a
        href="/merkin/"
        class="inline-flex items-center gap-2 rounded-lg px-2 py-1 text-sm font-bold text-slate-300 transition hover:text-[var(--primary)]"
        data-sfx-hover="hover-soft"
        data-sfx-click="soft"
      >
        <Icon name="material-symbols:arrow-back-rounded" class="h-5 w-5" />
        Merkin Gallery
      </a>
    </div>

    <div class="card-base overflow-hidden rounded-none bg-slate-950/86 text-slate-100 onload-animation sm:rounded-2xl">
      <div class="grid gap-0 lg:grid-cols-[minmax(0,1.08fr)_minmax(22rem,0.92fr)]">
        <div class="flex min-h-[24rem] bg-black sm:min-h-[38rem]">
          <MerkinMedia media={entry.data.media} loading="eager" />
        </div>

        <div class="flex flex-col gap-5 p-5 sm:p-7 lg:p-8">
          <div>
            <div class="text-[0.72rem] font-black uppercase tracking-[0.18em] text-[var(--primary)]">
              Merkin Gallery
            </div>
            <h1
              data-pagefind-body
              data-pagefind-weight="10"
              data-pagefind-meta="title"
              class="mt-2 text-3xl font-black leading-tight text-slate-50 sm:text-4xl"
            >
              {entry.data.title}
            </h1>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-slate-400">
            <span>{formatMerkinDate(entry.data.date)}</span>
            <span>/</span>
            <span>{entry.data.media.type === 'video' ? 'Moving Image' : 'Image'}</span>
          </div>

          <p
            data-pagefind-body
            class="text-base leading-relaxed text-slate-300 sm:text-lg"
          >
            {entry.data.caption}
          </p>

          <div class="border-y border-white/10 py-5">
            <MerkinShareActions
              client:load
              title={entry.data.title}
              text={entry.data.caption}
              url={absoluteEntryUrl}
            />
          </div>

          <Markdown class="markdown-content prose-invert text-slate-300 prose-p:text-slate-300 prose-strong:text-slate-100 prose-a:text-[var(--primary)] max-md:prose-sm">
            <Content />
          </Markdown>
        </div>
      </div>
    </div>

    {(newerEntry || olderEntry) && (
      <nav class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2" aria-label="Adjacent Merkin entries">
        {newerEntry ? (
          <a
            href={getMerkinHref(newerEntry)}
            class="card-base btn-card grid min-h-[7rem] grid-cols-[6rem_minmax(0,1fr)] gap-3 rounded-xl bg-slate-950/78 p-3 text-left text-slate-100 transition active:scale-[0.98]"
            data-sfx-hover="hover-soft"
            data-sfx-click="soft"
          >
            <img
              src={getMerkinThumbnail(newerEntry)}
              alt=""
              loading="lazy"
              decoding="async"
              class="aspect-square rounded-lg bg-black object-cover"
            />
            <span class="min-w-0 self-center">
              <span class="block text-[0.68rem] font-black uppercase tracking-[0.14em] text-[var(--primary)]">
                Newer
              </span>
              <span class="mt-1 block line-clamp-2 font-black leading-tight text-slate-100">
                {newerEntry.data.title}
              </span>
            </span>
          </a>
        ) : (
          <div></div>
        )}

        {olderEntry ? (
          <a
            href={getMerkinHref(olderEntry)}
            class="card-base btn-card grid min-h-[7rem] grid-cols-[minmax(0,1fr)_6rem] gap-3 rounded-xl bg-slate-950/78 p-3 text-right text-slate-100 transition active:scale-[0.98]"
            data-sfx-hover="hover-soft"
            data-sfx-click="soft"
          >
            <span class="min-w-0 self-center">
              <span class="block text-[0.68rem] font-black uppercase tracking-[0.14em] text-[var(--primary)]">
                Older
              </span>
              <span class="mt-1 block line-clamp-2 font-black leading-tight text-slate-100">
                {olderEntry.data.title}
              </span>
            </span>
            <img
              src={getMerkinThumbnail(olderEntry)}
              alt=""
              loading="lazy"
              decoding="async"
              class="aspect-square rounded-lg bg-black object-cover"
            />
          </a>
        ) : (
          <div></div>
        )}
      </nav>
    )}
  </article>
</MainGridLayout>
