---
import type { GetStaticPaths } from 'astro'
import PostPage from '../components/PostPage.astro'
import Pagination from '../components/control/Pagination.astro'
import PortalDemoVideoPlayer from '../components/home/PortalDemoVideoPlayer.astro'
import PortalHeroBackgroundSlide from '../components/home/PortalHeroBackgroundSlide.astro'
import PortalHeroSlide from '../components/home/PortalHeroSlide.astro'
import PortalSponsoredBloom from '../components/home/PortalSponsoredBloom.astro'
import { PAGE_SIZE } from '../constants/constants'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { getSortedPosts } from '../utils/content-utils'
import homeIntroEnvironmentHref from '../styles/features/extracted/home-intro-environment.css?url'
import factsWidgetCoreHref from '../styles/features/facts-widget/core.css?url'
import portalHeroScrollCueHref from '../styles/features/home/portal-hero-scroll-cue.css?url'
import portalHeroSlideHref from '../styles/features/home/portal-hero-slide.css?url'
import portalSponsoredBloomHref from '../styles/features/home/portal-sponsored-bloom.css?url'

export const getStaticPaths = (async ({ paginate }) => {
  const allBlogPosts = await getSortedPosts()
  return paginate(allBlogPosts, { pageSize: PAGE_SIZE })
}) satisfies GetStaticPaths
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props
const isFirstPage = page.currentPage === 1
const len = page.data.length
import dynamicPageHref from '../styles/pages/dynamic-page.css?url'
const homeStyleHrefs = isFirstPage
  ? [
      homeIntroEnvironmentHref,
      factsWidgetCoreHref,
      portalHeroScrollCueHref,
      portalHeroSlideHref,
      portalSponsoredBloomHref,
      dynamicPageHref,
    ]
  : [dynamicPageHref]
---

<MainGridLayout
  homeLayout={isFirstPage ? 'portal' : 'default'}
  contentMode={isFirstPage ? 'banner-only' : 'default'}
>
  <Fragment slot="head">
    {homeStyleHrefs.map(href => (
      <link rel="stylesheet" href={href} data-route-style="home" />
    ))}
  </Fragment>
  {isFirstPage && (
    <Fragment slot="banner-overlay-content">
      <PortalHeroSlide />
    </Fragment>
  )}
  {isFirstPage && (
    <Fragment slot="banner-slide-content">
      <PortalHeroBackgroundSlide />
    </Fragment>
  )}
  {isFirstPage && (
    <Fragment slot="portal-demo-content">
      <PortalDemoVideoPlayer />
    </Fragment>
  )}
  {!isFirstPage && (
    <div class="dispatches-stream deferred-section">
      <PostPage page={page}></PostPage>
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      ></Pagination>
    </div>
  )}
  {isFirstPage && (
    <PortalSponsoredBloom
      slot="overlay"
    />
  )}
</MainGridLayout>
