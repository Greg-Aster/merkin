---
import type { GetStaticPaths } from 'astro'
import postsManifest from '../../../../packages/shared-data/generated/posts.json'
import timelineManifest from '../../../../packages/shared-data/generated/timeline.json'
import PostPage from '../components/PostPage.astro'
import Pagination from '../components/control/Pagination.astro'
import FeaturedArc from '../components/home/FeaturedArc.astro'
import EraBrowser from '../components/home/EraBrowser.astro'
import PortalDestinations from '../components/home/PortalDestinations.astro'
import FactsWidget from '../components/widget/FactsWidget.astro'
import { PAGE_SIZE } from '../constants/constants'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { getSortedPosts } from '../utils/content-utils'

export const getStaticPaths = (async ({ paginate }) => {
  const allBlogPosts = await getSortedPosts()
  return paginate(allBlogPosts, { pageSize: PAGE_SIZE })
}) satisfies GetStaticPaths
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props
const isFirstPage = page.currentPage === 1
const len = page.data.length
const publishedDispatchCount = postsManifest.items.filter(post => !post.draft).length
const publishedTimelineCount = timelineManifest.items.filter(event => !event.isDraft).length
---

<MainGridLayout homeLayout="portal">
  {isFirstPage && (
    <>
      <div id="portal-overview" class="portal-snap-section portal-snap-section--destinations appear-on-scroll delay-1">
        <PortalDestinations
          publishedDispatchCount={publishedDispatchCount}
          timelineCount={publishedTimelineCount}
        />
      </div>
      <div class="portal-snap-section portal-snap-section--featured appear-on-scroll delay-2 featured-arc-section deferred-section">
        <FeaturedArc />
      </div>
      <section class="portal-snap-section portal-snap-section--dispatches deferred-section" aria-labelledby="dispatches-title">
        <div class="dispatches-header appear-on-scroll delay-3">
          <span id="dispatches-title" class="dispatches-label">Recent Dispatches</span>
          <span class="dispatches-sub">
            {publishedDispatchCount} published transmissions across {publishedTimelineCount} live timeline nodes.
          </span>
        </div>
        <div class="dispatches-stream">
          <PostPage page={page}></PostPage>
          <Pagination
            class="mx-auto onload-animation"
            page={page}
            style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
          ></Pagination>
        </div>
      </section>
    </>
  )}
  {!isFirstPage && (
    <div class="dispatches-stream deferred-section">
      <PostPage page={page}></PostPage>
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      ></Pagination>
    </div>
  )}
  {isFirstPage && (
    <FactsWidget
      slot="overlay"
      variant="overlay"
      dismissible={true}
      storageKey="megameal-home-sponsored-overlay-dismissed"
      kicker="Sponsored"
      title="Sponsored"
      footerText="Floating promotions are a service, not an intrusion."
    />
  )}
  {isFirstPage && (
    <div class="portal-snap-section portal-snap-section--eras era-browser-wrapper appear-on-scroll deferred-section">
      <EraBrowser />
    </div>
  )}
</MainGridLayout>

<script>
  const portalScrollCleanupKey = '__megamealPortalScrollCleanup'
  const portalScrollBoundKey = '__megamealPortalScrollBound'

  const initPortalScrollStages = () => {
    ;(window as any)[portalScrollCleanupKey]?.()

    const hasPortal = Boolean(document.getElementById('portal-overview'))
    document.documentElement.classList.toggle('megameal-home-snap', hasPortal)
    document.documentElement.classList.remove('megameal-home-stage-ready')
    if (!hasPortal) return

    const revealObserver = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.add('is-visible')
          revealObserver.unobserve(entry.target)
        }),
      { threshold: 0.02, rootMargin: '0px 0px -8% 0px' }
    )
    document.querySelectorAll('.appear-on-scroll').forEach(el => revealObserver.observe(el))

    const bannerStage = document.getElementById('banner-container')
    bannerStage?.classList.add('portal-snap-stage', 'portal-snap-stage--hero')

    document
      .querySelectorAll('.portal-showcase > .portal-route')
      .forEach(el => el.classList.add('portal-snap-stage', 'portal-snap-stage--destination'))

    const stages = Array.from(
      new Set([
        ...(bannerStage ? [bannerStage] : []),
        ...document.querySelectorAll(
          '.portal-snap-stage, .portal-snap-section:not(.portal-snap-section--destinations)'
        ),
      ])
    )

    if (stages.length === 0) return

    const setCurrentStage = () => {
      const viewportCenter = window.innerHeight * 0.5
      let currentStage: Element | null = null
      let currentDistance = Number.POSITIVE_INFINITY
      let anyVisible = false

      stages.forEach(stage => {
        const rect = stage.getBoundingClientRect()
        if (rect.bottom <= 0 || rect.top >= window.innerHeight) return
        anyVisible = true
        const stageCenter = rect.top + rect.height * 0.5
        const distance = Math.abs(stageCenter - viewportCenter)
        if (distance < currentDistance) {
          currentDistance = distance
          currentStage = stage
        }
      })

      // Only activate the dim effect when we can reliably identify a visible stage.
      // If no stage is in the viewport (layout not settled, or mid-transition),
      // remove the class so nothing gets stuck dim.
      document.documentElement.classList.toggle('megameal-home-stage-ready', anyVisible)

      stages.forEach(stage => {
        const rect = stage.getBoundingClientRect()
        const isApproaching =
          rect.bottom > window.innerHeight * 0.16 &&
          rect.top < window.innerHeight * 0.84

        stage.classList.toggle('is-current', anyVisible && stage === currentStage)
        stage.classList.toggle('is-approaching', anyVisible && stage !== currentStage && isApproaching)
      })
    }

    let frameRequest = 0

    const scheduleCurrentStage = () => {
      if (frameRequest) return
      frameRequest = window.requestAnimationFrame(() => {
        frameRequest = 0
        setCurrentStage()
      })
    }

    const handleScroll = () => {
      scheduleCurrentStage()
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    window.addEventListener('resize', scheduleCurrentStage)

    // Delay the first measurement so layout has settled after the page swap /
    // view-transition animation. A double rAF gets past the first paint frame;
    // the timeout is a safety net for slower devices or deferred content.
    let initialMeasureRaf = 0
    initialMeasureRaf = window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        setCurrentStage()
      })
    })

    const delayedMeasure = window.setTimeout(() => {
      setCurrentStage()
    }, 400)

    ;(window as any)[portalScrollCleanupKey] = () => {
      revealObserver.disconnect()
      window.removeEventListener('scroll', handleScroll)
      window.removeEventListener('resize', scheduleCurrentStage)
      window.cancelAnimationFrame(initialMeasureRaf)
      window.clearTimeout(delayedMeasure)
      if (frameRequest) {
        window.cancelAnimationFrame(frameRequest)
      }
      document.documentElement.classList.remove('megameal-home-stage-ready')
      stages.forEach(stage => stage.classList.remove('is-current', 'is-approaching'))
    }
  }

  initPortalScrollStages()
  if (!(window as any)[portalScrollBoundKey]) {
    document.addEventListener('astro:page-load', initPortalScrollStages)
    ;(window as any)[portalScrollBoundKey] = true
  }
</script>

<style>
  .portal-snap-section {
    position: relative;
    scroll-margin-block-start: 0.75rem;
    transition:
      opacity 0.58s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.58s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.66s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.megameal-home-stage-ready) .portal-snap-section:not(.portal-snap-section--destinations):not(.is-current) {
    opacity: 0.26;
    pointer-events: none;
    filter: saturate(0.72) brightness(0.68) blur(1px);
    transform: translateY(0.38rem) scale(0.995);
  }

  :global(html.megameal-home-stage-ready) .portal-snap-section.is-approaching:not(.portal-snap-section--destinations):not(.is-current) {
    opacity: 0.52;
    filter: saturate(0.88) brightness(0.82) blur(0.35px);
    transform: translateY(0.16rem) scale(0.998);
  }

  .portal-snap-section.is-current,
  .portal-snap-section.is-current.is-visible {
    opacity: 1;
    pointer-events: auto;
    filter: saturate(1) brightness(1);
    transform: none;
    transition-delay: 0s;
  }

  .portal-snap-section--destinations {
    display: block;
  }

  .portal-snap-section--destinations.is-visible {
    opacity: 1;
    filter: saturate(1) brightness(1);
    transform: none;
  }

  :global(.portal-showcase) {
    gap: clamp(2.25rem, 7svh, 5rem);
  }

  :global(.portal-showcase > .portal-route.portal-snap-stage) {
    min-height: min(48rem, calc(100svh - 1.5rem));
  }

  .portal-snap-section--featured,
  .portal-snap-section--dispatches,
  .portal-snap-section--eras {
    min-height: min(48rem, calc(100svh - 1.5rem));
    display: grid;
    align-content: center;
  }

  .portal-snap-section--dispatches {
    align-content: start;
    padding-top: clamp(1rem, 4svh, 2.5rem);
  }

  :global(html.megameal-home-snap) {
    scroll-padding-top: 0.75rem;
  }

  /*
   * Keep this as visual staging, not root-level scroll snapping. The site already
   * runs custom scroll/overlay systems, and CSS snap on html can trap mousewheel
   * movement in Firefox/OverlayScrollbars.
   */
  :global(html.megameal-home-snap #banner-container.portal-snap-stage),
  :global(html.megameal-home-snap .portal-showcase > .portal-route),
  .portal-snap-section:not(.portal-snap-section--destinations) {
    scroll-margin-block-start: 0.75rem;
  }

  :global(#banner-container.portal-snap-stage),
  :global(.portal-showcase > .portal-route.portal-snap-stage) {
    transition:
      opacity 0.58s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.58s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.66s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
   * Synthetic destination cards also carry .card-base, whose global transition
   * uses !important and omits opacity/filter. Override it here so staged cards
   * fade instead of popping when is-current/is-approaching changes.
   */
  :global(.portal-showcase > .portal-route.portal-snap-stage.card-base) {
    transition:
      opacity 0.58s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.58s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.66s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease !important;
  }

  :global(html.megameal-home-stage-ready #banner-container.portal-snap-stage:not(.is-current)),
  :global(html.megameal-home-stage-ready .portal-showcase > .portal-route.portal-snap-stage:not(.is-current)) {
    opacity: 0.26;
    pointer-events: none;
    filter: saturate(0.72) brightness(0.68) blur(1px);
    transform: translateY(0.38rem) scale(0.995);
  }

  :global(html.megameal-home-stage-ready #banner-container.portal-snap-stage.is-approaching:not(.is-current)),
  :global(html.megameal-home-stage-ready .portal-showcase > .portal-route.portal-snap-stage.is-approaching:not(.is-current)) {
    opacity: 0.52;
    filter: saturate(0.88) brightness(0.82) blur(0.35px);
    transform: translateY(0.16rem) scale(0.998);
  }

  :global(#banner-container.portal-snap-stage.is-current),
  :global(.portal-showcase > .portal-route.portal-snap-stage.is-current) {
    opacity: 1;
    pointer-events: auto;
    filter: saturate(1) brightness(1);
    transform: none;
    transition-delay: 0s;
  }

  .dispatches-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid oklch(0.3 0.05 var(--hue) / 0.3);
  }

  .dispatches-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: oklch(0.6 0.1 var(--hue));
    font-weight: 700;
  }

  .dispatches-sub {
    font-size: 0.75rem;
    color: oklch(0.5 0.05 var(--hue));
    font-style: italic;
  }

  .era-browser-wrapper {
    margin-top: 2.5rem;
  }

  @supports (content-visibility: auto) {
    .dispatches-stream {
      content-visibility: auto;
      contain-intrinsic-size: 1px 720px;
    }
  }

  @media (max-width: 48rem) {
    :global(.portal-showcase) {
      gap: clamp(1.25rem, 6svh, 3rem);
    }

    :global(.portal-showcase > .portal-route.portal-snap-stage) {
      min-height: calc(100svh - 4.75rem);
    }

    .portal-snap-section--featured,
    .portal-snap-section--eras {
      min-height: calc(100svh - 4.75rem);
      align-content: center;
    }

    .portal-snap-section--dispatches {
      min-height: auto;
      align-content: start;
    }

    :global(html.megameal-home-stage-ready) .portal-snap-section:not(.portal-snap-section--destinations):not(.is-current) {
      opacity: 0.24;
      pointer-events: none;
      filter: saturate(0.72) brightness(0.68) blur(0.75px);
      transform: translateY(0.28rem) scale(0.996);
    }

    :global(html.megameal-home-stage-ready) .portal-snap-section.is-approaching:not(.portal-snap-section--destinations):not(.is-current) {
      opacity: 0.56;
      filter: saturate(0.9) brightness(0.84) blur(0.25px);
      transform: translateY(0.1rem) scale(0.999);
    }

    :global(html.megameal-home-stage-ready #banner-container.portal-snap-stage:not(.is-current)),
    :global(html.megameal-home-stage-ready .portal-showcase > .portal-route.portal-snap-stage:not(.is-current)) {
      opacity: 0.24;
      pointer-events: none;
      filter: saturate(0.72) brightness(0.68) blur(0.75px);
      transform: translateY(0.28rem) scale(0.996);
    }

    :global(html.megameal-home-stage-ready #banner-container.portal-snap-stage.is-approaching:not(.is-current)),
    :global(html.megameal-home-stage-ready .portal-showcase > .portal-route.portal-snap-stage.is-approaching:not(.is-current)) {
      opacity: 0.56;
      filter: saturate(0.9) brightness(0.84) blur(0.25px);
      transform: translateY(0.1rem) scale(0.999);
    }

    .dispatches-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal-snap-section,
    :global(#banner-container.portal-snap-stage),
    :global(.portal-showcase > .portal-route.portal-snap-stage) {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
