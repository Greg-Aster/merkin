---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import MarketplaceListingCard from '../components/store/MarketplaceListingCard.astro'
import StoreLayout from '../layouts/store/StoreLayout.astro'
import { buildFlagshipProductShowcase } from '../utils/flagship-product-showcase'
import { url } from '../utils/url-utils'

const allProducts = await getCollection(
  'products',
  ({ data }) => data.draft !== true,
)

function resolveAsset(path: string | undefined) {
  if (!path) return undefined
  return path.startsWith('/') ? url(path) : path
}

function getProductHref(product: (typeof allProducts)[number]) {
  return `/store/${product.data.slug ?? product.id.replace(/\.(md|mdx)$/, '')}/`
}

function getPrimaryVisual(product: (typeof allProducts)[number]) {
  const media = product.data.media ?? []
  for (const item of media) {
    if (item.type === 'image' && item.src) return resolveAsset(item.src)
    if (item.thumbnail) return resolveAsset(item.thumbnail)
    if (item.poster) return resolveAsset(item.poster)
    if (item.type === 'youtube' && item.videoId) {
      return `https://img.youtube.com/vi/${item.videoId}/hqdefault.jpg`
    }
  }
  return resolveAsset(product.data.image)
}

allProducts.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1
  if (!a.data.featured && b.data.featured) return 1
  return (b.data.rating ?? 0) - (a.data.rating ?? 0)
})

const featuredProduct = allProducts.find(p => p.data.featured)
const featuredShowcase = featuredProduct
  ? buildFlagshipProductShowcase(featuredProduct, allProducts)
  : null
const spotlightProducts = allProducts
  .filter(product => product.id !== featuredProduct?.id)
  .slice(0, 3)

const categories = [
  { id: 'all', label: 'All Products' },
  { id: 'equipment', label: 'Equipment' },
  { id: 'consumables', label: 'Consumables' },
  { id: 'publications', label: 'Publications' },
  { id: 'companions', label: 'Companions' },
  { id: 'relics', label: 'Relics' },
]

const categoryCounts = Object.fromEntries(
  categories.map(category => [
    category.id,
    category.id === 'all'
      ? allProducts.length
      : allProducts.filter(product => product.data.category === category.id)
          .length,
  ]),
)

const availabilityDisplay: Record<string, string> = {
  available: 'Available Now',
  coming_soon: 'Coming Soon',
  out_of_stock: 'Out of Stock',
  not_in_your_area: 'Not in Your Area',
  not_in_your_timeline: 'Not in Your Timeline',
  artifact_only: 'Artifact Only',
}

const availabilityCounts = Object.entries(availabilityDisplay).map(
  ([availability, label]) => ({
    availability,
    label,
    count: allProducts.filter(
      product => (product.data.availability ?? 'coming_soon') === availability,
    ).length,
  }),
)

const availableNowCount =
  availabilityCounts.find(item => item.availability === 'available')?.count ?? 0
const restrictedCount = allProducts.length - availableNowCount
const companionCount = allProducts.filter(
  product => product.data.category === 'companions',
).length
---

<StoreLayout
	title="Store — MEGA MEAL"
	description="Browse the official MEGA MEAL artifact catalog. Some items are purchasable. Others exist only in adjacent timelines. We apologize for the inconvenience."
>
	<div class="container mx-auto max-w-[86rem] px-4 py-8">
		<div class="mb-8 grid gap-4 xl:grid-cols-[minmax(0,1.1fr)_minmax(22rem,0.7fr)] xl:items-end">
			<div class="space-y-4">
				<div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-slate-900/60 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.24em] text-cyan-200">
					<span class="h-2 w-2 rounded-full bg-cyan-300 shadow-[0_0_12px_rgba(103,232,249,0.8)]"></span>
					Catalog Portal
				</div>
				<div>
					<h1 class="mb-3 text-4xl font-bold text-[var(--primary)] md:text-5xl">
						The Artifact Catalog
					</h1>
					<p class="max-w-3xl text-sm leading-relaxed text-slate-300">
						Official merchandise, domestic companions, relic hardware, and consumer spillover recovered from across the MEGA MEAL timeline. Browse by category, inspect listings, and proceed only if your household is certified for attachment-grade inventory.
					</p>
				</div>
				<div class="grid gap-3 sm:grid-cols-3">
					<div class="rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3">
						<p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500">
							Products
						</p>
						<strong class="mt-1 block text-lg text-slate-100">{allProducts.length}</strong>
						<span class="text-xs text-slate-400">Visible in this timeline</span>
					</div>
					<div class="rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3">
						<p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500">
							Immediate Purchase
						</p>
						<strong class="mt-1 block text-lg text-slate-100">{availableNowCount}</strong>
						<span class="text-xs text-slate-400">Cleared for regional checkout</span>
					</div>
					<div class="rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3">
						<p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500">
							Restricted
						</p>
						<strong class="mt-1 block text-lg text-slate-100">{restrictedCount}</strong>
						<span class="text-xs text-slate-400">Visible, delayed, or unavailable</span>
					</div>
				</div>
			</div>

			<aside class="rounded-[1.6rem] border border-slate-700/70 bg-[linear-gradient(180deg,rgba(15,23,42,0.92),rgba(2,6,23,0.96))] p-5 shadow-2xl">
				<p class="text-[10px] font-bold uppercase tracking-[0.24em] text-cyan-200">
					Catalog Advisory
				</p>
				<p class="mt-3 text-sm leading-relaxed text-slate-300">
					Items marked <em>Available Now</em> may be purchased in this timeline. Listings marked <em>Artifact Record</em>, <em>Not In Your Area</em>, or <em>Not In Your Timeline</em> remain viewable for research, longing, and extremely poor decision-making.
				</p>
				<div class="mt-4 flex flex-wrap gap-2">
					{Object.entries(availabilityDisplay).slice(0, 4).map(([, label]) => (
						<span class="rounded-full border border-slate-700/70 bg-slate-900/70 px-3 py-1 text-[11px] text-slate-300">
							{label}
						</span>
					))}
				</div>
			</aside>
		</div>

		{featuredProduct && featuredShowcase && (
			<section class="storefront-featured-listing mb-10">
				<div class="storefront-featured-listing__inner overflow-hidden rounded-[1.9rem] border border-slate-700/70 bg-[linear-gradient(180deg,rgba(15,23,42,0.94),rgba(2,6,23,0.98))] shadow-[0_30px_80px_rgba(2,6,23,0.45)]">
					<div class="relative p-6 md:p-8">
					<div class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full bg-[var(--primary)]/90 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
						Featured Listing
					</div>
					<div class="grid items-center gap-8 pt-8 xl:grid-cols-[minmax(0,1.1fr)_minmax(24rem,0.9fr)]">
						<div class="relative aspect-[16/10] overflow-hidden rounded-[1.4rem] border border-slate-700/60 bg-slate-900">
							{(() => {
								const media = featuredProduct.data.media;
								const img = featuredProduct.data.image;
								const first = Array.isArray(media) && media.length > 0 ? media[0] : null;
								if (first?.type === "youtube") {
									return (
										<div class="relative h-full w-full">
											<img
												src={`https://img.youtube.com/vi/${first.videoId}/hqdefault.jpg`}
												alt={featuredProduct.data.name}
												class="h-full w-full object-cover"
											/>
											<div class="absolute inset-0 flex items-center justify-center bg-black/30">
												<a
													href={getProductHref(featuredProduct)}
													data-sfx-hover="hover-emphasis"
													data-sfx-click="sweep"
													class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600/90 shadow-xl transition hover:bg-red-600"
													aria-label="View product"
												>
													<svg viewBox="0 0 24 24" fill="white" class="ml-1 h-8 w-8">
														<path d="M8 5v14l11-7z"></path>
													</svg>
												</a>
											</div>
										</div>
									);
								}
								const src = first?.type === "image" ? resolveAsset(first.src) : resolveAsset(img);
								return src ? (
									<img src={src} alt={featuredProduct.data.name} class="h-full w-full object-cover" />
								) : (
									<div class="flex h-full w-full items-center justify-center text-slate-600">
										<Icon name="mdi:image-off-outline" class="h-12 w-12 opacity-30" />
									</div>
								);
							})()}
						</div>
						<div class="space-y-4">
							<div class="flex flex-wrap items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-slate-500">
								<span>{featuredProduct.data.category ?? "Product"}</span>
								<span>•</span>
								<span>{availabilityDisplay[featuredProduct.data.availability ?? "coming_soon"] ?? "Catalog Entry"}</span>
								{featuredProduct.data.rating && (
									<>
										<span>•</span>
										<span>{featuredProduct.data.rating.toFixed(1)} rating</span>
									</>
								)}
							</div>
							<h2 class="text-3xl font-bold text-slate-100">{featuredProduct.data.name}</h2>
							{featuredProduct.data.tagline && (
								<p class="text-sm italic text-slate-300">"{featuredProduct.data.tagline}"</p>
							)}
							{featuredProduct.data.description && (
								<p class="text-sm leading-relaxed text-slate-300">
									{featuredProduct.data.description}
								</p>
							)}
							<div class="grid gap-3 sm:grid-cols-3">
								<div class="rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3">
									<p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500">
										Primary Asset
									</p>
									<strong class="mt-1 block text-sm text-slate-100">
										{featuredShowcase.product.media[0]?.type ?? "listing"}
									</strong>
									<span class="text-xs text-slate-400">First contact surface</span>
								</div>
								<div class="rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3">
									<p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500">
										Reviews
									</p>
									<strong class="mt-1 block text-sm text-slate-100">
										{featuredShowcase.product.reviews.length}
									</strong>
									<span class="text-xs text-slate-400">Consumer accounts on file</span>
								</div>
								<div class="rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3">
									<p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500">
										Questions
									</p>
									<strong class="mt-1 block text-sm text-slate-100">
										{featuredShowcase.product.qanda.length}
									</strong>
									<span class="text-xs text-slate-400">Clarifications available</span>
								</div>
							</div>
							<div class="flex flex-wrap items-center gap-4">
								{featuredProduct.data.price && (
									<span class="text-xl font-bold text-emerald-400">
										${featuredProduct.data.price.toFixed(2)}
									</span>
								)}
									<a
										href={getProductHref(featuredProduct)}
										data-sfx-hover="hover-emphasis"
										data-sfx-click="sweep"
										class="btn-primary rounded-[var(--radius-medium)] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover)]"
									>
									View Product
								</a>
								<span class="text-xs text-slate-500">
									Use the full listing to inspect media, reviews, and attached disclosures.
								</span>
							</div>
						</div>
					</div>
				</div>
				</div>
			</section>
		)}

		<div class="storefront-marketplace">
			<aside class="storefront-marketplace__sidebar">
				<section class="storefront-panel">
					<div class="storefront-panel__header">
						<p>Channel Filters</p>
						<h2>Browse By Category</h2>
					</div>
					<div class="storefront-category-list" role="group" aria-label="Filter by category">
						{categories.map((category) => (
								<button
									type="button"
									data-category={category.id}
									data-active={category.id === "all" ? "true" : "false"}
									data-sfx-hover="hover-soft"
									data-sfx-click="soft"
									class="category-filter storefront-filter-button"
								>
								<span>{category.label}</span>
								<strong>{categoryCounts[category.id]}</strong>
							</button>
						))}
					</div>
				</section>

				<section class="storefront-panel">
					<div class="storefront-panel__header">
						<p>Availability Matrix</p>
						<h2>Fulfillment Status</h2>
					</div>
					<div class="storefront-stat-stack">
						{availabilityCounts.map((item) => (
							<div class="storefront-stat-row">
								<span>{item.label}</span>
								<strong>{item.count}</strong>
							</div>
						))}
					</div>
				</section>

				<section class="storefront-panel storefront-panel--signal">
					<div class="storefront-panel__header">
						<p>Market Signal</p>
						<h2>Recommended Route</h2>
					</div>
					<div class="storefront-signal-grid">
						<div>
							<span>Fastest entry</span>
							<strong>{availableNowCount} purchasable listings</strong>
						</div>
						<div>
							<span>Highest tension</span>
							<strong>{companionCount} companion entries</strong>
						</div>
						<div>
							<span>Archive drift</span>
							<strong>{restrictedCount} restricted or delayed listings</strong>
						</div>
					</div>
					<p class="storefront-panel__copy">
						Start with approved listings if you want a normal shopping surface. Start with companions if you want the catalog to answer back.
					</p>
				</section>
			</aside>

			<div class="storefront-marketplace__main">
				<div class="storefront-toolbar">
					<div>
						<p class="storefront-toolbar__kicker">Marketplace Board</p>
						<h2>Current Listings</h2>
					</div>
					<div class="storefront-toolbar__controls">
						<span id="product-count">{allProducts.length} products</span>
							<select
								id="sort-select"
								data-sfx-focus="focus-soft"
								class="storefront-sort-select"
								aria-label="Sort products"
							>
							<option value="featured">Featured</option>
							<option value="rating">Top Rated</option>
							<option value="price-asc">Price: Low to High</option>
							<option value="price-desc">Price: High to Low</option>
							<option value="available">Available First</option>
						</select>
					</div>
				</div>

				{spotlightProducts.length > 0 && (
					<section class="storefront-spotlight">
						<div class="storefront-panel__header">
							<p>Sponsored Shelf</p>
							<h2>Secondary Signals</h2>
						</div>
						<div class="storefront-spotlight__grid">
								{spotlightProducts.map((product) => (
									<a href={getProductHref(product)} data-sfx-hover="hover-soft" data-sfx-click="soft" class="storefront-spotlight__card">
									<div class="storefront-spotlight__media">
										{getPrimaryVisual(product) ? (
											<img
												src={getPrimaryVisual(product)}
												alt={product.data.name}
												loading="lazy"
											/>
										) : (
											<div class="storefront-spotlight__placeholder">
												<Icon name="mdi:image-off-outline" class="h-8 w-8 opacity-30" />
											</div>
										)}
									</div>
									<div class="storefront-spotlight__body">
										<p>{product.data.category ?? "catalog entry"}</p>
										<h3>{product.data.name}</h3>
										{product.data.tagline && (
											<span>"{product.data.tagline}"</span>
										)}
										<strong>
											{typeof product.data.price === "number"
												? `$${product.data.price.toFixed(2)}`
												: availabilityDisplay[product.data.availability ?? "coming_soon"]}
										</strong>
									</div>
								</a>
							))}
						</div>
					</section>
				)}

				{allProducts.length === 0 ? (
					<div class="py-24 text-center text-slate-500">
						<Icon name="mdi:package-variant-remove" class="mx-auto mb-4 h-16 w-16 opacity-30" />
						<p class="text-xl italic">Our shelves are currently empty. How ominous.</p>
					</div>
				) : (
					<div id="product-grid" class="storefront-marketplace__grid">
						{allProducts.map((product) => (
							<div
								class="product-grid-item"
								data-category={product.data.category ?? "uncategorized"}
								data-availability={product.data.availability ?? "coming_soon"}
								data-price={product.data.price ?? 0}
								data-rating={product.data.rating ?? 0}
								data-featured={product.data.featured ? "1" : "0"}
							>
								<MarketplaceListingCard product={product} />
							</div>
						))}
					</div>
				)}

				<div id="no-results" class="hidden py-16 text-center text-slate-500">
					<Icon name="mdi:filter-remove-outline" class="mx-auto mb-3 h-12 w-12 opacity-30" />
					<p class="italic">No products match this filter in your timeline.</p>
						<button
							type="button"
							data-category="all"
							data-sfx-hover="hover-soft"
							data-sfx-click="panel-back"
							class="category-filter mt-3 text-xs text-[var(--primary)] hover:underline"
						>
						Clear filter
					</button>
				</div>
			</div>
		</div>
	</div>
</StoreLayout>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const items = Array.from(
			document.querySelectorAll<HTMLElement>(".product-grid-item"),
		);
		const grid = document.getElementById("product-grid");
		const noResults = document.getElementById("no-results");
		const countEl = document.getElementById("product-count");
		const sortSelect = document.getElementById(
			"sort-select",
		) as HTMLSelectElement | null;

		let activeCategory = "all";

		function applyFilter() {
			let visible = 0;
			for (const item of items) {
				const category = item.dataset.category ?? "";
				const show = activeCategory === "all" || category === activeCategory;
				item.classList.toggle("hidden", !show);
				if (show) visible += 1;
			}

			if (countEl) {
				countEl.textContent = `${visible} product${visible !== 1 ? "s" : ""}`;
			}
			noResults?.classList.toggle("hidden", visible > 0);
			grid?.classList.toggle("hidden", visible === 0);
		}

		function applySort(value: string) {
			if (!grid) return;

			const sorted = [...items].sort((a, b) => {
				switch (value) {
					case "rating":
						return (
							parseFloat(b.dataset.rating ?? "0") -
							parseFloat(a.dataset.rating ?? "0")
						);
					case "price-asc":
						return (
							parseFloat(a.dataset.price ?? "0") -
							parseFloat(b.dataset.price ?? "0")
						);
					case "price-desc":
						return (
							parseFloat(b.dataset.price ?? "0") -
							parseFloat(a.dataset.price ?? "0")
						);
					case "available":
						return (
							(a.dataset.availability === "available" ? 0 : 1) -
							(b.dataset.availability === "available" ? 0 : 1)
						);
					default:
						return (
							parseInt(b.dataset.featured ?? "0") -
							parseInt(a.dataset.featured ?? "0")
						);
				}
			});

			for (const item of sorted) grid.appendChild(item);
		}

		document.querySelectorAll<HTMLButtonElement>(".category-filter").forEach((button) => {
			button.addEventListener("click", () => {
				activeCategory = button.dataset.category ?? "all";

				document
					.querySelectorAll<HTMLButtonElement>(".category-filter")
					.forEach((candidate) => {
						candidate.dataset.active =
							candidate.dataset.category === activeCategory ? "true" : "false";
					});

				applyFilter();
			});
		});

		sortSelect?.addEventListener("change", () => applySort(sortSelect.value));
	});
</script>

<style>
	.storefront-marketplace {
		display: grid;
		gap: 1rem;
		align-items: start;
	}

	.storefront-featured-listing {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		padding-inline: clamp(1rem, 4vw, 2rem);
	}

	.storefront-featured-listing__inner {
		width: 100%;
	}

	.storefront-marketplace__sidebar,
	.storefront-marketplace__main {
		display: grid;
		gap: 1rem;
	}

	.storefront-panel,
	.storefront-toolbar,
	.storefront-spotlight,
	.storefront-marketplace__grid {
		border: 1px solid rgb(51 65 85 / 0.62);
		border-radius: 1.5rem;
		background:
			radial-gradient(circle at 12% 12%, rgb(255 255 255 / 0.05), transparent 26%),
			linear-gradient(180deg, rgb(15 23 42 / 0.92), rgb(2 6 23 / 0.98));
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.04),
			0 24px 70px rgb(2 6 23 / 0.26);
	}

	.storefront-panel {
		padding: 1rem;
	}

	.storefront-panel__header {
		margin-bottom: 0.9rem;
	}

	.storefront-panel__header p,
	.storefront-toolbar__kicker,
	.storefront-spotlight__body p {
		margin: 0 0 0.28rem;
		color: rgb(125 211 252 / 0.82);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.storefront-panel__header h2,
	.storefront-toolbar h2 {
		margin: 0;
		color: rgb(241 245 249);
		font-size: 1.12rem;
	}

	.storefront-category-list,
	.storefront-stat-stack,
	.storefront-signal-grid {
		display: grid;
		gap: 0.65rem;
	}

	.storefront-filter-button,
	.storefront-stat-row,
	.storefront-signal-grid div {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		padding: 0.8rem 0.9rem;
		border: 1px solid rgb(51 65 85 / 0.64);
		border-radius: 1rem;
		background: rgb(15 23 42 / 0.58);
		color: rgb(226 232 240);
		transition:
			border-color 180ms ease,
			background-color 180ms ease,
			transform 180ms ease;
	}

	.storefront-filter-button {
		width: 100%;
		cursor: pointer;
