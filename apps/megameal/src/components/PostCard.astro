---
// src/components/PostCard.astro
// UNIFIED: Single responsive system that works the same across all screen sizes

import path from 'path'
import { Icon } from 'astro-icon/components'
import { postCardConfig } from '../config/postcard.config'
import I18nKey from '../i18n/i18nKey'
import { i18n } from '../i18n/translation'
import { getDir } from '../utils/url-utils'
import ImageWrapper from './misc/ImageWrapper.astro'

interface Props {
  class?: string
  entry: any
  title: string
  url: string
  published: Date
  updated?: Date
  category: string
  image: string
  description: string
  draft: boolean
  style?: string
  isPostPage?: boolean
}

const {
  entry,
  title,
  url,
  published,
  updated,
  category,
  image,
  description,
  style = '',
  isPostPage = false,
} = Astro.props

const contentFormat = entry.data?.contentFormat as string | undefined
const series = entry.data?.series as string | undefined
const seriesPart = entry.data?.seriesPart as number | undefined
const seriesTitle = entry.data?.seriesTitle as string | undefined

const FORMAT_LABELS: Record<string, string> = {
  chronicle: '📖 Chronicle',
  recipe: '🍽️ Recipe',
  review: '🌟 Review',
  report: '📋 Report',
  commercial: '📡 Commercial',
  manual: '📘 Manual',
  update: '📡 Update',
  classified: '☢️ Classified',
}

const className = Astro.props.class

const hasCover =
  image !== undefined &&
  image !== null &&
  image !== '' &&
  (!isPostPage || (isPostPage && entry.data.showImageOnPost !== false))

const config = postCardConfig.localPosts
const { remarkPluginFrontmatter } = await entry.render()

const timestamp = published.getTime()
const dateStr = published.toISOString().split('T')[0]
const mobileMetaDate = published.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
})
---

<!-- UNIFIED: Same horizontal flexbox layout for all screen sizes -->
<div
  class:list={[
    "card-base megameal-surface megameal-surface--interactive w-full overflow-hidden relative local-post",
    "flex flex-row-reverse postcard-shell", // Images on right side for all screen sizes
    // 🎯 RESPONSIVE HEIGHTS - compact on mobile, comfortable on desktop
    "h-[10rem] sm:h-[10.5rem] md:h-[12rem] lg:h-[14rem]",
    config.layout.cardBorderRadius, 
    className
  ]}
  style={style}
  data-post-type="local"
  data-post-id={entry.id}
  data-post-date={dateStr}
  data-post-timestamp={timestamp}
  data-post-category={category?.toLowerCase()}
  data-post-image={image}
  data-post-description={description}>
  
  <!-- IMAGE SECTION: Consistent across all screen sizes -->
  {hasCover && (
    <a href={url} 
       aria-label={title}
       class:list={[
         "group relative rounded-xl overflow-hidden bg-black shrink-0 postcard-cover-link",
         "m-2 sm:m-3", // 🎯 RESPONSIVE MARGINS - tighter on mobile
         // 🎯 RESPONSIVE IMAGE SIZING - proportional to card height
         "w-28 sm:w-36 md:w-44 lg:w-52"
       ]}>
      
      <!-- Blurred background -->
      <div class="absolute inset-0 blur-background">
        <ImageWrapper 
          src={image} 
          basePath={path.join("content/posts/", getDir(entry.id))} 
          alt=""
          class="w-full h-full object-cover blur-md scale-110 opacity-60" />
      </div>
      
      <!-- Hover effects -->
      <div class="absolute pointer-events-none z-10 w-full h-full postcard-cover-overlay"></div>
      <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center postcard-cover-chevron">
        <Icon 
          name="material-symbols:chevron-right-rounded"
          class="text-white text-5xl" />
      </div>
      
      <!-- Main image -->
      <div class="absolute inset-0 main-image z-5">
        <ImageWrapper 
          src={image} 
          basePath={path.join("content/posts/", getDir(entry.id))} 
          alt="Cover Image of the Post"
          class="postcard-image postcard-image-fix w-full h-full object-cover" />
      </div>
    </a>
  )}

  <!-- CONTENT SECTION: Fixed spacing layout with responsive padding -->
  <div class="flex flex-col flex-1">
    <div class="postcard-mobile-meta hidden items-center gap-2 text-[0.72rem] font-medium uppercase tracking-[0.08em]">
      <time datetime={published.toISOString()}>{mobileMetaDate}</time>
      {category && (
        <>
          <span class="postcard-meta-separator">•</span>
          <span>{category}</span>
        </>
      )}
    </div>
    <div class="postcard-content flex flex-col flex-1 p-3 sm:p-4 py-4 sm:py-5 pr-2 sm:pr-3 pl-6 sm:pl-8">
    <!-- Note: Removed justify-between for fixed spacing control -->
    
    <!-- TOP SECTION: Title and Metadata -->
    <div class="flex-shrink-0">
      <!-- TITLE - 🎯 RESPONSIVE TEXT SIZING -->
      <a href={url}
         class:list={[
           "transition group w-full block font-bold mb-2 sm:mb-3 text-90 postcard-title-link",
           // 🎯 RESPONSIVE TITLE SIZE - scales properly on all devices
           "text-base sm:text-2xl md:text-3xl lg:text-4xl",
           // Simple hover effect for all sizes
           "relative",
           // Blue accent line on the left - responsive spacing
           "before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]",
           "before:absolute before:top-2 before:-left-4 before:block"
         ]}>
        {title}
      </a>

      <!-- METADATA: Show on larger screens - 🎯 RESPONSIVE SIZING -->
      <div class="postcard-desktop-meta mb-2 sm:mb-3 hidden md:flex gap-3 items-center flex-wrap text-xs md:text-sm">
        {contentFormat && FORMAT_LABELS[contentFormat] && (
          <span class="format-badge">{FORMAT_LABELS[contentFormat]}</span>
        )}
        <time datetime={published.toISOString()}>
          {published.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          })}
        </time>
        {updated && config.content.showUpdateDate && (
          <>
            <span class="postcard-meta-separator">•</span>
            <span>Updated {updated.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })}</span>
          </>
        )}
        {category && (
          <>
            <span class="postcard-meta-separator">•</span>
            <span class="capitalize">{category}</span>
          </>
        )}
      </div>
    </div>

    <!-- DESCRIPTION SECTION: Progressive responsive spacing from title/metadata -->
    <div class="mt-2 sm:mt-3 md:mt-4 lg:mt-5 space-y-2 sm:space-y-3"> <!-- 🎯 PROGRESSIVE RESPONSIVE SPACING -->
      
      <!-- DESCRIPTION - 🎯 RESPONSIVE TEXT SIZING -->
      <div class:list={[
        "transition text-75 postcard-description",
        // 🎯 RESPONSIVE DESCRIPTION SIZE - smaller on mobile, comfortable on desktop
        "text-sm sm:text-base md:text-base",
        "line-clamp-2 md:line-clamp-3", // Simple responsive line clamping
        "text-ellipsis overflow-hidden", // Ensure proper ellipsis handling
      ]}>
        {description || remarkPluginFrontmatter.excerpt}
      </div>

      <!-- SERIES INDICATOR -->
      {series && (
        <div class="series-indicator">
          {seriesPart !== undefined ? `Part ${seriesPart}` : 'Part of'}{' '}
          <span class="series-name">{seriesTitle ?? series}</span>
        </div>
      )}

      <!-- WORD COUNT AND READ TIME - 🎯 ALREADY RESPONSIVE -->
      {(config.content.showWordCount || config.content.showReadTime) && (
        <div class="postcard-reading-meta text-xs md:text-sm flex gap-3 transition">
          {config.content.showWordCount && (
            <div>{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
          )}
          {config.content.showWordCount && config.content.showReadTime && <div>|</div>}
          {config.content.showReadTime && (
            <div>{remarkPluginFrontmatter.minutes} {" " + i18n(I18nKey.minutesCount)}</div>
          )}
        </div>
      )}
    </div>
  </div>
</div>

<!-- ENTER BUTTON: Simplified for cards without cover (positioned on right) -->
{!hasCover && config.layout.showEnterButton && (
  <a href={url} 
     aria-label={title} 
     class="hidden md:flex btn-regular w-12 h-12 m-4 mr-4 rounded-xl bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95 items-center justify-center flex-shrink-0">
    <Icon 
      name="material-symbols:chevron-right-rounded"
      class="transition text-[var(--primary)] text-2xl" />
  </a>
)}
</div>



<style>
  .postcard-shell {
    --megameal-surface-border: oklch(0.36 0.05 var(--hue) / 0.34);
    --megameal-surface-hover-border: oklch(0.58 0.12 var(--hue) / 0.46);
    --megameal-surface-bg:
      radial-gradient(circle at top left, oklch(0.52 0.11 var(--hue) / 0.12), transparent 30%),
      linear-gradient(180deg, oklch(0.16 0.03 var(--hue) / 0.72), oklch(0.13 0.03 var(--hue) / 0.62));
    --megameal-surface-filter: blur(18px) saturate(1.1);
    --megameal-surface-shadow:
      0 16px 34px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    --megameal-surface-hover-shadow:
      0 0 0 1px oklch(0.58 0.12 var(--hue) / 0.24),
      0 22px 44px rgba(0, 0, 0, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    --megameal-surface-sheen:
      linear-gradient(120deg, rgba(255, 255, 255, 0.06), transparent 34%),
      linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.03));
  }

  .blur-background {
    z-index: 1;
  }
  
  .main-image {
    z-index: 5;
  }

  .postcard-cover-link {
    border: 1px solid oklch(0.42 0.06 var(--hue) / 0.35);
    background: oklch(0.14 0.03 var(--hue) / 0.65);
    box-shadow:
      0 12px 26px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .postcard-cover-overlay {
    background:
      linear-gradient(180deg, rgba(5, 10, 18, 0.05), rgba(5, 10, 18, 0.28)),
      radial-gradient(circle at center, transparent 20%, rgba(5, 10, 18, 0.22) 100%);
    transition: background 0.3s ease, opacity 0.3s ease;
  }

  .postcard-cover-chevron {
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .postcard-shell:hover .postcard-cover-overlay {
    background:
      linear-gradient(180deg, rgba(5, 10, 18, 0.08), rgba(5, 10, 18, 0.4)),
      radial-gradient(circle at center, transparent 10%, rgba(10, 18, 28, 0.28) 100%);
  }

  .postcard-shell:hover .postcard-cover-chevron {
    opacity: 1;
    transform: scale(1);
  }

  .postcard-image {
    object-fit: cover !important;
    width: 100% !important;
    height: 100% !important;
  }

  .postcard-content {
    position: relative;
    z-index: 1;
  }

  .postcard-mobile-meta,
  .postcard-desktop-meta {
    color: oklch(0.78 0.03 var(--hue) / 0.78);
  }

  .postcard-meta-separator,
  .postcard-reading-meta {
    color: oklch(0.72 0.03 var(--hue) / 0.48);
  }

  .postcard-title-link {
    color: white;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.18);
  }

  .postcard-title-link::before {
    background: linear-gradient(180deg, oklch(0.76 0.16 var(--hue)), oklch(0.66 0.15 var(--hue)));
    box-shadow: 0 0 14px oklch(0.72 0.14 var(--hue) / 0.38);
  }

  .postcard-shell:hover .postcard-title-link {
    color: oklch(0.9 0.03 var(--hue));
  }

  .postcard-description {
    color: oklch(0.8 0.03 var(--hue) / 0.88);
  }

  /* Ensure line-clamp works properly with ellipsis */
  .line-clamp-2,
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .line-clamp-2 {
    -webkit-line-clamp: 2;
  }

  .line-clamp-3 {
    -webkit-line-clamp: 3;
  }

  .format-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, oklch(0.76 0.16 var(--hue)) 18%, rgba(255, 255, 255, 0.05));
    color: oklch(0.88 0.04 var(--hue));
    border: 1px solid oklch(0.55 0.08 var(--hue) / 0.3);
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .series-indicator {
    font-size: 0.74rem;
    color: oklch(0.78 0.06 var(--hue) / 0.78);
    font-style: italic;
  }

  .series-name {
    font-weight: 600;
    font-style: normal;
    color: oklch(0.88 0.06 var(--hue));
  }

  @media (max-width: 640px) {
    .postcard-shell {
      backdrop-filter: blur(14px) saturate(1.08);
    }

    .postcard-content {
      padding-left: 1.2rem;
    }

    .postcard-title-link::before {
      left: -0.9rem;
    }
  }

</style>
