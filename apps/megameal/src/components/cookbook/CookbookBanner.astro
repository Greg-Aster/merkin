---
import { Icon } from 'astro-icon/components'

interface CookbookEntry {
  slug: string
  data: {
    title: string
    description?: string
    image?: string
    section?: string
    page?: number
  }
}

interface Props {
  entries: CookbookEntry[]
  activeSlug?: string
}

const { entries, activeSlug = '' } = Astro.props
const navigationEntries = [...entries].sort(
  (a, b) => (a.data.page ?? 999) - (b.data.page ?? 999),
)
const activeEntry =
  navigationEntries.find(entry => entry.slug === activeSlug) ??
  navigationEntries[0] ??
  null
const recipeCount = navigationEntries.length

function cookbookHrefForEntry(entry: CookbookEntry) {
  return entry.slug === 'cookbook-index' ? '/cookbook/' : `/cookbook/${entry.slug}/`
}

const sectionGroups = navigationEntries.reduce<
  Array<{ title: string; items: CookbookEntry[] }>
>((groups, entry) => {
  const title = entry.data.section || 'Cookbook'
  const existing = groups.find(group => group.title === title)

  if (existing) {
    existing.items.push(entry)
    return groups
  }

  groups.push({ title, items: [entry] })
  return groups
}, [])
---

<section
  class="relative h-full w-full overflow-hidden bg-black text-stone-950"
  aria-label="Cookbook navigation"
>
  <img
    src="/assets/banner/cookbook-open-book.webp"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full scale-[1.01] object-cover object-[center_42%] blur-[1.25px]"
  />
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgba(255,210,150,0.1),transparent_32%),linear-gradient(180deg,rgba(0,0,0,0.38),transparent_20%,transparent_72%,rgba(0,0,0,0.5))]"></div>

  <div class="absolute z-10 grid grid-cols-2 gap-[6%] font-serif text-[#160b05] [text-shadow:0_1px_0_rgba(255,236,190,0.38),0_0_10px_rgba(255,218,145,0.2)] left-[8%] right-[8%] top-[24%] bottom-[24%] md:left-[26%] md:right-[25%] md:top-[18%] md:bottom-[19%] md:gap-[8%] lg:left-[27%] lg:right-[24%]">
    <div class="relative isolate grid min-w-0 content-start md:pt-4">
      <div class="pointer-events-none absolute -inset-x-2 -inset-y-2 -z-10 rounded-[3px] bg-[radial-gradient(circle_at_48%_38%,rgba(246,214,151,0.46),rgba(235,181,103,0.18)_48%,transparent_76%)] opacity-90 md:-inset-x-5 md:-inset-y-4"></div>

      <div class="flex items-center gap-1.5 text-[0.54rem] font-black uppercase tracking-[0.16em] text-[#3a2010]/82 md:text-[0.82rem] md:tracking-[0.16em]">
        <Icon name="material-symbols:menu-book-outline-rounded" class="text-xs text-[#4c2d1b]/62 md:text-sm" />
        <span>
          Cookbook
        </span>
      </div>

      <p class="mt-1 text-[1.3rem] font-black leading-[0.95] text-[#120803] sm:text-2xl md:mt-3 md:max-w-[24rem] md:text-[3.2rem] md:leading-[0.86] xl:text-[3.55rem]">
        The Galactic Cookbook
      </p>
      <p class="mt-1 line-clamp-3 text-[0.74rem] font-semibold leading-snug text-[#201007]/88 md:mt-5 md:max-w-[22rem] md:text-[1.2rem] md:leading-relaxed">
        Recipes, substitutions, and culinary field notes from the live archive.
      </p>

      <div class="mt-3 flex w-full items-end justify-between gap-2 border-y border-[#2d1608]/38 py-1.5 md:mt-7 md:max-w-[22rem] md:gap-5 md:py-3">
        <div class="grid grid-cols-2 gap-3 md:gap-5">
          <div>
            <div class="text-[0.52rem] font-black uppercase tracking-[0.14em] text-[#321909]/76 md:text-[0.72rem]">
              Pages
            </div>
            <div class="mt-0.5 text-lg font-black leading-none text-[#120803] md:text-3xl">{recipeCount}</div>
          </div>
          <div>
            <div class="text-[0.52rem] font-black uppercase tracking-[0.14em] text-[#321909]/76 md:text-[0.72rem]">
              Current
            </div>
            <div class="mt-0.5 text-lg font-black leading-none text-[#120803] md:text-3xl">
              {activeEntry?.data.page ?? 1}
            </div>
          </div>
        </div>

        <a
          href="#cookbook-reader"
          class="inline-flex min-h-8 items-center gap-1 border-b-2 border-[#2d1608]/52 text-[0.56rem] font-black uppercase tracking-[0.14em] text-[#120803] transition hover:border-[#120803] hover:bg-[#f4d48e]/20 hover:text-[#3a1b09] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3a1b09]/70 active:scale-[0.98] md:min-h-10 md:text-[0.86rem]"
          data-sfx-hover="hover-soft"
          data-sfx-click="soft"
        >
          Read
          <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-sm text-[#4a2b18]/70 md:text-base" />
        </a>
      </div>
    </div>

    <nav
      class="relative isolate grid min-w-0 content-start md:pt-4"
      aria-label="Cookbook pages"
    >
      <div class="pointer-events-none absolute -inset-x-2 -inset-y-2 -z-10 rounded-[3px] bg-[radial-gradient(circle_at_48%_34%,rgba(246,214,151,0.42),rgba(235,181,103,0.16)_50%,transparent_78%)] opacity-90 md:-inset-x-5 md:-inset-y-4"></div>

      <div class="mb-1.5 flex items-end justify-between gap-3 border-b border-[#2d1608]/38 pb-1.5 md:mb-4 md:max-w-[22rem] md:pb-2.5">
        <div>
          <div class="text-[0.54rem] font-black uppercase tracking-[0.16em] text-[#321909]/82 md:text-[0.82rem] md:tracking-[0.16em]">
            Contents
          </div>
          <div class="mt-0.5 line-clamp-2 text-[0.66rem] font-semibold italic leading-snug text-[#201007]/82 md:text-lg">
            Select a page to open its post or recipe.
          </div>
        </div>
        <Icon name="material-symbols:menu-book-outline-rounded" class="hidden text-xl text-[#4a2b18]/42 md:block" />
      </div>

      <div class="hidden min-h-0 max-w-[22rem] content-start gap-y-3 overflow-y-auto pr-1 md:grid md:grid-cols-1">
        {sectionGroups.map(group => (
          <section class="min-w-0">
            <div class="mb-1 text-[0.72rem] font-black uppercase tracking-[0.13em] text-[#321909]/72">
              {group.title}
            </div>
            <div class="grid">
              {group.items.map(entry => {
                const href = cookbookHrefForEntry(entry)
                const isActive = entry.slug === activeSlug

                return (
                  <a
                    href={href}
                    class:list={[
                      'group -mx-1 grid grid-cols-[minmax(0,1fr)_3.25rem] items-baseline gap-3 rounded-[2px] px-1 py-1.5 text-[#160b05] transition hover:bg-[#f4d48e]/22 hover:text-[#351907] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[#3a1b09]/70 active:scale-[0.99]',
                      isActive
                        ? 'font-black'
                        : 'font-bold',
                    ]}
                    aria-current={isActive ? 'page' : undefined}
                    data-sfx-hover="hover-soft"
                    data-sfx-click="soft"
                  >
                    <span class="min-w-0">
                      <span class="line-clamp-2 block text-base leading-tight">
                        {entry.data.title}
                      </span>
                      <span class:list={[
                        'mt-0.5 block h-px bg-[#2d1608]/34 transition group-hover:bg-[#2d1608]/70',
                        isActive ? 'bg-[#2d1608]/80' : '',
                      ]}>
                      </span>
                    </span>
                    <span class="inline-flex items-center gap-1 justify-self-end text-[0.95rem] font-black leading-none text-[#2a1407]/86">
                      <span>{entry.data.page ?? 1}</span>
                      <Icon name="material-symbols:arrow-forward-rounded" class="text-sm opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
                    </span>
                  </a>
                )
              })}
            </div>
          </section>
        ))}
      </div>

      <div class="grid min-w-0 gap-y-1.5 md:hidden">
        {navigationEntries.map(entry => {
          const href = cookbookHrefForEntry(entry)
          const isActive = entry.slug === activeSlug

          return (
            <a
              href={href}
              class:list={[
                'group grid grid-cols-[minmax(0,1fr)_2rem] items-baseline gap-1.5 border-b border-[#2d1608]/34 py-1 text-[#160b05] transition hover:bg-[#f4d48e]/22 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[#3a1b09]/70 active:scale-[0.98]',
                isActive
                  ? 'font-black'
                  : 'font-bold',
              ]}
              aria-current={isActive ? 'page' : undefined}
              data-sfx-hover="hover-soft"
              data-sfx-click="soft"
            >
              <span class="line-clamp-2 min-w-0 text-[0.72rem] leading-tight">
                {entry.data.title}
              </span>
              <span class="inline-flex items-center gap-0.5 justify-self-end text-[0.66rem] font-black text-[#2a1407]/82">
                <span>{entry.data.page ?? 1}</span>
                <Icon name="material-symbols:arrow-forward-rounded" class="text-[0.65rem] opacity-65 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
              </span>
            </a>
          )
        })}
      </div>
    </nav>
  </div>
</section>

<style is:global>
  #banner-container.has-cookbook-banner .banner-aspect-container {
    height: clamp(32rem, 42vw, 38.5rem) !important;
  }

  @media (max-width: 767px) {
    #banner-container.has-cookbook-banner {
      margin-top: calc(4.75rem + env(safe-area-inset-top, 0px)) !important;
    }

    #banner-container.has-cookbook-banner .banner-aspect-container {
      height: clamp(456px, 56svh, 480px) !important;
    }
  }
</style>
