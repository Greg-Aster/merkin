---
import { Icon } from 'astro-icon/components'

interface CookbookEntry {
  slug: string
  data: {
    title: string
    description?: string
    image?: string
    section?: string
    page?: number
  }
}

interface Props {
  entries: CookbookEntry[]
  activeSlug?: string
}

const { entries, activeSlug = '' } = Astro.props
const navigationEntries = [...entries].sort(
  (a, b) => (a.data.page ?? 999) - (b.data.page ?? 999),
)
const activeEntry =
  navigationEntries.find(entry => entry.slug === activeSlug) ??
  navigationEntries[0] ??
  null
const recipeCount = navigationEntries.length

function cookbookHrefForEntry(entry: CookbookEntry) {
  return entry.slug === 'cookbook-index' ? '/cookbook/' : `/cookbook/${entry.slug}/`
}

const sectionGroups = navigationEntries.reduce<
  Array<{ title: string; items: CookbookEntry[] }>
>((groups, entry) => {
  const title = entry.data.section || 'Cookbook'
  const existing = groups.find(group => group.title === title)

  if (existing) {
    existing.items.push(entry)
    return groups
  }

  groups.push({ title, items: [entry] })
  return groups
}, [])
---

<section
  class="relative h-full w-full overflow-hidden bg-black text-stone-950"
  aria-label="Cookbook navigation"
>
  <img
    src="/assets/banner/cookbook-open-book.webp"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[center_42%]"
  />
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgba(255,210,150,0.1),transparent_32%),linear-gradient(180deg,rgba(0,0,0,0.38),transparent_20%,transparent_72%,rgba(0,0,0,0.5))]"></div>

  <div class="absolute z-10 grid grid-cols-2 gap-[5%] font-serif text-[#24150d] [text-shadow:0_1px_0_rgba(255,238,205,0.28)] left-[7%] right-[7%] top-[23%] bottom-[23%] md:left-[24%] md:right-[24%] md:top-[18%] md:bottom-[22%] md:gap-[7%]">
    <div class="grid min-w-0 content-start">
      <div class="flex items-center gap-1.5 text-[0.5rem] font-black uppercase tracking-[0.18em] text-[#4c2d1b]/75 md:text-[0.62rem] md:tracking-[0.22em]">
        <Icon name="material-symbols:menu-book-outline-rounded" class="text-xs text-[#4c2d1b]/62 md:text-sm" />
        <span>
          Cookbook
        </span>
      </div>

      <p class="mt-1 text-[1.15rem] font-black leading-[0.95] tracking-tight text-[#1d1109] sm:text-2xl md:mt-2 md:text-[2.15rem]">
        The Galactic Cookbook
      </p>
      <p class="mt-1 line-clamp-3 text-[0.68rem] leading-snug text-[#321d10]/82 md:mt-3 md:max-w-[18rem] md:text-sm md:leading-relaxed">
        Recipes, substitutions, and culinary field notes from the live archive.
      </p>

      <div class="mt-2 flex items-end justify-between gap-2 border-y border-[#4a2b18]/28 py-1.5 md:mt-5 md:gap-4 md:py-2">
        <div class="grid grid-cols-2 gap-3 md:gap-5">
          <div>
            <div class="text-[0.48rem] font-black uppercase tracking-[0.16em] text-[#4a2b18]/62 md:text-[0.58rem]">
              Pages
            </div>
            <div class="mt-0.5 text-base font-black leading-none text-[#1d1109] md:text-xl">{recipeCount}</div>
          </div>
          <div>
            <div class="text-[0.48rem] font-black uppercase tracking-[0.16em] text-[#4a2b18]/62 md:text-[0.58rem]">
              Current
            </div>
            <div class="mt-0.5 text-base font-black leading-none text-[#1d1109] md:text-xl">
              {activeEntry?.data.page ?? 1}
            </div>
          </div>
        </div>

        <a
          href="#cookbook-reader"
          class="inline-flex min-h-8 items-center gap-1 border-b border-[#4a2b18]/46 text-[0.52rem] font-black uppercase tracking-[0.16em] text-[#211309] transition hover:border-[#211309] hover:text-[#4a2b18] active:scale-[0.98] md:min-h-9 md:text-[0.64rem]"
          data-sfx-hover="hover-soft"
          data-sfx-click="soft"
        >
          Read
          <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-sm text-[#4a2b18]/70 md:text-base" />
        </a>
      </div>
    </div>

    <nav
      class="grid min-w-0 content-start"
      aria-label="Cookbook pages"
    >
      <div class="mb-1.5 flex items-end justify-between gap-3 border-b border-[#4a2b18]/28 pb-1.5 md:mb-3 md:pb-2">
        <div>
          <div class="text-[0.5rem] font-black uppercase tracking-[0.18em] text-[#4a2b18]/70 md:text-[0.62rem] md:tracking-[0.22em]">
            Contents
          </div>
          <div class="mt-0.5 line-clamp-1 text-[0.62rem] italic text-[#321d10]/72 md:text-sm">
            Select a page to open its post or recipe.
          </div>
        </div>
        <Icon name="material-symbols:menu-book-outline-rounded" class="hidden text-xl text-[#4a2b18]/42 md:block" />
      </div>

      <div class="hidden min-h-0 content-start gap-x-4 gap-y-1.5 overflow-y-auto pr-1 md:grid md:grid-cols-2">
        {sectionGroups.map(group => (
          <section class="min-w-0">
            <div class="mb-1 text-[0.54rem] font-black uppercase tracking-[0.16em] text-[#4a2b18]/58">
              {group.title}
            </div>
            <div class="grid">
              {group.items.map(entry => {
                const href = cookbookHrefForEntry(entry)
                const isActive = entry.slug === activeSlug

                return (
                  <a
                    href={href}
                    class:list={[
                      'group grid grid-cols-[minmax(0,1fr)_1.8rem] items-baseline gap-2 py-1 text-[#24150d] transition active:scale-[0.99]',
                      isActive
                        ? 'font-black'
                        : 'font-bold hover:text-[#55331f]',
                    ]}
                    aria-current={isActive ? 'page' : undefined}
                    data-sfx-hover="hover-soft"
                    data-sfx-click="soft"
                  >
                    <span class="min-w-0">
                      <span class="line-clamp-2 block text-[0.78rem] leading-tight">
                        {entry.data.title}
                      </span>
                      <span class:list={[
                        'mt-0.5 block h-px bg-[#4a2b18]/18 transition group-hover:bg-[#4a2b18]/36',
                        isActive ? 'bg-[#4a2b18]/44' : '',
                      ]}>
                      </span>
                    </span>
                    <span class="justify-self-end text-[0.7rem] font-black leading-none text-[#3b2213]/72">
                      {entry.data.page ?? 1}
                    </span>
                  </a>
                )
              })}
            </div>
          </section>
        ))}
      </div>

      <div class="grid min-w-0 gap-y-1.5 md:hidden">
        {navigationEntries.map(entry => {
          const href = cookbookHrefForEntry(entry)
          const isActive = entry.slug === activeSlug

          return (
            <a
              href={href}
              class:list={[
                'grid grid-cols-[minmax(0,1fr)_1.35rem] items-baseline gap-1.5 border-b border-[#4a2b18]/22 py-1 text-[#24150d] transition active:scale-[0.98]',
                isActive
                  ? 'font-black'
                  : 'font-bold',
              ]}
              aria-current={isActive ? 'page' : undefined}
              data-sfx-hover="hover-soft"
              data-sfx-click="soft"
            >
              <span class="line-clamp-2 min-w-0 text-[0.68rem] leading-tight">
                {entry.data.title}
              </span>
              <span class="justify-self-end text-[0.62rem] font-black text-[#3b2213]/68">
                {entry.data.page ?? 1}
              </span>
            </a>
          )
        })}
      </div>
    </nav>
  </div>
</section>

<style is:global>
  #banner-container.has-cookbook-banner .banner-aspect-container {
    height: clamp(25rem, 31vw, 28.75rem) !important;
  }

  @media (max-width: 767px) {
    #banner-container.has-cookbook-banner {
      margin-top: calc(4.75rem + env(safe-area-inset-top, 0px)) !important;
    }

    #banner-container.has-cookbook-banner .banner-aspect-container {
      height: clamp(456px, 56svh, 480px) !important;
    }
  }
</style>
