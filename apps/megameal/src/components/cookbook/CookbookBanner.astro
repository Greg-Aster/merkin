---
import { Icon } from 'astro-icon/components'

interface CookbookEntry {
  slug: string
  data: {
    title: string
    description?: string
    image?: string
    section?: string
    page?: number
  }
}

interface Props {
  entries: CookbookEntry[]
  activeSlug?: string
}

const { entries, activeSlug = '' } = Astro.props
const activeEntry =
  entries.find(entry => entry.slug === activeSlug) ?? entries[0] ?? null
const recipeCount = entries.length
const entryBySlug = new Map(entries.map(entry => [entry.slug, entry]))
const cookbookIndexSections = [
  {
    title: 'Front Matter',
    items: [
      { label: 'Archivist Introduction', page: '1', slug: 'cookbook-index' },
    ],
  },
  {
    title: 'Legendary Beverages',
    items: [
      {
        label: 'The Perfect Miranda Bloody Mary',
        page: '12',
        slug: 'perfect-miranda-bloody-mary',
      },
      { label: 'Zero-G Vodka Notes', page: '18' },
      { label: 'Temporal Brunch Pairings', page: '22' },
    ],
  },
  {
    title: 'Magnificent Main Courses',
    items: [
      {
        label: 'Zelephant and Black Quarnivorian Truffle Roast',
        page: '38',
        slug: 'zelephant-truffle-roast',
      },
      { label: 'Corporate Banquet Substitutions', page: '46' },
      { label: 'Extinct Protein Handling', page: '52' },
    ],
  },
  {
    title: 'Spectacular Sweets',
    items: [
      { label: 'Chromatic Meat Cake', page: '64', slug: 'meat-cake' },
      { label: 'Bioluminescent Frostings', page: '72' },
      { label: 'Candied Sweetmeat Appendix', page: '78' },
    ],
  },
  {
    title: 'Appendices',
    items: [
      { label: 'Reality-Compliant Substitutions', page: '91' },
      { label: 'Restricted Ingredients', page: '104' },
    ],
  },
]

function cookbookHrefForSlug(slug?: string) {
  if (!slug || !entryBySlug.has(slug)) return ''
  return slug === 'cookbook-index' ? '/cookbook/' : `/cookbook/${slug}/`
}

const linkedSections = cookbookIndexSections
  .map(section => ({
    ...section,
    items: section.items.filter(item => cookbookHrefForSlug(item.slug)),
  }))
  .filter(section => section.items.length)
const plannedItems = cookbookIndexSections.flatMap(section =>
  section.items
    .filter(item => !cookbookHrefForSlug(item.slug))
    .map(item => ({ ...item, section: section.title })),
)
---

<section
  class="relative h-full w-full overflow-hidden bg-black text-white"
  aria-label="Cookbook browser"
>
  <video
    id="cookbook-banner-video"
    src="/assets/banner/cookbook-glitch0001-0049.webm"
    poster="/assets/banner/posters/cookbook-poster.webp"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    class="absolute inset-0 h-full w-full object-cover opacity-55"
  ></video>
  <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/35 to-black/85"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.18),transparent_32%),radial-gradient(circle_at_78%_42%,rgba(255,210,120,0.14),transparent_30%)]"></div>

  <div class="relative z-10 mx-auto grid h-full max-w-[var(--page-width)] min-w-0 gap-4 px-3 py-4 sm:px-4 md:grid-cols-[minmax(18rem,0.78fr)_minmax(0,1.22fr)] md:items-stretch md:px-8 md:py-6">
    <div class="hidden min-h-0 md:block">
      <div class="flex h-full max-w-sm flex-col rounded-lg border border-white/20 bg-black/40 p-4 shadow-2xl backdrop-blur">
        <div class="mb-3 flex items-center justify-between gap-3 border-b border-white/15 pb-3">
          <div>
            <div class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--primary)]">
              Cookbook Index
            </div>
            <div class="mt-1 text-lg font-black leading-tight text-white">
              Available Pages
            </div>
          </div>
          <Icon name="material-symbols:menu-book-outline-rounded" class="text-2xl text-white/55" />
        </div>
        <nav class="min-h-0 flex-1 space-y-3 overflow-y-auto pr-1" aria-label="Cookbook table of contents">
          {linkedSections.map(section => (
            <section class="space-y-1.5">
              <h2 class="text-[0.7rem] font-black uppercase tracking-[0.14em] text-white/50">
                {section.title}
              </h2>
              <div class="space-y-1">
                {section.items.map(item => {
                  const href = cookbookHrefForSlug(item.slug)
                  const isActive = item.slug === activeSlug

                  return (
                    <a
                      href={href}
                      class:list={[
                        'grid grid-cols-[2.25rem_minmax(0,1fr)] gap-2 rounded-md border px-2 py-1.5 transition active:scale-[0.98]',
                        isActive
                          ? 'border-[var(--primary)] bg-white/15'
                          : 'border-white/10 bg-white/5 hover:border-white/25 hover:bg-white/10',
                      ]}
                      aria-current={isActive ? 'page' : undefined}
                      data-sfx-hover="hover-soft"
                      data-sfx-click="soft"
                    >
                      <span class="rounded bg-white/10 px-1.5 py-0.5 text-center text-[0.68rem] font-bold text-white/75">
                        {item.page}
                      </span>
                      <span class="min-w-0">
                        <span class="line-clamp-1 block text-sm font-bold leading-tight text-white">
                          {item.label}
                        </span>
                      </span>
                    </a>
                  )
                })}
              </div>
            </section>
          ))}
        </nav>

        {plannedItems.length > 0 && (
          <details class="mt-3 border-t border-white/15 pt-3">
            <summary class="cursor-pointer text-[0.7rem] font-black uppercase tracking-[0.14em] text-white/45">
              Coming Soon
            </summary>
            <div class="mt-2 grid gap-1.5">
              {plannedItems.slice(0, 5).map(item => (
                <div class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-2 rounded-md border border-white/5 bg-white/[0.03] px-2 py-1.5 opacity-65">
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-center text-[0.68rem] font-bold text-white/55">
                    {item.page}
                  </span>
                  <span class="min-w-0">
                    <span class="line-clamp-1 block text-sm font-bold leading-tight text-white/75">
                      {item.label}
                    </span>
                    <span class="mt-0.5 block text-[0.62rem] font-bold uppercase tracking-[0.1em] text-white/35">
                      {item.section}
                    </span>
                  </span>
                </div>
              ))}
            </div>
          </details>
        )}
      </div>
    </div>

    <div class="grid min-w-0 content-center gap-4 md:gap-5">
      <div class="min-w-0">
        <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-white/80 backdrop-blur">
          <Icon name="material-symbols:menu-book-outline-rounded" class="text-base text-[var(--primary)]" />
          Cookbook
        </div>
        <h1 class="max-w-3xl text-3xl font-black leading-none text-white sm:text-4xl md:text-5xl">
          The Galactic Cookbook
        </h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/75 sm:text-base md:text-lg">
          A virtual recipe book for dishes that survived corporate collapse,
          extinction events, temporal loops, and several rounds of compliance review.
        </p>
      </div>

      {activeEntry && (
        <a
          href={activeEntry.slug === 'cookbook-index'
            ? '/cookbook/'
            : `/cookbook/${activeEntry.slug}/`}
          class="grid w-full max-w-2xl min-w-0 grid-cols-[4.5rem_minmax(0,1fr)] gap-3 rounded-lg border border-white/20 bg-black/40 p-3 text-left shadow-2xl backdrop-blur transition hover:border-[var(--primary)] hover:bg-black/55 active:scale-[0.99] sm:grid-cols-[5.5rem_minmax(0,1fr)]"
          data-sfx-hover="hover-soft"
          data-sfx-click="soft"
        >
          {activeEntry.data.image && (
            <img
              src={activeEntry.data.image}
              alt=""
              loading="eager"
              decoding="async"
              class="aspect-square w-full rounded-md object-cover"
            />
          )}
          <span class="min-w-0 self-center">
            <span class="block text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--primary)] sm:text-xs">
              Current Page {activeEntry.data.page ?? 1}
            </span>
            <span class="mt-1 line-clamp-2 block text-base font-black leading-tight text-white sm:text-lg">
              {activeEntry.data.title}
            </span>
            <span class="mt-1 line-clamp-2 block text-sm leading-snug text-white/65">
              {activeEntry.data.description}
            </span>
            <span class="mt-2 inline-flex items-center gap-1.5 text-[0.68rem] font-black uppercase tracking-[0.12em] text-white/75">
              Open Page
              <Icon name="material-symbols:arrow-forward-rounded" class="text-base text-[var(--primary)]" />
            </span>
          </span>
        </a>
      )}

      <nav
        class="min-w-0 rounded-lg border border-white/15 bg-black/45 p-2 backdrop-blur md:hidden"
        aria-label="Cookbook recipes"
      >
        <div class="mb-2 flex items-center justify-between gap-3 px-2 text-xs font-bold uppercase tracking-[0.14em] text-white/60">
          <span>{recipeCount} Pages</span>
          <span>Index</span>
        </div>
        <div class="flex min-w-0 gap-2 overflow-x-auto pb-1">
          {entries.map(entry => {
            const isActive = entry.slug === activeSlug
            return (
              <a
                href={entry.slug === 'cookbook-index'
                  ? '/cookbook/'
                  : `/cookbook/${entry.slug}/`}
                class:list={[
                  'grid min-w-[12.5rem] grid-cols-[3.25rem_minmax(0,1fr)] gap-2 rounded-md border p-2 transition active:scale-[0.98]',
                  isActive
                    ? 'border-[var(--primary)] bg-white/15'
                    : 'border-white/10 bg-white/5 hover:border-white/25 hover:bg-white/10',
                ]}
                aria-current={isActive ? 'page' : undefined}
                data-sfx-hover="hover-soft"
                data-sfx-click="soft"
              >
                {entry.data.image && (
                  <img
                    src={entry.data.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="aspect-square w-full rounded object-cover"
                  />
                )}
                <span class="min-w-0 self-center">
                  <span class="block text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[var(--primary)]">
                    Page {entry.data.page ?? 1}
                  </span>
                  <span class="line-clamp-2 block text-sm font-bold leading-tight text-white">
                    {entry.data.title}
                  </span>
                </span>
              </a>
            )
          })}
        </div>
      </nav>
    </div>
  </div>
</section>

<script>
  const cookbookBannerVideo = document.getElementById('cookbook-banner-video')

  if (cookbookBannerVideo instanceof HTMLVideoElement) {
    cookbookBannerVideo.playbackRate = 0.25
  }
</script>
