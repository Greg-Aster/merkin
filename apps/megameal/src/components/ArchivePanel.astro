---
import SharedArchivePanel from '@merkin/blog-core/components/ArchivePanel.astro'
import {
  getArchivePanelGroups,
  getArchiveRecordsByTaxonomy,
} from '../utils/archiveTaxonomy'

interface Props {
  keyword?: string
  tags?: string[]
  categories?: string[]
}
const { tags, categories } = Astro.props

const records = getArchiveRecordsByTaxonomy({ tags, categories })
const archiveGroups = getArchivePanelGroups(records)
---

<SharedArchivePanel
  groups={archiveGroups}
  postsCountLabel="records"
/>
