---
import { getCollection } from 'astro:content'
import { SERIES_CONFIG } from '@/config/seriesConfig'
import gameStarsManifest from '../../../../../packages/shared-data/generated/game-stars.json'
import postsManifest from '../../../../../packages/shared-data/generated/posts.json'
import timelineManifest from '../../../../../packages/shared-data/generated/timeline.json'
import { isPublicContentData } from '../../contracts/content'
import { isPublishedManifestRecord } from '../../contracts/manifests'
import { publicProductCollectionFilter } from '../../contracts/products'
import PortalSyntheticRoute from './PortalSyntheticRoute.astro'
import PortalTimelineRoute from './PortalTimelineRoute.astro'
import '../../styles/features/home/portal-destinations.css'

const allProducts = await getCollection(
  'products',
  publicProductCollectionFilter,
)

const {
  publishedDispatchCount: publishedDispatchCountProp,
  timelineCount: timelineCountProp,
} = Astro.props

const publishedPosts = postsManifest.items.filter(isPublicContentData)
const publishedTimelineItems = timelineManifest.items.filter(
  isPublishedManifestRecord,
)
const publishedGameStars = gameStarsManifest.items.filter(
  isPublishedManifestRecord,
)
const activeArcIds = new Set(
  publishedPosts
    .map(post => post.series)
    .filter(
      (seriesId): seriesId is keyof typeof SERIES_CONFIG =>
        typeof seriesId === 'string' && seriesId in SERIES_CONFIG,
    ),
)

const publishedDispatchCount =
  publishedDispatchCountProp ?? publishedPosts.length
const timelineCount = timelineCountProp ?? publishedTimelineItems.length
const gameStarsCount = publishedGameStars.length
const activeArcCount = activeArcIds.size

const featureRoutes = [
  {
    href: 'https://game.megameal.org/',
    eyebrow: 'Star Observatory',
    title: 'Enter the Game Mode',
    description:
      'Move from reading the universe into navigating it. The observatory turns story nodes into explorable coordinates.',
    stat: `${gameStarsCount} star nodes`,
    icon: 'mdi:gamepad-variant',
    tone: 'game',
  },
  {
    href: '/archive/',
    eyebrow: 'Story Archive',
    title: 'Read the Story Arcs',
    description:
      'Follow connected chapters, recovered accounts, recipes, corporate records, and cosmic incident reports.',
    stat: `${activeArcCount} active arcs`,
    icon: 'mdi:book-open-page-variant',
    tone: 'story',
  },
  {
    href: '/store/',
    eyebrow: 'Commercial Layer',
    title: 'Browse the Store',
    description:
      'Artifacts, goods, fake products, and dystopian brand debris from the MEGAMEAL economy.',
    stat: `${allProducts.length} listed products`,
    icon: 'mdi:storefront-outline',
    tone: 'store',
  },
  {
    href: '/community/',
    eyebrow: 'Live Channels',
    title: 'Join the Community',
    description:
      'Follow updates, contact the project, and stay connected as the universe expands.',
    stat: `${publishedDispatchCount} transmissions`,
    icon: 'mdi:account-group',
    tone: 'community',
  },
] as const
---

<section class="portal-showcase">
  <PortalTimelineRoute timelineCount={timelineCount} />

  {featureRoutes.map((route, index) => (
    <PortalSyntheticRoute {...route} reverse={index % 2 === 1} />
  ))}
</section>
