---
import postsManifest from '../../../../../packages/shared-data/generated/posts.json'
import timelineManifest from '../../../../../packages/shared-data/generated/timeline.json'
import gameStarsManifest from '../../../../../packages/shared-data/generated/game-stars.json'
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { SERIES_CONFIG } from '@/config/seriesConfig'

const allProducts = await getCollection('products', ({ data }) => data.draft !== true)

interface Props {
  publishedDispatchCount?: number
  timelineCount?: number
}

const {
  publishedDispatchCount: publishedDispatchCountProp,
  timelineCount: timelineCountProp,
} = Astro.props

const publishedPosts = postsManifest.items.filter(post => !post.draft)
const publishedTimelineItems = timelineManifest.items.filter(event => !event.isDraft)
const publishedGameStars = gameStarsManifest.items.filter(event => !event.isDraft)
const activeArcIds = new Set(
  publishedPosts
    .map(post => post.series)
    .filter((seriesId): seriesId is string => Boolean(seriesId) && Boolean(SERIES_CONFIG[seriesId])),
)

const publishedDispatchCount = publishedDispatchCountProp ?? publishedPosts.length
const timelineCount = timelineCountProp ?? publishedTimelineItems.length
const gameStarsCount = publishedGameStars.length
const activeArcCount = activeArcIds.size

const destinations = [
  {
    href: '/posts/explainer/',
    title: 'Open the Timeline',
    description:
      'Use the main chronology as your orientation map across eras, incidents, recipes, and corporate disasters.',
    meta: `${timelineCount} timeline entries`,
    icon: 'mdi:orbit',
    tone: 'timeline',
    featured: true,
  },
  {
    href: '/archive/',
    title: 'Read the Story Arcs',
    description:
      'Move through the saga as connected chapters instead of isolated posts.',
    meta: `${activeArcCount} active arcs`,
    icon: 'mdi:book-open-page-variant',
    tone: 'story',
  },
  {
    href: '/game/',
    title: 'Enter the Game',
    description:
      'Jump straight to Star Observatory without another navigation step.',
    meta: `${gameStarsCount} live star nodes`,
    icon: 'mdi:gamepad-variant',
    tone: 'game',
  },
  {
    href: '/store/',
    title: 'Browse the Store',
    description:
      'Commercial artifacts, products, and unsettling merchandise from the universe.',
    meta: `${allProducts.length} listed products`,
    icon: 'mdi:storefront-outline',
    tone: 'store',
  },
  {
    href: '/community/',
    title: 'Join the Community',
    description:
      'Contact channels, live discussion, and ways to follow the project as it grows.',
    meta: `${publishedDispatchCount} published dispatches`,
    icon: 'mdi:account-group',
    tone: 'community',
  },
]
---

<section class="portal-destinations card-base">
  <div class="portal-header">
    <div class="portal-kicker">Primary Access</div>
    <h2 class="portal-title">Choose a route into the universe.</h2>
    <p class="portal-copy">
      The banner is the viewscreen. This panel is the cockpit navigation.
      Every major part of the site stays reachable in one click.
    </p>
  </div>

  <div class="portal-grid">
    {destinations.map((destination) => (
      <a
        href={destination.href}
        data-sfx-click="sweep"
        class:list={[
          'portal-card',
          destination.featured && 'portal-card-featured',
        ]}
        style={`--portal-accent: var(--portal-${destination.tone});`}
      >
        <div class="portal-card-topline">
          <span class="portal-icon-shell">
            <Icon name={destination.icon} class="portal-icon" />
          </span>
          <span class="portal-meta">{destination.meta}</span>
        </div>
        <h3 class="portal-card-title">{destination.title}</h3>
        <p class="portal-card-copy">{destination.description}</p>
        <div class="portal-card-cta">
          <span>Open</span>
          <Icon name="mdi:arrow-right" class="portal-arrow" />
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .portal-destinations {
    --portal-timeline: oklch(0.72 0.17 245);
    --portal-story: oklch(0.74 0.18 325);
    --portal-game: oklch(0.79 0.15 145);
    --portal-store: oklch(0.82 0.15 85);
    --portal-community: oklch(0.76 0.16 25);
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
    margin-bottom: 2rem;
    background:
      radial-gradient(circle at top left, oklch(0.24 0.06 var(--hue) / 0.42), transparent 38%),
      linear-gradient(180deg, oklch(0.15 0.03 var(--hue) / 0.72), oklch(0.12 0.03 var(--hue) / 0.62));
    border: 1px solid oklch(0.36 0.05 var(--hue) / 0.4);
    backdrop-filter: blur(18px) saturate(1.12);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .portal-destinations::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent, oklch(0.82 0.02 var(--hue) / 0.05), transparent),
      linear-gradient(0deg, transparent 92%, oklch(0.82 0.02 var(--hue) / 0.06) 100%);
    pointer-events: none;
  }

  .portal-header {
    position: relative;
    z-index: 1;
    max-width: 48rem;
    margin-bottom: 1.25rem;
  }

  .portal-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: oklch(0.72 0.11 var(--hue));
    margin-bottom: 0.65rem;
  }

  .portal-title {
    margin: 0;
    font-size: clamp(1.45rem, 3.2vw, 2.4rem);
    line-height: 1.05;
    color: white;
  }

  .portal-copy {
    margin: 0.85rem 0 0;
    max-width: 42rem;
    color: oklch(0.76 0.03 var(--hue));
    line-height: 1.6;
    font-size: 0.98rem;
  }

  .portal-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .portal-card {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    min-height: 14rem;
    text-decoration: none;
    padding: 1.1rem;
    border-radius: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--portal-accent) 30%, transparent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--portal-accent) 10%, rgba(255,255,255,0.03)), rgba(0,0,0,0.08)),
      oklch(0.16 0.03 var(--hue) / 0.58);
    backdrop-filter: blur(16px) saturate(1.08);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.06),
      0 10px 28px rgba(0, 0, 0, 0.12);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .portal-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--portal-accent) 70%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--portal-accent) 25%, transparent),
      0 18px 40px rgba(0, 0, 0, 0.28);
  }

  .portal-card-featured {
    grid-column: span 12;
    min-height: 11.5rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--portal-accent) 16%, transparent), transparent 40%),
      linear-gradient(180deg, color-mix(in srgb, var(--portal-accent) 12%, rgba(255,255,255,0.02)), rgba(0,0,0,0.18)),
      oklch(0.16 0.03 var(--hue) / 0.62);
  }

  .portal-card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }

  .portal-icon-shell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 0.8rem;
    color: var(--portal-accent);
    background: color-mix(in srgb, var(--portal-accent) 14%, rgba(255,255,255,0.02));
    border: 1px solid color-mix(in srgb, var(--portal-accent) 28%, transparent);
  }

  .portal-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  .portal-meta {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--portal-accent) 72%, white);
  }

  .portal-card-title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    line-height: 1.15;
    color: white;
  }

  .portal-card-copy {
    margin: 0;
    color: oklch(0.76 0.03 var(--hue));
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .portal-card-cta {
    margin-top: auto;
    padding-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--portal-accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.74rem;
  }

  .portal-arrow {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.2s ease;
  }

  .portal-card:hover .portal-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 800px) {
    .portal-grid {
      grid-template-columns: 1fr;
    }

    .portal-card,
    .portal-card-featured {
      grid-column: auto;
      min-height: auto;
    }
  }

  @media (max-width: 540px) {
    .portal-destinations {
      padding: 1rem;
    }

    .portal-card {
      padding: 1rem;
    }

    .portal-card-topline {
      align-items: flex-start;
      flex-direction: column;
      margin-bottom: 0.9rem;
    }
  }
</style>
