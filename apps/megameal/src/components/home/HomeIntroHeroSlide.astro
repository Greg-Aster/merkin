---
import { Image } from "astro:assets";
import mainTitleCard from "@/assets/banner/main-title.png";
import HomeIntroEnvironment from "./HomeIntroEnvironment.svelte";
import '../../styles/features/home/home-intro-hero-slide.css'
---

<section class="megameal-home-intro" aria-label="MEGAMEAL portal introduction">
  <div class="megameal-home-intro__environment" aria-hidden="true">
    <HomeIntroEnvironment client:load />
  </div>

  <div class="megameal-home-intro__veil" aria-hidden="true"></div>

  <div class="megameal-home-intro__card">
    <p class="megameal-home-intro__eyebrow">Commercial Portal Online</p>
    <div class="megameal-home-intro__image-frame">
      <Image
        src={mainTitleCard}
        alt="MEGA MEAL SAGA title card"
        class="megameal-home-intro__image"
        loading="eager"
      />
    </div>
    <p class="megameal-home-intro__caption">
      Transmission stabilizing. Promotional sequence will begin shortly.
    </p>
  </div>
</section>
