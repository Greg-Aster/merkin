---
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import postsManifest from '../../../../../packages/shared-data/generated/posts.json'
import timelineManifest from '../../../../../packages/shared-data/generated/timeline.json'
import gameStarsManifest from '../../../../../packages/shared-data/generated/game-stars.json'
import { FEATURED_SERIES_ORDER, SERIES_CONFIG } from '@/config/seriesConfig'

const allProducts = await getCollection('products', ({ data }) => data.draft !== true)

const publishedPosts = postsManifest.items.filter(post => !post.draft)
const publishedTimelineItems = timelineManifest.items.filter(event => !event.isDraft)
const publishedGameStars = gameStarsManifest.items.filter(event => !event.isDraft)

function isKnownSeriesId(
  seriesId: unknown,
): seriesId is keyof typeof SERIES_CONFIG {
  return typeof seriesId === 'string' && seriesId in SERIES_CONFIG
}

const activeArcIds = new Set(
  publishedPosts
    .map(post => post.series)
    .filter(isKnownSeriesId),
)

const featuredSeriesId =
  FEATURED_SERIES_ORDER.find(seriesId => activeArcIds.has(seriesId)) ??
  FEATURED_SERIES_ORDER[0]
const featuredSeries = featuredSeriesId ? SERIES_CONFIG[featuredSeriesId] : null

const introSignals = [
  {
    label: 'Storefront',
    value: `${allProducts.length}`,
    detail: 'Products disguised as fiction',
    href: '/store/',
  },
  {
    label: 'Timeline',
    value: `${publishedTimelineItems.length}`,
    detail: 'Chronology nodes online',
    href: '/timeline/',
  },
  {
    label: 'Dispatches',
    value: `${publishedPosts.length}`,
    detail: 'Active transmissions in archive',
    href: '/archive/',
  },
  {
    label: 'Arc Index',
    value: `${activeArcIds.size}`,
    detail: featuredSeries ? `Featured: ${featuredSeries.title}` : 'Connected story tracks',
    href: '/archive/',
  },
  {
    label: 'Observatory',
    value: `${publishedGameStars.length}`,
    detail: 'Playable star coordinates',
    href: '/game/',
  },
] as const

const accessLinks = [
  { href: '/store/', label: 'Enter Storefront', tone: 'primary', icon: 'mdi:storefront-outline' },
  { href: '/posts/explainer/', label: 'Start With The Signal', tone: 'secondary', icon: 'mdi:access-point' },
  { href: '/timeline/', label: 'Open Timeline', tone: 'ghost', icon: 'mdi:timeline-outline' },
  { href: '/archive/', label: 'Browse Archive', tone: 'ghost', icon: 'mdi:archive-outline' },
] as const

const promoRail = [
  'Commercial portal open',
  'Broadcasts live',
  'Archive unlocked',
  'Story arcs active',
  'Community uplink stable',
  'Observatory on standby',
] as const
---

<section class="megameal-home-intro">
  <div class="megameal-home-intro__backdrop" aria-hidden="true">
    <div class="megameal-home-intro__grid"></div>
    <div class="megameal-home-intro__ring megameal-home-intro__ring--one"></div>
    <div class="megameal-home-intro__ring megameal-home-intro__ring--two"></div>
    <div class="megameal-home-intro__glow megameal-home-intro__glow--left"></div>
    <div class="megameal-home-intro__glow megameal-home-intro__glow--right"></div>
    <div class="megameal-home-intro__scanlines"></div>
  </div>

  <div class="megameal-home-intro__shell">
    <div class="megameal-home-intro__statusbar">
      <div class="megameal-home-intro__statuschip">
        <span class="megameal-home-intro__statusdot"></span>
        <span>Commercial Portal Active</span>
      </div>
      <div class="megameal-home-intro__statusmeta">
        <span>Year 3042</span>
        <span>MEGAMEAL.ORG</span>
        <span>Retail Narrative Layer</span>
      </div>
    </div>

    <div class="megameal-home-intro__layout">
      <div class="megameal-home-intro__hero">
        <p class="megameal-home-intro__eyebrow">Consumption gateway // universe entry</p>
        <h1 class="megameal-home-intro__title">
          <span>Shop The Signal.</span>
          <span>Enter The Universe.</span>
        </h1>
        <p class="megameal-home-intro__lede">
          MEGAMEAL is a cosmic-horror shopping interface where products,
          broadcasts, recipes, dossiers, and propaganda all point to the same
          world. The storefront is not adjacent to the story. It is the story.
        </p>

        <div class="megameal-home-intro__actions">
          {accessLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'megameal-home-intro__action',
                `megameal-home-intro__action--${link.tone}`,
              ]}
              data-sfx-click="sweep"
            >
              <Icon name={link.icon} class="megameal-home-intro__actionicon" />
              <span>{link.label}</span>
            </a>
          ))}
        </div>

        <div class="megameal-home-intro__rail" aria-label="Portal activity summary">
          {promoRail.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </div>

      <aside class="megameal-home-intro__broadcast" aria-label="Portal highlights">
        <div class="megameal-home-intro__broadcasthead">
          <p>Live Surfaces</p>
          <span>Do not trust the discounts</span>
        </div>

        <div class="megameal-home-intro__broadcastcard megameal-home-intro__broadcastcard--primary">
          <div class="megameal-home-intro__broadcastlabel">Flagship Access Point</div>
          <h2>Storefront First</h2>
          <p>
            Enter through commerce, then branch into archive files, chronology,
            recipes, companion products, and transmission debris.
          </p>
          <a href="/store/" data-sfx-click="sweep">
            Browse live product nodes
          </a>
        </div>

        <div class="megameal-home-intro__broadcaststack">
          <article class="megameal-home-intro__broadcastcard">
            <div class="megameal-home-intro__broadcastlabel">Featured Arc</div>
            <strong>{featuredSeries?.title ?? 'Story Archive'}</strong>
            <p>
              {featuredSeries?.description ??
                'Follow connected chapters, incidents, and recovered records.'}
            </p>
          </article>
          <article class="megameal-home-intro__broadcastcard">
            <div class="megameal-home-intro__broadcastlabel">Navigation Logic</div>
            <strong>One world, many lenses</strong>
            <p>Store for commerce. Timeline for chronology. Archive for dossiers. Community for the uplink.</p>
          </article>
        </div>
      </aside>
    </div>

    <div class="megameal-home-intro__signalgrid" aria-label="Site activity counters">
      {introSignals.map((signal) => (
        <a
          href={signal.href}
          class="megameal-home-intro__signal"
          data-sfx-click="sweep"
        >
          <span class="megameal-home-intro__signalvalue">{signal.value}</span>
          <span class="megameal-home-intro__signallabel">{signal.label}</span>
          <span class="megameal-home-intro__signaldetail">{signal.detail}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .megameal-home-intro {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: white;
    background:
      radial-gradient(circle at 15% 20%, rgb(236 72 153 / 0.15), transparent 26%),
      radial-gradient(circle at 82% 14%, rgb(245 158 11 / 0.18), transparent 26%),
      radial-gradient(circle at 70% 72%, rgb(34 197 94 / 0.14), transparent 24%),
      linear-gradient(135deg, rgb(5 10 18 / 0.98), rgb(9 18 30 / 0.95));
  }

  .megameal-home-intro__backdrop,
  .megameal-home-intro__shell {
    position: absolute;
    inset: 0;
  }

  .megameal-home-intro__backdrop {
    pointer-events: none;
  }

  .megameal-home-intro__grid,
  .megameal-home-intro__scanlines,
  .megameal-home-intro__ring,
  .megameal-home-intro__glow {
    position: absolute;
    inset: 0;
  }

  .megameal-home-intro__grid {
    background:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 3.9rem 3.9rem;
    mask-image: radial-gradient(circle at center, black 34%, transparent 92%);
    opacity: 0.42;
    transform: perspective(1000px) rotateX(72deg) translateY(36%);
    transform-origin: center bottom;
    animation: intro-grid-drift 24s linear infinite;
  }

  .megameal-home-intro__ring {
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    filter: blur(0.2px);
  }

  .megameal-home-intro__ring--one {
    inset: 12% 18%;
    animation: intro-ring-spin 22s linear infinite;
  }

  .megameal-home-intro__ring--two {
    inset: 4% 33%;
    border-color: rgb(255 255 255 / 0.08);
    animation: intro-ring-spin-reverse 30s linear infinite;
  }

  .megameal-home-intro__glow--left {
    background: radial-gradient(circle at 16% 28%, rgb(236 72 153 / 0.28), transparent 36%);
  }

  .megameal-home-intro__glow--right {
    background: radial-gradient(circle at 82% 22%, rgb(56 189 248 / 0.24), transparent 30%);
  }

  .megameal-home-intro__scanlines {
    background: repeating-linear-gradient(
      180deg,
      rgb(255 255 255 / 0.02) 0,
      rgb(255 255 255 / 0.02) 1px,
      transparent 1px,
      transparent 5px
    );
    mix-blend-mode: screen;
    opacity: 0.28;
  }

  .megameal-home-intro__shell {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(1rem, 2vw, 1.6rem);
    padding: clamp(1rem, 2vw, 1.5rem);
    z-index: 1;
  }

  .megameal-home-intro__statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
    backdrop-filter: blur(16px) saturate(1.15);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 18px 40px rgb(0 0 0 / 0.18);
  }

  .megameal-home-intro__statuschip,
  .megameal-home-intro__statusmeta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .megameal-home-intro__statuschip {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(255 240 191);
  }

  .megameal-home-intro__statusdot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 999px;
    background: rgb(250 204 21);
    box-shadow: 0 0 0.9rem rgb(250 204 21 / 0.85);
    animation: intro-pulse 1.8s ease-in-out infinite;
  }

  .megameal-home-intro__statusmeta {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(209 213 219 / 0.88);
  }

  .megameal-home-intro__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.9fr);
    gap: clamp(1rem, 2vw, 1.6rem);
    align-items: stretch;
    min-height: 0;
  }

  .megameal-home-intro__hero,
  .megameal-home-intro__broadcast {
    min-height: 0;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at top left, rgb(255 255 255 / 0.12), transparent 28%),
      linear-gradient(180deg, rgb(6 12 24 / 0.76), rgb(4 9 19 / 0.6));
    backdrop-filter: blur(18px) saturate(1.15);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 24px 56px rgb(0 0 0 / 0.24);
  }

  .megameal-home-intro__hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.4rem, 4vw, 2.6rem);
    position: relative;
    overflow: hidden;
  }

  .megameal-home-intro__hero::before {
    content: '';
    position: absolute;
    inset: auto -8% -34% 32%;
    height: 60%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(251 191 36 / 0.18), transparent 68%);
    filter: blur(22px);
    pointer-events: none;
  }

  .megameal-home-intro__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(253 224 71 / 0.92);
  }

  .megameal-home-intro__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: clamp(2.3rem, 5vw, 5.4rem);
    line-height: 0.93;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .megameal-home-intro__title span:last-child {
    color: rgb(253 224 71);
    text-shadow: 0 0 2rem rgb(251 191 36 / 0.28);
  }

  .megameal-home-intro__lede {
    max-width: 44rem;
    margin: 1rem 0 0;
    font-size: clamp(0.95rem, 1.55vw, 1.18rem);
    line-height: 1.7;
    color: rgb(226 232 240 / 0.9);
    text-wrap: pretty;
  }

  .megameal-home-intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
  }

  .megameal-home-intro__action {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    min-height: 3rem;
    padding: 0.85rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.14);
    text-decoration: none;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease;
  }

  .megameal-home-intro__action:hover {
    transform: translateY(-2px);
  }

  .megameal-home-intro__action--primary {
    color: rgb(9 13 20);
    background: linear-gradient(135deg, rgb(253 224 71), rgb(251 191 36));
    border-color: rgb(253 224 71 / 0.7);
    box-shadow: 0 0 2rem rgb(251 191 36 / 0.2);
  }

  .megameal-home-intro__action--secondary {
    color: white;
    background: linear-gradient(135deg, rgb(236 72 153 / 0.28), rgb(59 130 246 / 0.26));
    border-color: rgb(255 255 255 / 0.18);
  }

  .megameal-home-intro__action--ghost {
    color: rgb(226 232 240 / 0.92);
    background: rgb(255 255 255 / 0.05);
  }

  .megameal-home-intro__actionicon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .megameal-home-intro__rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.35rem;
    color: rgb(148 163 184 / 0.95);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .megameal-home-intro__rail span {
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.04);
    animation: intro-tag-float 8s ease-in-out infinite;
  }

  .megameal-home-intro__rail span:nth-child(2n) {
    animation-delay: 1.2s;
  }

  .megameal-home-intro__rail span:nth-child(3n) {
    animation-delay: 2.4s;
  }

  .megameal-home-intro__broadcast {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.9rem;
    padding: clamp(1rem, 2vw, 1.25rem);
  }

  .megameal-home-intro__broadcasthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .megameal-home-intro__broadcasthead p,
  .megameal-home-intro__broadcasthead span {
    margin: 0;
  }

  .megameal-home-intro__broadcasthead p {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(253 224 71 / 0.92);
  }

  .megameal-home-intro__broadcasthead span {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(148 163 184 / 0.85);
  }

  .megameal-home-intro__broadcaststack {
    display: grid;
    gap: 0.8rem;
  }

  .megameal-home-intro__broadcastcard {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1.1rem;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.03));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  .megameal-home-intro__broadcastcard--primary {
    background:
      radial-gradient(circle at 12% 8%, rgb(251 191 36 / 0.18), transparent 26%),
      linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.03));
  }

  .megameal-home-intro__broadcastlabel {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(253 224 71 / 0.92);
  }

  .megameal-home-intro__broadcastcard h2,
  .megameal-home-intro__broadcastcard strong {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.2;
    color: white;
  }

  .megameal-home-intro__broadcastcard p {
    margin: 0;
    color: rgb(203 213 225 / 0.86);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .megameal-home-intro__broadcastcard a {
    color: rgb(253 224 71 / 0.96);
    text-decoration: none;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .megameal-home-intro__signalgrid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .megameal-home-intro__signal {
    display: grid;
    gap: 0.24rem;
    min-height: 7rem;
    padding: 0.95rem 1rem;
    border-radius: 1.2rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.03));
    color: inherit;
    text-decoration: none;
    backdrop-filter: blur(14px) saturate(1.08);
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      background 0.22s ease;
  }

  .megameal-home-intro__signal:hover {
    transform: translateY(-2px);
    border-color: rgb(253 224 71 / 0.36);
    box-shadow: 0 0 2rem rgb(250 204 21 / 0.12);
  }

  .megameal-home-intro__signalvalue {
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1;
    font-weight: 900;
    color: rgb(253 224 71);
  }

  .megameal-home-intro__signallabel {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.95);
  }

  .megameal-home-intro__signaldetail {
    color: rgb(148 163 184 / 0.88);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @keyframes intro-grid-drift {
    from {
      transform: perspective(1000px) rotateX(72deg) translateY(36%) translateX(0);
    }
    to {
      transform: perspective(1000px) rotateX(72deg) translateY(33%) translateX(-2%);
    }
  }

  @keyframes intro-ring-spin {
    from { transform: rotate(0deg) scale(1); }
    to { transform: rotate(360deg) scale(1.02); }
  }

  @keyframes intro-ring-spin-reverse {
    from { transform: rotate(360deg) scale(1.02); }
    to { transform: rotate(0deg) scale(1); }
  }

  @keyframes intro-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.92;
    }
    50% {
      transform: scale(1.12);
      opacity: 1;
    }
  }

  @keyframes intro-tag-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-0.22rem); }
  }

  @media (max-width: 1100px) {
    .megameal-home-intro__layout {
      grid-template-columns: 1fr;
    }

    .megameal-home-intro__broadcast {
      grid-template-rows: auto;
    }

    .megameal-home-intro__signalgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .megameal-home-intro__shell {
      overflow-y: auto;
      padding: 0.9rem;
    }

    .megameal-home-intro__statusbar {
      border-radius: 1.15rem;
      align-items: flex-start;
      flex-direction: column;
    }

    .megameal-home-intro__hero,
    .megameal-home-intro__broadcast {
      padding: 1rem;
      border-radius: 1.25rem;
    }

    .megameal-home-intro__title {
      font-size: clamp(2rem, 11vw, 3.2rem);
    }

    .megameal-home-intro__lede {
      font-size: 0.94rem;
      line-height: 1.6;
    }

    .megameal-home-intro__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .megameal-home-intro__action {
      justify-content: center;
    }

    .megameal-home-intro__signalgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .megameal-home-intro__signal {
      min-height: 6.35rem;
    }
  }

  @media (max-width: 520px) {
    .megameal-home-intro__signalgrid {
      grid-template-columns: 1fr;
    }

    .megameal-home-intro__statusmeta {
      gap: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .megameal-home-intro *,
    .megameal-home-intro *::before,
    .megameal-home-intro *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }

    .megameal-home-intro__grid {
      transform: perspective(1000px) rotateX(72deg) translateY(36%);
    }
  }
</style>
