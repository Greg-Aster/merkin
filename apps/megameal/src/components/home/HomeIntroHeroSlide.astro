---
import { Image } from 'astro:assets'
import mainTitleCard from '@/assets/banner/main-title.png'
---

<section class="megameal-home-intro" aria-label="MEGAMEAL portal introduction">
  <div class="megameal-home-intro__veil" aria-hidden="true"></div>

  <div class="megameal-home-intro__card">
    <p class="megameal-home-intro__eyebrow">Commercial Portal Online</p>
    <div class="megameal-home-intro__image-frame">
      <Image
        src={mainTitleCard}
        alt="MEGA MEAL SAGA title card"
        class="megameal-home-intro__image"
        loading="eager"
      />
    </div>
    <p class="megameal-home-intro__caption">
      Transmission stabilizing. Promotional sequence will begin shortly.
    </p>
  </div>
</section>

<style>
  .megameal-home-intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    pointer-events: none;
    overflow: hidden;
  }

  .megameal-home-intro__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, rgb(8 10 18 / 0.08), rgb(2 4 10 / 0.38) 72%, rgb(1 2 6 / 0.58)),
      linear-gradient(180deg, rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.3));
    animation: intro-veil-fade 1800ms ease-out both;
  }

  .megameal-home-intro__card {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    width: min(44rem, calc(100% - 2rem));
    padding: clamp(1rem, 2vw, 1.4rem);
    border-radius: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    background:
      linear-gradient(180deg, rgb(8 10 18 / 0.22), rgb(8 10 18 / 0.08));
    box-shadow:
      0 30px 80px rgb(0 0 0 / 0.28),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
    backdrop-filter: blur(8px) saturate(1.08);
    animation: intro-card-fade 2200ms cubic-bezier(0.22, 1, 0.36, 1) 320ms both;
  }

  .megameal-home-intro__eyebrow,
  .megameal-home-intro__caption {
    margin: 0;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgb(241 245 249 / 0.88);
    text-shadow: 0 4px 18px rgb(0 0 0 / 0.55);
  }

  .megameal-home-intro__eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
  }

  .megameal-home-intro__image-frame {
    width: min(34rem, 100%);
  }

  .megameal-home-intro__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter:
      drop-shadow(0 0 1.8rem rgb(255 214 10 / 0.16))
      drop-shadow(0 0.8rem 2rem rgb(0 0 0 / 0.35));
  }

  .megameal-home-intro__caption {
    font-size: 0.64rem;
    color: rgb(226 232 240 / 0.74);
  }

  @keyframes intro-card-fade {
    from {
      opacity: 0;
      transform: translateY(1.25rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes intro-veil-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .megameal-home-intro {
      padding: 1rem;
    }

    .megameal-home-intro__card {
      width: min(100%, 28rem);
      padding: 0.9rem;
      border-radius: 1.2rem;
    }

    .megameal-home-intro__eyebrow {
      font-size: 0.62rem;
    }

    .megameal-home-intro__caption {
      font-size: 0.58rem;
      letter-spacing: 0.14em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .megameal-home-intro__veil,
    .megameal-home-intro__card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
