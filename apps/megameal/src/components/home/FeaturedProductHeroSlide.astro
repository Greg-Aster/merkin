---
import { getCollection } from 'astro:content'
import {
  buildFlagshipProductShowcase,
  getProductSlug,
} from '../../utils/flagship-product-showcase'
import FeaturedProductBanner from './FeaturedProductBanner.svelte'
import '../../styles/features/home/featured-product-hero-slide.css'

const products = await getCollection(
  'products',
  ({ data }) => data.draft !== true,
)
const product =
  products.find(entry => getProductSlug(entry) === 'snuggaloids') ??
  products.find(entry => entry.data.featured) ??
  products[0]

if (!product) {
  throw new Error('FeaturedProductHeroSlide could not resolve a product entry.')
}
const showcase = buildFlagshipProductShowcase(product, products)
---

<div class="featured-product-hero-slide">
  <FeaturedProductBanner
    client:load
    product={showcase.product}
    relatedProducts={showcase.relatedProducts}
    embedOrigin={Astro.url.origin}
  />
</div>
