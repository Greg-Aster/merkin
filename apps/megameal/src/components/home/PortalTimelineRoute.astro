---
import { Icon } from 'astro-icon/components'
import TimelineBanner from '../timeline/TimelineBanner.astro'

interface Props {
  timelineCount: number
}

const { timelineCount } = Astro.props
import '../../styles/features/home/portal-timeline-route.css'
---

<article class="portal-route portal-route--timeline" style="--route-accent: var(--route-timeline);">
  <div class="route-copy">
    <div class="route-kicker">Chronology Console</div>
    <h3>Open the Timeline</h3>
    <p>
      The timeline is the map layer for the whole project: eras, incidents,
      recipes, wars, corporate ascensions, and archival fragments.
    </p>
    <a
      href="/timeline/"
      class="route-link"
      data-sfx-hover="portal-hover"
      data-sfx-click="portal-activate"
    >
      <span>Enter Timeline</span>
      <Icon name="mdi:arrow-right" class="route-link__icon" />
    </a>
  </div>
  <div
    class="route-viewport route-viewport--timeline"
    style="--timeline-preview-bg: url('/assets/banner/posters/universe-poster.webp');"
    aria-label={`${timelineCount} timeline entries preview`}
  >
    <TimelineBanner
      id="portal-timeline-preview"
      category="MEGA MEAL"
      background="/assets/banner/posters/universe-poster.webp"
      compact={true}
      asBanner={true}
      bannerHeight="100%"
      mobileHeight="100%"
      initialViewMode="timeline"
      initialScale={0.82}
      initialOffsetX={0}
      initialOffsetY={0}
      useEraColors={true}
    />
    <div class="route-viewport__shade"></div>
    <div class="route-viewport__label">
      <Icon name="mdi:orbit" />
      <span>{timelineCount} live timeline entries</span>
    </div>
  </div>
</article>
