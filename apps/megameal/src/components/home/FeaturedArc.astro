---
// FeaturedArc.astro
// Highlights one story arc/series with chapters listed, inviting the visitor to begin reading.
// Designed to communicate "this is a complete story" rather than individual blog posts.

import ImageWrapper from '@/components/misc/ImageWrapper.astro'
import { FEATURED_SERIES_ORDER, SERIES_CONFIG } from '@/config/seriesConfig'
import postsManifest from '../../../../../packages/shared-data/generated/posts.json'
import { isPublicContentData } from '../../contracts/content'

type SharedFeaturedPost = (typeof postsManifest.items)[number]

function getPostsBySeriesFromSharedData(
  seriesId: string,
): SharedFeaturedPost[] {
  return postsManifest.items
    .filter(post => isPublicContentData(post) && post.series === seriesId)
    .sort((left, right) => (left.seriesPart ?? 0) - (right.seriesPart ?? 0))
}

// Find the first featured series that has actual posts
let featuredId: string | null = null
let featuredPosts: SharedFeaturedPost[] = []

for (const id of FEATURED_SERIES_ORDER) {
  const config = SERIES_CONFIG[id]
  if (!config) continue
  const posts = getPostsBySeriesFromSharedData(id)
  if (posts.length > 0) {
    featuredId = id
    featuredPosts = posts
    break
  }
}

// If no series has tagged posts yet, show a static preview of the first configured arc
const firstConfigId = FEATURED_SERIES_ORDER[0]
const displayId = featuredId ?? firstConfigId
const displayConfig = SERIES_CONFIG[displayId]
const hasPosts = featuredPosts.length > 0
import '../../styles/features/extracted/featured-arc.css'
---

{displayConfig && (
  <section class="featured-arc">
    <div class="arc-label">Featured Story Arc</div>

    <div class="arc-card" style={`--arc-color: ${displayConfig.color}`}>
      {displayConfig.featuredImage && (
        <div class="arc-image-col">
          <ImageWrapper
            src={displayConfig.featuredImage}
            alt=""
            class="arc-image"
            imgClass="arc-image"
            loading="lazy"
          />
          <div class="arc-image-overlay"></div>
        </div>
      )}

      <div class="arc-content-col">
        <div class="arc-series-tag">Story Arc</div>
        <h2 class="arc-title">{displayConfig.title}</h2>
        <p class="arc-description">{displayConfig.description}</p>

        {hasPosts ? (
          <div class="arc-chapters">
            <div class="chapters-label">Chapters</div>
            <ol class="chapters-list">
              {featuredPosts.slice(0, 6).map((post, i) => (
                <li class="chapter-item">
                  <a href={`/posts/${post.slug}/`} class="chapter-link">
                    <span class="chapter-num">{post.seriesPart ?? i + 1}</span>
                    <span class="chapter-title">{post.title}</span>
                  </a>
                </li>
              ))}
              {featuredPosts.length > 6 && (
                <li class="chapter-item chapter-more">
                  +{featuredPosts.length - 6} more chapters
                </li>
              )}
            </ol>
          </div>
        ) : (
          <div class="arc-coming-soon">
            More chapters incoming. The timeline is still unfolding.
          </div>
        )}

        <div class="arc-actions">
          <a
            href={`/posts/${displayConfig.startSlug}/`}
            class="arc-cta"
            style={`background: ${displayConfig.color}`}
          >
            Begin Reading &rarr;
          </a>
          <a href="/archive/" class="arc-all-link">View all arcs</a>
        </div>
      </div>
    </div>
  </section>
)}
