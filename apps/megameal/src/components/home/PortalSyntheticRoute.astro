---
import { Icon } from 'astro-icon/components'

interface Props {
  href: string
  eyebrow: string
  title: string
  description: string
  stat: string
  icon: string
  tone: 'game' | 'story' | 'store' | 'community'
  reverse?: boolean
}

const {
  href,
  eyebrow,
  title,
  description,
  stat,
  icon,
  tone,
  reverse = false,
} = Astro.props

const linkLabel =
  tone === 'game'
    ? 'Enter Game'
    : tone === 'story'
      ? 'Open Archive'
      : tone === 'store'
        ? 'Browse Store'
        : 'Open Channels'
---

<article
  class:list={[
    'portal-route',
    `portal-route--${tone}`,
    reverse && 'portal-route--reverse',
    'card-base',
  ]}
  style={`--route-accent: var(--route-${tone});`}
>
  <div class="route-copy">
    <div class="route-kicker">{eyebrow}</div>
    <h3>{title}</h3>
    <p>{description}</p>
    <a href={href} class="route-link" data-sfx-click="sweep">
      <span>{linkLabel}</span>
      <Icon name="mdi:arrow-right" class="route-link__icon" />
    </a>
  </div>

  <a href={href} class="route-viewport route-viewport--synthetic" data-sfx-click="sweep" aria-label={title}>
    <div class="route-scene">
      <div class="route-scene__grid"></div>
      {tone === 'game' && (
        <>
          <div class="route-scene__nebula"></div>
          <div class="route-observatory" aria-hidden="true">
            <div class="route-observatory__ring route-observatory__ring--outer"></div>
            <div class="route-observatory__ring route-observatory__ring--middle"></div>
            <div class="route-observatory__ring route-observatory__ring--inner"></div>
            <div class="route-observatory__core"></div>
            <span class="route-observatory__node route-observatory__node--one"></span>
            <span class="route-observatory__node route-observatory__node--two"></span>
            <span class="route-observatory__node route-observatory__node--three"></span>
            <span class="route-observatory__node route-observatory__node--four"></span>
          </div>
          <div class="route-targeting" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </>
      )}
      {tone === 'story' && (
        <>
          <div class="route-archive-bg" aria-hidden="true"></div>
          <div class="route-archive-board" aria-hidden="true">
            <div class="route-archive-card route-archive-card--primary">
              <span>CASE FILE</span>
              <strong>FIRST CONTACT</strong>
              <small>Witness reports cross-indexed</small>
            </div>
            <div class="route-archive-card route-archive-card--redacted">
              <span>REDACTED</span>
              <strong>THE MIRANDA INCIDENT</strong>
              <small>Three accounts recovered</small>
            </div>
            <div class="route-archive-card route-archive-card--signal">
              <span>ARC NODE</span>
              <strong>SINGULARITY WARS</strong>
              <small>Temporal chain unstable</small>
            </div>
            <div class="route-archive-thread route-archive-thread--one"></div>
            <div class="route-archive-thread route-archive-thread--two"></div>
            <div class="route-archive-thread route-archive-thread--three"></div>
          </div>
          <div class="route-archive-index" aria-hidden="true">
            <span>ARCHIVE INDEX</span>
            <span>01</span>
            <span>02</span>
            <span>03</span>
          </div>
        </>
      )}
      {tone === 'store' && (
        <>
          <div class="route-store-glow" aria-hidden="true"></div>
          <div class="route-storefront" aria-hidden="true">
            <div class="route-storefront__sign">MEGAMEAL MARKET</div>
            <div class="route-storefront__shelf route-storefront__shelf--top">
              <span>VALUE SIZE</span>
              <strong>INFINITE HUNGER PACK</strong>
            </div>
            <div class="route-storefront__shelf route-storefront__shelf--middle">
              <span>LIMITED OFFER</span>
              <strong>BUY ONE MEMORY, GET ONE FREE</strong>
            </div>
            <div class="route-storefront__shelf route-storefront__shelf--bottom">
              <span>CORPORATE APPROVED</span>
              <strong>NO REFUNDS AFTER ASCENSION</strong>
            </div>
            <div class="route-storefront__price">$9.99*</div>
          </div>
        </>
      )}
      {tone === 'community' && (
        <>
          <div class="route-community-signal" aria-hidden="true"></div>
          <div class="route-community-network" aria-hidden="true">
            <span class="route-community-node route-community-node--one"></span>
            <span class="route-community-node route-community-node--two"></span>
            <span class="route-community-node route-community-node--three"></span>
            <span class="route-community-node route-community-node--four"></span>
            <span class="route-community-node route-community-node--five"></span>
            <div class="route-community-line route-community-line--one"></div>
            <div class="route-community-line route-community-line--two"></div>
            <div class="route-community-line route-community-line--three"></div>
            <div class="route-community-transmission">
              <span>LIVE CHANNEL</span>
              <strong>COMMUNITY UPLINK</strong>
            </div>
          </div>
        </>
      )}
      <div class="route-scene__orb route-scene__orb--one"></div>
      <div class="route-scene__orb route-scene__orb--two"></div>
      <div class="route-scene__panel">
        <Icon name={icon} class="route-scene__icon" />
        <span>{stat}</span>
      </div>
      <div class="route-scene__scanline"></div>
    </div>
  </a>
</article>

<style>
  .portal-route {
    position: relative;
    display: grid;
    grid-template-columns: minmax(16rem, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(1rem, 3vw, 1.6rem);
    align-items: stretch;
    overflow: visible;
    min-height: clamp(26rem, 46vw, 34rem);
    padding: clamp(1rem, 2.4vw, 1.4rem);
    background:
      radial-gradient(circle at 12% 18%, color-mix(in srgb, var(--route-accent) 18%, transparent), transparent 38%),
      radial-gradient(circle at 92% 88%, color-mix(in srgb, var(--route-accent) 12%, transparent), transparent 35%),
      linear-gradient(180deg, oklch(0.14 0.03 var(--hue) / 0.72), oklch(0.1 0.03 var(--hue) / 0.62));
    border: 1px solid color-mix(in srgb, var(--route-accent) 28%, transparent);
    backdrop-filter: blur(18px) saturate(1.12);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.08),
      0 22px 60px rgba(0,0,0,0.24);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .portal-route::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -1.4rem;
    border-radius: calc(1.25rem + 1.4rem);
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--route-accent) 28%, transparent), transparent 68%),
      radial-gradient(circle at 18% 22%, color-mix(in srgb, var(--route-accent) 14%, transparent), transparent 42%);
    opacity: 0;
    filter: blur(22px);
    transform: scale(0.96);
    transition:
      opacity 0.45s ease,
      transform 0.65s ease,
      filter 0.65s ease;
  }

  .portal-route::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(90deg, transparent 0 48%, color-mix(in srgb, var(--route-accent) 10%, transparent) 50%, transparent 52%),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 5px);
    opacity: 0.34;
    mix-blend-mode: screen;
    transition: opacity 0.35s ease;
  }

  .portal-route:hover {
    border-color: color-mix(in srgb, var(--route-accent) 46%, white);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.11),
      0 26px 72px rgba(0,0,0,0.3),
      0 0 46px color-mix(in srgb, var(--route-accent) 14%, transparent);
  }

  .portal-route:hover::before {
    opacity: 0.72;
    transform: scale(1.05);
    filter: blur(34px);
  }

  .portal-route:hover::after {
    opacity: 0.48;
  }

  .portal-route--reverse {
    grid-template-columns: minmax(0, 0.58fr) minmax(16rem, 0.42fr);
  }

  .portal-route--reverse .route-copy {
    order: 2;
  }

  .portal-route--reverse .route-viewport {
    order: 1;
  }

  .route-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 20rem;
    padding: clamp(1rem, 3vw, 2rem);
    transition:
      transform 0.35s ease,
      filter 0.35s ease;
  }

  .portal-route:hover .route-copy {
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--route-accent) 14%, transparent));
  }

  .route-kicker {
    margin-bottom: 0.65rem;
    color: color-mix(in srgb, var(--route-accent) 76%, white);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .route-copy h3 {
    margin: 0;
    color: white;
    font-size: clamp(1.55rem, 4vw, 2.65rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .route-copy p {
    margin: 0.9rem 0 0;
    max-width: 44rem;
    color: oklch(0.78 0.03 var(--hue));
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .route-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-top: 1.35rem;
    padding: 0.72rem 0.92rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--route-accent) 45%, transparent);
    background: color-mix(in srgb, var(--route-accent) 13%, rgba(0,0,0,0.2));
    color: color-mix(in srgb, var(--route-accent) 72%, white);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .route-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--route-accent) 78%, white);
    box-shadow: 0 0 28px color-mix(in srgb, var(--route-accent) 20%, transparent);
  }

  .route-link__icon {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .route-link:hover .route-link__icon {
    transform: translateX(3px);
  }

  .route-viewport {
    position: relative;
    z-index: 1;
    overflow: hidden;
    min-height: 22rem;
    border-radius: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--route-accent) 34%, transparent);
    background: oklch(0.08 0.03 var(--hue) / 0.78);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.08),
      0 22px 60px rgba(0,0,0,0.24);
  }

  .route-viewport--synthetic {
    display: block;
    text-decoration: none;
    transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
  }

  .route-viewport--synthetic:hover {
    border-color: color-mix(in srgb, var(--route-accent) 74%, white);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--route-accent) 20%, transparent),
      0 26px 72px rgba(0,0,0,0.34);
  }

  .route-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 24% 30%, color-mix(in srgb, var(--route-accent) 28%, transparent), transparent 26%),
      radial-gradient(circle at 72% 70%, rgba(255,255,255,0.12), transparent 18%),
      linear-gradient(135deg, rgba(4, 8, 20, 0.96), rgba(10, 18, 24, 0.82));
    transition: filter 0.45s ease, transform 0.7s ease;
  }

  .portal-route:hover .route-scene {
    filter: saturate(1.15) brightness(1.08);
    transform: scale(1.018);
  }

  .portal-route--game,
  .portal-route--story,
  .portal-route--store,
  .portal-route--community {
    display: block;
    min-height: clamp(28rem, 58vw, 40rem);
    padding: 0;
    border-radius: 1.25rem;
  }

  .portal-route--game .route-copy,
  .portal-route--story .route-copy,
  .portal-route--store .route-copy,
  .portal-route--community .route-copy {
    position: absolute;
    z-index: 4;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    align-items: center;
    justify-content: center;
    width: min(42rem, calc(100% - 2rem));
    min-height: auto;
    padding: clamp(1.25rem, 4vw, 2.35rem);
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--route-accent) 24%, rgba(255,255,255,0.18));
    border-radius: 1.35rem;
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--route-accent) 20%, transparent), transparent 58%),
      rgba(0, 0, 0, 0.32);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(11px) saturate(1.1);
  }

  .portal-route--game:hover .route-copy,
  .portal-route--story:hover .route-copy,
  .portal-route--store:hover .route-copy,
  .portal-route--community:hover .route-copy {
    transform: translate(-50%, -50%);
    border-color: color-mix(in srgb, var(--route-accent) 52%, rgba(255,255,255,0.28));
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--route-accent) 25%, transparent), transparent 58%),
      rgba(0, 0, 0, 0.38);
    box-shadow:
      0 30px 86px rgba(0, 0, 0, 0.3),
      0 0 38px color-mix(in srgb, var(--route-accent) 14%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .portal-route--game .route-copy p,
  .portal-route--story .route-copy p,
  .portal-route--store .route-copy p,
  .portal-route--community .route-copy p {
    max-width: 34rem;
  }

  .portal-route--game .route-viewport,
  .portal-route--story .route-viewport,
  .portal-route--store .route-viewport,
  .portal-route--community .route-viewport {
    min-height: clamp(28rem, 58vw, 40rem);
    border: 0;
    border-radius: inherit;
    box-shadow: none;
  }

  .portal-route--game .route-scene {
    background:
      linear-gradient(90deg, rgba(0,0,0,0.5), rgba(0,0,0,0.04) 52%, rgba(0,0,0,0.5)),
      radial-gradient(circle at 50% 52%, color-mix(in srgb, var(--route-accent) 22%, transparent), transparent 24%),
      url('/assets/hdri/skywip4crop1920.webp') center / cover no-repeat,
      radial-gradient(circle at 18% 22%, rgba(255,255,255,0.18), transparent 2px),
      radial-gradient(circle at 72% 30%, rgba(255,255,255,0.14), transparent 1px),
      radial-gradient(circle at 78% 78%, rgba(255,255,255,0.12), transparent 2px),
      linear-gradient(145deg, #030712, #06141a 55%, #07120d);
  }

  .portal-route--game .route-scene::after,
  .portal-route--story .route-scene::after,
  .portal-route--store .route-scene::after,
  .portal-route--community .route-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, rgba(0,0,0,0), rgba(0,0,0,0.34) 62%, rgba(0,0,0,0.64)),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 6px);
    pointer-events: none;
  }

  .route-archive-bg {
    position: absolute;
    inset: -8%;
    background:
      radial-gradient(circle at 22% 34%, rgba(255,255,255,0.12), transparent 18%),
      radial-gradient(circle at 78% 64%, color-mix(in srgb, var(--route-accent) 30%, transparent), transparent 22%),
      url('/posts/timeline/redacted.png') center / cover no-repeat;
    opacity: 0.28;
    filter: saturate(0.86) contrast(1.08);
    transform: rotate(-2deg) scale(1.08);
    animation: archiveParallax 22s ease-in-out infinite alternate;
  }

  .route-archive-board {
    position: absolute;
    z-index: 1;
    inset: 0;
    opacity: 0.78;
  }

  .route-archive-card {
    position: absolute;
    width: clamp(9rem, 22vw, 15rem);
    min-height: 7.4rem;
    padding: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--route-accent) 32%, rgba(255,255,255,0.18));
    border-radius: 0.9rem;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0.03)),
      rgba(12, 8, 14, 0.66);
    box-shadow:
      0 18px 50px rgba(0,0,0,0.32),
      inset 0 1px 0 rgba(255,255,255,0.08);
    backdrop-filter: blur(10px) saturate(1.08);
  }

  .route-archive-card span,
  .route-archive-card small {
    display: block;
    color: color-mix(in srgb, var(--route-accent) 68%, white);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .route-archive-card strong {
    display: block;
    margin: 0.65rem 0 0.5rem;
    color: white;
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .route-archive-card small {
    color: oklch(0.74 0.03 var(--hue));
    font-size: 0.58rem;
    line-height: 1.45;
    letter-spacing: 0.08em;
  }

  .route-archive-card--primary {
    left: 10%;
    top: 14%;
    transform: rotate(-5deg);
  }

  .route-archive-card--redacted {
    right: 10%;
    top: 18%;
    transform: rotate(4deg);
  }

  .route-archive-card--redacted strong::after {
    content: '';
    display: block;
    width: 72%;
    height: 0.52rem;
    margin-top: 0.42rem;
    background: rgba(0,0,0,0.82);
    box-shadow: 2.2rem 0 0 rgba(0,0,0,0.82);
  }

  .route-archive-card--signal {
    left: 50%;
    bottom: 14%;
    transform: translateX(-50%) rotate(1deg);
  }

  .route-archive-thread {
    position: absolute;
    height: 1px;
    background: color-mix(in srgb, var(--route-accent) 44%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--route-accent) 28%, transparent);
    transform-origin: left center;
  }

  .route-archive-thread--one {
    left: 28%;
    top: 32%;
    width: 44%;
    transform: rotate(3deg);
  }

  .route-archive-thread--two {
    left: 32%;
    top: 40%;
    width: 28%;
    transform: rotate(28deg);
  }

  .route-archive-thread--three {
    left: 56%;
    top: 42%;
    width: 20%;
    transform: rotate(132deg);
  }

  .route-archive-index {
    position: absolute;
    z-index: 2;
    right: 1.15rem;
    top: 1.15rem;
    display: grid;
    gap: 0.42rem;
    justify-items: end;
    color: color-mix(in srgb, var(--route-accent) 70%, white);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .portal-route--story:hover .route-archive-card {
    border-color: color-mix(in srgb, var(--route-accent) 52%, rgba(255,255,255,0.26));
    box-shadow:
      0 20px 58px rgba(0,0,0,0.36),
      0 0 24px color-mix(in srgb, var(--route-accent) 12%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.1);
  }

  .route-scene__nebula {
    position: absolute;
    inset: -18%;
    background:
      radial-gradient(circle at 28% 44%, color-mix(in srgb, var(--route-accent) 32%, transparent), transparent 18%),
      radial-gradient(circle at 70% 48%, rgba(87, 210, 255, 0.16), transparent 22%),
      conic-gradient(from 70deg at 52% 54%, transparent, rgba(255,255,255,0.06), transparent, color-mix(in srgb, var(--route-accent) 16%, transparent), transparent);
    filter: blur(12px);
    opacity: 0.64;
    animation: observatoryDrift 18s ease-in-out infinite alternate;
  }

  .route-observatory {
    position: absolute;
    z-index: 1;
    inset: 50% auto auto 50%;
    width: clamp(17rem, 42vw, 31rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    opacity: 0.82;
  }

  .route-observatory__ring {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--route-accent) 44%, rgba(255,255,255,0.18));
    border-radius: 999px;
    box-shadow:
      0 0 28px color-mix(in srgb, var(--route-accent) 18%, transparent),
      inset 0 0 34px rgba(255,255,255,0.035);
  }

  .route-observatory__ring--outer {
    animation: observatorySpin 38s linear infinite;
  }

  .route-observatory__ring--middle {
    inset: 14%;
    border-style: dashed;
    opacity: 0.76;
    animation: observatorySpin 28s linear infinite reverse;
  }

  .route-observatory__ring--inner {
    inset: 31%;
    opacity: 0.92;
    animation: observatoryPulse 4.8s ease-in-out infinite;
  }

  .route-observatory__core {
    position: absolute;
    inset: 43%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--route-accent) 55%, white);
    box-shadow:
      0 0 22px color-mix(in srgb, var(--route-accent) 70%, transparent),
      0 0 62px color-mix(in srgb, var(--route-accent) 30%, transparent);
  }

  .route-observatory__node {
    position: absolute;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: white;
    box-shadow: 0 0 18px color-mix(in srgb, var(--route-accent) 80%, transparent);
  }

  .route-observatory__node--one {
    left: 18%;
    top: 29%;
  }

  .route-observatory__node--two {
    right: 21%;
    top: 22%;
  }

  .route-observatory__node--three {
    left: 29%;
    bottom: 20%;
  }

  .route-observatory__node--four {
    right: 15%;
    bottom: 34%;
  }

  .route-targeting {
    position: absolute;
    z-index: 2;
    inset: 1.25rem;
    pointer-events: none;
    opacity: 0.46;
  }

  .route-targeting span {
    position: absolute;
    width: 2.2rem;
    height: 2.2rem;
    border-color: color-mix(in srgb, var(--route-accent) 58%, white);
  }

  .route-targeting span:nth-child(1) {
    left: 0;
