---
import {
  megaMealUniverseFacts,
  resolveTimelineFactHref,
} from '../../config/timelineFacts'
import '../../styles/features/facts-widget/core.css'
import '../../styles/features/home/portal-sponsored-bloom.css'

const sponsoredFacts = megaMealUniverseFacts
  .filter(fact => fact.type === 'advertisement')
  .map((fact, index) => ({
    id: `sponsored-${index}`,
    eyebrow: fact.eyebrow ?? 'Sponsored Placement',
    headline: fact.headline ?? 'Sponsored Message',
    text: fact.text,
    ctaText: fact.ctaText ?? 'Comply',
    href: resolveTimelineFactHref(fact) ?? '/posts/explainer/',
    sponsor: fact.sponsor ?? 'Consumer Satisfaction Bureau',
    finePrint: fact.finePrint ?? '',
    theme: fact.theme ?? 'default',
    image: fact.image ?? '',
    video: fact.video ?? '',
  }))

const bloomId = `portal-sponsored-bloom-${Math.random().toString(36).slice(2, 10)}`
---

<section
  id={bloomId}
  class="portal-sponsored-bloom"
  data-portal-sponsored-bloom
  data-state="waiting"
  data-complete="false"
  aria-hidden="true"
>
  <div class="portal-sponsored-bloom__stage" data-bloom-stage></div>
</section>

<script is:inline define:vars={{ bloomId, sponsoredFacts }}>
  ;(() => {
    const cleanupKey = '__megamealPortalSponsoredBloomCleanup'
    window[cleanupKey]?.()

    const root = document.getElementById(bloomId)
    const stage = root?.querySelector('[data-bloom-stage]')
    const facts = Array.isArray(sponsoredFacts) ? sponsoredFacts : []

    if (!root || !stage || facts.length === 0) return

    const abortController = new AbortController()
    const { signal } = abortController
    const movementKeys = new Set([
      'ArrowDown',
      'ArrowUp',
      'ArrowLeft',
      'ArrowRight',
      'PageDown',
      'PageUp',
      'Home',
      'End',
      ' ',
      'Spacebar',
    ])
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    )
    let stopped = false
    let started = false
    let completed = false
    let spawnTimeout = 0
    let removalTimeout = 0
    let nextFactIndex = 0
    let pointerStart = null
    let shuffledFacts = []
    let placementZones = []

    const randomUnit = () => {
      if (window.crypto?.getRandomValues) {
        const values = new Uint32Array(1)
        window.crypto.getRandomValues(values)
        return values[0] / 4294967296
      }

      return Math.random()
    }

    const randomBetween = (min, max) => min + randomUnit() * (max - min)

    const clamp = (value, min, max) =>
      Math.min(Math.max(value, min), Math.max(min, max))

    const shuffle = items => {
      const shuffled = [...items]
      for (let index = shuffled.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(randomUnit() * (index + 1))
        ;[shuffled[index], shuffled[swapIndex]] = [
          shuffled[swapIndex],
          shuffled[index],
        ]
      }

      return shuffled
    }

    const createText = (tagName, className, text) => {
      const element = document.createElement(tagName)
      element.className = className
      element.textContent = text || ''
      return element
    }

    const createMedia = fact => {
      const media = document.createElement('div')
      media.className = `facts-widget-media${
        fact.image || fact.video ? '' : ' is-hidden'
      }`
      media.dataset.factMedia = ''

      if (fact.video) {
        const video = document.createElement('video')
        video.className = 'facts-widget-media-video'
        video.dataset.factMediaVideo = ''
        video.autoplay = true
        video.loop = true
        video.muted = true
        video.defaultMuted = true
        video.playsInline = true
        video.preload = 'none'
        video.src = fact.video
        media.append(video)
      } else if (fact.image) {
        const image = document.createElement('img')
        image.className = 'facts-widget-media-img'
        image.dataset.factMediaImg = ''
        image.src = fact.image
        image.alt = fact.headline || ''
        image.loading = 'lazy'
        image.decoding = 'async'
        media.append(image)
      }

      return media
    }

    const createCard = (fact, options = {}) => {
      const card = document.createElement('article')
      const hasMedia = Boolean(fact.image || fact.video)
      card.className = 'portal-sponsored-bloom__card facts-widget-container facts-widget-portal'
      card.dataset.factTheme = fact.theme || 'default'
      card.dataset.expanded = 'true'
      card.dataset.bloomDensity =
        options.primary || hasMedia || randomUnit() > 0.34
          ? 'standard'
          : 'compact'
      card.dataset.hasMedia = hasMedia ? 'true' : 'false'

      if (options.primary) {
        card.classList.add('portal-sponsored-bloom__card--primary')
      } else {
        const placement = createPlacement(options.order ?? 0)
        card.style.setProperty('--bloom-left', `${placement.left}%`)
        card.style.setProperty('--bloom-top', `${placement.top}%`)
        card.style.setProperty('--bloom-width', `${placement.widthRem}rem`)
        card.style.setProperty('--bloom-rotate', `${placement.rotate}deg`)
        card.style.setProperty('--bloom-order', String(options.order ?? 0))
      }

      const shell = document.createElement('div')
      shell.className = 'facts-widget-shell'

      const frame = document.createElement('div')
      frame.className =
        'facts-widget-frame megameal-surface megameal-surface--interactive'

      const header = document.createElement('div')
      header.className = 'facts-widget-header'

      const headerCopy = document.createElement('div')
      headerCopy.className = 'facts-widget-header-copy'
      headerCopy.append(createText('div', 'facts-widget-kicker', 'Live Ad Feed'))
      header.append(headerCopy)

      const body = document.createElement('div')
      body.className = 'facts-widget-body'

      const labelRow = document.createElement('div')
      labelRow.className = 'facts-widget-label-row'
      labelRow.append(
        createText(
          'span',
          'facts-widget-label',
          fact.eyebrow || 'Sponsored Placement',
        ),
        createText(
          'span',
          'facts-widget-sponsor',
          fact.sponsor || 'Consumer Satisfaction Bureau',
        ),
      )

      const actionRow = document.createElement('div')
      actionRow.className = 'facts-widget-actions'

      const link = document.createElement('a')
      link.className = 'facts-widget-cta'
      link.href = fact.href || '/posts/explainer/'
      link.textContent = fact.ctaText || 'Comply'
      link.tabIndex = -1
      link.dataset.sfxClick = 'sweep'
      link.dataset.sfxHover = 'hover-soft'
      actionRow.append(link)

      const finePrint = createText('p', 'facts-widget-fineprint', fact.finePrint)
      if (!fact.finePrint) finePrint.classList.add('is-hidden')

      body.append(
        labelRow,
        createText(
          'h3',
          'facts-widget-headline',
          fact.headline || 'Sponsored Message',
        ),
        createMedia(fact),
        createText('p', 'facts-widget-text', fact.text),
        actionRow,
        finePrint,
      )

      frame.append(
        header,
        body,
        createText(
          'p',
          'facts-widget-footer',
          'Paid propaganda. Unpaid consequences.',
        ),
      )
      shell.append(frame)
      card.append(shell)

      return card
    }

    const createPlacementZones = () => {
      const compact = window.matchMedia('(max-width: 640px)').matches
      const zones = compact
        ? [
            { x: [4, 8], y: [7, 13], width: [9.75, 12] },
            { x: [48, 58], y: [9, 17], width: [9.75, 12.5] },
            { x: [8, 16], y: [28, 39], width: [10, 13] },
            { x: [40, 52], y: [35, 47], width: [10, 13.5] },
            { x: [4, 12], y: [53, 64], width: [9.75, 12.25] },
            { x: [45, 55], y: [62, 73], width: [9.75, 12.5] },
            { x: [18, 30], y: [74, 84], width: [10, 13] },
          ]
        : [
            { x: [3, 10], y: [8, 16], width: [12, 16] },
            { x: [27, 39], y: [6, 14], width: [13, 18] },
            { x: [61, 74], y: [8, 18], width: [12, 17] },
            { x: [5, 14], y: [29, 43], width: [13, 19] },
            { x: [34, 47], y: [27, 41], width: [14, 21] },
            { x: [68, 80], y: [30, 45], width: [12, 18] },
            { x: [3, 13], y: [56, 71], width: [11, 16] },
            { x: [29, 43], y: [58, 75], width: [13, 20] },
            { x: [57, 70], y: [55, 71], width: [12, 18] },
            { x: [42, 54], y: [72, 83], width: [12, 17] },
          ]

      return shuffle(zones)
    }

    const createPlacement = order => {
      if (placementZones.length === 0) {
        placementZones = createPlacementZones()
      }

      const zone = placementZones[order % placementZones.length]
      const cycle = Math.floor(order / placementZones.length)
      const rootFontSize =
        Number.parseFloat(
          window.getComputedStyle(document.documentElement).fontSize,
        ) || 16
      const viewportWidth = Math.max(window.innerWidth, 320)
      const viewportHeight = Math.max(window.innerHeight, 420)
      const margin = rootFontSize * 0.55
      const maxWidthRem = Math.max(8.5, (viewportWidth - margin * 2) / rootFontSize)
      const widthRem = Math.min(
        maxWidthRem,
        randomBetween(zone.width[0], zone.width[1]) *
          Math.max(0.82, 1 - cycle * 0.035),
      )
      const widthPx = widthRem * rootFontSize
      const estimatedHeightPx = widthPx * (viewportWidth < 640 ? 0.82 : 0.72)
      const leftPx = clamp(
        (randomBetween(zone.x[0], zone.x[1]) / 100) * viewportWidth,
        margin,
        viewportWidth - widthPx - margin,
      )
      const topPx = clamp(
        (randomBetween(zone.y[0], zone.y[1]) / 100) * viewportHeight,
        margin,
        viewportHeight - estimatedHeightPx - margin,
      )

      return {
        left: (leftPx / viewportWidth) * 100,
        top: (topPx / viewportHeight) * 100,
        widthRem,
        rotate: randomBetween(-4.8, 4.8),
      }
    }

    const clearSpawnTimer = () => {
      if (!spawnTimeout) return

      window.clearTimeout(spawnTimeout)
      spawnTimeout = 0
    }

    const clearRemovalTimer = () => {
      if (!removalTimeout) return

      window.clearTimeout(removalTimeout)
      removalTimeout = 0
    }

    const removeBloomRoot = () => {
      clearRemovalTimer()
      root.dataset.state = 'stopped'
      root.remove()
    }

    const finishBloom = () => {
      completed = true
      root.dataset.complete = 'true'
      clearSpawnTimer()
    }

    const scheduleNextSpawn = (delay = randomBetween(4200, 7000)) => {
      clearSpawnTimer()
      if (stopped || completed) return
      if (nextFactIndex >= shuffledFacts.length) {
        finishBloom()
        return
      }

      spawnTimeout = window.setTimeout(() => {
        spawnTimeout = 0
        if (stopped) return

        const fact = shuffledFacts[nextFactIndex]
        nextFactIndex += 1
        const card = createCard(fact, {
          order: nextFactIndex,
        })
        stage.append(card)
        scheduleNextSpawn(
          prefersReducedMotion.matches
            ? randomBetween(6200, 8200)
            : randomBetween(2800, 5600),
        )
      }, delay)
    }

    const startBloom = () => {
      if (started || stopped) return
      if (
        window.scrollY > 24 ||
        document.documentElement.classList.contains(
          'megameal-home-standard-banner-phase',
        )
      ) {
        stopBloom()
        return
      }

      shuffledFacts = shuffle(facts)
      placementZones = createPlacementZones()
      const firstFact = shuffledFacts[0]
      if (!firstFact) {
        stopBloom()
        return
      }

      started = true
      nextFactIndex = 1
      root.dataset.state = 'active'
      stage.append(
        createCard(firstFact, {
          primary: true,
          order: 0,
        }),
      )
      scheduleNextSpawn(prefersReducedMotion.matches ? 7600 : 5200)
    }

    function stopBloom() {
      if (stopped) return

      stopped = true
      clearSpawnTimer()
      abortController.abort()
      root.dataset.state = 'stopping'
      removalTimeout = window.setTimeout(removeBloomRoot, 520)
      if (window[cleanupKey] === stopBloom) {
        window[cleanupKey] = null
      }
    }

    const handleMovement = () => {
      stopBloom()
    }

    const handleWindowScroll = () => {
      if (window.scrollY > 16) {
        handleMovement()
      }
    }

    const handleKeydown = event => {
      if (movementKeys.has(event.key)) {
        handleMovement()
      }
    }

    const handlePointerDown = event => {
      if (event.button !== 0) return
      if (
        event.target instanceof Element &&
        event.target.closest('[data-portal-sponsored-bloom]')
      ) {
        return
      }

      pointerStart = {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
      }
    }

    const handlePointerMove = event => {
      if (!pointerStart || pointerStart.id !== event.pointerId) return

      const distance = Math.hypot(
        event.clientX - pointerStart.x,
        event.clientY - pointerStart.y,
      )
      if (distance > 12) {
        handleMovement()
      }
    }

    const clearPointerStart = event => {
      if (!pointerStart || pointerStart.id === event.pointerId) {
        pointerStart = null
      }
    }

    window[cleanupKey] = stopBloom
    window.addEventListener('wheel', handleMovement, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('touchmove', handleMovement, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('scroll', handleWindowScroll, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('merkin:portal-advance', handleMovement, {
      signal,
    })
    window.addEventListener('keydown', handleKeydown, {
      capture: true,
      signal,
    })
    window.addEventListener('pointerdown', handlePointerDown, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('pointermove', handlePointerMove, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('pointerup', clearPointerStart, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('pointercancel', clearPointerStart, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('megameal:portal-intro-ready', startBloom, {
      signal,
    })
    window.addEventListener('pagehide', stopBloom, {
      once: true,
      signal,
    })
    document.addEventListener('astro:before-preparation', stopBloom, {
      once: true,
      signal,
    })

    if (document.documentElement.dataset.megamealPortalIntroReady === 'true') {
      window.setTimeout(startBloom, 0)
    }
  })()
</script>
