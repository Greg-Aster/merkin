---
import type { TimelineFact } from '../../config/timelineFacts'
import {
  megaMealUniverseFacts,
  privacyNoticeTimelineFact,
  resolveTimelineFactHref,
} from '../../config/timelineFacts'
import '../../styles/features/facts-widget/core.css'
import '../../styles/features/home/portal-sponsored-bloom.css'

const toSponsoredFact = (fact: TimelineFact, id: string) => ({
  id,
  eyebrow: fact.eyebrow ?? 'Sponsored Placement',
  headline: fact.headline ?? 'Sponsored Message',
  text: fact.text,
  ctaText: fact.ctaText ?? 'Comply',
  href: resolveTimelineFactHref(fact) ?? '/posts/explainer/',
  sponsor: fact.sponsor ?? 'Consumer Satisfaction Bureau',
  finePrint: fact.finePrint ?? '',
  theme: fact.theme ?? 'default',
  image: fact.image ?? '',
  video: fact.video ?? '',
  cookieActions: fact.cookieActions ?? [],
})

const privacyNoticeFact = toSponsoredFact(
  privacyNoticeTimelineFact,
  'privacy-notice',
)
const sponsoredFacts = megaMealUniverseFacts
  .filter(fact => fact.type === 'advertisement')
  .map((fact, index) => toSponsoredFact(fact, `sponsored-${index}`))

const bloomId = `portal-sponsored-bloom-${Math.random().toString(36).slice(2, 10)}`
---

<section
  id={bloomId}
  class="portal-sponsored-bloom"
  data-portal-sponsored-bloom
  data-state="waiting"
  data-complete="false"
  aria-hidden="true"
>
  <div class="portal-sponsored-bloom__stage" data-bloom-stage></div>
</section>

<script is:inline define:vars={{ bloomId, privacyNoticeFact, sponsoredFacts }}>
  ;(() => {
    const cleanupKey = '__megamealPortalSponsoredBloomCleanup'
    window[cleanupKey]?.()

    const root = document.getElementById(bloomId)
    const stage = root?.querySelector('[data-bloom-stage]')
    const facts = Array.isArray(sponsoredFacts) ? sponsoredFacts : []

    if (!root || !stage || facts.length === 0) return

    const abortController = new AbortController()
    const { signal } = abortController
    const movementKeys = new Set([
      'ArrowDown',
      'ArrowUp',
      'ArrowLeft',
      'ArrowRight',
      'PageDown',
      'PageUp',
      'Home',
      'End',
      ' ',
      'Spacebar',
    ])
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    )
    const initialSpawnDelayMs = 5000
    const minSpawnDelayMs = 8000
    const maxSpawnDelayMs = 12000
    let stopped = false
    let started = false
    let completed = false
    let spawnTimeout = 0
    let removalTimeout = 0
    let nextFactIndex = 0
    let pointerStart = null
    let shuffledFacts = []
    let placementHistory = []

    const randomUnit = () => {
      if (window.crypto?.getRandomValues) {
        const values = new Uint32Array(1)
        window.crypto.getRandomValues(values)
        return values[0] / 4294967296
      }

      return Math.random()
    }

    const randomBetween = (min, max) => min + randomUnit() * (max - min)

    const clamp = (value, min, max) =>
      Math.min(Math.max(value, min), Math.max(min, max))

    const shuffle = items => {
      const shuffled = [...items]
      for (let index = shuffled.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(randomUnit() * (index + 1))
        ;[shuffled[index], shuffled[swapIndex]] = [
          shuffled[swapIndex],
          shuffled[index],
        ]
      }

      return shuffled
    }

    const createText = (tagName, className, text) => {
      const element = document.createElement(tagName)
      element.className = className
      element.textContent = text || ''
      return element
    }

    const createMedia = fact => {
      const media = document.createElement('div')
      media.className = `facts-widget-media${
        fact.image || fact.video ? '' : ' is-hidden'
      }`
      media.dataset.factMedia = ''

      if (fact.video) {
        const video = document.createElement('video')
        video.className = 'facts-widget-media-video'
        video.dataset.factMediaVideo = ''
        video.autoplay = true
        video.loop = true
        video.muted = true
        video.defaultMuted = true
        video.playsInline = true
        video.preload = 'none'
        video.src = fact.video
        media.append(video)
      } else if (fact.image) {
        const image = document.createElement('img')
        image.className = 'facts-widget-media-img'
        image.dataset.factMediaImg = ''
        image.src = fact.image
        image.alt = fact.headline || ''
        image.loading = 'lazy'
        image.decoding = 'async'
        media.append(image)
      }

      return media
    }

    const createCard = (fact, options = {}) => {
      const card = document.createElement('article')
      const hasMedia = Boolean(fact.image || fact.video)
      card.className = 'portal-sponsored-bloom__card facts-widget-container facts-widget-portal'
      card.dataset.factTheme = fact.theme || 'default'
      card.dataset.factRole = fact.cookieActions?.length
        ? 'privacy-notice'
        : 'standard'
      card.dataset.expanded = 'true'
      card.dataset.bloomDensity =
        options.primary || hasMedia || randomUnit() > 0.34
          ? 'standard'
          : 'compact'
      card.dataset.hasMedia = hasMedia ? 'true' : 'false'

      if (options.primary) {
        card.classList.add('portal-sponsored-bloom__card--primary')
      } else {
        const placement = createPlacement(options.order ?? 0)
        card.style.setProperty('--bloom-left', `${placement.left}%`)
        card.style.setProperty('--bloom-top', `${placement.top}%`)
        card.style.setProperty('--bloom-width', `${placement.widthRem}rem`)
        card.style.setProperty('--bloom-rotate', `${placement.rotate}deg`)
        card.style.setProperty('--bloom-order', String(options.order ?? 0))
      }

      const shell = document.createElement('div')
      shell.className = 'facts-widget-shell'

      const frame = document.createElement('div')
      frame.className =
        'facts-widget-frame megameal-surface megameal-surface--interactive'

      const header = document.createElement('div')
      header.className = 'facts-widget-header'

      const headerCopy = document.createElement('div')
      headerCopy.className = 'facts-widget-header-copy'
      headerCopy.append(createText('div', 'facts-widget-kicker', 'Live Ad Feed'))
      header.append(headerCopy)

      const body = document.createElement('div')
      body.className = 'facts-widget-body'

      const labelRow = document.createElement('div')
      labelRow.className = 'facts-widget-label-row'
      labelRow.append(
        createText(
          'span',
          'facts-widget-label',
          fact.eyebrow || 'Sponsored Placement',
        ),
        createText(
          'span',
          'facts-widget-sponsor',
          fact.sponsor || 'Consumer Satisfaction Bureau',
        ),
      )

      const actionRow = document.createElement('div')
      actionRow.className = 'facts-widget-actions'

      const link = document.createElement('a')
      link.className = 'facts-widget-cta'
      link.href = fact.href || '/posts/explainer/'
      link.textContent = fact.ctaText || 'Comply'
      link.tabIndex = -1
      link.dataset.sfxClick = 'sweep'
      link.dataset.sfxHover = 'hover-soft'
      actionRow.append(link)

      if (fact.cookieActions?.length) {
        link.hidden = true
        const cookieActions = document.createElement('div')
        cookieActions.className = 'facts-widget-cookie-actions'
        fact.cookieActions.forEach((label, index) => {
          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'facts-widget-cookie-choice'
          button.textContent = label
          button.tabIndex = -1
          button.dataset.factCookieChoice = String(index)
          button.dataset.sfxClick = 'sweep'
          cookieActions.append(button)
        })
        actionRow.append(cookieActions)
      }

      const finePrint = createText('p', 'facts-widget-fineprint', fact.finePrint)
      if (!fact.finePrint) finePrint.classList.add('is-hidden')

      body.append(
        labelRow,
        createText(
          'h3',
          'facts-widget-headline',
          fact.headline || 'Sponsored Message',
        ),
        createMedia(fact),
        createText('p', 'facts-widget-text', fact.text),
        actionRow,
        finePrint,
      )

      frame.append(
        header,
        body,
        createText(
          'p',
          'facts-widget-footer',
          'Paid propaganda. Unpaid consequences.',
        ),
      )
      shell.append(frame)
      card.append(shell)

      return card
    }

    const rememberPlacement = placement => {
      placementHistory.push(placement)
      if (placementHistory.length > 18) {
        placementHistory.shift()
      }
    }

    const rememberPrimaryPlacement = () => {
      const rootFontSize =
        Number.parseFloat(
          window.getComputedStyle(document.documentElement).fontSize,
        ) || 16
      const viewportWidth = Math.max(window.innerWidth, 320)
      const viewportHeight = Math.max(window.innerHeight, 420)
      const compact = window.matchMedia('(max-width: 640px)').matches
      const widthPx = compact
        ? viewportWidth - rootFontSize * 1.1
        : Math.min(14.25 * rootFontSize, viewportWidth - rootFontSize)
      const heightPx = Math.min(
        compact ? 8.2 * rootFontSize : 25 * rootFontSize,
        viewportHeight * 0.58,
      )
      const right = compact
        ? rootFontSize * 0.55
        : clamp(viewportWidth * 0.03, rootFontSize * 0.9, rootFontSize * 2)
      const bottom = rootFontSize * 0.9

      rememberPlacement({
        centerX: viewportWidth - right - widthPx / 2,
        centerY: viewportHeight - bottom - heightPx / 2,
        radius: Math.hypot(widthPx, heightPx) * 0.34,
      })
    }

    const scorePlacementCandidate = candidate => {
      if (placementHistory.length === 0) return randomUnit()

      const nearestClearance = Math.min(
        ...placementHistory.map(placement => {
          const distance = Math.hypot(
            candidate.centerX - placement.centerX,
            candidate.centerY - placement.centerY,
          )
          return distance / Math.max(1, candidate.radius + placement.radius)
        }),
      )
      const centerBias =
        Math.abs(candidate.centerX / candidate.viewportWidth - 0.5) +
        Math.abs(candidate.centerY / candidate.viewportHeight - 0.5)
      const bottomRightPenalty =
        candidate.centerX > candidate.viewportWidth * 0.68 &&
        candidate.centerY > candidate.viewportHeight * 0.55
          ? 0.55
          : 0

      return nearestClearance + centerBias * 0.18 + randomUnit() * 0.42 - bottomRightPenalty
    }

    const createPlacementCandidate = (order, metrics) => {
      const cycle = Math.floor(order / 8)
      const widthMin = metrics.compact ? 9.75 : 11.5
      const widthMax = metrics.compact ? 14.5 : 22.5
      const widthRem = Math.min(
        metrics.maxWidthRem,
        randomBetween(widthMin, widthMax) * Math.max(0.82, 1 - cycle * 0.035),
      )
      const widthPx = widthRem * metrics.rootFontSize
      const estimatedHeightPx =
        widthPx * (metrics.compact ? randomBetween(0.72, 0.92) : randomBetween(0.62, 0.78))
      const maxLeftPx = Math.max(
        metrics.margin,
        metrics.viewportWidth - widthPx - metrics.margin,
      )
      const maxTopPx = Math.max(
        metrics.margin,
        metrics.viewportHeight - estimatedHeightPx - metrics.margin,
      )
      const leftPx = randomBetween(metrics.margin, maxLeftPx)
      const topPx = randomBetween(metrics.margin, maxTopPx)

      return {
        leftPx,
        topPx,
        widthRem,
        widthPx,
        estimatedHeightPx,
        centerX: leftPx + widthPx / 2,
        centerY: topPx + estimatedHeightPx / 2,
        radius: Math.hypot(widthPx, estimatedHeightPx) * 0.34,
        viewportWidth: metrics.viewportWidth,
        viewportHeight: metrics.viewportHeight,
      }
    }

    const createPlacement = order => {
      const compact = window.matchMedia('(max-width: 640px)').matches
      const rootFontSize =
        Number.parseFloat(
          window.getComputedStyle(document.documentElement).fontSize,
        ) || 16
      const viewportWidth = Math.max(window.innerWidth, 320)
      const viewportHeight = Math.max(window.innerHeight, 420)
      const margin = rootFontSize * 0.55
      const maxWidthRem = Math.max(8.5, (viewportWidth - margin * 2) / rootFontSize)
      const metrics = {
        compact,
        rootFontSize,
        viewportWidth,
        viewportHeight,
        margin,
        maxWidthRem,
      }
      const candidateCount = compact ? 12 : 22
      const candidates = Array.from({ length: candidateCount }, () =>
        createPlacementCandidate(order, metrics),
      )
      const placement = candidates
        .map(candidate => ({
          candidate,
          score: scorePlacementCandidate(candidate),
        }))
        .reduce((best, entry) => (entry.score > best.score ? entry : best))
        .candidate

      rememberPlacement(placement)

      return {
        left: (placement.leftPx / viewportWidth) * 100,
        top: (placement.topPx / viewportHeight) * 100,
        widthRem: placement.widthRem,
        rotate: randomBetween(-4.8, 4.8),
      }
    }

    const clearSpawnTimer = () => {
      if (!spawnTimeout) return

      window.clearTimeout(spawnTimeout)
      spawnTimeout = 0
    }

    const clearRemovalTimer = () => {
      if (!removalTimeout) return

      window.clearTimeout(removalTimeout)
      removalTimeout = 0
    }

    const removeBloomRoot = () => {
      clearRemovalTimer()
      root.dataset.state = 'stopped'
      root.remove()
    }

    const finishBloom = () => {
      completed = true
      root.dataset.complete = 'true'
      clearSpawnTimer()
    }

    const scheduleNextSpawn = (
      delay = randomBetween(minSpawnDelayMs, maxSpawnDelayMs),
    ) => {
      clearSpawnTimer()
      if (stopped || completed) return
      if (nextFactIndex >= shuffledFacts.length) {
        finishBloom()
        return
      }

      spawnTimeout = window.setTimeout(() => {
        spawnTimeout = 0
        if (stopped) return

        const fact = shuffledFacts[nextFactIndex]
        nextFactIndex += 1
        const card = createCard(fact, {
          order: nextFactIndex,
        })
        stage.append(card)
        scheduleNextSpawn(
          prefersReducedMotion.matches
            ? maxSpawnDelayMs
            : randomBetween(minSpawnDelayMs, maxSpawnDelayMs),
        )
      }, delay)
    }

    const startBloom = () => {
      if (started || stopped) return
      if (
        window.scrollY > 24 ||
        document.documentElement.classList.contains(
          'megameal-home-standard-banner-phase',
        )
      ) {
        stopBloom()
        return
      }

      shuffledFacts = shuffle(facts)
      placementHistory = []
      const firstFact = privacyNoticeFact || shuffledFacts[0]
      if (!firstFact) {
        stopBloom()
        return
      }

      started = true
      nextFactIndex = privacyNoticeFact ? 0 : 1
      root.dataset.state = 'active'
      spawnTimeout = window.setTimeout(() => {
        spawnTimeout = 0
        if (stopped) return

        stage.append(
          createCard(firstFact, {
            primary: true,
            order: 0,
          }),
        )
        rememberPrimaryPlacement()
        scheduleNextSpawn(
          prefersReducedMotion.matches
            ? maxSpawnDelayMs
            : randomBetween(minSpawnDelayMs, maxSpawnDelayMs),
        )
      }, initialSpawnDelayMs)
    }

    function stopBloom() {
      if (stopped) return

      stopped = true
      clearSpawnTimer()
      abortController.abort()
      root.dataset.state = 'stopping'
      removalTimeout = window.setTimeout(removeBloomRoot, 520)
      if (window[cleanupKey] === stopBloom) {
        window[cleanupKey] = null
      }
    }

    const handleMovement = () => {
      stopBloom()
    }

    const handleWindowScroll = () => {
      if (window.scrollY > 16) {
        handleMovement()
      }
    }

    const handleKeydown = event => {
      if (movementKeys.has(event.key)) {
        handleMovement()
      }
    }

    const handlePointerDown = event => {
      if (event.button !== 0) return
      if (
        event.target instanceof Element &&
        event.target.closest('[data-portal-sponsored-bloom]')
      ) {
        return
      }

      pointerStart = {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
      }
    }

    const handlePointerMove = event => {
      if (!pointerStart || pointerStart.id !== event.pointerId) return

      const distance = Math.hypot(
        event.clientX - pointerStart.x,
        event.clientY - pointerStart.y,
      )
      if (distance > 12) {
        handleMovement()
      }
    }

    const clearPointerStart = event => {
      if (!pointerStart || pointerStart.id === event.pointerId) {
        pointerStart = null
      }
    }

    window[cleanupKey] = stopBloom
    window.addEventListener('wheel', handleMovement, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('touchmove', handleMovement, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('scroll', handleWindowScroll, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('merkin:portal-advance', handleMovement, {
      signal,
    })
    window.addEventListener('keydown', handleKeydown, {
      capture: true,
      signal,
    })
    window.addEventListener('pointerdown', handlePointerDown, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('pointermove', handlePointerMove, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('pointerup', clearPointerStart, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('pointercancel', clearPointerStart, {
      capture: true,
      passive: true,
      signal,
    })
    window.addEventListener('megameal:portal-intro-ready', startBloom, {
      signal,
    })
    window.addEventListener('pagehide', stopBloom, {
      once: true,
      signal,
    })
    document.addEventListener('astro:before-preparation', stopBloom, {
      once: true,
      signal,
    })

    if (document.documentElement.dataset.megamealPortalIntroReady === 'true') {
      window.setTimeout(startBloom, 0)
    }
  })()
</script>
