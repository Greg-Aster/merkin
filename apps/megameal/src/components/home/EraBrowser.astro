---
// EraBrowser.astro
// Browse the MEGAMEAL universe by timeline era.
// Pulls era config from timelineconfig.ts and counts posts per era.

import { getCollection } from 'astro:content'
import { defaultEraConfig, eraColorMap } from '@/config/timelineconfig'

// Get all non-draft posts
const allPosts = await getCollection('posts', ({ data }) => data.draft !== true)

// Count posts per era
const postCountByEra: Record<string, number> = {}
for (const post of allPosts) {
  const era = (post.data as any).timelineEra as string | undefined
  if (era) {
    postCountByEra[era] = (postCountByEra[era] ?? 0) + 1
  }
}

// Ordered list of eras to display (exclude meta-eras like all-time, all-eras, unknown)
const DISPLAY_ERAS = [
  'ancient-epoch',
  'awakening-era',
  'golden-age',
  'conflict-epoch',
  'singularity-conflict',
  'transcendent-age',
  'final-epoch',
]

// Brief in-universe taglines for each era
const ERA_TAGLINES: Record<string, string> = {
  'ancient-epoch': 'From the Big Bang to the First Corporations',
  'awakening-era':
    'The rise of digital consciousness and early stellar expansion',
  'golden-age': 'Hyper-capitalism at its most delicious and most dangerous',
  'conflict-epoch': 'Extinction events, uprisings, and very bad Yelp reviews',
  'singularity-conflict': 'The war that fractured time itself',
  'transcendent-age': 'What remains after everything ends (almost everything)',
  'final-epoch': 'The last menus. The last meals. The heat death approaches.',
}

const eras = DISPLAY_ERAS.map(id => ({
  id,
  config: defaultEraConfig[id],
  color: eraColorMap[id] ?? '#6366f1',
  tagline: ERA_TAGLINES[id] ?? '',
  postCount: postCountByEra[id] ?? 0,
})).filter(e => e.config)
---

<section class="era-browser">
  <div class="era-browser-header">
    <div class="era-browser-label">Explore by Era</div>
    <p class="era-browser-sub">
      The MEGAMEAL universe spans Year 1 to Year 50,000. Click any era to read its stories.
    </p>
  </div>

  <div class="era-grid">
    {eras.map(era => (
      <a
        href={`/archive/?timelineEra=${era.id}`}
        class="era-card"
        style={`--era-color: ${era.color}`}
      >
        <div class="era-card-bg" style={`background-image: url(${era.config.backgroundImage})`}></div>
        <div class="era-card-overlay"></div>

        <div class="era-card-content">
          <div class="era-years">
            {era.config.startYear.toLocaleString()} – {era.config.endYear.toLocaleString()}
          </div>
          <h3 class="era-name">{era.config.displayName}</h3>
          <p class="era-tagline">{era.tagline}</p>
          {era.postCount > 0 && (
            <div class="era-count">
              {era.postCount} {era.postCount === 1 ? 'entry' : 'entries'}
            </div>
          )}
          {era.postCount === 0 && (
            <div class="era-count era-count-empty">Coming soon</div>
          )}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .era-browser {
    width: 100%;
    margin-bottom: 3rem;
  }

  .era-browser-header {
    margin-bottom: 1.25rem;
  }

  .era-browser-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted, oklch(0.5 0.05 var(--hue)));
    margin-bottom: 0.4rem;
  }

  .era-browser-sub {
    font-size: 0.875rem;
    color: oklch(0.6 0.05 var(--hue));
    margin: 0;
    line-height: 1.5;
  }

  /* 3-column grid on desktop, 2 on tablet, 1 on mobile */
  .era-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
  }

  @media (max-width: 900px) {
    .era-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .era-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Individual era card */
  .era-card {
    position: relative;
    border-radius: 0.625rem;
    overflow: hidden;
    min-height: 160px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid oklch(0.4 0.1 var(--hue) / 0.45);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .era-card:hover {
    border-color: var(--era-color);
    transform: translateY(-4px) perspective(600px) rotateX(2deg);
    box-shadow: 0 0 0 1px var(--era-color), 0 0 24px color-mix(in srgb, var(--era-color) 25%, transparent), 0 10px 30px rgba(0,0,0,0.35);
  }

  .era-card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
    filter: saturate(0.6) brightness(0.4);
  }

  .era-card:hover .era-card-bg {
    transform: scale(1.06);
    filter: saturate(0.8) brightness(0.5);
  }

  .era-card-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, var(--era-color) 0%, transparent 60%),
      linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 70%);
    opacity: 0.5;
    transition: opacity 0.25s ease;
  }

  .era-card:hover .era-card-overlay {
    opacity: 0.7;
  }

  .era-card-content {
    position: relative;
    z-index: 1;
    padding: 1rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    justify-content: flex-end;
  }

  .era-years {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--era-color);
    font-weight: 600;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .era-name {
    font-size: 0.95rem;
    font-weight: 800;
    color: white;
    margin: 0;
    line-height: 1.2;
  }

  .era-tagline {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .era-count {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--era-color);
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .era-count-empty {
    color: rgba(255,255,255,0.3);
    font-weight: 400;
    font-style: italic;
  }
</style>
