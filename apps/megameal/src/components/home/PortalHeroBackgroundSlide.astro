---
import { siteConfig } from '@/config/config'
---

<div class="megameal-portal-background-slide" aria-hidden="true">
  <video
    class="megameal-portal-background-slide__video"
    loop
    muted
    playsinline
    preload="none"
    data-src={siteConfig.banner.video}
    data-playback-rate={siteConfig.banner.playbackRate ?? 1}
  ></video>
  <div class="megameal-portal-background-slide__shade"></div>
</div>

<script>
  const video = document.currentScript
    ?.previousElementSibling
    ?.querySelector<HTMLVideoElement>('.megameal-portal-background-slide__video')

  if (video) {
    const configuredRate = Number(video.dataset.playbackRate)
    const playbackRate =
      Number.isFinite(configuredRate) && configuredRate > 0 ? configuredRate : 1
    let loaded = false

    video.playbackRate = playbackRate
    video.addEventListener('play', () => {
      video.playbackRate = playbackRate
    })

    const loadBackgroundVideo = () => {
      if (loaded) return
      const source = video.dataset.src
      if (!source) return

      loaded = true
      window.removeEventListener('scroll', loadAfterScroll)
      video.src = source
      video.removeAttribute('data-src')
      video.load()
      video.play().catch(() => {})
    }

    const loadAfterScroll = () => {
      if (window.scrollY <= 80) return
      loadBackgroundVideo()
    }

    const shouldAutoloadBackgroundVideo = () => {
      const nav = navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string }
        deviceMemory?: number
      }
      const connection = nav.connection
      const effectiveType = connection?.effectiveType ?? ''
      const deviceMemory = nav.deviceMemory

      return !(
        connection?.saveData === true ||
        /(^|-)2g$/.test(effectiveType) ||
        effectiveType === '3g' ||
        (typeof deviceMemory === 'number' && deviceMemory <= 2)
      )
    }

    const scheduleBackgroundVideoLoad = () => {
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          const fallback = window.setTimeout(loadBackgroundVideo, 1400)

          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(
              () => {
                window.clearTimeout(fallback)
                loadBackgroundVideo()
              },
              { timeout: 2200 },
            )
          }
        })
      })
    }

    window.addEventListener('merkin:portal-advance', loadBackgroundVideo, {
      once: true,
    })
    window.addEventListener('pointerdown', loadBackgroundVideo, { once: true })
    window.addEventListener('keydown', loadBackgroundVideo, { once: true })
    window.addEventListener('scroll', loadAfterScroll, { passive: true })

    if (shouldAutoloadBackgroundVideo()) {
      scheduleBackgroundVideoLoad()
    }
  }
</script>
