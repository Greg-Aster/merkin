---
import mainTitleCard from '@/assets/banner/main-title.png'
import HomeIntroEnvironment from './HomeIntroEnvironment.svelte'
---

<section class="megameal-home-intro" aria-label="MEGAMEAL test portal introduction">
  <div class="megameal-home-intro__environment" aria-hidden="true">
    <HomeIntroEnvironment client:load titleImageSrc={mainTitleCard.src} />
  </div>

  <div class="megameal-home-intro__veil" aria-hidden="true"></div>

  <div class="megameal-home-intro__screen-reader-copy">
    <p>Commercial Portal Online</p>
    <p>MEGA MEAL SAGA title card. Transmission stabilizing.</p>
  </div>
</section>

<style>
  .megameal-home-intro {
    position: absolute;
    inset: 0;
    z-index: 24;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    pointer-events: none;
    overflow: hidden;
  }

  .megameal-home-intro__veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(circle at center, rgb(8 10 18 / 0.08), rgb(2 4 10 / 0.38) 72%, rgb(1 2 6 / 0.58)),
      linear-gradient(180deg, rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.3));
    animation: intro-veil-fade 1800ms ease-out both;
  }

  .megameal-home-intro__environment {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.96;
    pointer-events: none;
    animation: intro-environment-fade 1800ms ease-out 160ms both;
  }

  .megameal-home-intro__screen-reader-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :global(#banner-container.banner-only-mode #standard-banner-container .banner-billboard),
  :global(#banner-container.banner-only-mode #standard-banner-container .banner-title-display) {
    display: none !important;
  }

  @keyframes intro-veil-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes intro-environment-fade {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
    to {
      opacity: 0.96;
      transform: scale(1);
    }
  }

  @media (max-width: 720px) {
    .megameal-home-intro {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .megameal-home-intro__veil,
    .megameal-home-intro__environment {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
