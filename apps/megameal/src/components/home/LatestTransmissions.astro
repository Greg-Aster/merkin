---
// LatestTransmissions.astro
// Compact freshness signal for the homepage — 3 most recent posts as mini-cards.
// Visual style mirrors FeaturedArc: same glass card, same label treatment, same CTA pattern.

import postsManifest from '../../../../../packages/shared-data/generated/posts.json'

const latest = postsManifest.items.filter(post => !post.draft).slice(0, 3)

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
import '../../styles/features/extracted/latest-transmissions.css'
---

<section class="latest-transmissions">
  <div class="arc-label">Latest Transmissions</div>

  <div class="lt-grid">
    {latest.map(post => (
      <a href={`/posts/${post.slug}/`} class="lt-card" data-sfx-click="select">
        <div class="lt-thumb">
          {post.image ? (
            <img
              src={post.image}
              alt=""
              class="lt-thumb-img"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="lt-thumb-placeholder" aria-hidden="true"></div>
          )}
          <div class="lt-thumb-overlay"></div>
          {post.category && (
            <span class="lt-category">{post.category}</span>
          )}
        </div>

        <div class="lt-body">
          <h3 class="lt-title">{post.title}</h3>
          <time class="lt-date">{formatDate(post.published)}</time>
        </div>
      </a>
    ))}
  </div>

  <div class="arc-actions">
    <a href="/archive/" class="arc-all-link">View all dispatches &rarr;</a>
  </div>
</section>

