---
import '../../styles/features/home/universe-hero-slide.css'
---

<div class="hero-slide-inner">
  <div class="hero-bg-layer" aria-hidden="true">
    <div class="hero-stars"></div>
    <div class="hero-stars-twinkle"></div>
    <div class="hero-nebula"></div>
    <div class="hero-vignette"></div>
  </div>

  <div class="hero-content-inner">
    <div class="hero-eyebrow">Year 3042 — The Multiverse is Open</div>

    <p class="hero-title">
      <span class="hero-title-mega">MEGA</span><span class="hero-title-meal">MEAL</span>
      <span class="hero-title-saga">SAGA</span>
    </p>

    <p class="hero-tagline">
      Cosmic Horror and Food.<br />
      A non-linear transmedia universe spanning from the Big Bang to the Heat Death of everything you loved.
    </p>

    <div class="hero-ctas">
      <a href="/posts/explainer/" class="hero-cta-primary">
        <span class="cta-icon">&#9654;</span>
        Start Here
      </a>
      <a href="/timeline/" class="hero-cta-secondary">
        <span class="cta-icon">&#9881;</span>
        Explore the Timeline
      </a>
      <a href="/archive/" class="hero-cta-ghost">
        Browse All Content
      </a>
    </div>

    <div class="hero-lore-line">
      Featuring: sentient sporks · recursive restaurants · the Bloody Mary that broke time · The Snuggloids · and one very persistent figure in a striped suit.
    </div>
  </div>

  <div class="hero-scroll-hint" aria-hidden="true">
    <span>&#8595;</span>
  </div>
</div>
