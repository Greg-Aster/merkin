---
import { Icon } from 'astro-icon/components'
import { formatTimelineYear } from '@merkin/shared-content'
import archiveManifest from '../../../../../packages/shared-data/generated/archive.json'
import { isPublicArchiveRecord } from '../../contracts/archive'

type ArchivePost = (typeof archiveManifest.items)[number]

interface Props {
  post?: {
    slug?: string
    data?: {
      title?: string
      description?: string
      series?: string
      seriesTitle?: string
      category?: string
      tags?: string[]
    }
  }
}

const { post } = Astro.props
const currentSlug = post?.slug ?? ''
const currentData = post?.data ?? {}
const currentSeries = currentData.series
const currentCategory = currentData.category

function byArchiveOrder(a: ArchivePost, b: ArchivePost) {
  const partA = a.seriesPart ?? Number.POSITIVE_INFINITY
  const partB = b.seriesPart ?? Number.POSITIVE_INFINITY
  if (partA !== partB) return partA - partB

  const timelineA = a.timelineYear ?? Number.POSITIVE_INFINITY
  const timelineB = b.timelineYear ?? Number.POSITIVE_INFINITY
  if (timelineA !== timelineB) return timelineA - timelineB

  return (
    new Date(b.published ?? 0).getTime() - new Date(a.published ?? 0).getTime()
  )
}

function getTimelineLabel(item: ArchivePost) {
  if (typeof item.timelineYear === 'number')
    return formatTimelineYear(item.timelineYear)
  if (!item.published) return 'undated'
  const year = new Date(item.published).getUTCFullYear()
  return Number.isFinite(year) ? String(year) : 'undated'
}

const relatedRecords = archiveManifest.items
  .filter(item => {
    if (currentSeries) return item.series === currentSeries
    if (currentCategory) return item.category === currentCategory
    return true
  })
  .sort(byArchiveOrder)

const visibleRecords = relatedRecords.slice(0, 6)
const openCount = relatedRecords.filter(isPublicArchiveRecord).length
const restrictedCount = Math.max(relatedRecords.length - openCount, 0)
const archiveTitle =
  currentData.seriesTitle || currentData.title || 'Archive Record'
const archiveDescription =
  currentData.description ||
  'A compact archive path through connected records, restricted files, and nearby transmissions.'
---

<section class="relative h-full w-full overflow-hidden bg-black text-white">
  <video
    data-compact-archive-banner-video
    class="absolute inset-0 h-full w-full object-cover opacity-72"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/assets/banner/archive_still.png"
    aria-hidden="true"
  >
    <source src="/assets/banner/archive_2.webm" type="video/webm" />
  </video>

  <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_22%,rgba(56,189,248,0.2),transparent_30%),linear-gradient(90deg,rgba(2,6,23,0.94),rgba(2,6,23,0.72)_48%,rgba(2,6,23,0.42))]"></div>
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.055)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-30"></div>

  <div class="relative z-10 grid h-full w-full content-end gap-5 px-4 py-5 md:px-8 md:py-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(22rem,0.72fr)] lg:items-end lg:px-12">
    <a
      href="/archive/"
      class="group max-w-3xl rounded-xl outline-none transition focus-visible:ring-2 focus-visible:ring-cyan-200/80 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-950"
      data-sfx-hover="hover-soft"
      data-sfx-click="sweep"
    >
      <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-cyan-200/20 bg-cyan-950/35 px-3 py-1 text-[0.68rem] font-black uppercase tracking-[0.22em] text-cyan-100/78 backdrop-blur">
        <Icon name="mdi:archive-eye-outline" class="text-base text-cyan-200" />
        Archive Navigation
      </div>
      <h1 class="max-w-4xl text-3xl font-black leading-[0.96] text-white transition group-hover:text-cyan-50 md:text-5xl lg:text-6xl">
        {archiveTitle}
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-6 text-white/72 md:text-base">
        {archiveDescription}
      </p>
    </a>

    <div class="mt-5 flex flex-wrap gap-2 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-white/62 lg:col-start-1 lg:mt-0">
      <a href="/archive/" class="rounded-full border border-white/12 bg-white/8 px-3 py-1 transition hover:border-cyan-100/42 hover:bg-cyan-300/12 hover:text-white" data-sfx-hover="hover-soft" data-sfx-click="soft">
        {relatedRecords.length} linked files
      </a>
      <a href="/archive/" class="rounded-full border border-white/12 bg-white/8 px-3 py-1 transition hover:border-cyan-100/42 hover:bg-cyan-300/12 hover:text-white" data-sfx-hover="hover-soft" data-sfx-click="soft">
        {openCount} open
      </a>
      <a href="/archive/" class="rounded-full border border-white/12 bg-white/8 px-3 py-1 transition hover:border-cyan-100/42 hover:bg-cyan-300/12 hover:text-white" data-sfx-hover="hover-soft" data-sfx-click="soft">
        {restrictedCount} restricted
      </a>
    </div>

    <nav class="rounded-xl border border-cyan-100/16 bg-slate-950/58 p-2 shadow-2xl backdrop-blur-md lg:row-span-2 lg:row-start-1" aria-label="Related archive records">
      <div class="mb-2 flex items-center justify-between gap-3 px-2 py-1 text-[0.65rem] font-black uppercase tracking-[0.18em] text-cyan-100/58">
        <span>Record Stack</span>
        <a href="/archive/" class="text-cyan-100/80 transition hover:text-white" data-sfx-hover="hover-soft" data-sfx-click="soft">
          Full Archive
        </a>
      </div>
      <ol class="grid gap-1.5">
        {visibleRecords.map((item, index) => {
          const isCurrent = item.slug === currentSlug
          const isLocked = item.draft && !isCurrent
          const recordHref = isCurrent
            ? '#post-container'
            : isLocked
              ? '/archive/'
              : item.url
          const content = (
            <>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-white/10 bg-white/8 text-[0.68rem] font-black text-cyan-100/76">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-black leading-tight text-white/90">
                  {item.title}
                </span>
                <span class="mt-0.5 block truncate text-xs leading-tight text-white/50">
                  {getTimelineLabel(item)} · {isCurrent ? 'Current file' : isLocked ? 'Restricted' : 'Open record'}
                </span>
              </span>
              <Icon
                name={isCurrent ? 'mdi:crosshairs-gps' : isLocked ? 'mdi:lock-outline' : 'mdi:arrow-right'}
                class="shrink-0 text-lg text-cyan-100/70"
              />
            </>
          )

          return (
            <li>
              <a
                href={recordHref}
                class:list={[
                  'flex items-center gap-2 rounded-lg border px-2.5 py-2 transition',
                  isCurrent
                    ? 'border-cyan-200/38 bg-cyan-300/14 shadow-[0_0_1.4rem_rgba(34,211,238,0.12)] hover:bg-cyan-300/20'
                    : isLocked
                      ? 'border-white/8 bg-white/[0.035] opacity-70 hover:border-cyan-200/24 hover:bg-cyan-300/8 hover:opacity-100'
                      : 'border-white/8 bg-white/[0.045] hover:border-cyan-200/30 hover:bg-cyan-300/10',
                ]}
                data-sfx-hover="hover-soft"
                data-sfx-click={isCurrent ? 'soft' : 'sweep'}
                aria-label={isCurrent
                  ? `Jump to ${item.title}`
                  : isLocked
                    ? `Open archive index for restricted record ${item.title}`
                    : `Open ${item.title}`}
              >
                {content}
              </a>
            </li>
          )
        })}
      </ol>
    </nav>
  </div>
</section>

<script>
  import { attachArchiveBannerVideoPlayback } from '../../utils/archive-banner-video'

  attachArchiveBannerVideoPlayback({
    selector: '[data-compact-archive-banner-video]',
    playbackRate: 0.1,
  })
</script>
