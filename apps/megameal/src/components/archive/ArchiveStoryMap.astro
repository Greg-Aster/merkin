---
import { getPostUrlBySlug } from '@/utils/url-utils'
import { Icon } from 'astro-icon/components'
import postsManifest from '../../../../../packages/shared-data/generated/posts.json'

type ArchivePost = (typeof postsManifest.items)[number]

interface ArchiveGroup {
  id: string
  title: string
  description: string
  tone: string
  previewImages: string[]
  posts: ArchivePost[]
}

function normalizeId(value: string) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
}

function getArchiveGroupTitle(post: ArchivePost) {
  if (post.seriesTitle) return post.seriesTitle
  if (post.series === 'first-contact-manual')
    return "The Interstellar Traveler's First Contact Manual"
  if (post.series) return post.series
  if (post.sourcePath?.includes('miranda-bloody-mary'))
    return 'The Miranda Incident'
  if (post.tags?.some(tag => /cookbook|recipe/i.test(tag)))
    return 'Galactic Cookbook'
  if (post.category === 'Site Updates') return 'Site Transmissions'
  if (
    post.category === 'Store Announcement' ||
    post.sourcePath?.includes('/store/')
  )
    return 'Commercial Records'
  if (post.sourcePath?.startsWith('timelines/')) return 'Chronology Fragments'
  return 'Core Entry Points'
}

function getGroupDescription(title: string) {
  const descriptions: Record<string, string> = {
    'Core Entry Points':
      'Primary gateways into the MEGAMEAL universe and its competing transmission modes.',
    'Site Transmissions':
      'Development notes, assistant dispatches, and project-facing updates from the active surface.',
    'Galactic Cookbook':
      'Culinary records, recipe fragments, and edible historical artifacts from the archive.',
    'Chronology Fragments':
      'Loose timeline records that define eras, disasters, ascensions, and lost civilizations.',
    "The Interstellar Traveler's First Contact Manual":
      'A survival manual for contact with beings that do not care if you remain intact.',
    'Commercial Records':
      'Storefront debris, product records, and corporate commerce fragments.',
    'The Miranda Incident':
      'Recovered testimony, recipes, access denials, and contradictory evidence from a temporal catastrophe.',
    'The Snuggloid Emergence':
      'Companion-product records documenting the rise of a suspiciously affectionate species.',
  }

  return (
    descriptions[title] ??
    'Related records in the broader MEGAMEAL story graph.'
  )
}

function getGroupTone(index: number) {
  const tones = [
    'core',
    'signal',
    'cookbook',
    'chronology',
    'manual',
    'commercial',
    'miranda',
    'snuggloid',
  ]
  return tones[index % tones.length]
}

function formatYear(value: string | null | undefined) {
  if (!value) return 'undated'
  const year = new Date(value).getUTCFullYear()
  return Number.isFinite(year) ? String(year) : 'undated'
}

function getTimelineLabel(post: ArchivePost) {
  if (typeof post.timelineYear === 'number') return `Y${post.timelineYear}`
  return formatYear(post.published)
}

function getNodeStyle(index: number, total: number) {
  const safeTotal = Math.max(total, 1)
  const angle = (index / safeTotal) * Math.PI * 2 - Math.PI / 2
  const ring = index % 3
  const radius = ring === 0 ? 32 : ring === 1 ? 40 : 24
  const x = 50 + Math.cos(angle) * radius
  const y = 50 + Math.sin(angle) * radius * 0.72
  const delay = index * 0.12
  return `--node-x: ${x.toFixed(2)}%; --node-y: ${y.toFixed(2)}%; --node-delay: ${delay.toFixed(2)}s;`
}

function getPreviewImages(posts: ArchivePost[], tone: string) {
  const fallbackByTone: Record<string, string[]> = {
    core: [
      '/posts/timeline/universe.png',
      '/posts/timeline/universe-avatar.png',
    ],
    signal: ['/assets/banner/golden-era.jpg', '/posts/horror.png'],
    cookbook: [
      '/posts/cookbook/cookbook.png',
      '/posts/timeline/zelephant-roast.png',
    ],
    chronology: [
      '/posts/timeline/archive.png',
      '/posts/timeline/corporate.png',
    ],
    manual: [
      '/posts/timeline/chronos.png',
      '/posts/timeline/awakening-era.png',
    ],
    commercial: [
      '/posts/Mega-Meal-Explained/ultra-sign.png',
      '/posts/Mega-Meal-Explained/burger-hole.png',
    ],
    miranda: [
      '/posts/timeline/redacted.png',
      '/posts/timeline/vault-keypad.png',
    ],
    snuggloid: [
      '/posts/timeline/snuggloid-entity.png',
      '/posts/timeline/snuggloid1.png',
    ],
  }

  const seen = new Set<string>()
  const discovered = posts
    .flatMap(post => [post.image, post.bannerData?.background])
    .filter((value): value is string => Boolean(value))
    .filter(value => {
      if (seen.has(value)) return false
      seen.add(value)
      return true
    })

  return [
    ...discovered,
    ...(fallbackByTone[tone] ?? fallbackByTone.core),
  ].slice(0, 3)
}

const grouped = new Map<string, ArchivePost[]>()

for (const post of postsManifest.items) {
  const groupTitle = getArchiveGroupTitle(post)
  if (!grouped.has(groupTitle)) grouped.set(groupTitle, [])
  grouped.get(groupTitle)?.push(post)
}

const preferredOrder = [
  'Core Entry Points',
  'The Miranda Incident',
  "The Interstellar Traveler's First Contact Manual",
  'Chronology Fragments',
  'Galactic Cookbook',
  'Commercial Records',
  'The Snuggloid Emergence',
  'Site Transmissions',
]

const archiveGroups: ArchiveGroup[] = Array.from(grouped.entries())
  .sort(([a], [b]) => {
    const aIndex = preferredOrder.indexOf(a)
    const bIndex = preferredOrder.indexOf(b)
    if (aIndex !== -1 || bIndex !== -1) {
      return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex)
    }
    return a.localeCompare(b)
  })
  .map(([title, posts], index) => ({
    id: normalizeId(title),
    title,
    description: getGroupDescription(title),
    tone: getGroupTone(index),
    previewImages: getPreviewImages(posts, getGroupTone(index)),
    posts: posts.sort((a, b) => {
      const partA = a.seriesPart ?? Number.POSITIVE_INFINITY
      const partB = b.seriesPart ?? Number.POSITIVE_INFINITY
      if (partA !== partB) return partA - partB

      const timelineA = a.timelineYear ?? Number.POSITIVE_INFINITY
      const timelineB = b.timelineYear ?? Number.POSITIVE_INFINITY
      if (timelineA !== timelineB) return timelineA - timelineB

      return (
        new Date(b.published ?? 0).getTime() -
        new Date(a.published ?? 0).getTime()
      )
    }),
  }))

const publicCount = postsManifest.items.filter(post => !post.draft).length
const restrictedCount = postsManifest.items.length - publicCount
---

<section class="story-archive-map" data-view="node" aria-labelledby="story-archive-map-title">
  <div class="archive-map-hero">
    <div class="archive-map-hero__copy">
      <div class="archive-map-kicker">Story Archive</div>
      <h2 id="story-archive-map-title">A restricted map of the known story graph.</h2>
      <p>
        Public records are open entry points. Restricted records are visible as locked nodes so the scale of the universe is readable before every file is cleared for release.
      </p>
      <div class="archive-view-switch" role="group" aria-label="Archive display mode">
        <button type="button" class="archive-view-switch__button is-active" data-archive-view-button data-view-target="node" data-sfx-hover="hover-soft" data-sfx-click="soft" aria-pressed="true">
          <Icon name="mdi:vector-polyline" />
          <span>Node View</span>
        </button>
        <button type="button" class="archive-view-switch__button" data-archive-view-button data-view-target="list" data-sfx-hover="hover-soft" data-sfx-click="soft" aria-pressed="false">
          <Icon name="mdi:format-list-bulleted-square" />
          <span>List View</span>
        </button>
      </div>
    </div>
    <div class="archive-map-ledger" aria-label={`${publicCount} open records and ${restrictedCount} restricted records`}>
      <div>
        <span>{publicCount}</span>
        <strong>Open</strong>
      </div>
      <div>
        <span>{restrictedCount}</span>
        <strong>Restricted</strong>
      </div>
      <div>
        <span>{postsManifest.items.length}</span>
        <strong>Total Files</strong>
      </div>
    </div>
  </div>

  <div class="archive-map-grid">
    {archiveGroups.map((group) => {
      const openCount = group.posts.filter(post => !post.draft).length
      const restrictedGroupCount = group.posts.length - openCount

      return (
        <article
          class="archive-arc-card"
          data-archive-tone={group.tone}
          style={`--archive-bg-1: url('${group.previewImages[0]}'); --archive-bg-2: url('${group.previewImages[1] ?? group.previewImages[0]}'); --archive-bg-3: url('${group.previewImages[2] ?? group.previewImages[0]}');`}
        >
          <div class="archive-arc-card__header">
            <div>
              <div class="archive-arc-kicker">Archive File</div>
              <h3>{group.title}</h3>
            </div>
            <div class="archive-arc-count">
              <span>{group.posts.length}</span>
              <small>records</small>
            </div>
          </div>

          <p class="archive-arc-description">{group.description}</p>

          <div class="archive-node-map" aria-hidden="true">
            <div class="archive-node-map__backdrop">
              <div class="archive-node-map__image archive-node-map__image--one"></div>
              <div class="archive-node-map__image archive-node-map__image--two"></div>
              <div class="archive-node-map__image archive-node-map__image--three"></div>
            </div>
            <div class="archive-node-map__orbit archive-node-map__orbit--outer"></div>
            <div class="archive-node-map__orbit archive-node-map__orbit--inner"></div>
            <div class="archive-node-map__core">
              <Icon name="mdi:archive-eye-outline" />
            </div>
            {group.posts.map((post, index) => (
              <div
                class:list={[
                  'archive-map-node',
                  post.draft ? 'archive-map-node--locked' : 'archive-map-node--open',
                ]}
                style={getNodeStyle(index, group.posts.length)}
                title={`${post.title} - ${post.draft ? 'Restricted' : 'Open'}`}
              >
                <Icon name={post.draft ? 'mdi:lock-outline' : 'mdi:file-eye-outline'} />
              </div>
            ))}
          </div>

          <div class="archive-access-line">
            <span>{openCount} open</span>
            <span>{restrictedGroupCount} restricted</span>
          </div>

          <ol class="archive-record-list">
            {group.posts.map((post, index) => {
              const isLocked = post.draft === true
              const content = (
                <>
                  <span class="archive-record-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="archive-record-main">
                    <strong>{post.title}</strong>
                    <small>{getTimelineLabel(post)} · {isLocked ? 'Restricted record' : 'Public entry point'}</small>
                  </span>
                  <span class="archive-record-status">
                    <Icon name={isLocked ? 'mdi:lock-outline' : 'mdi:arrow-right'} />
                    <span>{isLocked ? 'Locked' : 'Open'}</span>
                  </span>
                </>
              )

              return (
                <li>
                  {isLocked ? (
                    <div class="archive-record archive-record--locked" aria-label={`${post.title}, restricted record`}>
                      {content}
                    </div>
                  ) : (
                    <a class="archive-record archive-record--open" href={getPostUrlBySlug(post.slug)} data-sfx-click="sweep">
                      {content}
                    </a>
                  )}
                </li>
              )
            })}
          </ol>
        </article>
      )
    })}
  </div>
</section>

<script>
  const archiveMaps = document.querySelectorAll('.story-archive-map')

  archiveMaps.forEach((map) => {
    const buttons = map.querySelectorAll('[data-archive-view-button]')
    const prefersListView = window.matchMedia('(max-width: 640px)').matches

    const setView = (nextView: string) => {
      map.setAttribute('data-view', nextView)
      buttons.forEach((button) => {
        const isActive = button.getAttribute('data-view-target') === nextView
        button.classList.toggle('is-active', isActive)
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false')
      })
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextView = button.getAttribute('data-view-target') || 'node'
        setView(nextView)
      })
    })

    if (prefersListView) {
      setView('list')
    }
  })
</script>

<style>
  .story-archive-map {
    display: grid;
    gap: 1.2rem;
    margin-bottom: 2rem;
  }

  .archive-map-hero,
  .archive-arc-card {
    position: relative;
    overflow: visible;
    border: 1px solid oklch(0.38 0.06 var(--hue) / 0.36);
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 16% 12%, oklch(0.28 0.08 var(--hue) / 0.28), transparent 34%),
      radial-gradient(circle at 88% 86%, oklch(0.2 0.07 var(--hue) / 0.22), transparent 32%),
      linear-gradient(180deg, oklch(0.14 0.03 var(--hue) / 0.78), oklch(0.1 0.03 var(--hue) / 0.7));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.08),
      0 22px 62px rgba(0,0,0,0.24);
    backdrop-filter: blur(18px) saturate(1.1);
  }

  .archive-map-hero::before,
  .archive-arc-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -1.2rem;
    border-radius: calc(1.25rem + 1.2rem);
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--archive-accent, oklch(0.72 0.14 var(--hue))) 24%, transparent), transparent 68%);
    opacity: 0;
    filter: blur(24px);
    transform: scale(0.96);
    transition: opacity 0.45s ease, transform 0.65s ease, filter 0.65s ease;
  }

  .archive-map-hero:hover::before,
  .archive-arc-card:hover::before {
    opacity: 0.62;
    transform: scale(1.04);
    filter: blur(34px);
  }

  .archive-map-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: end;
    padding: clamp(1.2rem, 3vw, 2rem);
    --archive-accent: oklch(0.73 0.15 245);
  }

  .archive-map-hero::after,
  .archive-arc-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 0 48%, color-mix(in srgb, var(--archive-accent, oklch(0.73 0.15 245)) 10%, transparent) 50%, transparent 52%),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.032) 0 1px, transparent 1px 6px);
    opacity: 0.34;
    mix-blend-mode: screen;
  }

  .archive-map-hero__copy {
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .archive-view-switch {
    display: inline-flex;
    gap: 0.45rem;
    margin-top: 1rem;
    padding: 0.35rem;
    border: 1px solid color-mix(in srgb, var(--archive-accent) 24%, transparent);
    border-radius: 999px;
    background: rgba(0,0,0,0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .archive-view-switch__button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.2rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: oklch(0.76 0.03 var(--hue));
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color 0.22s ease, background 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
  }

  .archive-view-switch__button :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .archive-view-switch__button.is-active {
    border-color: color-mix(in srgb, var(--archive-accent) 40%, transparent);
    background: color-mix(in srgb, var(--archive-accent) 14%, rgba(0,0,0,0.22));
    color: white;
    box-shadow: 0 0 22px color-mix(in srgb, var(--archive-accent) 10%, transparent);
  }

  .archive-map-kicker,
  .archive-arc-kicker {
    margin-bottom: 0.6rem;
    color: color-mix(in srgb, var(--archive-accent, oklch(0.73 0.15 245)) 72%, white);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .archive-map-hero h2,
  .archive-arc-card h3 {
    margin: 0;
    color: white;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .archive-map-hero h2 {
    font-size: clamp(1.75rem, 4vw, 3rem);
  }

  .archive-map-hero p,
  .archive-arc-description {
    color: oklch(0.78 0.03 var(--hue));
    line-height: 1.62;
  }

  .archive-map-hero p {
    margin: 0.9rem 0 0;
    max-width: 44rem;
  }

  .archive-map-ledger {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(5.5rem, 1fr));
    gap: 0.7rem;
  }

  .archive-map-ledger div {
    padding: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--archive-accent) 30%, transparent);
    border-radius: 0.95rem;
    background: rgba(0,0,0,0.32);
    text-align: center;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
  }

  .archive-map-ledger span {
    display: block;
    color: white;
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    font-weight: 900;
    line-height: 1;
  }

  .archive-map-ledger strong {
    display: block;
    margin-top: 0.4rem;
    color: color-mix(in srgb, var(--archive-accent) 68%, white);
    font-size: 0.66rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .archive-map-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .archive-arc-card {
    --archive-accent: oklch(0.72 0.15 245);
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 2.4vw, 1.35rem);
  }

  .archive-arc-card[data-archive-tone='signal'] {
    --archive-accent: oklch(0.76 0.16 25);
  }

  .archive-arc-card[data-archive-tone='cookbook'] {
    --archive-accent: oklch(0.83 0.16 86);
  }

  .archive-arc-card[data-archive-tone='chronology'] {
    --archive-accent: oklch(0.72 0.16 275);
  }

  .archive-arc-card[data-archive-tone='manual'] {
    --archive-accent: oklch(0.76 0.14 160);
  }

  .archive-arc-card[data-archive-tone='commercial'] {
    --archive-accent: oklch(0.8 0.16 70);
  }

  .archive-arc-card[data-archive-tone='miranda'] {
    --archive-accent: oklch(0.74 0.18 330);
  }

  .archive-arc-card[data-archive-tone='snuggloid'] {
    --archive-accent: oklch(0.77 0.15 200);
  }

  .archive-arc-card__header,
  .archive-access-line {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .archive-arc-card h3 {
    font-size: clamp(1.2rem, 2.4vw, 1.8rem);
  }

  .archive-arc-count {
    display: grid;
    justify-items: center;
    min-width: 4.5rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--archive-accent) 34%, transparent);
    border-radius: 0.9rem;
    background: rgba(0,0,0,0.32);
  }

  .archive-arc-count span {
    color: white;
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1;
  }

  .archive-arc-count small,
  .archive-access-line span {
    color: color-mix(in srgb, var(--archive-accent) 70%, white);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .archive-arc-description {
    position: relative;
    z-index: 1;
    min-height: 3.2rem;
    margin: 0;
    font-size: 0.9rem;
  }

  .archive-node-map {
    position: relative;
    z-index: 1;
    min-height: clamp(15rem, 30vw, 20rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--archive-accent) 30%, transparent);
    border-radius: 1rem;
    background:
      radial-gradient(circle at center, color-mix(in srgb, var(--archive-accent) 18%, transparent), transparent 28%),
      radial-gradient(circle at 24% 24%, rgba(255,255,255,0.1), transparent 18%),
      linear-gradient(145deg, rgba(5,8,18,0.82), rgba(8,5,12,0.76));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.06),
      0 18px 48px rgba(0,0,0,0.24);
  }

  .archive-node-map__backdrop {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr 0.85fr;
    gap: 0.35rem;
    padding: 0.4rem;
    opacity: 0.46;
  }

  .archive-node-map__image {
    position: relative;
    overflow: hidden;
    border-radius: 0.8rem;
    border: 1px solid rgba(255,255,255,0.08);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: saturate(0.92) contrast(1.08) brightness(0.72);
  }

  .archive-node-map__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.1), rgba(0,0,0,0.42)),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.03) 0 1px, transparent 1px 5px);
  }

  .archive-node-map__image--one {
    background-image: var(--archive-bg-1);
  }

  .archive-node-map__image--two {
    background-image: var(--archive-bg-2);
    transform: translateY(8%);
  }

  .archive-node-map__image--three {
    background-image: var(--archive-bg-3);
    transform: translateY(-6%);
  }

  .archive-node-map::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--archive-accent) 15%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--archive-accent) 12%, transparent) 1px, transparent 1px);
    background-size: 2.8rem 2.8rem;
    opacity: 0.28;
    transform: perspective(620px) rotateX(62deg) translateY(20%);
    transform-origin: bottom;
  }

  .archive-node-map__orbit {
    position: absolute;
    inset: 14%;
    border: 1px solid color-mix(in srgb, var(--archive-accent) 30%, transparent);
    border-radius: 999px;
    box-shadow: 0 0 28px color-mix(in srgb, var(--archive-accent) 12%, transparent);
  }

  .archive-node-map__orbit--inner {
    inset: 29%;
    border-style: dashed;
    opacity: 0.68;
  }

  .archive-node-map__core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
