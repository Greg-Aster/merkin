---
import { Icon } from 'astro-icon/components'
import {
  getArchiveStoryMapModel,
  getCollectionLabel,
} from './archiveStoryMapModel'

const { archiveGroups, collectionFilters } = getArchiveStoryMapModel()

---

<section class="story-archive-map" data-view="list" aria-labelledby="story-archive-map-title">
  <div class="archive-map-toolbar">
    <div class="archive-map-toolbar__copy">
      <div class="archive-map-kicker">Archive Retrieval Console</div>
      <h2 id="story-archive-map-title">Search the library stacks.</h2>
      <p>Search, filter, and open only the archive files you need. Node view keeps the same retrieval controls with the map layer visible.</p>
    </div>
    <div class="archive-toolbar-controls">
      <label class="archive-search-field">
        <Icon name="mdi:magnify" />
        <span class="sr-only">Search archive records</span>
        <input
          type="search"
          data-archive-search
          placeholder="Search title, file, year, or type"
          autocomplete="off"
        />
      </label>
      <div class="archive-filter-row">
        <label class="archive-select-field">
          <span>Access</span>
          <select data-archive-access-filter aria-label="Filter by access">
            <option value="open" selected>Open records</option>
            <option value="all">All access</option>
            <option value="restricted">Restricted</option>
          </select>
        </label>
        <label class="archive-select-field">
          <span>Type</span>
          <select data-archive-type-filter aria-label="Filter by record type">
            <option value="all">All types</option>
            {collectionFilters.map(collection => (
              <option value={collection}>{getCollectionLabel(collection)}</option>
            ))}
          </select>
        </label>
      </div>
      <div class="archive-view-switch" role="group" aria-label="Archive display mode">
        <button type="button" class="archive-view-switch__button is-active" data-archive-view-button data-view-target="list" data-sfx-hover="hover-soft" data-sfx-click="soft" aria-pressed="true">
          <Icon name="mdi:format-list-bulleted-square" />
          <span>List</span>
        </button>
        <button type="button" class="archive-view-switch__button" data-archive-view-button data-view-target="node" data-sfx-hover="hover-soft" data-sfx-click="soft" aria-pressed="false">
          <Icon name="mdi:vector-polyline" />
          <span>Node</span>
        </button>
      </div>
      <div class="archive-bulk-actions" role="group" aria-label="Archive group controls">
        <button type="button" data-archive-expand-all>Open all</button>
        <button type="button" data-archive-collapse-all>Seal all</button>
      </div>
      <button type="button" class="archive-locked-toggle" data-archive-show-locked>
        <Icon name="mdi:lock-open-variant-outline" />
        <span>Show locked</span>
      </button>
    </div>
  </div>

  <div class="archive-filter-status" data-archive-filter-status aria-live="polite">
    Showing all archive records.
  </div>

  <div class="archive-map-grid">
    {archiveGroups.map((group) => {
      return (
        <details
          class="archive-arc-card"
          data-archive-tone={group.tone}
          data-archive-group
          data-group-title={group.title}
          data-group-description={group.description}
          data-group-collections={group.collectionValues.join(' ')}
          style={`--archive-bg-1: url('${group.previewImages[0]}'); --archive-bg-2: url('${group.previewImages[1] ?? group.previewImages[0]}'); --archive-bg-3: url('${group.previewImages[2] ?? group.previewImages[0]}');`}
        >
          <summary class="archive-arc-summary">
            <div class="archive-arc-card__header">
              <div>
                <div class="archive-arc-kicker">Archive File</div>
                <h3>{group.title}</h3>
              </div>
              <div class="archive-arc-count">
                <span>{group.posts.length}</span>
                <small>records</small>
              </div>
            </div>
            <p class="archive-arc-description">{group.description}</p>
            <div class="archive-access-line archive-access-line--summary">
              <span>{group.openCount} open</span>
              <span>{group.restrictedCount} restricted</span>
              <span>{group.collectionSummary}</span>
            </div>
            <div class="archive-arc-open-indicator" aria-hidden="true">
              <Icon name="mdi:chevron-down" />
            </div>
          </summary>

          <div class="archive-node-map" aria-hidden="true">
            <div class="archive-node-map__backdrop">
              <div class="archive-node-map__image archive-node-map__image--one"></div>
              <div class="archive-node-map__image archive-node-map__image--two"></div>
              <div class="archive-node-map__image archive-node-map__image--three"></div>
            </div>
            <div class="archive-node-map__orbit archive-node-map__orbit--outer"></div>
            <div class="archive-node-map__orbit archive-node-map__orbit--inner"></div>
            <div class="archive-node-map__core">
              <Icon name="mdi:archive-eye-outline" />
            </div>
            {group.posts.map(record => (
              <div
                class:list={[
                  'archive-map-node',
                  record.isLocked ? 'archive-map-node--locked' : 'archive-map-node--open',
                ]}
                style={record.nodeStyle}
                title={`${record.post.title} - ${record.isLocked ? 'Restricted' : 'Open'}`}
              >
                <Icon name={record.isLocked ? 'mdi:lock-outline' : 'mdi:file-eye-outline'} />
              </div>
            ))}
          </div>

          <div class="archive-access-line">
            <span>{group.openCount} open</span>
            <span>{group.restrictedCount} restricted</span>
          </div>

          <ol class="archive-record-list" data-archive-record-list>
            {group.posts.map(record => {
              const content = (
                <>
                  <span class="archive-record-index">{record.indexLabel}</span>
                  <span class="archive-record-main">
                    <strong>{record.post.title}</strong>
                    <small>{record.timelineLabel} &middot; {record.isLocked ? 'Restricted record' : `${record.collectionLabel} entry point`}</small>
                  </span>
                  <span class="archive-record-status">
                    <Icon name={record.isLocked ? 'mdi:lock-outline' : 'mdi:arrow-right'} />
                    <span>{record.isLocked ? 'Locked' : 'Open'}</span>
                  </span>
                </>
              )

              return (
                <li
                  data-archive-record
                  data-record-title={record.post.title}
                  data-record-access={record.access}
                  data-record-type={record.collection}
                  data-record-year={record.timelineLabel}
                  data-record-search={record.searchText}
                >
                  {record.isLocked ? (
                    <div class="archive-record archive-record--locked" aria-label={`${record.post.title}, restricted record`}>
                      {content}
                    </div>
                  ) : (
                    <a class="archive-record archive-record--open" href={record.post.url} data-sfx-click="sweep">
                      {content}
                    </a>
                  )}
                </li>
              )
            })}
          </ol>
        </details>
      )
    })}
  </div>
</section>

<script>
  const archiveMaps = document.querySelectorAll('.story-archive-map')

  archiveMaps.forEach((map) => {
    const buttons = map.querySelectorAll('[data-archive-view-button]')
    const groups = Array.from(
      map.querySelectorAll<HTMLDetailsElement>('[data-archive-group]'),
    )
    const searchInput = map.querySelector<HTMLInputElement>('[data-archive-search]')
    const accessFilter = map.querySelector<HTMLSelectElement>('[data-archive-access-filter]')
    const typeFilter = map.querySelector<HTMLSelectElement>('[data-archive-type-filter]')
    const status = map.querySelector<HTMLElement>('[data-archive-filter-status]')
    const expandAll = map.querySelector<HTMLButtonElement>('[data-archive-expand-all]')
    const collapseAll = map.querySelector<HTMLButtonElement>('[data-archive-collapse-all]')
    const showLocked = map.querySelector<HTMLButtonElement>('[data-archive-show-locked]')

    const setView = (nextView: string) => {
      map.setAttribute('data-view', nextView)
      buttons.forEach((button) => {
        const isActive = button.getAttribute('data-view-target') === nextView
        button.classList.toggle('is-active', isActive)
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false')
      })
    }

    const normalize = (value: string) => value.trim().toLowerCase()

    const filtersAreActive = () =>
      Boolean(normalize(searchInput?.value ?? '')) ||
      accessFilter?.value !== 'all' ||
      typeFilter?.value !== 'all'

    const applyFilters = () => {
      const query = normalize(searchInput?.value ?? '')
      const access = accessFilter?.value ?? 'all'
      const type = typeFilter?.value ?? 'all'
      let visibleRecordCount = 0
      let visibleGroupCount = 0

      groups.forEach((group) => {
        const records = Array.from(
          group.querySelectorAll<HTMLElement>('[data-archive-record]'),
        )
        let groupMatchCount = 0

        records.forEach((record) => {
          const matchesQuery =
            !query ||
            (record.dataset.recordSearch ?? '').includes(query) ||
            (group.dataset.groupTitle ?? '').toLowerCase().includes(query)
          const matchesAccess =
            access === 'all' || record.dataset.recordAccess === access
          const matchesType = type === 'all' || record.dataset.recordType === type
          const isVisible = matchesQuery && matchesAccess && matchesType

          record.hidden = !isVisible
          if (isVisible) {
            groupMatchCount += 1
            visibleRecordCount += 1
          }
        })

        const groupIsVisible = groupMatchCount > 0
        group.hidden = !groupIsVisible
        group.dataset.matchCount = String(groupMatchCount)
        if (groupIsVisible) visibleGroupCount += 1
        if (filtersAreActive()) {
          group.open = groupIsVisible
        }
      })

      if (status) {
        status.textContent = filtersAreActive()
          ? `Showing ${visibleRecordCount} record${visibleRecordCount === 1 ? '' : 's'} in ${visibleGroupCount} archive file${visibleGroupCount === 1 ? '' : 's'}.`
          : `Showing all ${visibleRecordCount} archive records in ${visibleGroupCount} archive files.`
      }
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextView = button.getAttribute('data-view-target') || 'node'
        setView(nextView)
      })
    })

    searchInput?.addEventListener('input', applyFilters)
    accessFilter?.addEventListener('change', applyFilters)
    typeFilter?.addEventListener('change', applyFilters)
    expandAll?.addEventListener('click', () => {
      groups.forEach(group => {
        if (!group.hidden) group.open = true
      })
    })
    collapseAll?.addEventListener('click', () => {
      groups.forEach(group => {
        group.open = false
      })
    })
    showLocked?.addEventListener('click', () => {
      if (!accessFilter) return

      const nextAccess = accessFilter.value === 'all' ? 'open' : 'all'
      accessFilter.value = nextAccess
      showLocked.classList.toggle('is-active', nextAccess === 'all')
      showLocked.querySelector('span')?.replaceChildren(
        document.createTextNode(nextAccess === 'all' ? 'Hide locked' : 'Show locked'),
      )
      applyFilters()
    })

    applyFilters()
  })
</script>
