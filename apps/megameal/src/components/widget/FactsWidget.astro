---
import type { TimelineFact } from '../../config/timelineFacts'
import {
  megaMealUniverseFacts,
  resolveTimelineFactHref,
} from '../../config/timelineFacts'

export interface Props {
  class?: string
  style?: string
  footerText?: string
  variant?: 'sidebar' | 'portal' | 'overlay'
  dismissible?: boolean
  storageKey?: string
  title?: string
  kicker?: string
  factTypes?: TimelineFact['type'][]
}

const {
  class: className = '',
  style = '',
  footerText = 'Paid propaganda. Unpaid consequences.',
  variant = 'sidebar',
  dismissible = false,
  storageKey = 'megameal-sponsored-window-dismissed',
  title =
    variant === 'overlay'
      ? 'Sponsored Overlay'
      : variant === 'portal'
        ? 'Sponsored Transmission'
        : 'Signal Window',
  kicker =
    variant === 'overlay'
      ? 'Live Ad Feed'
      : variant === 'portal'
        ? 'Paid Message'
        : 'Megameal Signal',
  factTypes = ['advertisement'],
} = Astro.props

const availableFacts = megaMealUniverseFacts.filter(fact =>
  factTypes.includes(fact.type),
)

const fallbackFact: TimelineFact = {
  type: 'advertisement',
  eyebrow: 'System Notice',
  headline: 'Sponsored Silence',
  text: 'No propaganda is currently available. This is either a miracle or an accounting error.',
  ctaText: 'Return To Consumption',
  href: '/posts/explainer/',
  sponsor: 'Corporate Calm Division',
  finePrint: 'Normal service will resume once the market regains consciousness.',
}

const initialFact = availableFacts[0] ?? fallbackFact
const widgetId = `facts-widget-${Math.random().toString(36).slice(2, 10)}`
const initialHref = resolveTimelineFactHref(initialFact)
---

<section
  id={widgetId}
  class:list={['facts-widget-container', `facts-widget-${variant}`, className]}
  style={style}
  data-facts-widget
  data-fact-theme={initialFact.theme || 'default'}
  data-expanded={variant === 'overlay' ? 'false' : 'true'}
  data-pinned="false"
  data-storage-key={storageKey}
  data-dismissible={dismissible ? 'true' : 'false'}
>
  <div class="facts-widget-shell">
    <div class="facts-widget-frame megameal-surface megameal-surface--interactive">
      <div class="facts-widget-header">
        <div class="facts-widget-header-copy">
          <div class="facts-widget-kicker">{kicker}</div>
        </div>

        <div class="facts-widget-controls">
          <button
            type="button"
            class="facts-widget-refresh"
            data-action="next"
            data-sfx-click="sweep"
            aria-label="Show the next sponsored campaign"
          >
            Next Campaign
          </button>
          {dismissible && (
            <button
              type="button"
              class="facts-widget-dismiss"
              data-action="dismiss"
              data-sfx-click="panel-back"
              aria-label="Dismiss sponsored transmission window"
            >
              ×
            </button>
          )}
        </div>
      </div>

      <div class="facts-widget-body">
        <div class="facts-widget-label-row">
          <span class="facts-widget-label" data-fact-eyebrow>
            {initialFact.eyebrow || 'Sponsored Placement'}
          </span>
          <span class="facts-widget-sponsor" data-fact-sponsor>
            {initialFact.sponsor || 'Consumer Satisfaction Bureau'}
          </span>
        </div>

        <h3 class="facts-widget-headline" data-fact-headline>
          {initialFact.headline || 'Sponsored Message'}
        </h3>

        <p class="facts-widget-text" data-fact-text>{initialFact.text}</p>

        {variant === 'overlay' && (
          <div class="facts-widget-selection-hint" aria-hidden="true">
            <span class="facts-widget-selection-dot"></span>
          </div>
        )}

        <div class="facts-widget-actions">
          <a
            href={initialHref || '/posts/explainer/'}
            class="facts-widget-cta"
            data-fact-cta
            data-sfx-click="sweep"
          >
            {initialFact.ctaText || 'Comply'}
          </a>
        </div>

        <p
          class:list={[
            'facts-widget-fineprint',
            !initialFact.finePrint && 'is-hidden',
          ]}
          data-fact-fineprint
        >
          {initialFact.finePrint || ' '}
        </p>
      </div>

      <p class="facts-widget-footer">{footerText}</p>
    </div>

    {dismissible && (
      <button
        type="button"
        class="facts-widget-restore"
        data-action="restore"
        data-sfx-click="panel-open"
        aria-label="Restore sponsored transmission window"
      >
        Resume Sponsored Feed
      </button>
    )}
  </div>
</section>

<script define:vars={{ widgetId, facts: availableFacts, fallbackFact }}>
  const widget = document.getElementById(widgetId)

  if (!widget) {
    console.error(`FactsWidget: could not find widget ${widgetId}`)
  } else {
    const emitSfx = id => {
      document.dispatchEvent(new CustomEvent('megameal:sfx', { detail: { id } }))
    }

    const eyebrowEl = widget.querySelector('[data-fact-eyebrow]')
    const headlineEl = widget.querySelector('[data-fact-headline]')
    const textEl = widget.querySelector('[data-fact-text]')
    const ctaEl = widget.querySelector('[data-fact-cta]')
    const sponsorEl = widget.querySelector('[data-fact-sponsor]')
    const finePrintEl = widget.querySelector('[data-fact-fineprint]')
    const frameEl = widget.querySelector('.facts-widget-frame')
    const storageKey =
      widget.dataset.storageKey || 'megameal-sponsored-window-dismissed'
    const isDismissible = widget.dataset.dismissible === 'true'
    const isOverlay = widget.classList.contains('facts-widget-overlay')
    const prefersTouchUi = window.matchMedia('(hover: none), (pointer: coarse)').matches
    let currentIndex = facts.length > 0 ? 0 : -1
    let intervalId
    let expandTimeoutId
    let collapseTimeoutId

    const specialFactLinks = {
      Explainer: '/posts/explainer/',
      Timeline: '/posts/explainer/',
      'Mega-Meal-3': '/posts/mega-meal-3/',
    }

    const resolveHref = fact => {
      if (fact?.href) return fact.href
      if (!fact?.link) return '/posts/explainer/'
      if (fact.link.startsWith('/')) return fact.link
      if (specialFactLinks[fact.link]) return specialFactLinks[fact.link]
      return `/posts/${fact.link}/`
    }

    const applyFact = fact => {
      if (
        !eyebrowEl ||
        !headlineEl ||
        !textEl ||
        !ctaEl ||
        !sponsorEl ||
        !finePrintEl
      ) {
        return
      }

      eyebrowEl.textContent = fact.eyebrow || 'Sponsored Placement'
      headlineEl.textContent = fact.headline || 'Sponsored Message'
      textEl.textContent = fact.text || ''
      sponsorEl.textContent = fact.sponsor || 'Consumer Satisfaction Bureau'
      ctaEl.textContent = fact.ctaText || 'Comply'
      ctaEl.setAttribute('href', resolveHref(fact))
      widget.dataset.factTheme = fact.theme || 'default'

      if (fact.finePrint) {
        finePrintEl.textContent = fact.finePrint
        finePrintEl.classList.remove('is-hidden')
      } else {
        finePrintEl.textContent = ''
        finePrintEl.classList.add('is-hidden')
      }
    }

    const getNextIndex = () => {
      if (facts.length <= 1) return 0
      return (currentIndex + 1) % facts.length
    }

    const showNextFact = () => {
      if (!facts.length || widget.classList.contains('is-dismissed')) return
      currentIndex = getNextIndex()
      applyFact(facts[currentIndex] || fallbackFact)
    }

    const setExpanded = expanded => {
      if (!isOverlay) return
      widget.dataset.expanded = expanded ? 'true' : 'false'
    }

    const setPinned = pinned => {
      if (!isOverlay) return
      widget.dataset.pinned = pinned ? 'true' : 'false'
    }

    const startRotation = () => {
      if (!facts.length) return
      window.clearInterval(intervalId)
      intervalId = window.setInterval(showNextFact, 18000)
    }

    const dismissWidget = () => {
      widget.classList.add('is-dismissed')
      window.sessionStorage.setItem(storageKey, 'true')
      window.clearInterval(intervalId)
      window.clearTimeout(expandTimeoutId)
      window.clearTimeout(collapseTimeoutId)
      setPinned(false)
      setExpanded(false)
    }

    const restoreWidget = () => {
      widget.classList.remove('is-dismissed')
      window.sessionStorage.removeItem(storageKey)
      applyFact(facts[currentIndex] || fallbackFact)
      setPinned(false)
      setExpanded(false)
      startRotation()
    }

    widget.addEventListener('click', event => {
      const target = event.target
      if (!(target instanceof HTMLElement)) return
      const actionTarget = target.closest('[data-action]')
      if (!actionTarget) return

      const action = actionTarget.getAttribute('data-action')
      if (action === 'next') {
        event.preventDefault()
        showNextFact()
      }
      if (action === 'dismiss' && isDismissible) {
        event.preventDefault()
        dismissWidget()
      }
      if (action === 'restore' && isDismissible) {
        event.preventDefault()
        restoreWidget()
      }
    })

    if (facts.length) {
      applyFact(facts[currentIndex] || fallbackFact)
    } else {
      applyFact(fallbackFact)
    }

    if (isDismissible && window.sessionStorage.getItem(storageKey) === 'true') {
      widget.classList.add('is-dismissed')
    } else {
      setExpanded(isOverlay ? false : true)
      startRotation()
    }

    if (frameEl instanceof HTMLElement && isOverlay) {
      frameEl.addEventListener('click', event => {
        const target = event.target
        if (!(target instanceof HTMLElement)) return
        if (target.closest('a, button, [data-action]')) return

        const nextPinned = widget.dataset.pinned !== 'true'
        setPinned(nextPinned)
        setExpanded(nextPinned || widget.matches(':hover'))
        emitSfx(nextPinned ? 'panel-open' : 'panel-back')
      })
    }

    widget.addEventListener('mouseenter', () => {
      window.clearInterval(intervalId)
      window.clearTimeout(collapseTimeoutId)
      if (isOverlay && !prefersTouchUi && widget.dataset.pinned !== 'true') {
        expandTimeoutId = window.setTimeout(() => setExpanded(true), 210)
      }
    })
    widget.addEventListener('mouseleave', () => {
      window.clearTimeout(expandTimeoutId)
      if (isOverlay && !prefersTouchUi && widget.dataset.pinned !== 'true') {
        collapseTimeoutId = window.setTimeout(() => setExpanded(false), 260)
      }
      if (!widget.classList.contains('is-dismissed')) startRotation()
    })
  }
</script>

<style>
  .facts-widget-container {
    position: relative;
    overflow: visible;
  }

  .facts-widget-shell {
    position: relative;
  }

  .facts-widget-frame {
    --megameal-surface-border: oklch(0.45 0.08 38 / 0.34);
    --megameal-surface-hover-border: oklch(0.7 0.16 60 / 0.52);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(255, 180, 80, 0.2), transparent 34%),
      linear-gradient(180deg, rgba(16, 10, 11, 0.78), rgba(20, 11, 15, 0.62));
    --megameal-surface-shadow:
      0 18px 36px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    --megameal-surface-hover-shadow:
      0 0 0 1px oklch(0.72 0.12 58 / 0.22),
      0 20px 42px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 1.05rem;
    border-radius: 1.35rem;
  }

  .facts-widget-container[data-fact-theme='recovery'] .facts-widget-frame {
    --megameal-surface-border: oklch(0.58 0.13 340 / 0.35);
    --megameal-surface-hover-border: oklch(0.78 0.16 38 / 0.54);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(255, 99, 173, 0.24), transparent 34%),
      linear-gradient(180deg, rgba(48, 10, 28, 0.86), rgba(20, 7, 16, 0.68));
  }

  .facts-widget-container[data-fact-theme='harvest'] .facts-widget-frame {
    --megameal-surface-border: oklch(0.5 0.12 34 / 0.38);
    --megameal-surface-hover-border: oklch(0.72 0.17 52 / 0.56);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(255, 128, 64, 0.24), transparent 34%),
      linear-gradient(180deg, rgba(53, 14, 7, 0.88), rgba(23, 8, 7, 0.7));
  }

  .facts-widget-container[data-fact-theme='morale'] .facts-widget-frame {
    --megameal-surface-border: oklch(0.55 0.1 230 / 0.36);
    --megameal-surface-hover-border: oklch(0.8 0.15 145 / 0.54);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(53, 194, 255, 0.24), transparent 34%),
      linear-gradient(180deg, rgba(8, 29, 47, 0.86), rgba(7, 14, 25, 0.68));
  }

  .facts-widget-container[data-fact-theme='archive'] .facts-widget-frame,
  .facts-widget-container[data-fact-theme='storymode'] .facts-widget-frame {
    --megameal-surface-border: oklch(0.48 0.08 300 / 0.35);
    --megameal-surface-hover-border: oklch(0.73 0.15 320 / 0.52);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(183, 110, 255, 0.22), transparent 34%),
      linear-gradient(180deg, rgba(28, 12, 43, 0.86), rgba(16, 9, 24, 0.68));
  }

  .facts-widget-container[data-fact-theme='chronology'] .facts-widget-frame,
  .facts-widget-container[data-fact-theme='observatory'] .facts-widget-frame {
    --megameal-surface-border: oklch(0.5 0.08 235 / 0.34);
    --megameal-surface-hover-border: oklch(0.7 0.12 220 / 0.52);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(110, 160, 255, 0.22), transparent 34%),
      linear-gradient(180deg, rgba(8, 20, 44, 0.86), rgba(7, 11, 24, 0.68));
  }

  .facts-widget-container[data-fact-theme='comfort'] .facts-widget-frame {
    --megameal-surface-border: oklch(0.56 0.08 350 / 0.33);
    --megameal-surface-hover-border: oklch(0.78 0.12 15 / 0.5);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(255, 183, 214, 0.24), transparent 34%),
      linear-gradient(180deg, rgba(59, 26, 40, 0.84), rgba(23, 11, 18, 0.68));
  }

  .facts-widget-container[data-fact-theme='culinary'] .facts-widget-frame,
  .facts-widget-container[data-fact-theme='loyalty'] .facts-widget-frame {
    --megameal-surface-border: oklch(0.58 0.09 82 / 0.34);
    --megameal-surface-hover-border: oklch(0.82 0.15 82 / 0.54);
    --megameal-surface-bg:
      radial-gradient(circle at top right, rgba(255, 205, 92, 0.24), transparent 34%),
      linear-gradient(180deg, rgba(42, 28, 7, 0.85), rgba(22, 15, 7, 0.68));
  }

  .facts-widget-container.is-dismissed .facts-widget-frame {
    opacity: 0;
    transform: translateY(0.75rem) scale(0.96);
    pointer-events: none;
    height: 0;
    overflow: hidden;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
  }

  .facts-widget-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .facts-widget-header-copy {
    min-width: 0;
  }

  .facts-widget-kicker {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: oklch(0.82 0.16 72);
  }

  .facts-widget-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .facts-widget-refresh,
  .facts-widget-dismiss,
  .facts-widget-restore {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.82);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .facts-widget-refresh,
  .facts-widget-restore {
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .facts-widget-dismiss {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    font-size: 1.1rem;
    line-height: 1;
  }

  .facts-widget-refresh:hover,
  .facts-widget-dismiss:hover,
  .facts-widget-restore:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.22);
    color: white;
  }

  .facts-widget-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .facts-widget-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .facts-widget-label,
  .facts-widget-sponsor {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.58);
  }

  .facts-widget-label {
    color: oklch(0.82 0.11 62 / 0.9);
  }

  .facts-widget-headline {
    margin: 0;
    font-size: clamp(1.08rem, 2.2vw, 1.5rem);
    line-height: 1.08;
    color: white;
    text-wrap: balance;
  }

  .facts-widget-text {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.58;
    font-size: 0.94rem;
    max-width: 38rem;
  }

  .facts-widget-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .facts-widget-selection-hint {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    line-height: 0;
  }

  .facts-widget-selection-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: oklch(0.82 0.12 72);
    box-shadow: 0 0 12px oklch(0.82 0.12 72 / 0.45);
    animation: sponsored-pulse 2.2s ease-in-out infinite;
  }

  .facts-widget-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.82rem 1rem;
    border-radius: 0.85rem;
    text-decoration: none;
    color: #120908;
    background: linear-gradient(135deg, oklch(0.84 0.16 66), oklch(0.74 0.18 35));
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.76rem;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
    transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
  }

  .facts-widget-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
    filter: brightness(1.03);
  }

  .facts-widget-container[data-fact-theme='recovery'] .facts-widget-cta {
    background: linear-gradient(135deg, oklch(0.82 0.17 55), oklch(0.74 0.19 15));
  }

  .facts-widget-container[data-fact-theme='harvest'] .facts-widget-cta {
    background: linear-gradient(135deg, oklch(0.8 0.14 68), oklch(0.67 0.17 35));
  }

  .facts-widget-container[data-fact-theme='morale'] .facts-widget-cta,
  .facts-widget-container[data-fact-theme='chronology'] .facts-widget-cta,
  .facts-widget-container[data-fact-theme='observatory'] .facts-widget-cta {
    background: linear-gradient(135deg, oklch(0.8 0.14 205), oklch(0.73 0.16 155));
  }

  .facts-widget-container[data-fact-theme='archive'] .facts-widget-cta,
  .facts-widget-container[data-fact-theme='storymode'] .facts-widget-cta {
    background: linear-gradient(135deg, oklch(0.8 0.15 320), oklch(0.73 0.16 285));
    color: white;
  }

  .facts-widget-container[data-fact-theme='comfort'] .facts-widget-cta {
    background: linear-gradient(135deg, oklch(0.83 0.11 12), oklch(0.77 0.1 350));
  }

  .facts-widget-container[data-fact-theme='culinary'] .facts-widget-cta,
  .facts-widget-container[data-fact-theme='loyalty'] .facts-widget-cta {
    background: linear-gradient(135deg, oklch(0.86 0.12 90), oklch(0.76 0.14 68));
  }

  .facts-widget-fineprint,
  .facts-widget-footer {
    margin: 0;
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.48);
    line-height: 1.45;
  }

  .facts-widget-fineprint.is-hidden {
    display: none;
  }

  .facts-widget-restore {
    display: none;
    margin-top: 0.5rem;
    width: 100%;
    justify-content: center;
  }

  .facts-widget-container.is-dismissed .facts-widget-restore {
    display: inline-flex;
  }

  .facts-widget-sidebar .facts-widget-frame {
    min-height: 24rem;
  }

  .facts-widget-portal .facts-widget-frame {
    min-height: 0;
  }

  .facts-widget-overlay {
    position: fixed;
    right: clamp(0.9rem, 3vw, 2rem);
    bottom: max(0.9rem, env(safe-area-inset-bottom));
    width: min(14.25rem, calc(100vw - 1rem));
    z-index: 70;
    transform-origin: bottom right;
    transition: width 0.46s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .facts-widget-overlay[data-expanded='true'] {
    width: min(17rem, calc(100vw - 1rem));
  }

  .facts-widget-overlay .facts-widget-shell {
    animation: sponsored-drift 16s ease-in-out infinite;
  }

  .facts-widget-overlay .facts-widget-frame {
    gap: 0.72rem;
    padding: 0.82rem 0.88rem;
    cursor: pointer;
    transition:
      padding 0.46s cubic-bezier(0.16, 1, 0.3, 1),
      gap 0.46s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.46s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.38s ease,
      border-color 0.38s ease,
      background 0.38s ease;
  }

  .facts-widget-overlay .facts-widget-frame a,
  .facts-widget-overlay .facts-widget-frame button {
    cursor: pointer;
  }

  .facts-widget-overlay .facts-widget-kicker {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
  }

  .facts-widget-overlay .facts-widget-label,
  .facts-widget-overlay .facts-widget-sponsor {
    font-size: 0.62rem;
  }

  .facts-widget-overlay .facts-widget-headline {
    font-size: clamp(0.98rem, 2.4vw, 1.18rem);
  }

  .facts-widget-overlay .facts-widget-text {
    font-size: 0.8rem;
    line-height: 1.45;
    max-width: 24rem;
  }

  .facts-widget-overlay .facts-widget-cta,
  .facts-widget-overlay .facts-widget-refresh,
  .facts-widget-overlay .facts-widget-restore {
    font-size: 0.64rem;
    padding: 0.42rem 0.68rem;
  }

  .facts-widget-overlay .facts-widget-footer,
  .facts-widget-overlay .facts-widget-fineprint {
    font-size: 0.66rem;
    line-height: 1.35;
  }

  .facts-widget-overlay .facts-widget-dismiss {
    width: 1.8rem;
    height: 1.8rem;
  }

  .facts-widget-overlay .facts-widget-label-row,
