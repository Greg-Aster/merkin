---
import type { TimelineFact } from '../../config/timelineFacts'
import {
  megaMealUniverseFacts,
  resolveTimelineFactHref,
} from '../../config/timelineFacts'

export interface Props {
  class?: string
  style?: string
  footerText?: string
  variant?: 'sidebar' | 'portal' | 'overlay'
  dismissible?: boolean
  storageKey?: string
  title?: string
  kicker?: string
  factTypes?: TimelineFact['type'][]
  showPrivacyNoticeFirst?: boolean
}

const {
  class: className = '',
  style = '',
  footerText = 'Paid propaganda. Unpaid consequences.',
  variant = 'sidebar',
  dismissible = false,
  storageKey = 'megameal-sponsored-window-dismissed',
  kicker = variant === 'overlay'
    ? 'Live Ad Feed'
    : variant === 'portal'
      ? 'Paid Message'
      : 'Megameal Signal',
  factTypes = ['advertisement'],
  showPrivacyNoticeFirst = false,
} = Astro.props

const filteredFacts = megaMealUniverseFacts.filter(fact =>
  factTypes.includes(fact.type),
)

const privacyNoticeFact = {
  type: 'advertisement',
  eyebrow: 'Cookie Refusal Desk',
  headline: 'No Cookies. No Personal Data. No Appetite For Either.',
  text: "This site doesn't use cookies, and we don't care about your personal data. Thank you for choosing MEGAMEAL.",
  sponsor: 'Privacy Indifference Department',
  finePrint:
    'Your refusal has been accepted before you were asked.',
  theme: 'morale',
  cookieActions: [
    'Reject All Cookies',
    'Reject Every Cookie',
    'Reject Cookies Again',
  ],
} as TimelineFact & { cookieActions: string[] }

const shouldShowPrivacyNoticeFirst =
  showPrivacyNoticeFirst && variant === 'overlay'
const availableFacts = shouldShowPrivacyNoticeFirst
  ? [privacyNoticeFact, ...filteredFacts]
  : filteredFacts

const fallbackFact: TimelineFact = {
  type: 'advertisement',
  eyebrow: 'System Notice',
  headline: 'Sponsored Silence',
  text: 'No propaganda is currently available. This is either a miracle or an accounting error.',
  ctaText: 'Return To Consumption',
  href: '/posts/explainer/',
  sponsor: 'Corporate Calm Division',
  finePrint:
    'Normal service will resume once the market regains consciousness.',
}

const initialFact = availableFacts[0] ?? fallbackFact
const widgetId = `facts-widget-${Math.random().toString(36).slice(2, 10)}`
const initialHref = resolveTimelineFactHref(initialFact)
import '../../styles/features/facts-widget/core.css'
import '../../styles/features/facts-widget/overlay.css'
import '../../styles/features/facts-widget/motion-responsive.css'
---

<section
  id={widgetId}
  class:list={['facts-widget-container', `facts-widget-${variant}`, className]}
  style={style}
  data-facts-widget
  data-fact-theme={initialFact.theme || 'default'}
  data-expanded={variant === 'overlay' ? 'false' : 'true'}
  data-pinned="false"
  data-scroll-idle={variant === 'overlay' ? 'false' : 'true'}
  data-storage-key={storageKey}
  data-dismissible={dismissible ? 'true' : 'false'}
>
  <div class="facts-widget-shell">
    <div class="facts-widget-frame megameal-surface megameal-surface--interactive">
      <div class="facts-widget-header">
        <div class="facts-widget-header-copy">
          <div class="facts-widget-kicker">{kicker}</div>
        </div>

        <div class="facts-widget-controls">
          <button
            type="button"
            class="facts-widget-refresh"
            data-action="next"
            data-sfx-click="sweep"
            aria-label="Show another sponsored campaign"
          >
            Next Campaign
          </button>
          {dismissible && (
            <button
              type="button"
              class="facts-widget-dismiss"
              data-action="dismiss"
              data-sfx-click="panel-back"
              aria-label="Dismiss sponsored transmission window"
            >
              ×
            </button>
          )}
        </div>
      </div>

      <div class="facts-widget-body">
        <div class="facts-widget-label-row">
          <span class="facts-widget-label" data-fact-eyebrow>
            {initialFact.eyebrow || 'Sponsored Placement'}
          </span>
          <span class="facts-widget-sponsor" data-fact-sponsor>
            {initialFact.sponsor || 'Consumer Satisfaction Bureau'}
          </span>
        </div>

        <h3 class="facts-widget-headline" data-fact-headline>
          {initialFact.headline || 'Sponsored Message'}
        </h3>

        <div
          class:list={['facts-widget-media', !(initialFact.image || initialFact.video) && 'is-hidden']}
          data-fact-media
        >
          <video
            class:list={['facts-widget-media-video', !initialFact.video && 'is-hidden']}
            data-fact-media-video
            autoplay
            loop
            muted
            playsinline
            src={initialFact.video || ''}
          ></video>
          <img
            class:list={['facts-widget-media-img', !initialFact.image && 'is-hidden']}
            data-fact-media-img
            src={initialFact.image || ''}
            alt={initialFact.headline || ''}
          />
        </div>

        <p class="facts-widget-text" data-fact-text>{initialFact.text}</p>

        {variant === 'overlay' && (
          <div class="facts-widget-selection-hint" aria-hidden="true">
            <span class="facts-widget-selection-dot"></span>
          </div>
        )}

        <div class="facts-widget-actions">
          <a
            href={initialHref || '/posts/explainer/'}
            class="facts-widget-cta"
            data-fact-cta
            data-sfx-click="sweep"
          >
            {initialFact.ctaText || 'Comply'}
          </a>
          <div class="facts-widget-cookie-actions" data-fact-cookie-actions hidden>
            <button
              type="button"
              class="facts-widget-cookie-choice"
              data-fact-cookie-choice="0"
              data-action="next"
              data-sfx-click="sweep"
            >
              Reject All Cookies
            </button>
            <button
              type="button"
              class="facts-widget-cookie-choice"
              data-fact-cookie-choice="1"
              data-action="next"
              data-sfx-click="sweep"
            >
              Reject Every Cookie
            </button>
            <button
              type="button"
              class="facts-widget-cookie-choice"
              data-fact-cookie-choice="2"
              data-action="next"
              data-sfx-click="sweep"
            >
              Reject Cookies Again
            </button>
          </div>
        </div>

        <p
          class:list={[
            'facts-widget-fineprint',
            !initialFact.finePrint && 'is-hidden',
          ]}
          data-fact-fineprint
        >
          {initialFact.finePrint || ' '}
        </p>
      </div>

      <p class="facts-widget-footer">{footerText}</p>
    </div>

    {dismissible && (
      <button
        type="button"
        class="facts-widget-restore"
        data-action="restore"
        data-sfx-click="panel-open"
        aria-label="Restore sponsored transmission window"
      >
        Resume Sponsored Feed
      </button>
    )}
  </div>
</section>

<script is:inline define:vars={{ widgetId, facts: availableFacts, fallbackFact, hasFirstPrivacyNotice: shouldShowPrivacyNoticeFirst }}>
  const widget = document.getElementById(widgetId)

  if (!widget) {
    console.error(`FactsWidget: could not find widget ${widgetId}`)
  } else {
    const emitSfx = id => {
      document.dispatchEvent(new CustomEvent('megameal:sfx', { detail: { id } }))
    }

    const eyebrowEl = widget.querySelector('[data-fact-eyebrow]')
    const headlineEl = widget.querySelector('[data-fact-headline]')
    const textEl = widget.querySelector('[data-fact-text]')
    const ctaEl = widget.querySelector('[data-fact-cta]')
    const sponsorEl = widget.querySelector('[data-fact-sponsor]')
    const finePrintEl = widget.querySelector('[data-fact-fineprint]')
    const mediaEl = widget.querySelector('[data-fact-media]')
    const mediaVideoEl = widget.querySelector('[data-fact-media-video]')
    const mediaImgEl = widget.querySelector('[data-fact-media-img]')
    const cookieActionsEl = widget.querySelector('[data-fact-cookie-actions]')
    const cookieChoiceEls = Array.from(widget.querySelectorAll('[data-fact-cookie-choice]'))
    const frameEl = widget.querySelector('.facts-widget-frame')
    const storageKey =
      widget.dataset.storageKey || 'megameal-sponsored-window-dismissed'
    const isDismissible = widget.dataset.dismissible === 'true'
    const isOverlay = widget.classList.contains('facts-widget-overlay')
    const prefersTouchUi = window.matchMedia('(hover: none), (pointer: coarse)').matches
    let currentIndex = -1
    let intervalId
    let expandTimeoutId
    let collapseTimeoutId
    let scrollIdleTimeoutId
    let cleanupOverlayActivityListeners = () => {}
    const overlayScrollIdleDelay = 7000
    const overlayRestoreIdleDelay = 4200

    const specialFactLinks = {
      Explainer: '/posts/explainer/',
      Timeline: '/timeline/',
      'Mega-Meal-3': '/videos/qarnivor-snuggloid-emergence/',
    }

    const resolveHref = fact => {
      if (fact?.href) return fact.href
      if (!fact?.link) return '/posts/explainer/'
      if (fact.link.startsWith('/')) return fact.link
      if (specialFactLinks[fact.link]) return specialFactLinks[fact.link]
      return `/posts/${fact.link}/`
    }

    const applyFact = fact => {
      if (
        !eyebrowEl ||
        !headlineEl ||
        !textEl ||
        !ctaEl ||
        !sponsorEl ||
        !finePrintEl
      ) {
        return
      }

      eyebrowEl.textContent = fact.eyebrow || 'Sponsored Placement'
      headlineEl.textContent = fact.headline || 'Sponsored Message'
      textEl.textContent = fact.text || ''
      sponsorEl.textContent = fact.sponsor || 'Consumer Satisfaction Bureau'
      ctaEl.textContent = fact.ctaText || 'Comply'
      ctaEl.setAttribute('href', resolveHref(fact))
      widget.dataset.factTheme = fact.theme || 'default'
      widget.dataset.factRole = fact.cookieActions ? 'privacy-notice' : 'standard'

      if (fact.cookieActions?.length && cookieActionsEl) {
        ctaEl.hidden = true
        cookieActionsEl.hidden = false
        cookieChoiceEls.forEach((button, index) => {
          button.textContent = fact.cookieActions[index] || 'Reject All Cookies'
        })
      } else {
        ctaEl.hidden = false
        if (cookieActionsEl) cookieActionsEl.hidden = true
      }

      if (fact.finePrint) {
        finePrintEl.textContent = fact.finePrint
        finePrintEl.classList.remove('is-hidden')
      } else {
        finePrintEl.textContent = ''
        finePrintEl.classList.add('is-hidden')
      }

      if (mediaEl && mediaVideoEl && mediaImgEl) {
        if (fact.video) {
          mediaVideoEl.setAttribute('src', fact.video)
          mediaVideoEl.classList.remove('is-hidden')
          mediaImgEl.classList.add('is-hidden')
          mediaEl.classList.remove('is-hidden')
          mediaVideoEl.load()
          mediaVideoEl.play().catch(() => {})
        } else if (fact.image) {
          mediaImgEl.setAttribute('src', fact.image)
          mediaImgEl.setAttribute('alt', fact.headline || '')
          mediaImgEl.classList.remove('is-hidden')
          mediaVideoEl.classList.add('is-hidden')
          mediaVideoEl.pause()
          mediaEl.classList.remove('is-hidden')
        } else {
          mediaVideoEl.pause()
          mediaVideoEl.removeAttribute('src')
          mediaVideoEl.classList.add('is-hidden')
          mediaImgEl.classList.add('is-hidden')
          mediaEl.classList.add('is-hidden')
        }
      }
    }

    const getRandomFactIndex = () => {
      const firstRandomIndex = hasFirstPrivacyNotice ? 1 : 0
      if (facts.length <= firstRandomIndex) return -1
      if (facts.length === firstRandomIndex + 1) return firstRandomIndex

      let nextIndex = currentIndex
      while (nextIndex === currentIndex || nextIndex < firstRandomIndex) {
        nextIndex = firstRandomIndex + Math.floor(Math.random() * (facts.length - firstRandomIndex))
      }

      return nextIndex
    }

    const showRandomFact = () => {
      if (!facts.length || widget.classList.contains('is-dismissed')) return
      currentIndex = getRandomFactIndex()
      applyFact(facts[currentIndex] || fallbackFact)
    }

    const setExpanded = expanded => {
      if (!isOverlay) return
      widget.dataset.expanded = expanded ? 'true' : 'false'
    }

    const setPinned = pinned => {
      if (!isOverlay) return
      widget.dataset.pinned = pinned ? 'true' : 'false'
    }

    const setScrollIdle = idle => {
      if (!isOverlay) return
      widget.dataset.scrollIdle = idle ? 'true' : 'false'
    }

    const scheduleScrollIdle = (delay = overlayScrollIdleDelay) => {
      if (!isOverlay || widget.classList.contains('is-dismissed')) return
      window.clearTimeout(scrollIdleTimeoutId)
      scrollIdleTimeoutId = window.setTimeout(() => setScrollIdle(true), delay)
    }

    const markUserIsNavigating = () => {
      if (!isOverlay) return
      setScrollIdle(false)
      setPinned(false)
      setExpanded(false)
      scheduleScrollIdle()
    }

    const startRotation = () => {
      if (!facts.length) return
      // Respect prefers-reduced-motion: disable auto-rotation if user prefers reduced motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return
      }
      window.clearInterval(intervalId)
      intervalId = window.setInterval(showRandomFact, 18000)
    }

    const dismissWidget = () => {
      widget.classList.add('is-dismissed')
      window.sessionStorage.setItem(storageKey, 'true')
      window.clearInterval(intervalId)
      window.clearTimeout(expandTimeoutId)
      window.clearTimeout(collapseTimeoutId)
      window.clearTimeout(scrollIdleTimeoutId)
      cleanupOverlayActivityListeners()
      setPinned(false)
      setExpanded(false)
      setScrollIdle(false)
    }

    const restoreWidget = () => {
      widget.classList.remove('is-dismissed')
      window.sessionStorage.removeItem(storageKey)
      applyFact(facts[currentIndex] || fallbackFact)
      setPinned(false)
      setExpanded(false)
      scheduleScrollIdle(overlayRestoreIdleDelay)
      startRotation()
    }

    widget.addEventListener('click', event => {
      const target = event.target
      if (!(target instanceof HTMLElement)) return
      const actionTarget = target.closest('[data-action]')
      if (!actionTarget) return

      const action = actionTarget.getAttribute('data-action')
      if (action === 'next') {
        event.preventDefault()
        showRandomFact()
      }
      if (action === 'dismiss' && isDismissible) {
        event.preventDefault()
        dismissWidget()
      }
      if (action === 'restore' && isDismissible) {
        event.preventDefault()
        restoreWidget()
      }
    })

    if (facts.length) {
      currentIndex = hasFirstPrivacyNotice ? 0 : getRandomFactIndex()
      applyFact(facts[currentIndex] || fallbackFact)
    } else {
      applyFact(fallbackFact)
    }

    if (isDismissible && window.sessionStorage.getItem(storageKey) === 'true') {
      widget.classList.add('is-dismissed')
    } else {
      setExpanded(isOverlay ? false : true)
      startRotation()
      scheduleScrollIdle()
    }

    if (frameEl instanceof HTMLElement && isOverlay) {
      frameEl.addEventListener('click', event => {
        const target = event.target
        if (!(target instanceof HTMLElement)) return
        if (target.closest('a, button, [data-action]')) return

        const nextPinned = widget.dataset.pinned !== 'true'
        setPinned(nextPinned)
        setExpanded(nextPinned || widget.matches(':hover'))
        emitSfx(nextPinned ? 'panel-open' : 'panel-back')
      })
    }

    widget.addEventListener('mouseenter', () => {
      window.clearInterval(intervalId)
      window.clearTimeout(collapseTimeoutId)
      if (isOverlay && !prefersTouchUi && widget.dataset.pinned !== 'true') {
        expandTimeoutId = window.setTimeout(() => setExpanded(true), 210)
      }
    })
    widget.addEventListener('mouseleave', () => {
      window.clearTimeout(expandTimeoutId)
      if (isOverlay && !prefersTouchUi && widget.dataset.pinned !== 'true') {
        collapseTimeoutId = window.setTimeout(() => setExpanded(false), 260)
      }
      if (!widget.classList.contains('is-dismissed')) startRotation()
    })

    if (isOverlay) {
      const activityController = new AbortController()
      const activitySignal = activityController.signal
      const handleKeyNavigation = event => {
        if (
          event.key === 'PageDown' ||
          event.key === 'PageUp' ||
          event.key === 'Home' ||
          event.key === 'End' ||
          event.key === 'ArrowDown' ||
          event.key === 'ArrowUp' ||
          event.key === ' '
        ) {
          markUserIsNavigating()
        }
      }

      window.addEventListener('scroll', markUserIsNavigating, { passive: true, signal: activitySignal })
      window.addEventListener('wheel', markUserIsNavigating, { passive: true, signal: activitySignal })
      window.addEventListener('touchmove', markUserIsNavigating, { passive: true, signal: activitySignal })
      window.addEventListener('keydown', handleKeyNavigation, { signal: activitySignal })

      cleanupOverlayActivityListeners = () => {
        activityController.abort()
        window.clearTimeout(scrollIdleTimeoutId)
      }

      document.addEventListener('astro:before-swap', cleanupOverlayActivityListeners, { once: true })
    }
  }
</script>
