---
type Tone = 'blue' | 'cyan' | 'green' | 'orange' | 'purple' | 'red' | 'yellow'
type Variant = 'panel' | 'bar'

interface Props {
  tone?: Tone
  variant?: Variant
  title?: string
  icon?: string
  class?: string
}

const {
  tone = 'blue',
  variant = 'panel',
  title,
  icon,
  class: className = '',
} = Astro.props

const toneClasses: Record<Tone, { panel: string; bar: string; title: string; body: string }> = {
  blue: {
    panel: 'border-blue-500/50 bg-gradient-to-r from-blue-900/40 to-black/20',
    bar: 'border-blue-500 bg-blue-900/20',
    title: 'text-blue-400',
    body: 'text-blue-200',
  },
  cyan: {
    panel: 'border-cyan-500/50 bg-gradient-to-r from-cyan-900/40 to-black/20',
    bar: 'border-cyan-500 bg-cyan-900/20',
    title: 'text-cyan-400',
    body: 'text-cyan-200',
  },
  green: {
    panel: 'border-green-500/50 bg-gradient-to-r from-green-900/40 to-black/20',
    bar: 'border-green-500 bg-green-900/20',
    title: 'text-green-400',
    body: 'text-green-200',
  },
  orange: {
    panel: 'border-orange-500/50 bg-gradient-to-r from-orange-900/40 to-black/20',
    bar: 'border-orange-500 bg-orange-900/20',
    title: 'text-orange-400',
    body: 'text-orange-200',
  },
  purple: {
    panel: 'border-purple-500/50 bg-gradient-to-r from-purple-900/40 to-black/20',
    bar: 'border-purple-500 bg-purple-900/20',
    title: 'text-purple-400',
    body: 'text-purple-200',
  },
  red: {
    panel: 'border-red-500/50 bg-gradient-to-r from-red-900/40 to-black/20',
    bar: 'border-red-500 bg-red-900/20',
    title: 'text-red-400',
    body: 'text-red-200',
  },
  yellow: {
    panel: 'border-yellow-500/50 bg-gradient-to-r from-yellow-900/40 to-black/20',
    bar: 'border-yellow-500 bg-yellow-900/20',
    title: 'text-yellow-400',
    body: 'text-yellow-200',
  },
}

const selected = toneClasses[tone]
const wrapperClass =
  variant === 'bar'
    ? ['my-6 border-l-4 p-4', selected.bar, className]
    : ['rounded-lg border p-6', selected.panel, className]
---

<div class:list={wrapperClass}>
  {title && (
    <div class="mb-4 flex items-center gap-3">
      {icon && <span class:list={['text-2xl', selected.title]}>{icon}</span>}
      <h3 class:list={['text-xl font-bold', selected.title]}>{title}</h3>
    </div>
  )}
  <div class:list={['leading-relaxed', selected.body]}>
    <slot />
  </div>
</div>
