---
interface Props {
  chapter: string
  title: string
  icon: string
  quote: string
  cite?: string
  quoteMarks?: boolean
}

const { chapter, title, icon, quote, cite, quoteMarks = true } = Astro.props
---

<div class="mb-8 rounded-xl border-2 border-purple-500/50 bg-gradient-to-br from-purple-900/30 to-red-900/20 p-8">
  <div class="mb-6 flex items-center gap-4">
    <div class="flex h-16 w-16 items-center justify-center rounded-lg bg-purple-500/20">
      <span class="text-5xl text-purple-400">{icon}</span>
    </div>
    <div>
      <div class="text-3xl font-bold text-purple-400">{chapter}</div>
      <div class="text-lg text-purple-300">{title}</div>
    </div>
  </div>

  <blockquote class="border-l-4 border-purple-400 pl-6 text-lg italic leading-relaxed text-purple-200">
    {quoteMarks ? `"${quote}"` : quote}
  </blockquote>

  {cite && (
    <div class="mt-4 text-right">
      <cite class="text-sm text-purple-300">- {cite}</cite>
    </div>
  )}
</div>
