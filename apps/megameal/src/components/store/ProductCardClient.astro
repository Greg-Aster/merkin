---
interface Props {
  descriptionData?: string
  formActionUrl?: string
  preWrittenReviewsData?: unknown[]
  productId: string
  productName: string
  qandaData?: unknown[]
  realDescriptionData?: string
  shippingNoteData?: string
  specificationsData?: unknown[]
}

const payloadJson = JSON.stringify(Astro.props).replace(/</g, '\\u003c')
---

<script
  is:inline
  type="application/json"
  data-product-card-payload
  set:html={payloadJson}
/>

<script>
  import { mountAllProductCards } from './productCardController'

  mountAllProductCards()
  document.addEventListener('astro:page-load', mountAllProductCards)
</script>
