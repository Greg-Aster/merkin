---
import { Icon } from 'astro-icon/components'

interface MediaItem {
  type: 'image' | 'video' | 'youtube'
  src?: string
  videoId?: string
  poster?: string
  alt?: string
  caption?: string
}

interface CardThumbnail {
  kind: 'image' | 'youtube'
  src?: string
  videoId?: string
}

interface Props {
  availabilityClasses: string
  availabilityLabel: string
  mediaItems: MediaItem[]
  name: string
  thumbnail: CardThumbnail | null
}

const {
  availabilityClasses,
  availabilityLabel,
  mediaItems,
  name,
  thumbnail,
} = Astro.props
---

<div class="block overflow-hidden relative product-card-thumb">
  <div class:list={['absolute top-2 left-2 z-10 px-2 py-0.5 rounded text-xs font-bold tracking-wide shadow', availabilityClasses]}>
    {availabilityLabel}
  </div>

  {mediaItems.length > 1 && (
    <div class="absolute top-2 right-2 z-10 px-1.5 py-0.5 rounded bg-black/60 text-white text-[10px] flex items-center gap-1">
      {mediaItems.some(item => item.type === 'youtube' || item.type === 'video') && (
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
          <path d="M8 5v14l11-7z" />
        </svg>
      )}
      {mediaItems.length}
    </div>
  )}

  {thumbnail ? (
    thumbnail.kind === 'image' ? (
      <img
        src={thumbnail.src}
        alt={name}
        class="w-full h-52 object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="relative w-full h-52 bg-slate-800">
        <img
          src={`https://img.youtube.com/vi/${thumbnail.videoId}/mqdefault.jpg`}
          alt={name}
          class="w-full h-52 object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-12 h-12 rounded-full bg-red-600/90 flex items-center justify-center shadow-xl">
            <svg viewBox="0 0 24 24" fill="white" class="w-6 h-6 ml-0.5">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>
      </div>
    )
  ) : (
    <div class="w-full h-52 bg-slate-700/50 flex flex-col items-center justify-center gap-2">
      <Icon name="mdi:image-off-outline" class="h-8 w-8 text-slate-600" />
      <p class="text-slate-500 italic text-sm">Image Coming Soon</p>
    </div>
  )}
</div>

