---
import type { CollectionEntry } from 'astro:content'
import { communityConfig } from '../../config/community.config'
import { url } from '../../utils/url-utils'
import ProductCardClient from './ProductCardClient.astro'
import ProductCardDetails from './ProductCardDetails.astro'
import ProductCardSummary from './ProductCardSummary.astro'
import ProductCardThumbnail from './ProductCardThumbnail.astro'

export interface Props {
  class?: string
  product: CollectionEntry<'products'>
  style?: string
}

const { product, style } = Astro.props
const className = Astro.props.class
const {
  name,
  tagline,
  description,
  price,
  image,
  sku,
  rating,
  additionalImages,
  media,
  specifications,
  qanda,
  preWrittenReviews,
  availability,
  ctaMode,
  stripePaymentLink,
  shippingNote,
  badge,
} = product.data

type MediaGalleryItem = {
  type: 'image' | 'video' | 'youtube'
  src?: string
  videoId?: string
  poster?: string
  alt?: string
  caption?: string
}

type CardThumbnail = {
  kind: 'image' | 'youtube'
  src?: string
  videoId?: string
}

const resolveAsset = (path: string | undefined) => {
  if (!path) return undefined
  return path.startsWith('/') ? url(path) : path
}
const formActionUrl = communityConfig.contact.formActionUrl

const hasSpecifications =
  Array.isArray(specifications) && specifications.length > 0
const hasQandA = Array.isArray(qanda) && qanda.length > 0
const hasPreWrittenReviews =
  Array.isArray(preWrittenReviews) && preWrittenReviews.length > 0

// Build unified media items: prefer media[] field, fall back to legacy image/additionalImages
const isGalleryMediaType = (type: string): type is MediaGalleryItem['type'] =>
  type === 'image' || type === 'video' || type === 'youtube'

const mediaItems: MediaGalleryItem[] =
  Array.isArray(media) && media.length > 0
    ? media.flatMap(item => {
        if (!isGalleryMediaType(item.type)) return []
        return [
          {
            type: item.type,
            src: item.src ? resolveAsset(item.src) : undefined,
            videoId: item.videoId,
            poster: item.poster ? resolveAsset(item.poster) : undefined,
            alt: item.alt,
            caption: item.caption,
          },
        ]
      })
    : [
        ...(image
          ? [{ type: 'image' as const, src: resolveAsset(image), alt: name }]
          : []),
        ...(additionalImages ?? []).map((src: string) => ({
          type: 'image' as const,
          src: resolveAsset(src),
          alt: name,
        })),
      ]

// For the card thumbnail: first image or YouTube thumbnail
const cardThumbnail: CardThumbnail | null = (() => {
  for (const m of mediaItems) {
    if (m.type === 'image' && m.src)
      return { kind: 'image' as const, src: resolveAsset(m.src) }
    if (m.type === 'video' && m.poster)
      return { kind: 'image' as const, src: resolveAsset(m.poster) }
    if (m.type === 'youtube' && m.videoId)
      return { kind: 'youtube' as const, videoId: m.videoId }
  }
  return null
})()

// Star rating calculation
let calculatedFullStars = 0
let calculatedHalfStar = false
let calculatedEmptyStars = 5
let isRated = false

if (typeof rating === 'number' && rating >= 0 && rating <= 5) {
  isRated = true
  calculatedFullStars = Math.floor(rating)
  calculatedHalfStar = rating % 1 >= 0.5
  calculatedEmptyStars = 5 - calculatedFullStars - (calculatedHalfStar ? 1 : 0)
}

// Availability badge config — each status gets a label, color, and satirical CTA message
const availabilityMap: Record<
  string,
  { label: string; classes: string; ctaMessage: string }
> = {
  available: {
    label: badge || 'Available Now',
    classes: 'bg-emerald-500/90 text-white',
    ctaMessage: '',
  },
  coming_soon: {
    label: badge || 'Coming Soon',
    classes: 'bg-blue-500/80 text-white',
    ctaMessage: 'Transmission pending. Stand by.',
  },
  out_of_stock: {
    label: badge || 'Out of Stock',
    classes: 'bg-slate-500/80 text-white',
    ctaMessage: 'The shelves are bare. Demand has been noted. Probably.',
  },
  not_in_your_area: {
    label: badge || 'Not in Your Area',
    classes: 'bg-amber-500/80 text-black',
    ctaMessage: 'Your coordinates are outside our current distribution matrix.',
  },
  not_in_your_timeline: {
    label: badge || 'Not Available in Your Timeline',
    classes: 'bg-purple-500/80 text-white',
    ctaMessage:
      'This product exists. Procurement from your timeline is not currently supported.',
  },
  artifact_only: {
    label: badge || 'Artifact Record',
    classes: 'bg-rose-900/80 text-rose-200',
    ctaMessage:
      'This item is catalogued for archival purposes. Acquiring it would be inadvisable.',
  },
}
const currentAvailability = availability ?? 'coming_soon'
const availBadge =
  availabilityMap[currentAvailability] ?? availabilityMap.coming_soon
const canAddToCart = ctaMode === 'cart' && currentAvailability === 'available'
const canBuyExternal =
  ctaMode === 'external' &&
  !!stripePaymentLink &&
  currentAvailability === 'available'
const productSlug = product.data.slug ?? product.id.replace(/\.(md|mdx)$/, '')
const productHref = `/store/${productSlug}/`
const ratingLabel =
  typeof rating === 'number'
    ? `Rating: ${rating.toFixed(1)} out of 5 stars`
    : 'Not rated'
---

<div
  class:list={[
    "card-base group flex flex-col w-full overflow-hidden relative product-card rounded-[var(--radius-large)]",
    "transition-all duration-300 ease-in-out",
    "cursor-pointer",
    "hover:shadow-xl dark:hover:shadow-[0_0_20px_3px_rgba(var(--primary-rgb),0.25)]",
    className
  ]}
  style={style}
  data-product-id={product.id}
  role="link"
  tabindex="0"
  aria-labelledby={`product-title-${product.id}`}
  onclick={`if (!event.target.closest('a, button, .card-expansion-trigger, .tab-link, .details-content')) { window.location.href = '${productHref}'; }`}
  onkeydown={`if ((event.key === 'Enter' || event.key === ' ') && !event.target.closest('a, button, .card-expansion-trigger, .tab-link, .details-content')) { event.preventDefault(); window.location.href = '${productHref}'; }`}
>
  <ProductCardThumbnail
    availabilityClasses={availBadge.classes}
    availabilityLabel={availBadge.label}
    mediaItems={mediaItems}
    name={name}
    thumbnail={cardThumbnail}
  />

  <ProductCardSummary
    emptyStars={calculatedEmptyStars}
    fullStars={calculatedFullStars}
    halfStar={calculatedHalfStar}
    isRated={isRated}
    name={name}
    price={price}
    productHref={productHref}
    productId={product.id}
    ratingLabel={ratingLabel}
    tagline={tagline}
  />

  <ProductCardDetails
    availabilityMessage={availBadge.ctaMessage}
    canAddToCart={canAddToCart}
    canBuyExternal={canBuyExternal}
    currentAvailability={currentAvailability}
    description={description}
    hasPreWrittenReviews={hasPreWrittenReviews}
    hasQandA={hasQandA}
    hasSpecifications={hasSpecifications}
    mediaItems={mediaItems}
    name={name}
    price={price}
    productHref={productHref}
    productId={product.id}
    shippingNote={shippingNote}
    sku={sku}
    stripePaymentLink={stripePaymentLink}
  />
</div>

  <ProductCardClient
    descriptionData={product.data.description}
    formActionUrl={formActionUrl}
    preWrittenReviewsData={product.data.preWrittenReviews}
    productId={product.id}
    productName={product.data.name}
    qandaData={product.data.qanda}
    realDescriptionData={product.data.realDescription}
    shippingNoteData={product.data.shippingNote}
    specificationsData={product.data.specifications}
  />
